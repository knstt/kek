#import(std/core.kek);
#import(std/string.kek);

struct:ByteCursor {
	String:input;
	usize:pos;
	usize:line;
	usize:column;
};

ByteCursor:ByteCursorNew(String:input) {
	ByteCursor:cursor;
	cursor.input = input;
	cursor.pos = 0;
	cursor.line = 1;
	cursor.column = 1;
	return(cursor);
}

bool:ByteCursor::AtEnd() {
	return(this.pos >= this.input.len);
}

byte:ByteCursor::Peek() {
	if (this.AtEnd()) {
		return(0);
	}
	return(this.input.data[this.pos]);
}

byte:ByteCursor::PeekAt(usize:offset) {
	usize:target = this.pos + offset;
	if (target >= this.input.len) {
		return(0);
	}
	return(this.input.data[target]);
}

byte:ByteCursor::Advance() {
	byte:value = this.Peek();
	if (this.AtEnd()) {
		return(0);
	}
	this.pos += 1;
	if (value == '\n') {
		this.line += 1;
		this.column = 1;
	} else {
		this.column += 1;
	}
	return(value);
}

bool:ByteCursor::MatchByte(byte:value) {
	if (this.Peek() != value) {
		return(false);
	}
	this.Advance();
	return(true);
}

Status:ByteCursor::SkipAsciiWhitespace() {
	while (!this.AtEnd() && IsAsciiSpace(this.Peek())) {
		this.Advance();
	}
	return(Status::Ok);
}
