struct:MemoryReader {
	ptr<byte>:data;
	usize:len;
	usize:pos;
};

struct:MemoryWriter {
	ptr<byte>:data;
	usize:len;
	usize:pos;
};

MemoryReader:MemoryReaderNew(Slice<byte>:data) {
	MemoryReader:reader;
	reader.data = data.data;
	reader.len = data.len;
	reader.pos = 0;
	return(reader);
}

MemoryWriter:MemoryWriterNew(Span<byte>:data) {
	MemoryWriter:writer;
	writer.data = data.data;
	writer.len = data.len;
	writer.pos = 0;
	return(writer);
}

Result<usize>:MemoryRead(ptr<MemoryReader>:reader, Span<byte>:out) {
	Result<usize>:result;
	if (reader.pos >= reader.len) {
		result.status = Status::End;
		return(result);
	}

	usize:remaining = reader.len - reader.pos;
	usize:amount = out.len;
	if (amount > remaining) {
		amount = remaining;
	}

	for (usize:i = 0; i < amount; i++) {
		out.data[i] = reader.data[reader.pos + i];
	}

	reader.pos += amount;
	result.status = Status::Ok;
	result.value = amount;
	return(result);
}

Result<usize>:MemoryWrite(ptr<MemoryWriter>:writer, Slice<byte>:data) {
	Result<usize>:result;
	usize:remaining = writer.len - writer.pos;
	if (data.len > remaining) {
		result.status = Status::NoMemory;
		result.value = writer.pos;
		return(result);
	}

	for (usize:i = 0; i < data.len; i++) {
		writer.data[writer.pos + i] = data.data[i];
	}

	writer.pos += data.len;
	result.status = Status::Ok;
	result.value = data.len;
	return(result);
}

usize:MemoryWritten(ptr<MemoryWriter>:writer) {
	return(writer.pos);
}

Status:WriteByteToMemory(ptr<MemoryWriter>:writer, byte:value) {
	byte:buffer[1] = { value };
	Result<usize>:result = MemoryWrite(writer, std::FixedSlice<byte>(buffer, 1));
	return(result.status);
}
