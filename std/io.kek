struct:MemoryReader {
	ptr<byte>:data;
	usize:len;
	usize:pos;
};

struct:MemoryWriter {
	ptr<byte>:data;
	usize:len;
	usize:pos;
};

MemoryReader:MemoryReaderNew(Slice<byte>:data) {
	MemoryReader:reader;
	reader.data = data.data;
	reader.len = data.len;
	reader.pos = 0;
	return(reader);
}

MemoryWriter:MemoryWriterNew(Span<byte>:data) {
	MemoryWriter:writer;
	writer.data = data.data;
	writer.len = data.len;
	writer.pos = 0;
	return(writer);
}

Result<usize>:MemoryReader::Read(Span<byte>:out) {
	Result<usize>:result;
	if (this.pos >= this.len) {
		result.status = Status::End;
		return(result);
	}

	usize:remaining = this.len - this.pos;
	usize:amount = out.len;
	if (amount > remaining) {
		amount = remaining;
	}

	for (usize:i = 0; i < amount; i++) {
		out.data[i] = this.data[this.pos + i];
	}

	this.pos += amount;
	result.status = Status::Ok;
	result.value = amount;
	return(result);
}

Result<usize>:MemoryWriter::Write(Slice<byte>:data) {
	Result<usize>:result;
	usize:remaining = this.len - this.pos;
	if (data.len > remaining) {
		result.status = Status::NoMemory;
		result.value = this.pos;
		return(result);
	}

	for (usize:i = 0; i < data.len; i++) {
		this.data[this.pos + i] = data.data[i];
	}

	this.pos += data.len;
	result.status = Status::Ok;
	result.value = data.len;
	return(result);
}

usize:MemoryWriter::Written() {
	return(this.pos);
}

Status:WriteByteToMemory(ptr<MemoryWriter>:writer, byte:value) {
	byte:buffer[1] = { value };
	Result<usize>:result = writer.Write(std::FixedSlice<byte>(buffer, 1));
	return(result.status);
}
