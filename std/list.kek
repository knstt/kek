#import(std/core.kek);
#import(std/mem.kek);

struct:ListNode<T> {
	T:value;
	ptr<ListNode<T>>:next;
	ptr<ListNode<T>>:prev;
};

struct:LinkedList<T> {
	ptr<ListNode<T>>:first;
	ptr<ListNode<T>>:last;
	usize:len;
	Allocator:allocator;
};

LinkedList<T>:LinkedListNew<T>(Allocator:allocator) {
	LinkedList<T>:list;
	list.first = 0;
	list.last = 0;
	list.len = 0;
	list.allocator = allocator;
	return(list);
}

Status:LinkedList<T>::PushBack(T:value) {
	ptr<ListNode<T>>:node = std::Alloc<ListNode<T>>(this.allocator, 1);
	if (node == 0) {
		return(Status::NoMemory);
	}
	node.value = value;
	node.next = 0;
	node.prev = this.last;

	if (this.last != 0) {
		ptr<ListNode<T>>:last = this.last;
		last.next = node;
	} else {
		this.first = node;
	}
	this.last = node;
	this.len += 1;
	return(Status::Ok);
}

Status:LinkedList<T>::PushFront(T:value) {
	ptr<ListNode<T>>:node = std::Alloc<ListNode<T>>(this.allocator, 1);
	if (node == 0) {
		return(Status::NoMemory);
	}
	node.value = value;
	node.prev = 0;
	node.next = this.first;

	if (this.first != 0) {
		ptr<ListNode<T>>:first = this.first;
		first.prev = node;
	} else {
		this.last = node;
	}
	this.first = node;
	this.len += 1;
	return(Status::Ok);
}

Result<T>:LinkedList<T>::PopBack() {
	Result<T>:result;
	if (this.last == 0) {
		result.status = Status::End;
		return(result);
	}

	ptr<ListNode<T>>:node = this.last;
	result.value = node.value;
	this.last = node.prev;
	if (this.last != 0) {
		ptr<ListNode<T>>:last = this.last;
		last.next = 0;
	} else {
		this.first = 0;
	}
	this.len -= 1;
	std::Free<ListNode<T>>(this.allocator, node, 1);
	result.status = Status::Ok;
	return(result);
}

Status:LinkedList<T>::Destroy() {
	while (this.len > 0) {
		Result<T>:ignored = this.PopBack();
		if (ignored.status != Status::Ok) {
			return(ignored.status);
		}
	}
	return(Status::Ok);
}

Result<T>:LinkedList<T>::PopFront() {
	Result<T>:result;
	if (this.first == 0) {
		result.status = Status::End;
		return(result);
	}

	ptr<ListNode<T>>:node = this.first;
	result.value = node.value;
	this.first = node.next;
	if (this.first != 0) {
		ptr<ListNode<T>>:first = this.first;
		first.prev = 0;
	} else {
		this.last = 0;
	}
	this.len -= 1;
	std::Free<ListNode<T>>(this.allocator, node, 1);
	result.status = Status::Ok;
	return(result);
}
