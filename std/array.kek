struct:Array<T> {
	ptr<T>:data;
	usize:len;
	usize:cap;
	Allocator:allocator;
};

Array<T>:ArrayNew<T>(Allocator:allocator) {
	Array<T>:array;
	array.data = 0;
	array.len = 0;
	array.cap = 0;
	array.allocator = allocator;
	return(array);
}

Status:Array<T>::Destroy() {
	if (this.data != 0) {
		Free<T>(this.allocator, this.data, this.cap);
	}
	this.data = 0;
	this.len = 0;
	this.cap = 0;
	return(Status::Ok);
}

Status:Array<T>::Reserve(usize:additional) {
	usize:needed = this.len + additional;
	if (needed <= this.cap) {
		return(Status::Ok);
	}

	usize:newCap = this.cap;
	if (newCap == 0) {
		newCap = 8;
	}
	while (newCap < needed) {
		newCap = newCap * 2;
	}

	ptr<T>:newData = std::Resize<T>(this.allocator, this.data, this.cap, newCap);
	if (newData == 0) {
		return(Status::NoMemory);
	}
	this.data = newData;
	this.cap = newCap;
	return(Status::Ok);
}

Status:Array<T>::Push(T:value) {
	Status:status = this.Reserve(1);
	if (status != Status::Ok) {
		return(status);
	}
	this.data[this.len] = value;
	this.len += 1;
	return(Status::Ok);
}

Result<T>:Array<T>::Pop() {
	Result<T>:result;
	if (this.len == 0) {
		result.status = Status::End;
		return(result);
	}
	this.len -= 1;
	result.status = Status::Ok;
	result.value = this.data[this.len];
	return(result);
}

Result<T>:Array<T>::Get(usize:index) {
	Result<T>:result;
	if (index >= this.len) {
		result.status = Status::Invalid;
		return(result);
	}
	result.status = Status::Ok;
	result.value = this.data[index];
	return(result);
}

Status:Array<T>::Set(usize:index, T:value) {
	if (index >= this.len) {
		return(Status::Invalid);
	}
	this.data[index] = value;
	return(Status::Ok);
}

Span<T>:Array<T>::Span() {
	Span<T>:out;
	out.data = this.data;
	out.len = this.len;
	return(out);
}

Slice<T>:Array<T>::Slice() {
	Slice<T>:out;
	out.data = this.data;
	out.len = this.len;
	return(out);
}
