struct:String {
	ptr<byte>:data;
	usize:len;
};

struct:OwnedString {
	ptr<byte>:data;
	usize:len;
	usize:cap;
	Allocator:allocator;
};

struct:StringBuilder {
	ptr<byte>:data;
	usize:len;
	usize:cap;
	Allocator:allocator;
};

String:StringFromBytes(Slice<byte>:bytes) {
	String:out;
	out.data = bytes.data;
	out.len = bytes.len;
	return(out);
}

Slice<byte>:StringBytes(String:text) {
	Slice<byte>:out;
	out.data = text.data;
	out.len = text.len;
	return(out);
}

bool:StringEquals(String:left, String:right) {
	if (left.len != right.len) {
		return(false);
	}

	for (usize:i = 0; i < left.len; i++) {
		if (left.data[i] != right.data[i]) {
			return(false);
		}
	}

	return(true);
}

bool:StringStartsWith(String:text, String:prefix) {
	if (prefix.len > text.len) {
		return(false);
	}

	for (usize:i = 0; i < prefix.len; i++) {
		if (text.data[i] != prefix.data[i]) {
			return(false);
		}
	}

	return(true);
}

bool:StringEndsWith(String:text, String:suffix) {
	if (suffix.len > text.len) {
		return(false);
	}

	usize:offset = text.len - suffix.len;
	for (usize:i = 0; i < suffix.len; i++) {
		if (text.data[offset + i] != suffix.data[i]) {
			return(false);
		}
	}

	return(true);
}

String:OwnedStringView(ptr<OwnedString>:text) {
	String:out;
	out.data = text.data;
	out.len = text.len;
	return(out);
}

Status:OwnedStringDestroy(ptr<OwnedString>:text) {
	if (text.data != 0) {
		Free<byte>(text.allocator, text.data, text.cap);
	}
	text.data = 0;
	text.len = 0;
	text.cap = 0;
	return(Status::Ok);
}

StringBuilder:StringBuilderNew(Allocator:allocator) {
	StringBuilder:builder;
	builder.data = 0;
	builder.len = 0;
	builder.cap = 0;
	builder.allocator = allocator;
	return(builder);
}

Status:StringBuilderDestroy(ptr<StringBuilder>:builder) {
	if (builder.data != 0) {
		Free<byte>(builder.allocator, builder.data, builder.cap);
	}
	builder.data = 0;
	builder.len = 0;
	builder.cap = 0;
	return(Status::Ok);
}

Status:StringBuilderClear(ptr<StringBuilder>:builder) {
	builder.len = 0;
	return(Status::Ok);
}

Status:StringBuilderReserve(ptr<StringBuilder>:builder, usize:additional) {
	usize:needed = builder.len + additional;
	if (needed <= builder.cap) {
		return(Status::Ok);
	}

	usize:newCap = builder.cap;
	if (newCap == 0) {
		newCap = 16;
	}
	while (newCap < needed) {
		newCap = newCap * 2;
	}

	ptr<byte>:newData = std::Resize<byte>(builder.allocator, builder.data, builder.cap, newCap);
	if (newData == 0) {
		return(Status::NoMemory);
	}
	builder.data = newData;
	builder.cap = newCap;
	return(Status::Ok);
}

Result<usize>:StringBuilderWrite(ptr<StringBuilder>:builder, Slice<byte>:data) {
	Result<usize>:result;
	Status:status = StringBuilderReserve(builder, data.len);
	if (status != Status::Ok) {
		result.status = status;
		return(result);
	}

	for (usize:i = 0; i < data.len; i++) {
		builder.data[builder.len + i] = data.data[i];
	}

	builder.len += data.len;
	result.status = Status::Ok;
	result.value = data.len;
	return(result);
}

String:StringBuilderView(ptr<StringBuilder>:builder) {
	String:out;
	out.data = builder.data;
	out.len = builder.len;
	return(out);
}

Result<OwnedString>:StringBuilderToOwnedString(ptr<StringBuilder>:builder) {
	OwnedString:out;
	out.data = builder.data;
	out.len = builder.len;
	out.cap = builder.cap;
	out.allocator = builder.allocator;
	builder.data = 0;
	builder.len = 0;
	builder.cap = 0;
	Result<OwnedString>:result;
	result.status = Status::Ok;
	result.value = out;
	return(result);
}

Status:WriteStringToBuilder(ptr<StringBuilder>:builder, String:text) {
	Result<usize>:result = std::StringBuilderWrite(builder, std::StringBytes(text));
	return(result.status);
}
