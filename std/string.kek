struct:String {
	ptr<byte>:data;
	usize:len;
};

struct:OwnedString {
	ptr<byte>:data;
	usize:len;
	usize:cap;
	Allocator:allocator;
};

struct:StringBuilder {
	ptr<byte>:data;
	usize:len;
	usize:cap;
	Allocator:allocator;
};

String:StringFromBytes(Slice<byte>:bytes) {
	String:out;
	out.data = bytes.data;
	out.len = bytes.len;
	return(out);
}

String:StringFromCString(str:text) {
	String:out;
	usize:count = 0;
	while (text[count] != 0) {
		count += 1;
	}
	out.data = cast<ptr>(text);
	out.len = count;
	return(out);
}

Slice<byte>:String::Bytes() {
	Slice<byte>:out;
	out.data = this.data;
	out.len = this.len;
	return(out);
}

String:String::Slice(usize:start, usize:length) {
	String:out;
	if (start >= this.len) {
		out.data = this.data + this.len;
		out.len = 0;
		return(out);
	}
	usize:available = this.len - start;
	if (length > available) {
		length = available;
	}
	out.data = this.data + start;
	out.len = length;
	return(out);
}

bool:String::Equals(String:other) {
	if (this.len != other.len) {
		return(false);
	}

	for (usize:i = 0; i < this.len; i++) {
		if (this.data[i] != other.data[i]) {
			return(false);
		}
	}

	return(true);
}

bool:String::EqualsCString(str:text) {
	return(this.Equals(StringFromCString(text)));
}

bool:String::EqualsBytes(ptr<byte>:data, usize:len) {
	if (this.len != len) {
		return(false);
	}

	for (usize:i = 0; i < len; i++) {
		if (this.data[i] != data[i]) {
			return(false);
		}
	}

	return(true);
}

Result<usize>:String::FindByte(byte:value) {
	Result<usize>:result;
	for (usize:i = 0; i < this.len; i++) {
		if (this.data[i] == value) {
			result.status = Status::Ok;
			result.value = i;
			return(result);
		}
	}
	result.status = Status::NotFound;
	return(result);
}

bool:String::ContainsByte(byte:value) {
	Result<usize>:found = this.FindByte(value);
	return(found.status == Status::Ok);
}

bool:String::StartsWith(String:prefix) {
	if (prefix.len > this.len) {
		return(false);
	}

	for (usize:i = 0; i < prefix.len; i++) {
		if (this.data[i] != prefix.data[i]) {
			return(false);
		}
	}

	return(true);
}

bool:String::EndsWith(String:suffix) {
	if (suffix.len > this.len) {
		return(false);
	}

	usize:offset = this.len - suffix.len;
	for (usize:i = 0; i < suffix.len; i++) {
		if (this.data[offset + i] != suffix.data[i]) {
			return(false);
		}
	}

	return(true);
}

bool:IsAsciiSpace(byte:c) {
	return(c == 32 || c == 9 || c == 10 || c == 13);
}

bool:IsAsciiAlpha(byte:c) {
	return((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95);
}

bool:IsAsciiDigit(byte:c) {
	return(c >= 48 && c <= 57);
}

bool:IsAsciiWord(byte:c) {
	return(IsAsciiAlpha(c) || IsAsciiDigit(c));
}

bool:IsAsciiOperator(byte:c) {
	return(c == 33 || c == 37 || c == 38 || c == 42 || c == 43 || c == 45 || c == 47 || c == 60 || c == 61 || c == 62 || c == 94 || c == 124);
}

String:OwnedString::View() {
	String:out;
	out.data = this.data;
	out.len = this.len;
	return(out);
}

Status:OwnedString::Destroy() {
	if (this.data != 0) {
		Free<byte>(this.allocator, this.data, this.cap);
	}
	this.data = 0;
	this.len = 0;
	this.cap = 0;
	return(Status::Ok);
}

StringBuilder:StringBuilderNew(Allocator:allocator) {
	StringBuilder:builder;
	builder.data = 0;
	builder.len = 0;
	builder.cap = 0;
	builder.allocator = allocator;
	return(builder);
}

Status:StringBuilder::Destroy() {
	if (this.data != 0) {
		Free<byte>(this.allocator, this.data, this.cap);
	}
	this.data = 0;
	this.len = 0;
	this.cap = 0;
	return(Status::Ok);
}

Status:StringBuilder::Clear() {
	this.len = 0;
	return(Status::Ok);
}

Status:StringBuilder::Reserve(usize:additional) {
	usize:needed = this.len + additional;
	if (needed <= this.cap) {
		return(Status::Ok);
	}

	usize:newCap = this.cap;
	if (newCap == 0) {
		newCap = 16;
	}
	while (newCap < needed) {
		newCap = newCap * 2;
	}

	ptr<byte>:newData = std::Resize<byte>(this.allocator, this.data, this.cap, newCap);
	if (newData == 0) {
		return(Status::NoMemory);
	}
	this.data = newData;
	this.cap = newCap;
	return(Status::Ok);
}

Result<usize>:StringBuilder::Write(Slice<byte>:data) {
	Result<usize>:result;
	Status:status = this.Reserve(data.len);
	if (status != Status::Ok) {
		result.status = status;
		return(result);
	}

	for (usize:i = 0; i < data.len; i++) {
		this.data[this.len + i] = data.data[i];
	}

	this.len += data.len;
	result.status = Status::Ok;
	result.value = data.len;
	return(result);
}

Status:StringBuilder::WriteByte(byte:value) {
	byte:buffer[1] = { value };
	Result<usize>:result = this.Write(FixedSlice<byte>(buffer, 1));
	return(result.status);
}

Status:StringBuilder::WriteString(String:text) {
	Result<usize>:result = this.Write(text.Bytes());
	return(result.status);
}

Status:StringBuilder::WriteCString(str:text) {
	return(this.WriteString(StringFromCString(text)));
}

Status:StringBuilder::WriteRepeatByte(byte:value, usize:count) {
	for (usize:i = 0; i < count; i++) {
		Status:status = this.WriteByte(value);
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(Status::Ok);
}

Status:StringBuilder::WriteIndent(usize:count) {
	return(this.WriteRepeatByte(' ', count));
}

String:StringBuilder::View() {
	String:out;
	out.data = this.data;
	out.len = this.len;
	return(out);
}

Result<OwnedString>:StringBuilder::Detach() {
	OwnedString:out;
	out.data = this.data;
	out.len = this.len;
	out.cap = this.cap;
	out.allocator = this.allocator;
	this.data = 0;
	this.len = 0;
	this.cap = 0;
	Result<OwnedString>:result;
	result.status = Status::Ok;
	result.value = out;
	return(result);
}

Result<OwnedString>:StringBuilder::ToOwnedString() {
	return(this.Detach());
}

Status:WriteStringToBuilder(ptr<StringBuilder>:builder, String:text) {
	Result<usize>:result = builder.Write(text.Bytes());
	return(result.status);
}

Status:WriteSliceToBuilder(ptr<StringBuilder>:builder, Slice<byte>:data) {
	Result<usize>:result = builder.Write(data);
	return(result.status);
}

Status:DestroyStringBuilder(ptr<StringBuilder>:builder) {
	return(builder.Destroy());
}
