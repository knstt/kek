#import(kek/syntax.kek);

bool:IsOpenDelimiter(ptr<CompilerContext>:program, usize:fileIndex, usize:index) {
	return(IsPunctuation(program, fileIndex, index, PunctuationKind::LeftParen)
		|| IsPunctuation(program, fileIndex, index, PunctuationKind::LeftBrace)
		|| IsPunctuation(program, fileIndex, index, PunctuationKind::LeftBracket)
		|| IsOperator(program, fileIndex, index, OperatorKind::Less));
}

bool:DelimiterMatches(ptr<CompilerContext>:program, usize:fileIndex, usize:openIndex, usize:closeIndex) {
	if (IsPunctuation(program, fileIndex, openIndex, PunctuationKind::LeftParen)) {
		return(IsPunctuation(program, fileIndex, closeIndex, PunctuationKind::RightParen));
	}
	if (IsPunctuation(program, fileIndex, openIndex, PunctuationKind::LeftBrace)) {
		return(IsPunctuation(program, fileIndex, closeIndex, PunctuationKind::RightBrace));
	}
	if (IsPunctuation(program, fileIndex, openIndex, PunctuationKind::LeftBracket)) {
		return(IsPunctuation(program, fileIndex, closeIndex, PunctuationKind::RightBracket));
	}
	if (IsOperator(program, fileIndex, openIndex, OperatorKind::Less)) {
		return(IsOperator(program, fileIndex, closeIndex, OperatorKind::Greater));
	}
	return(false);
}

usize:FindMatching(ptr<CompilerContext>:program, usize:fileIndex, usize:openIndex) {
	usize:count = FileTokenCount(program, fileIndex);
	usize:depth = 0;
	bool:isParen = IsPunctuation(program, fileIndex, openIndex, PunctuationKind::LeftParen);
	bool:isBrace = IsPunctuation(program, fileIndex, openIndex, PunctuationKind::LeftBrace);
	bool:isBracket = IsPunctuation(program, fileIndex, openIndex, PunctuationKind::LeftBracket);
	bool:isGeneric = IsOperator(program, fileIndex, openIndex, OperatorKind::Less);
	for (usize:i = openIndex; i < count; i++) {
		if ((isParen && IsPunctuation(program, fileIndex, i, PunctuationKind::LeftParen))
			|| (isBrace && IsPunctuation(program, fileIndex, i, PunctuationKind::LeftBrace))
			|| (isBracket && IsPunctuation(program, fileIndex, i, PunctuationKind::LeftBracket))
			|| (isGeneric && IsOperator(program, fileIndex, i, OperatorKind::Less))) {
			depth += 1;
			continue;
		}
		if ((isParen && IsPunctuation(program, fileIndex, i, PunctuationKind::RightParen))
			|| (isBrace && IsPunctuation(program, fileIndex, i, PunctuationKind::RightBrace))
			|| (isBracket && IsPunctuation(program, fileIndex, i, PunctuationKind::RightBracket))
			|| (isGeneric && IsOperator(program, fileIndex, i, OperatorKind::Greater))) {
			if (depth == 0) {
				return(i);
			}
			depth -= 1;
			if (depth == 0) {
				return(i);
			}
		}
	}
	return(count);
}

usize:SkipDelimited(ptr<CompilerContext>:program, usize:fileIndex, usize:index) {
	usize:match = FindMatching(program, fileIndex, index);
	if (match >= FileTokenCount(program, fileIndex)) {
		return(index + 1);
	}
	return(match + 1);
}

usize:SkipAttributes(ptr<CompilerContext>:program, usize:fileIndex, usize:index) {
	while (index < FileTokenCount(program, fileIndex) && IsPunctuation(program, fileIndex, index, PunctuationKind::LeftBracket)) {
		index = SkipDelimited(program, fileIndex, index);
	}
	return(index);
}

usize:FindTopLevelColon(ptr<CompilerContext>:program, usize:fileIndex, usize:start, usize:end) {
	usize:parenDepth = 0;
	usize:braceDepth = 0;
	usize:bracketDepth = 0;
	usize:genericDepth = 0;
	for (usize:i = start; i < end; i++) {
		if (IsPunctuation(program, fileIndex, i, PunctuationKind::LeftParen)) {
			parenDepth += 1;
			continue;
		}
		if (IsPunctuation(program, fileIndex, i, PunctuationKind::RightParen)) {
			if (parenDepth > 0) {
				parenDepth -= 1;
			}
			continue;
		}
		if (IsPunctuation(program, fileIndex, i, PunctuationKind::LeftBrace)) {
			braceDepth += 1;
			continue;
		}
		if (IsPunctuation(program, fileIndex, i, PunctuationKind::RightBrace)) {
			if (braceDepth > 0) {
				braceDepth -= 1;
			}
			continue;
		}
		if (IsPunctuation(program, fileIndex, i, PunctuationKind::LeftBracket)) {
			bracketDepth += 1;
			continue;
		}
		if (IsPunctuation(program, fileIndex, i, PunctuationKind::RightBracket)) {
			if (bracketDepth > 0) {
				bracketDepth -= 1;
			}
			continue;
		}
		if (IsOperator(program, fileIndex, i, OperatorKind::Less)) {
			genericDepth += 1;
			continue;
		}
		if (IsOperator(program, fileIndex, i, OperatorKind::Greater)) {
			if (genericDepth > 0) {
				genericDepth -= 1;
			}
			continue;
		}
		if (parenDepth == 0 && braceDepth == 0 && bracketDepth == 0 && genericDepth == 0 && IsPunctuation(program, fileIndex, i, PunctuationKind::Colon)) {
			return(i);
		}
	}
	return(end);
}

usize:FindTokenAtDepthZero(ptr<CompilerContext>:program, usize:fileIndex, usize:start, usize:end, PunctuationKind:punctuation) {
	usize:parenDepth = 0;
	usize:braceDepth = 0;
	usize:bracketDepth = 0;
	usize:genericDepth = 0;
	for (usize:i = start; i < end; i++) {
		if (IsPunctuation(program, fileIndex, i, PunctuationKind::LeftParen)) {
			parenDepth += 1;
			continue;
		}
		if (IsPunctuation(program, fileIndex, i, PunctuationKind::RightParen)) {
			if (parenDepth > 0) {
				parenDepth -= 1;
			}
			continue;
		}
		if (IsPunctuation(program, fileIndex, i, PunctuationKind::LeftBrace)) {
			braceDepth += 1;
			continue;
		}
		if (IsPunctuation(program, fileIndex, i, PunctuationKind::RightBrace)) {
			if (braceDepth > 0) {
				braceDepth -= 1;
			}
			continue;
		}
		if (IsPunctuation(program, fileIndex, i, PunctuationKind::LeftBracket)) {
			bracketDepth += 1;
			continue;
		}
		if (IsPunctuation(program, fileIndex, i, PunctuationKind::RightBracket)) {
			if (bracketDepth > 0) {
				bracketDepth -= 1;
			}
			continue;
		}
		if (parenDepth == 0 && braceDepth == 0 && bracketDepth == 0 && genericDepth == 0 && IsPunctuation(program, fileIndex, i, punctuation)) {
			return(i);
		}
	}
	return(end);
}

usize:FindOperatorScope(ptr<CompilerContext>:program, usize:fileIndex, usize:start, usize:end) {
	usize:genericDepth = 0;
	for (usize:i = start; i < end; i++) {
		if (IsOperator(program, fileIndex, i, OperatorKind::Less)) {
			genericDepth += 1;
			continue;
		}
		if (IsOperator(program, fileIndex, i, OperatorKind::Greater)) {
			if (genericDepth > 0) {
				genericDepth -= 1;
			}
			continue;
		}
		if (genericDepth == 0 && IsOperator(program, fileIndex, i, OperatorKind::Scope)) {
			return(i);
		}
	}
	return(end);
}

usize:FindNextGroup(ptr<CompilerContext>:program, usize:fileIndex, usize:start, usize:end) {
	for (usize:i = start; i < end; i++) {
		if (IsPunctuation(program, fileIndex, i, PunctuationKind::LeftParen)) {
			return(i);
		}
	}
	return(end);
}

usize:FindNextBlock(ptr<CompilerContext>:program, usize:fileIndex, usize:start, usize:end) {
	for (usize:i = start; i < end; i++) {
		if (IsPunctuation(program, fileIndex, i, PunctuationKind::LeftBrace)) {
			return(i);
		}
	}
	return(end);
}

u8:OperatorCode(ptr<CompilerContext>:program, usize:fileIndex, usize:index) {
	Token:token = program.tokenFiles.data[fileIndex].tokens[index];
	if (token.kind == TokenKind::Operator) {
		return(cast<u8>(token.subkind + 1));
	}
	return(0);
}

Status:AddDecl(ptr<CompilerContext>:program, ptr<ModuleDecl>:decl) {
	Status:status = ReserveDecls(program, 1);
	if (status == Status::Ok) {
		program.decls.data[program.decls.len] = decl[0];
		program.decls.len += 1;
	}
	return(status);
}

Status:AddParam(ptr<CompilerContext>:program, ptr<ModuleParam>:param) {
	Status:status = ReserveParams(program, 1);
	if (status == Status::Ok) {
		program.params.data[program.params.len] = param[0];
		program.params.len += 1;
	}
	return(status);
}

Status:AddField(ptr<CompilerContext>:program, ptr<ModuleField>:field) {
	Status:status = ReserveFields(program, 1);
	if (status == Status::Ok) {
		program.fields.data[program.fields.len] = field[0];
		program.fields.len += 1;
	}
	return(status);
}

Status:ParseParams(ptr<CompilerContext>:program, ptr<ModuleDecl>:decl, usize:fileIndex, usize:start, usize:end) {
	decl.firstParam = program.params.len;
	decl.paramCount = 0;
	usize:itemStart = start;
	while (itemStart < end) {
		if (IsPunctuation(program, fileIndex, itemStart, PunctuationKind::Comma)) {
			itemStart += 1;
			continue;
		}
		usize:itemEnd = FindTokenAtDepthZero(program, fileIndex, itemStart, end, PunctuationKind::Comma);
		usize:colon = FindTopLevelColon(program, fileIndex, itemStart, itemEnd);
		if (colon >= itemEnd) {
			break;
		}
		ModuleParam:param;
		param.fileIndex = fileIndex;
		param.typeStart = itemStart;
		param.typeEnd = colon;
		param.nameIndex = colon + 1;
		param.defaultStart = itemEnd;
		param.defaultEnd = itemEnd;
		param.hasDefault = false;
		for (usize:i = param.nameIndex + 1; i < itemEnd; i++) {
			if (IsOperator(program, fileIndex, i, OperatorKind::Assign)) {
				param.defaultStart = i + 1;
				param.defaultEnd = itemEnd;
				param.hasDefault = true;
				break;
			}
		}
		Status:status = AddParam(program, &param);
		if (status != Status::Ok) {
			return(status);
		}
		decl.paramCount += 1;
		if (itemEnd >= end) {
			break;
		}
		itemStart = itemEnd + 1;
	}
	return(Status::Ok);
}

Status:ParseFields(ptr<CompilerContext>:program, ptr<ModuleDecl>:decl, usize:fileIndex, usize:start, usize:end) {
	decl.firstField = program.fields.len;
	decl.fieldCount = 0;
	usize:itemStart = start;
	while (itemStart < end) {
		itemStart = SkipAttributes(program, fileIndex, itemStart);
		if (itemStart >= end) {
			break;
		}
		if (IsPunctuation(program, fileIndex, itemStart, PunctuationKind::Semicolon)) {
			itemStart += 1;
			continue;
		}
		ModuleField:field;
		field.fileIndex = fileIndex;
		field.typeStart = itemStart;
		field.typeEnd = itemStart;
		field.nameIndex = itemStart;
		field.defaultStart = end;
		field.defaultEnd = end;
		field.arrayStart = end;
		field.arrayEnd = end;
		field.hasDefault = false;
		field.isArray = false;
		field.isNestedStruct = false;
		field.nestedBodyStart = end;
		field.nestedBodyEnd = end;

		if (IsKeyword(program, fileIndex, itemStart, KeywordKind::Struct)) {
			usize:colon = itemStart + 1;
			if (colon < end && IsPunctuation(program, fileIndex, colon, PunctuationKind::Colon)) {
				usize:nameIndex = colon + 1;
				usize:blockStart = FindNextBlock(program, fileIndex, nameIndex + 1, end);
				usize:blockEnd = FindMatching(program, fileIndex, blockStart);
				field.isNestedStruct = true;
				field.nameIndex = nameIndex;
				field.nestedBodyStart = blockStart + 1;
				field.nestedBodyEnd = blockEnd;
				Status:addNested = AddField(program, &field);
				if (addNested != Status::Ok) {
					return(addNested);
				}
				decl.fieldCount += 1;
				itemStart = blockEnd + 1;
				if (itemStart < end && IsPunctuation(program, fileIndex, itemStart, PunctuationKind::Semicolon)) {
					itemStart += 1;
				}
				continue;
			}
		}

		usize:itemEnd = itemStart;
		while (itemEnd < end && !IsPunctuation(program, fileIndex, itemEnd, PunctuationKind::Semicolon)) {
			if (IsPunctuation(program, fileIndex, itemEnd, PunctuationKind::LeftBrace)
				|| IsPunctuation(program, fileIndex, itemEnd, PunctuationKind::LeftParen)
				|| IsPunctuation(program, fileIndex, itemEnd, PunctuationKind::LeftBracket)) {
				itemEnd = SkipDelimited(program, fileIndex, itemEnd);
				continue;
			}
			itemEnd += 1;
		}
		usize:colon = FindTopLevelColon(program, fileIndex, itemStart, itemEnd);
		if (colon >= itemEnd) {
			itemStart = itemEnd + 1;
			continue;
		}
		field.typeStart = itemStart;
		field.typeEnd = colon;
		field.nameIndex = colon + 1;
		usize:afterName = field.nameIndex + 1;
		if (afterName < itemEnd && IsPunctuation(program, fileIndex, afterName, PunctuationKind::LeftBracket)) {
			field.isArray = true;
			field.arrayStart = afterName + 1;
			field.arrayEnd = FindMatching(program, fileIndex, afterName);
			afterName = field.arrayEnd + 1;
		}
		for (usize:i = afterName; i < itemEnd; i++) {
			if (IsOperator(program, fileIndex, i, OperatorKind::Assign)) {
				field.hasDefault = true;
				field.defaultStart = i + 1;
				field.defaultEnd = itemEnd;
				break;
			}
		}
		Status:status = AddField(program, &field);
		if (status != Status::Ok) {
			return(status);
		}
		decl.fieldCount += 1;
		itemStart = itemEnd + 1;
	}
	return(Status::Ok);
}

bool:ModuleDeclNameMatches(ptr<CompilerContext>:program, ptr<ModuleDecl>:decl, String:name) {
	if (decl.nameIndex >= FileTokenCount(program, decl.fileIndex)) {
		return(false);
	}
	String:declName = TokenText(program, decl.fileIndex, decl.nameIndex);
	return(declName.Equals(name));
}

ptr<ModuleDecl>:FindTypeDecl(ptr<CompilerContext>:program, String:name) {
	for (usize:i = 0; i < program.decls.len; i++) {
		ptr<ModuleDecl>:decl = &program.decls.data[i];
		if ((decl.kind == DeclKind::Struct || decl.kind == DeclKind::Union || decl.kind == DeclKind::Enum || decl.kind == DeclKind::Alias)
			&& ModuleDeclNameMatches(program, decl, name)) {
			return(decl);
		}
	}
	return(0);
}

Status:ParseAliasDecl(ptr<CompilerContext>:program, usize:fileIndex, usize:start, ptr<usize>:outEnd) {
	usize:count = FileTokenCount(program, fileIndex);
	usize:end = start;
	while (end < count && !IsPunctuation(program, fileIndex, end, PunctuationKind::Semicolon) && !IsEof(program, fileIndex, end)) {
		end += 1;
	}
	ModuleDecl:decl;
	decl.kind = DeclKind::Alias;
	decl.fileIndex = fileIndex;
	decl.start = start;
	decl.end = end + 1;
	decl.nameIndex = start + 2;
	decl.returnStart = end;
	decl.returnEnd = end;
	decl.receiverStart = end;
	decl.receiverEnd = end;
	decl.hasReceiver = false;
	decl.isOperator = false;
	decl.operatorCode = 0;
	decl.genericStart = end;
	decl.genericEnd = end;
	decl.isGeneric = false;
	decl.paramStart = end;
	decl.paramEnd = end;
	decl.bodyStart = end;
	decl.bodyEnd = end;
	decl.hasBody = false;
	decl.firstParam = 0;
	decl.paramCount = 0;
	decl.firstField = 0;
	decl.fieldCount = 0;
	decl.docStart = start;
	decl.docEnd = start;
	decl.hasDocComment = false;
	decl.emitted = false;
	decl.reachable = false;
	Status:clone = CloneContextString(program, std::OwnedStringView(&program.tokenFiles.data[fileIndex].packageName), &decl.packageName);
	if (clone != Status::Ok) {
		return(clone);
	}
	clone = CloneContextString(program, std::OwnedStringView(&program.tokenFiles.data[fileIndex].moduleName), &decl.moduleName);
	if (clone != Status::Ok) {
		return(clone);
	}
	for (usize:i = start + 3; i < end; i++) {
		if (IsOperator(program, fileIndex, i, OperatorKind::Assign)) {
			decl.returnStart = i + 1;
			decl.returnEnd = end;
			break;
		}
	}
	Status:status = AddDecl(program, &decl);
	outEnd[0] = end + 1;
	return(status);
}

Status:ParseTypeDecl(ptr<CompilerContext>:program, usize:fileIndex, usize:start, DeclKind:kind, ptr<usize>:outEnd) {
	usize:count = FileTokenCount(program, fileIndex);
	usize:colon = start + 1;
	usize:nameIndex = colon + 1;
	if (kind == DeclKind::Enum) {
		if (colon < count && IsPunctuation(program, fileIndex, colon, PunctuationKind::Colon)) {
			usize:secondColon = FindTopLevelColon(program, fileIndex, colon + 1, count);
			if (secondColon < count) {
				nameIndex = secondColon + 1;
			}
		}
	}
	usize:genericStart = count;
	usize:genericEnd = count;
	if (nameIndex + 1 < count && IsOperator(program, fileIndex, nameIndex + 1, OperatorKind::Less)) {
		genericStart = nameIndex + 1;
		genericEnd = FindMatching(program, fileIndex, genericStart);
	}
	usize:blockStart = FindNextBlock(program, fileIndex, nameIndex + 1, count);
	usize:blockEnd = FindMatching(program, fileIndex, blockStart);
	ModuleDecl:decl;
	decl.kind = kind;
	decl.fileIndex = fileIndex;
	decl.start = start;
	decl.end = blockEnd + 1;
	decl.nameIndex = nameIndex;
	decl.returnStart = start;
	decl.returnEnd = start;
	decl.receiverStart = start;
	decl.receiverEnd = start;
	decl.hasReceiver = false;
	decl.isOperator = false;
	decl.operatorCode = 0;
	decl.genericStart = genericStart;
	decl.genericEnd = genericEnd;
	decl.isGeneric = genericStart < count;
	decl.paramStart = start;
	decl.paramEnd = start;
	decl.bodyStart = blockStart + 1;
	decl.bodyEnd = blockEnd;
	decl.hasBody = true;
	decl.firstParam = 0;
	decl.paramCount = 0;
	decl.firstField = 0;
	decl.fieldCount = 0;
	decl.docStart = start;
	decl.docEnd = start;
	decl.hasDocComment = false;
	decl.emitted = false;
	decl.reachable = false;
	Status:clone = CloneContextString(program, std::OwnedStringView(&program.tokenFiles.data[fileIndex].packageName), &decl.packageName);
	if (clone != Status::Ok) {
		return(clone);
	}
	clone = CloneContextString(program, std::OwnedStringView(&program.tokenFiles.data[fileIndex].moduleName), &decl.moduleName);
	if (clone != Status::Ok) {
		return(clone);
	}
	if (kind == DeclKind::Struct || kind == DeclKind::Union) {
		Status:fields = ParseFields(program, &decl, fileIndex, blockStart + 1, blockEnd);
		if (fields != Status::Ok) {
			return(fields);
		}
	}
	Status:status = AddDecl(program, &decl);
	outEnd[0] = blockEnd + 1;
	if (outEnd[0] < count && IsPunctuation(program, fileIndex, outEnd[0], PunctuationKind::Semicolon)) {
		outEnd[0] += 1;
	}
	return(status);
}

Status:ParseExternDecl(ptr<CompilerContext>:program, usize:fileIndex, usize:start, ptr<usize>:outEnd) {
	usize:count = FileTokenCount(program, fileIndex);
	usize:blockStart = FindNextBlock(program, fileIndex, start, count);
	usize:blockEnd = FindMatching(program, fileIndex, blockStart);
	ModuleDecl:decl;
	decl.kind = DeclKind::ExternC;
	decl.fileIndex = fileIndex;
	decl.start = start;
	decl.end = blockEnd + 1;
	decl.nameIndex = start;
	decl.returnStart = start;
	decl.returnEnd = start;
	decl.receiverStart = start;
	decl.receiverEnd = start;
	decl.hasReceiver = false;
	decl.isOperator = false;
	decl.operatorCode = 0;
	decl.genericStart = start;
	decl.genericEnd = start;
	decl.isGeneric = false;
	decl.paramStart = start;
	decl.paramEnd = start;
	decl.bodyStart = blockStart + 1;
	decl.bodyEnd = blockEnd;
	decl.hasBody = true;
	decl.firstParam = 0;
	decl.paramCount = 0;
	decl.firstField = 0;
	decl.fieldCount = 0;
	decl.docStart = start;
	decl.docEnd = start;
	decl.hasDocComment = false;
	decl.emitted = false;
	decl.reachable = false;
	Status:clone = CloneContextString(program, std::OwnedStringView(&program.tokenFiles.data[fileIndex].packageName), &decl.packageName);
	if (clone != Status::Ok) {
		return(clone);
	}
	clone = CloneContextString(program, std::OwnedStringView(&program.tokenFiles.data[fileIndex].moduleName), &decl.moduleName);
	if (clone != Status::Ok) {
		return(clone);
	}
	Status:status = AddDecl(program, &decl);
	outEnd[0] = blockEnd + 1;
	return(status);
}

Status:ParseFunctionDecl(ptr<CompilerContext>:program, usize:fileIndex, usize:start, ptr<usize>:outEnd) {
	usize:count = FileTokenCount(program, fileIndex);
	usize:groupStart = FindNextGroup(program, fileIndex, start, count);
	if (groupStart >= count) {
		outEnd[0] = start + 1;
		return(Status::Ok);
	}
	usize:groupEnd = FindMatching(program, fileIndex, groupStart);
	usize:colon = FindTopLevelColon(program, fileIndex, start, groupStart);
	if (colon >= groupStart) {
		outEnd[0] = groupEnd + 1;
		return(Status::Ok);
	}
	usize:blockStart = groupEnd + 1;
	bool:hasBody = false;
	usize:blockEnd = groupEnd;
	if (blockStart < count && IsPunctuation(program, fileIndex, blockStart, PunctuationKind::LeftBrace)) {
		hasBody = true;
		blockEnd = FindMatching(program, fileIndex, blockStart);
	}
	ModuleDecl:decl;
	decl.kind = DeclKind::Function;
	decl.fileIndex = fileIndex;
	decl.start = start;
	decl.end = blockEnd + 1;
	decl.nameIndex = colon + 1;
	decl.returnStart = start;
	decl.returnEnd = colon;
	decl.receiverStart = colon + 1;
	decl.receiverEnd = colon + 1;
	decl.hasReceiver = false;
	decl.isOperator = false;
	decl.operatorCode = 0;
	decl.genericStart = count;
	decl.genericEnd = count;
	decl.isGeneric = false;
	decl.paramStart = groupStart + 1;
	decl.paramEnd = groupEnd;
	decl.bodyStart = blockStart + 1;
	decl.bodyEnd = blockEnd;
	decl.hasBody = hasBody;
	decl.firstParam = 0;
	decl.paramCount = 0;
	decl.firstField = 0;
	decl.fieldCount = 0;
	decl.docStart = start;
	decl.docEnd = start;
	decl.hasDocComment = false;
	decl.emitted = false;
	decl.reachable = false;
	Status:clone = CloneContextString(program, std::OwnedStringView(&program.tokenFiles.data[fileIndex].packageName), &decl.packageName);
	if (clone != Status::Ok) {
		return(clone);
	}
	clone = CloneContextString(program, std::OwnedStringView(&program.tokenFiles.data[fileIndex].moduleName), &decl.moduleName);
	if (clone != Status::Ok) {
		return(clone);
	}

	usize:scope = FindOperatorScope(program, fileIndex, colon + 1, groupStart);
	if (scope < groupStart) {
		decl.hasReceiver = true;
		decl.receiverStart = colon + 1;
		decl.receiverEnd = scope;
		decl.nameIndex = scope + 1;
	}
	if (decl.nameIndex < groupStart && IsIdentifierText(program, fileIndex, decl.nameIndex, "operator")) {
		decl.isOperator = true;
		decl.operatorCode = OperatorCode(program, fileIndex, decl.nameIndex + 1);
	}
	usize:genericProbe = decl.nameIndex + 1;
	if (decl.isOperator) {
		genericProbe = decl.nameIndex + 2;
	}
	if (genericProbe < groupStart && IsOperator(program, fileIndex, genericProbe, OperatorKind::Less)) {
		decl.genericStart = genericProbe;
		decl.genericEnd = FindMatching(program, fileIndex, genericProbe);
		decl.isGeneric = true;
	}
	for (usize:i = decl.receiverStart; i < decl.receiverEnd; i++) {
		if (IsOperator(program, fileIndex, i, OperatorKind::Less)) {
			decl.isGeneric = true;
		}
	}
	Status:params = ParseParams(program, &decl, fileIndex, groupStart + 1, groupEnd);
	if (params != Status::Ok) {
		return(params);
	}
	Status:status = AddDecl(program, &decl);
	outEnd[0] = blockEnd + 1;
	if (outEnd[0] < count && IsPunctuation(program, fileIndex, outEnd[0], PunctuationKind::Semicolon)) {
		outEnd[0] += 1;
	}
	return(status);
}

Status:ParseDeclarations(ptr<CompilerContext>:program) {
	for (usize:fileIndex = 0; fileIndex < program.tokenFiles.len; fileIndex++) {
		usize:index = 0;
		usize:count = FileTokenCount(program, fileIndex);
		usize:docStart = count;
		usize:docEnd = count;
		bool:hasDocComment = false;
		while (index < count && !IsEof(program, fileIndex, index)) {
			while (index < count && (IsTokenKind(program, fileIndex, index, TokenKind::Comment) || IsTokenKind(program, fileIndex, index, TokenKind::DocComment))) {
				if (IsTokenKind(program, fileIndex, index, TokenKind::DocComment)) {
					if (!hasDocComment) {
						docStart = index;
					}
					docEnd = index + 1;
					hasDocComment = true;
				}
				index += 1;
			}
			index = SkipAttributes(program, fileIndex, index);
			if (index >= count || IsEof(program, fileIndex, index)) {
				break;
			}
			usize:next = index + 1;
			usize:declCountBefore = program.decls.len;
			Status:status = Status::Ok;
			if (IsPunctuation(program, fileIndex, index, PunctuationKind::Hash)) {
				usize:groupStart = FindNextGroup(program, fileIndex, index, count);
				if (groupStart < count) {
					next = SkipDelimited(program, fileIndex, groupStart);
					if (next < count && IsPunctuation(program, fileIndex, next, PunctuationKind::Semicolon)) {
						next += 1;
					}
				}
			} else {
				if (IsKeyword(program, fileIndex, index, KeywordKind::Extern)) {
					status = ParseExternDecl(program, fileIndex, index, &next);
				} else {
					if (IsKeyword(program, fileIndex, index, KeywordKind::Alias) || IsIdentifierText(program, fileIndex, index, "alias")) {
						status = ParseAliasDecl(program, fileIndex, index, &next);
					} else {
						if (IsKeyword(program, fileIndex, index, KeywordKind::Struct) || IsIdentifierText(program, fileIndex, index, "struct")) {
							status = ParseTypeDecl(program, fileIndex, index, DeclKind::Struct, &next);
						} else {
							if (IsKeyword(program, fileIndex, index, KeywordKind::Union) || IsIdentifierText(program, fileIndex, index, "union")) {
								status = ParseTypeDecl(program, fileIndex, index, DeclKind::Union, &next);
							} else {
								if (IsKeyword(program, fileIndex, index, KeywordKind::Enum) || IsIdentifierText(program, fileIndex, index, "enum")) {
									status = ParseTypeDecl(program, fileIndex, index, DeclKind::Enum, &next);
								} else {
									status = ParseFunctionDecl(program, fileIndex, index, &next);
								}
							}
						}
					}
				}
			}
			if (status != Status::Ok) {
				return(status);
			}
			if (hasDocComment && program.decls.len > declCountBefore) {
				ptr<ModuleDecl>:decl = &program.decls.data[program.decls.len - 1];
				decl.docStart = docStart;
				decl.docEnd = docEnd;
				decl.hasDocComment = true;
			}
			hasDocComment = false;
			docStart = count;
			docEnd = count;
			if (next <= index) {
				next = index + 1;
			}
			index = next;
		}
	}
	return(Status::Ok);
}

Status:BuildModule(ptr<CompilerContext>:program) {
	return(ParseDeclarations(program));
}

Status:ModuleDestroy(ptr<CompilerContext>:program) {
	return(Status::Ok);
}
