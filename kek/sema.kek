#import(kek/diagnostics.kek);
#import(kek/compiler.kek);

Status:SelfWriteSemanticDiagnostics(str:inputPath, Allocator:allocator, ptr<StringBuilder>:out) {
	StringBuilder:generated = std::StringBuilderNew(allocator);
	SelfDiagnosticBag:diagnostics;
	diagnostics::SelfDiagnosticBagInit(&diagnostics, allocator);
	Status:status = compiler::SelfCompileToCString(inputPath, allocator, &generated, &diagnostics);
	Status:writeStatus = Status::Ok;
	if (diagnostics.count > 0) {
		writeStatus = diagnostics::SelfWriteDiagnosticDump(&diagnostics, out);
	} else {
		if (status != Status::Ok) {
			writeStatus = out.WriteCString("diag|2|4|-1|0|0|0|0|compile failed\n");
		}
	}
	generated.Destroy();
	diagnostics::SelfDiagnosticBagDestroy(&diagnostics);
	if (writeStatus != Status::Ok) {
		return(writeStatus);
	}
	return(Status::Ok);
}
