#import(std/core.kek);
#import(std/mem.kek);
#import(std/string.kek);
#import(std/array.kek);
#import(kek/diagnostics.kek);
#import(kek/tokenizer.kek);

enum:u8:AstKind {
	File,
	Statement,
	Block,
	Group,
	Index,
	Generic,
	Token,
};

struct:AstNode {
	AstKind:kind;
	SourceLocation:location;
	Token:token;
	usize:firstChild;
	usize:lastChild;
	usize:nextSibling;
	usize:childCount;
};

struct:AstTree {
	Array<AstNode>:nodes;
	usize:root;
};

struct:Parser {
	ptr<Token>:tokens;
	usize:count;
	usize:position;
	String:source;
	i64:fileIndex;
	ptr<DiagnosticBag>:diagnostics;
	AstTree:tree;
	usize:errorCount;
};

SourceLocation:TokenLocation(Token:token) {
	return(diagnostics::SourceLocationNew(token.line, token.column, token.offset, token.length));
}

Status:AstTreeReserve(ptr<AstTree>:tree, usize:additional) {
	Array<AstNode>:nodes = tree.nodes;
	Status:status = nodes.Reserve(additional);
	tree.nodes = nodes;
	return(status);
}

Status:AstTreeInit(ptr<AstTree>:tree, Allocator:allocator) {
	tree.nodes = std::ArrayNew<AstNode>(allocator);
	tree.root = 0;
	Status:status = AstTreeReserve(tree, 1);
	if (status != Status::Ok) {
		return(status);
	}
	AstNode:sentinel;
	tree.nodes.data[0] = sentinel;
	tree.nodes.len = 1;
	return(Status::Ok);
}

Status:AstTreeDestroy(ptr<AstTree>:tree) {
	Array<AstNode>:nodes = tree.nodes;
	Status:status = nodes.Destroy();
	tree.nodes = nodes;
	tree.root = 0;
	return(status);
}

bool:IsPunctuationToken(ptr<Token>:token, PunctuationKind:punctuation) {
	return(token.payload.tag == TokenPayloadTag_Punctuation && token.payload.data.Punctuation == punctuation);
}

bool:IsOperatorToken(ptr<Token>:token, OperatorKind:operatorKind) {
	return(token.payload.tag == TokenPayloadTag_Operator && token.payload.data.Operator == operatorKind);
}

bool:IsTriviaToken(ptr<Token>:token) {
	return(token.kind == TokenKind::Comment || token.kind == TokenKind::DocComment);
}

bool:IsClosingPunctuation(ptr<Token>:token) {
	return(IsPunctuationToken(token, PunctuationKind::RightParen)
		|| IsPunctuationToken(token, PunctuationKind::RightBrace)
		|| IsPunctuationToken(token, PunctuationKind::RightBracket));
}

bool:IsAstTerminator(ptr<Token>:token, u64:closePunctuation) {
	if (token.kind == TokenKind::Eof) {
		return(true);
	}
	if (closePunctuation < 11 && token.kind == TokenKind::Punctuation && token.subkind == closePunctuation) {
		return(true);
	}
	if (IsClosingPunctuation(token)) {
		return(true);
	}
	return(false);
}

bool:IsGenericTerminator(ptr<Token>:token) {
	return(token.kind == TokenKind::Eof || IsOperatorToken(token, OperatorKind::Greater));
}

bool:TokenTextEquals(ptr<Parser>:parser, ptr<Token>:token, str:text) {
	usize:length = 0;
	while (text[length] != 0) {
		length += 1;
	}
	if (!(token.kind == TokenKind::Identifier || token.kind == TokenKind::Number || token.kind == TokenKind::String)) {
		return(false);
	}
	if (token.length != length) {
		return(false);
	}
	if (token.offset + length > parser.source.len) {
		return(false);
	}
	for (usize:i = 0; i < length; i++) {
		if (parser.source.data[token.offset + i] != text[i]) {
			return(false);
		}
	}
	return(true);
}

usize:CreateAstNode(ptr<Parser>:parser, AstKind:kind, SourceLocation:location) {
	Status:status = AstTreeReserve(&parser.tree, 1);
	if (status != Status::Ok) {
		diagnostics::DiagnosticAddCString(parser.diagnostics, DiagnosticSeverity::Error, DiagnosticPhase::Parse, parser.fileIndex, location, "AST node storage capacity exceeded");
		parser.errorCount += 1;
		if (parser.tree.nodes.len > 0) {
			return(parser.tree.nodes.len - 1);
		}
		return(0);
	}
	usize:index = parser.tree.nodes.len;
	AstNode:node;
	node.kind = kind;
	node.location = location;
	parser.tree.nodes.data[index] = node;
	parser.tree.nodes.len += 1;
	return(index);
}

void:AddAstChild(ptr<AstTree>:tree, usize:parentIndex, usize:childIndex) {
	if (parentIndex == 0 || childIndex == 0) {
		return;
	}
	tree.nodes.data[childIndex].nextSibling = 0;
	if (tree.nodes.data[parentIndex].lastChild != 0) {
		usize:last = tree.nodes.data[parentIndex].lastChild;
		tree.nodes.data[last].nextSibling = childIndex;
	} else {
		tree.nodes.data[parentIndex].firstChild = childIndex;
	}
	tree.nodes.data[parentIndex].lastChild = childIndex;
	tree.nodes.data[parentIndex].childCount += 1;
}

void:FinishLocationFromChildren(ptr<AstTree>:tree, usize:nodeIndex) {
	if (nodeIndex == 0 || tree.nodes.data[nodeIndex].childCount == 0) {
		return;
	}
	usize:firstIndex = tree.nodes.data[nodeIndex].firstChild;
	usize:lastIndex = tree.nodes.data[nodeIndex].lastChild;
	SourceLocation:first = tree.nodes.data[firstIndex].location;
	SourceLocation:last = tree.nodes.data[lastIndex].location;
	tree.nodes.data[nodeIndex].location = first;
	if (last.offset + last.length >= first.offset) {
		tree.nodes.data[nodeIndex].location.length = (last.offset + last.length) - first.offset;
	}
}

usize:ParseTokenNode(ptr<Parser>:parser) {
	Token:token = parser.tokens[parser.position];
	parser.position += 1;
	usize:nodeIndex = CreateAstNode(parser, AstKind::Token, TokenLocation(token));
	parser.tree.nodes.data[nodeIndex].token = token;
	return(nodeIndex);
}

void:ReportParseError(ptr<Parser>:parser, ptr<Token>:token, str:message) {
	diagnostics::DiagnosticAddCString(parser.diagnostics, DiagnosticSeverity::Error, DiagnosticPhase::Parse, parser.fileIndex, TokenLocation(token[0]), message);
	parser.errorCount += 1;
}

str:PunctuationName(u64:punctuation) {
	if (punctuation == cast<u64>(PunctuationKind::RightParen)) {
		return(")");
	}
	if (punctuation == cast<u64>(PunctuationKind::RightBrace)) {
		return("}");
	}
	if (punctuation == cast<u64>(PunctuationKind::RightBracket)) {
		return("]");
	}
	return("<end of file>");
}

void:ReportExpected(ptr<Parser>:parser, ptr<Token>:token, u64:punctuation) {
	StringBuilder:builder = std::StringBuilderNew(parser.tree.nodes.allocator);
	builder.WriteCString("expected '");
	builder.WriteCString(PunctuationName(punctuation));
	builder.WriteByte('\'');
	String:message = builder.View();
	diagnostics::DiagnosticAdd(parser.diagnostics, DiagnosticSeverity::Error, DiagnosticPhase::Parse, parser.fileIndex, TokenLocation(token[0]), message);
	builder.Destroy();
	parser.errorCount += 1;
}

bool:ShouldParseGenericList(ptr<Parser>:parser, usize:previousChildIndex) {
	if (previousChildIndex == 0 || parser.tree.nodes.data[previousChildIndex].kind != AstKind::Token) {
		return(false);
	}
	ptr<Token>:previousToken = &parser.tree.nodes.data[previousChildIndex].token;
	if (previousToken.kind != TokenKind::Identifier && previousToken.kind != TokenKind::Keyword) {
		return(false);
	}
	if (TokenTextEquals(parser, previousToken, "cast")) {
		return(false);
	}
	if (parser.position >= parser.count || !IsOperatorToken(&parser.tokens[parser.position], OperatorKind::Less)) {
		return(false);
	}

	int:depth = 0;
	for (usize:i = parser.position; i < parser.count; i++) {
		ptr<Token>:token = &parser.tokens[i];
		if (IsOperatorToken(token, OperatorKind::Less)) {
			depth += 1;
			continue;
		}
		if (IsOperatorToken(token, OperatorKind::Greater)) {
			depth -= 1;
			if (depth == 0) {
				return(true);
			}
			continue;
		}
		if (depth == 1 && token.kind == TokenKind::Punctuation && token.subkind == cast<u64>(PunctuationKind::Dot)) {
			return(false);
		}
		if (token.kind == TokenKind::Eof
			|| IsPunctuationToken(token, PunctuationKind::Semicolon)
			|| IsPunctuationToken(token, PunctuationKind::RightParen)
			|| IsPunctuationToken(token, PunctuationKind::LeftBrace)
			|| IsPunctuationToken(token, PunctuationKind::RightBrace)) {
			return(false);
		}
	}
	return(false);
}

void:ParseChildrenInto(ptr<Parser>:parser, usize:parentIndex, u64:closePunctuation) {
	while (parser.position < parser.count && !IsAstTerminator(&parser.tokens[parser.position], closePunctuation)) {
		if (IsTriviaToken(&parser.tokens[parser.position])) {
			parser.position += 1;
			continue;
		}
		usize:previousPosition = parser.position;
		usize:statement = ParseStatement(parser, closePunctuation);
		if (parser.tree.nodes.data[statement].childCount > 0) {
			AddAstChild(&parser.tree, parentIndex, statement);
		} else {
			if (parser.position == previousPosition) {
				break;
			}
		}
	}
}

usize:ParseDelimited(ptr<Parser>:parser, AstKind:kind, u64:closePunctuation) {
	Token:open = parser.tokens[parser.position];
	parser.position += 1;
	usize:node = CreateAstNode(parser, kind, TokenLocation(open));

	ParseChildrenInto(parser, node, closePunctuation);

	if (parser.position < parser.count && parser.tokens[parser.position].kind == TokenKind::Punctuation && parser.tokens[parser.position].subkind == closePunctuation) {
		Token:close = parser.tokens[parser.position];
		parser.position += 1;
		parser.tree.nodes.data[node].location = TokenLocation(open);
		parser.tree.nodes.data[node].location.length = (close.offset + close.length) - open.offset;
	} else {
		if (parser.position < parser.count) {
			ReportExpected(parser, &parser.tokens[parser.position], closePunctuation);
			if (IsClosingPunctuation(&parser.tokens[parser.position])) {
				parser.position += 1;
			}
		} else {
			ReportParseError(parser, &open, "unterminated delimiter");
		}
	}

	if (parser.tree.nodes.data[node].childCount > 0 && parser.tree.nodes.data[node].location.length == open.length) {
		FinishLocationFromChildren(&parser.tree, node);
		parser.tree.nodes.data[node].location.offset = open.offset;
		parser.tree.nodes.data[node].location.line = open.line;
		parser.tree.nodes.data[node].location.column = open.column;
	}
	return(node);
}

usize:ParseGenericDelimited(ptr<Parser>:parser) {
	Token:open = parser.tokens[parser.position];
	parser.position += 1;
	usize:node = CreateAstNode(parser, AstKind::Generic, TokenLocation(open));

	while (parser.position < parser.count && !IsGenericTerminator(&parser.tokens[parser.position])) {
		if (IsTriviaToken(&parser.tokens[parser.position])) {
			parser.position += 1;
			continue;
		}
		usize:statement = CreateAstNode(parser, AstKind::Statement, TokenLocation(parser.tokens[parser.position]));
		while (parser.position < parser.count && !IsGenericTerminator(&parser.tokens[parser.position])) {
			ptr<Token>:token = &parser.tokens[parser.position];
			if (IsTriviaToken(token)) {
				parser.position += 1;
				continue;
			}
			if (IsPunctuationToken(token, PunctuationKind::Comma)) {
				parser.position += 1;
				break;
			}
			if (IsPunctuationToken(token, PunctuationKind::LeftParen)) {
				AddAstChild(&parser.tree, statement, ParseDelimited(parser, AstKind::Group, cast<u64>(PunctuationKind::RightParen)));
				continue;
			}
			if (IsPunctuationToken(token, PunctuationKind::LeftBracket)) {
				AddAstChild(&parser.tree, statement, ParseDelimited(parser, AstKind::Index, cast<u64>(PunctuationKind::RightBracket)));
				continue;
			}
			if (ShouldParseGenericList(parser, parser.tree.nodes.data[statement].lastChild)) {
				AddAstChild(&parser.tree, statement, ParseGenericDelimited(parser));
				continue;
			}
			AddAstChild(&parser.tree, statement, ParseTokenNode(parser));
		}
		FinishLocationFromChildren(&parser.tree, statement);
		if (parser.tree.nodes.data[statement].childCount > 0) {
			AddAstChild(&parser.tree, node, statement);
		}
	}

	if (parser.position < parser.count && IsOperatorToken(&parser.tokens[parser.position], OperatorKind::Greater)) {
		Token:close = parser.tokens[parser.position];
		parser.position += 1;
		parser.tree.nodes.data[node].location = TokenLocation(open);
		parser.tree.nodes.data[node].location.length = (close.offset + close.length) - open.offset;
	} else {
		if (parser.position < parser.count) {
			ReportParseError(parser, &parser.tokens[parser.position], "expected '>'");
		} else {
			ReportParseError(parser, &open, "unterminated generic list");
		}
	}

	if (parser.tree.nodes.data[node].childCount > 0 && parser.tree.nodes.data[node].location.length == open.length) {
		FinishLocationFromChildren(&parser.tree, node);
		parser.tree.nodes.data[node].location.offset = open.offset;
		parser.tree.nodes.data[node].location.line = open.line;
		parser.tree.nodes.data[node].location.column = open.column;
	}
	return(node);
}

usize:ParseStatement(ptr<Parser>:parser, u64:closePunctuation) {
	usize:statement = CreateAstNode(parser, AstKind::Statement, TokenLocation(parser.tokens[parser.position]));

	while (parser.position < parser.count && !IsAstTerminator(&parser.tokens[parser.position], closePunctuation)) {
		ptr<Token>:token = &parser.tokens[parser.position];
		if (IsTriviaToken(token)) {
			parser.position += 1;
			continue;
		}
		if (IsPunctuationToken(token, PunctuationKind::Semicolon) || IsPunctuationToken(token, PunctuationKind::Comma)) {
			parser.position += 1;
			break;
		}
		if (IsClosingPunctuation(token)) {
			break;
		}
		if (IsPunctuationToken(token, PunctuationKind::LeftBrace)) {
			AddAstChild(&parser.tree, statement, ParseDelimited(parser, AstKind::Block, cast<u64>(PunctuationKind::RightBrace)));
			break;
		}
		if (IsPunctuationToken(token, PunctuationKind::LeftParen)) {
			AddAstChild(&parser.tree, statement, ParseDelimited(parser, AstKind::Group, cast<u64>(PunctuationKind::RightParen)));
			continue;
		}
		if (IsPunctuationToken(token, PunctuationKind::LeftBracket)) {
			AddAstChild(&parser.tree, statement, ParseDelimited(parser, AstKind::Index, cast<u64>(PunctuationKind::RightBracket)));
			continue;
		}
		if (ShouldParseGenericList(parser, parser.tree.nodes.data[statement].lastChild)) {
			AddAstChild(&parser.tree, statement, ParseGenericDelimited(parser));
			continue;
		}
		AddAstChild(&parser.tree, statement, ParseTokenNode(parser));
	}

	FinishLocationFromChildren(&parser.tree, statement);
	return(statement);
}

usize:ParseList(ptr<Parser>:parser, AstKind:listKind, u64:closePunctuation) {
	usize:list = CreateAstNode(parser, listKind, TokenLocation(parser.tokens[parser.position]));
	ParseChildrenInto(parser, list, closePunctuation);
	if (closePunctuation == 11 && parser.position < parser.count && IsClosingPunctuation(&parser.tokens[parser.position])) {
		ReportParseError(parser, &parser.tokens[parser.position], "unexpected closing delimiter");
		parser.position += 1;
	}
	FinishLocationFromChildren(&parser.tree, list);
	return(list);
}

Status:ParseTokens(ptr<Token>:tokens, usize:count, String:source, i64:fileIndex, Allocator:allocator, ptr<DiagnosticBag>:diagnostics, ptr<AstTree>:out) {
	Parser:parser;
	parser.tokens = tokens;
	parser.count = count;
	parser.position = 0;
	parser.source = source;
	parser.fileIndex = fileIndex;
	parser.diagnostics = diagnostics;
	parser.errorCount = 0;
	Status:status = AstTreeInit(&parser.tree, allocator);
	if (status != Status::Ok) {
		return(status);
	}
	usize:root = ParseList(&parser, AstKind::File, 11);
	parser.tree.root = root;
	parser.tree.nodes.data[root].location = diagnostics::SourceLocationNew(1, 1, 0, source.len);
	out.nodes = parser.tree.nodes;
	out.root = parser.tree.root;
	return(Status::Ok);
}

Status:WriteAstNodeDump(ptr<AstTree>:tree, usize:nodeIndex, usize:depth, ptr<StringBuilder>:out) {
	ptr<AstNode>:node = &tree.nodes.data[nodeIndex];
	Status:status = out.WriteCString("node|");
	if (status != Status::Ok) {
		return(status);
	}
	status = diagnostics::WriteU64Field(out, cast<u64>(depth), true);
	if (status != Status::Ok) {
		return(status);
	}
	status = diagnostics::WriteU64Field(out, cast<u64>(node.kind), true);
	if (status != Status::Ok) {
		return(status);
	}
	status = diagnostics::WriteU64Field(out, cast<u64>(node.location.line), true);
	if (status != Status::Ok) {
		return(status);
	}
	status = diagnostics::WriteU64Field(out, cast<u64>(node.location.column), true);
	if (status != Status::Ok) {
		return(status);
	}
	status = diagnostics::WriteU64Field(out, cast<u64>(node.location.offset), true);
	if (status != Status::Ok) {
		return(status);
	}
	status = diagnostics::WriteU64Field(out, cast<u64>(node.location.length), true);
	if (status != Status::Ok) {
		return(status);
	}
	status = diagnostics::WriteU64Field(out, cast<u64>(node.childCount), true);
	if (status != Status::Ok) {
		return(status);
	}
	u64:tokenKind = 0;
	u64:tokenSubkind = 0;
	u64:tokenOffset = 0;
	u64:tokenLength = 0;
	if (node.kind == AstKind::Token) {
		tokenKind = cast<u64>(node.token.kind);
		tokenSubkind = node.token.subkind;
		tokenOffset = cast<u64>(node.token.offset);
		tokenLength = cast<u64>(node.token.length);
	}
	status = diagnostics::WriteU64Field(out, tokenKind, true);
	if (status != Status::Ok) {
		return(status);
	}
	status = diagnostics::WriteU64Field(out, tokenSubkind, true);
	if (status != Status::Ok) {
		return(status);
	}
	status = diagnostics::WriteU64Field(out, tokenOffset, true);
	if (status != Status::Ok) {
		return(status);
	}
	status = diagnostics::WriteU64Field(out, tokenLength, false);
	if (status != Status::Ok) {
		return(status);
	}
	status = out.WriteByte('\n');
	if (status != Status::Ok) {
		return(status);
	}

	usize:child = node.firstChild;
	while (child != 0) {
		status = WriteAstNodeDump(tree, child, depth + 1, out);
		if (status != Status::Ok) {
			return(status);
		}
		child = tree.nodes.data[child].nextSibling;
	}
	return(Status::Ok);
}

Status:WriteAstBridgeDump(String:source, ptr<StringBuilder>:out) {
	Allocator:allocator = out.allocator;
	Array<Token>:tokens;
	Status:status = tokenizer::TokenizeToArray(source, false, allocator, &tokens);
	if (status != Status::Ok) {
		return(status);
	}
	DiagnosticBag:diagnostics;
	diagnostics::DiagnosticBagInit(&diagnostics, allocator);
	AstTree:tree;
	status = ParseTokens(tokens.data, tokens.len, source, 0, allocator, &diagnostics, &tree);
	if (status == Status::Ok) {
		status = WriteAstNodeDump(&tree, tree.root, 0, out);
	}
	if (status == Status::Ok) {
		status = diagnostics::WriteDiagnosticDump(&diagnostics, out);
	}
	AstTreeDestroy(&tree);
	diagnostics::DiagnosticBagDestroy(&diagnostics);
	tokens.Destroy();
	return(status);
}
