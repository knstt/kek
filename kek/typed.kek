#import(kek/sema.kek);

Status:WriteTypedModuleSummary(str:inputPath, Allocator:allocator, ptr<StringBuilder>:out) {
	CompilerContext:program;
	Status:status = ProgramInit(&program, allocator);
	if (status != Status::Ok) {
		return(status);
	}
	status = LoadSyntaxPackage(inputPath, &program);
	if (status == Status::Ok) {
		status = BuildModule(&program);
	}
	if (status == Status::Ok) {
		status = CheckModule(&program);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("Typed module summary: generated by honest self compiler\n");
	}
	ProgramDestroy(&program);
	return(status);
}
