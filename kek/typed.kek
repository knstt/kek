#import(kek/compiler.kek);

Status:SelfWriteTypedModuleSummary(str:inputPath, Allocator:allocator, ptr<StringBuilder>:out) {
	StringBuilder:generated = std::StringBuilderNew(allocator);
	Status:status = compiler::SelfCompileToCStringWithoutDiagnostics(inputPath, allocator, &generated);
	if (status == Status::Ok) {
		status = out.WriteCString("Typed module summary: generated by honest self compiler\n");
	}
	generated.Destroy();
	return(status);
}
