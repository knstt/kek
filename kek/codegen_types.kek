#import(kek/codegen_emit.kek);

Status:WriteDeclarator(ptr<CompilerContext>:program, ptr<StringBuilder>:out, usize:fileIndex, usize:typeStart, usize:typeEnd, usize:nameIndex, bool:isArray, usize:arrayStart, usize:arrayEnd) {
	TypeInfo:info;
	Status:status = RenderTypeInfo(program, fileIndex, typeStart, typeEnd, &info);
	if (status != Status::Ok) {
		return(status);
	}
	CodeWriter:w = CodeWriterNew(out);
	w.String(std::OwnedStringView(&info.cType));
	w.Byte(' ');
	w.Token(program, fileIndex, nameIndex);
	if (isArray) {
		w.Byte('[');
		w.TokenRangeRaw(program, fileIndex, arrayStart, arrayEnd);
		w.Byte(']');
	}
	TypeInfoDestroy(&info);
	return(w.status);
}

Status:WriteFields(ptr<CompilerContext>:program, ptr<StringBuilder>:out, ptr<ModuleDecl>:decl) {
	for (usize:i = 0; i < decl.fieldCount; i++) {
		ptr<ModuleField>:field = &program.fields.data[decl.firstField + i];
		CodeWriter:w = CodeWriterNew(out);
		w.CString("    ");
		if (w.status != Status::Ok) {
			return(w.status);
		}
		if (field.isNestedStruct) {
			w.CString("struct {\n");
			if (w.status != Status::Ok) {
				return(w.status);
			}
			ModuleDecl:nested;
			InitNestedStructDecl(&nested, field, field.nestedFirstField, decl);
			Status:status = WriteFields(program, out, &nested);
			if (status != Status::Ok) {
				return(status);
			}
			w.CString("    } ");
			w.Token(program, field.fileIndex, field.nameIndex);
			w.CString(";\n");
			if (w.status != Status::Ok) {
				return(w.status);
			}
			continue;
		}
		Status:status = WriteDeclarator(program, out, field.fileIndex, field.typeStart, field.typeEnd, field.nameIndex, field.isArray, field.arrayStart, field.arrayEnd);
		if (status == Status::Ok) {
			w.CString(";\n");
			status = w.status;
		}
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(Status::Ok);
}

bool:GenericParamEquals(ptr<CompilerContext>:program, ptr<ModuleDecl>:decl, usize:paramIndex, String:name) {
	if (!decl.isGeneric) {
		return(false);
	}
	if (decl.genericStart < FileTokenCount(program, decl.fileIndex)) {
		usize:index = decl.genericStart + 1;
		usize:current = 0;
		while (index < decl.genericEnd) {
			if (IsPunctuation(program, decl.fileIndex, index, PunctuationKind::Comma)) {
				index += 1;
				continue;
			}
			if (current == paramIndex) {
				String:paramName = TokenText(program, decl.fileIndex, index);
				return(paramName.Equals(name));
			}
			current += 1;
			while (index < decl.genericEnd && !IsPunctuation(program, decl.fileIndex, index, PunctuationKind::Comma)) {
				index += 1;
			}
		}
	}
	if (decl.hasReceiver && decl.receiverStart + 1 < decl.receiverEnd
		&& IsOperator(program, decl.fileIndex, decl.receiverStart + 1, OperatorKind::Less)) {
		usize:genericEnd = FindMatching(program, decl.fileIndex, decl.receiverStart + 1);
		usize:index = decl.receiverStart + 2;
		usize:current = 0;
		while (index < genericEnd) {
			if (IsPunctuation(program, decl.fileIndex, index, PunctuationKind::Comma)) {
				index += 1;
				continue;
			}
			if (current == paramIndex) {
				String:paramName = TokenText(program, decl.fileIndex, index);
				return(paramName.Equals(name));
			}
			current += 1;
			while (index < genericEnd && !IsPunctuation(program, decl.fileIndex, index, PunctuationKind::Comma)) {
				index += 1;
			}
		}
	}
	return(false);
}

Status:WriteTypeSuffixSubst(ptr<CompilerContext>:program, ptr<StringBuilder>:out, ptr<ModuleDecl>:decl, ptr<Array<OwnedString>>:args, usize:fileIndex, usize:start, usize:end) {
	if (start >= end) {
		return(Status::Ok);
	}
	String:first = TokenText(program, fileIndex, start);
	if (end == start + 1) {
		for (usize:i = 0; i < args.len; i++) {
			if (GenericParamEquals(program, decl, i, first)) {
				return(out.WriteString(std::OwnedStringView(&args.data[i])));
			}
		}
		return(WriteSanitized(out, first));
	}
	if (start + 1 < end && IsOperator(program, fileIndex, start + 1, OperatorKind::Less)) {
		Status:status = WriteSanitized(out, first);
		usize:genericEnd = FindMatching(program, fileIndex, start + 1);
		usize:argStart = start + 2;
		while (argStart < genericEnd) {
			usize:argEnd = FindTokenAtDepthZero(program, fileIndex, argStart, genericEnd, PunctuationKind::Comma);
			if (status == Status::Ok) {
				status = out.WriteCString("__");
			}
			if (status == Status::Ok) {
				status = WriteTypeSuffixSubst(program, out, decl, args, fileIndex, argStart, argEnd);
			}
			if (status != Status::Ok || argEnd >= genericEnd) {
				break;
			}
			argStart = argEnd + 1;
		}
		return(status);
	}
	return(WriteTypeSuffixFromRange(program, out, fileIndex, start, end));
}

Status:MakeSubstTypeKey(ptr<CompilerContext>:program, ptr<ModuleDecl>:decl, ptr<Array<OwnedString>>:args, usize:fileIndex, usize:start, usize:end, ptr<OwnedString>:out) {
	StringBuilder:builder = std::StringBuilderNew(program.allocator);
	Status:status = WriteTypeSuffixSubst(program, &builder, decl, args, fileIndex, start, end);
	if (status == Status::Ok) {
		status = DetachBuilder(&builder, out);
	}
	builder.Destroy();
	return(status);
}

Status:MakeSubstTypeInfo(ptr<CompilerContext>:program, ptr<ModuleDecl>:decl, ptr<Array<OwnedString>>:args, usize:fileIndex, usize:start, usize:end, ptr<TypeInfo>:info) {
	Status:status = TypeInfoInitEmpty(program, info);
	if (status != Status::Ok) {
		return(status);
	}
	String:first = TokenText(program, fileIndex, start);
	OwnedString:key;
	if (first.EqualsCString("ptr") && start + 1 < end && IsOperator(program, fileIndex, start + 1, OperatorKind::Less)) {
		usize:genericEnd = FindMatching(program, fileIndex, start + 1);
		OwnedString:innerKey;
		innerKey.data = 0;
		status = MakeSubstTypeKey(program, decl, args, fileIndex, start + 2, genericEnd, &innerKey);
		StringBuilder:builder = std::StringBuilderNew(program.allocator);
		if (status == Status::Ok) {
			status = builder.WriteString(std::OwnedStringView(&innerKey));
		}
		if (status == Status::Ok) {
			status = builder.WriteByte('*');
		}
		if (status == Status::Ok) {
			status = DetachBuilder(&builder, &key);
		}
		builder.Destroy();
		if (innerKey.data != 0) {
			std::DestroyOwnedString(&innerKey);
		}
	} else {
		status = MakeSubstTypeKey(program, decl, args, fileIndex, start, end, &key);
	}
	if (status == Status::Ok) {
		status = ReplaceOwned(&info.key, key);
	}
	OwnedString:cOwned;
	if (status == Status::Ok) {
		status = MakeCTypeFromKey(program, std::OwnedStringView(&info.key), &cOwned);
	}
	if (status == Status::Ok) {
		status = ReplaceOwned(&info.cType, cOwned);
	}
	if (status == Status::Ok) {
		String:keyView = std::OwnedStringView(&info.key);
		Result<usize>:ptrMarker = keyView.FindByte('*');
		info.isPointer = ptrMarker.status == Status::Ok;
	}
	return(status);
}

Status:MakeSubstTypeInfoForFunc(ptr<CompilerContext>:program, ptr<ModuleDecl>:decl, ptr<FuncUse>:funcUse, usize:fileIndex, usize:start, usize:end, ptr<OwnedString>:outKey, ptr<OwnedString>:outCType, ptr<bool>:outIsPointer) {
	TypeInfo:info;
	Status:status = MakeSubstTypeInfo(program, decl, &funcUse.args, fileIndex, start, end, &info);
	if (status == Status::Ok) {
		outKey[0] = info.key;
		outCType[0] = info.cType;
		outIsPointer[0] = info.isPointer;
		info.key.data = 0;
		info.cType.data = 0;
		TypeInfoDestroy(&info);
	}
	return(status);
}

Status:WriteDeclaratorSubst(ptr<CompilerContext>:program, ptr<StringBuilder>:out, ptr<ModuleDecl>:decl, ptr<Array<OwnedString>>:args, usize:fileIndex, usize:typeStart, usize:typeEnd, usize:nameIndex, bool:isArray, usize:arrayStart, usize:arrayEnd) {
	String:first = TokenText(program, fileIndex, typeStart);
	OwnedString:key;
	Status:status = Status::Ok;
	if (first.EqualsCString("ptr") && typeStart + 1 < typeEnd && IsOperator(program, fileIndex, typeStart + 1, OperatorKind::Less)) {
		usize:genericEnd = FindMatching(program, fileIndex, typeStart + 1);
		OwnedString:innerKey;
		status = MakeSubstTypeKey(program, decl, args, fileIndex, typeStart + 2, genericEnd, &innerKey);
		StringBuilder:ct = std::StringBuilderNew(program.allocator);
		if (status == Status::Ok) {
			status = WriteCTypeFromKey(program, &ct, std::OwnedStringView(&innerKey));
		}
		if (status == Status::Ok) {
			status = ct.WriteByte('*');
		}
		if (status == Status::Ok) {
			status = out.WriteString(ct.View());
		}
		ct.Destroy();
		std::DestroyOwnedString(&innerKey);
	} else {
		status = MakeSubstTypeKey(program, decl, args, fileIndex, typeStart, typeEnd, &key);
		if (status == Status::Ok) {
			status = WriteCTypeFromKey(program, out, std::OwnedStringView(&key));
		}
		if (status == Status::Ok) {
			std::DestroyOwnedString(&key);
		}
	}
	if (status == Status::Ok) {
		status = out.WriteByte(' ');
	}
	if (status == Status::Ok) {
		status = WriteToken(program, out, fileIndex, nameIndex);
	}
	if (status == Status::Ok && isArray) {
		status = out.WriteByte('[');
		if (status == Status::Ok) {
			status = WriteTokenRangeRaw(program, out, fileIndex, arrayStart, arrayEnd);
		}
		if (status == Status::Ok) {
			status = out.WriteByte(']');
		}
	}
	return(status);
}

Status:WriteFieldsSubst(ptr<CompilerContext>:program, ptr<StringBuilder>:out, ptr<ModuleDecl>:decl, ptr<TypeUse>:use) {
	for (usize:i = 0; i < decl.fieldCount; i++) {
		ptr<ModuleField>:field = &program.fields.data[decl.firstField + i];
		CodeWriter:w = CodeWriterNew(out);
		w.CString("    ");
		Status:status = w.status;
		if (field.isNestedStruct) {
			w.CString("struct {\n");
			status = w.status;
			ModuleDecl:nested;
			InitNestedStructDecl(&nested, field, field.nestedFirstField, decl);
			if (status == Status::Ok) {
				status = WriteFieldsSubst(program, out, &nested, use);
			}
			w.status = status;
			w.CString("    } ");
			w.Token(program, field.fileIndex, field.nameIndex);
			status = w.status;
		} else {
			if (status == Status::Ok) {
				status = WriteDeclaratorSubst(program, out, decl, &use.args, field.fileIndex, field.typeStart, field.typeEnd, field.nameIndex, field.isArray, field.arrayStart, field.arrayEnd);
			}
		}
		w.status = status;
		w.CString(";\n");
		status = w.status;
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(Status::Ok);
}

Status:WriteStructDecl(ptr<CompilerContext>:program, ptr<StringBuilder>:out, ptr<ModuleDecl>:decl, String:specializedName) {
	Status:status = out.WriteCString("struct ");
	bool:hasPacked = false;
	bool:hasAligned = false;
	usize:alignedValue = 0;
	if (decl.start > 0) {
		usize:scan = decl.start;
		while (scan > 0) {
			scan -= 1;
			if (IsPunctuation(program, decl.fileIndex, scan, PunctuationKind::LeftBracket)) {
				for (usize:i = scan; i < decl.start; i++) {
					if (IsIdentifierText(program, decl.fileIndex, i, "packed")) {
						hasPacked = true;
					}
					if (IsIdentifierText(program, decl.fileIndex, i, "aligned")) {
						hasAligned = true;
						if (i + 2 < decl.start && IsPunctuation(program, decl.fileIndex, i + 1, PunctuationKind::LeftParen)) {
							alignedValue = i + 2;
						}
					}
				}
				break;
			}
			if (IsPunctuation(program, decl.fileIndex, scan, PunctuationKind::Semicolon)
				|| IsPunctuation(program, decl.fileIndex, scan, PunctuationKind::RightBrace)) {
				break;
			}
		}
	}
	if (status == Status::Ok && (hasPacked || hasAligned)) {
		status = out.WriteCString("__attribute__((");
		if (status == Status::Ok && hasPacked) {
			status = out.WriteCString("packed");
		}
		if (status == Status::Ok && hasAligned) {
			if (hasPacked) {
				status = out.WriteByte(',');
			}
			if (status == Status::Ok) {
				status = out.WriteCString("aligned(");
			}
			if (status == Status::Ok && alignedValue != 0) {
				status = WriteToken(program, out, decl.fileIndex, alignedValue);
			}
			if (status == Status::Ok) {
				status = out.WriteByte(')');
			}
		}
		if (status == Status::Ok) {
			status = out.WriteCString(")) ");
		}
	}
	if (status != Status::Ok) {
		return(status);
	}
	if (specializedName.len > 0) {
		status = out.WriteString(specializedName);
	} else {
		status = WriteToken(program, out, decl.fileIndex, decl.nameIndex);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(" {\n");
	}
	if (status == Status::Ok) {
		status = WriteFields(program, out, decl);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("};\n");
	}
	return(status);
}

Status:WriteUnionDecl(ptr<CompilerContext>:program, ptr<StringBuilder>:out, ptr<ModuleDecl>:decl) {
	CodeWriter:w = CodeWriterNew(out);
	w.CString("typedef union ");
	w.Token(program, decl.fileIndex, decl.nameIndex);
	w.CString(" {\n");
	Status:status = w.status;
	if (status == Status::Ok) {
		status = WriteFields(program, out, decl);
	}
	w.status = status;
	w.CString("} ");
	w.Token(program, decl.fileIndex, decl.nameIndex);
	w.CString(";\n");
	return(w.status);
}

Status:WriteTaggedUnionTagName(ptr<CompilerContext>:program, ptr<StringBuilder>:out, ptr<ModuleDecl>:decl) {
	CodeWriter:w = CodeWriterNew(out);
	w.Token(program, decl.fileIndex, decl.nameIndex);
	w.CString("Tag");
	return(w.status);
}

Status:WriteTaggedUnionVariantName(ptr<CompilerContext>:program, ptr<StringBuilder>:out, ptr<ModuleDecl>:decl, ptr<ModuleField>:field) {
	Status:status = WriteTaggedUnionTagName(program, out, decl);
	CodeWriter:w = CodeWriterNew(out);
	w.status = status;
	w.Byte('_');
	w.Token(program, field.fileIndex, field.nameIndex);
	return(w.status);
}

Status:WriteTaggedUnionConstructorName(ptr<CompilerContext>:program, ptr<StringBuilder>:out, ptr<ModuleDecl>:decl, ptr<ModuleField>:field) {
	CodeWriter:w = CodeWriterNew(out);
	w.Token(program, decl.fileIndex, decl.nameIndex);
	w.Byte('_');
	w.Token(program, field.fileIndex, field.nameIndex);
	return(w.status);
}

Status:WriteTaggedUnionDecl(ptr<CompilerContext>:program, ptr<StringBuilder>:out, ptr<ModuleDecl>:decl) {
	Status:status = out.WriteCString("typedef enum ");
	if (status == Status::Ok) {
		status = WriteTaggedUnionTagName(program, out, decl);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(" {\n");
	}
	for (usize:i = 0; i < decl.fieldCount; i++) {
		ptr<ModuleField>:field = &program.fields.data[decl.firstField + i];
		if (status == Status::Ok) {
			status = out.WriteCString("    ");
		}
		if (status == Status::Ok) {
			status = WriteTaggedUnionVariantName(program, out, decl, field);
		}
		if (status == Status::Ok) {
			status = out.WriteCString(",\n");
		}
	}
	if (status == Status::Ok) {
		status = out.WriteCString("} ");
	}
	if (status == Status::Ok) {
		status = WriteTaggedUnionTagName(program, out, decl);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(";\n");
	}
	if (status == Status::Ok) {
		status = out.WriteCString("typedef struct ");
	}
	if (status == Status::Ok) {
		status = WriteToken(program, out, decl.fileIndex, decl.nameIndex);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(" {\n    ");
	}
	if (status == Status::Ok) {
		status = WriteTaggedUnionTagName(program, out, decl);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(" tag;\n    union {\n");
	}
	if (status == Status::Ok) {
		status = WriteFields(program, out, decl);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("    } data;\n} ");
	}
	if (status == Status::Ok) {
		status = WriteToken(program, out, decl.fileIndex, decl.nameIndex);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(";\n");
	}
	for (usize:i = 0; i < decl.fieldCount; i++) {
		ptr<ModuleField>:field = &program.fields.data[decl.firstField + i];
		TypeInfo:fieldType;
		if (status == Status::Ok) {
			status = RenderTypeInfo(program, field.fileIndex, field.typeStart, field.typeEnd, &fieldType);
		}
		if (status == Status::Ok) {
			status = out.WriteCString("static inline ");
		}
		if (status == Status::Ok) {
			status = WriteToken(program, out, decl.fileIndex, decl.nameIndex);
		}
		if (status == Status::Ok) {
			status = out.WriteByte(' ');
		}
		if (status == Status::Ok) {
			status = WriteTaggedUnionConstructorName(program, out, decl, field);
		}
		if (status == Status::Ok) {
			status = out.WriteByte('(');
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&fieldType.cType));
		}
		if (status == Status::Ok) {
			status = out.WriteCString(" value) {\n    ");
		}
		if (status == Status::Ok) {
			status = WriteToken(program, out, decl.fileIndex, decl.nameIndex);
		}
		if (status == Status::Ok) {
			status = out.WriteCString(" out;\n    out.tag = ");
		}
		if (status == Status::Ok) {
			status = WriteTaggedUnionVariantName(program, out, decl, field);
		}
		if (status == Status::Ok) {
			status = out.WriteCString(";\n    out.data.");
		}
		if (status == Status::Ok) {
			status = WriteToken(program, out, field.fileIndex, field.nameIndex);
		}
		if (status == Status::Ok) {
			status = out.WriteCString(" = value;\n    return out;\n}\n");
		}
		TypeInfoDestroy(&fieldType);
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(status);
}

Status:WriteEnumDecl(ptr<CompilerContext>:program, ptr<StringBuilder>:out, ptr<ModuleDecl>:decl) {
	Status:status = out.WriteCString("typedef enum ");
	if (status == Status::Ok) {
		status = WriteToken(program, out, decl.fileIndex, decl.nameIndex);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(" {\n");
	}
	usize:i = decl.bodyStart;
	while (i < decl.bodyEnd) {
		if (IsPunctuation(program, decl.fileIndex, i, PunctuationKind::Comma)) {
			i += 1;
			continue;
		}
		if (!IsTokenKind(program, decl.fileIndex, i, TokenKind::Identifier)) {
			i += 1;
			continue;
		}
		status = out.WriteCString("    ");
		if (status == Status::Ok) {
			status = WriteToken(program, out, decl.fileIndex, decl.nameIndex);
		}
		if (status == Status::Ok) {
			status = out.WriteByte('_');
		}
		if (status == Status::Ok) {
			status = WriteToken(program, out, decl.fileIndex, i);
		}
		i += 1;
		if (i < decl.bodyEnd && IsOperator(program, decl.fileIndex, i, OperatorKind::Assign)) {
			status = out.WriteByte('=');
			i += 1;
			while (i < decl.bodyEnd && !IsPunctuation(program, decl.fileIndex, i, PunctuationKind::Comma)) {
				if (status == Status::Ok) {
					status = WriteToken(program, out, decl.fileIndex, i);
				}
				i += 1;
			}
		}
		if (status == Status::Ok) {
			status = out.WriteCString(",\n");
		}
		if (status != Status::Ok) {
			return(status);
		}
	}
	status = out.WriteCString("} ");
	if (status == Status::Ok) {
		status = WriteToken(program, out, decl.fileIndex, decl.nameIndex);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(";\n");
	}
	return(status);
}

bool:SoaFieldUnsupported(ptr<CompilerContext>:program, ptr<ModuleField>:field) {
	if (field.isNestedStruct || field.isArray) {
		return(true);
	}
	if (TokenEquals(program, field.fileIndex, field.nameIndex, "len")) {
		return(true);
	}
	if (TokenEquals(program, field.fileIndex, field.nameIndex, "cap")) {
		return(true);
	}
	if (TokenEquals(program, field.fileIndex, field.nameIndex, "allocator")) {
		return(true);
	}
	return(false);
}

Status:WriteAliasDecl(ptr<CompilerContext>:program, ptr<StringBuilder>:out, ptr<ModuleDecl>:decl) {
	TypeInfo:info;
	Status:status = RenderTypeInfo(program, decl.fileIndex, decl.returnStart, decl.returnEnd, &info);
	if (status == Status::Ok) {
		status = out.WriteCString("typedef ");
	}
	if (status == Status::Ok) {
		status = out.WriteString(std::OwnedStringView(&info.cType));
	}
	if (status == Status::Ok) {
		status = out.WriteByte(' ');
	}
	if (status == Status::Ok) {
		status = WriteToken(program, out, decl.fileIndex, decl.nameIndex);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(";\n");
	}
	TypeInfoDestroy(&info);
	return(status);
}

Status:WriteExternDecl(ptr<CompilerContext>:program, ptr<StringBuilder>:out, ptr<ModuleDecl>:decl) {
	ptr<SyntaxFile>:file = &program.tokenFiles.data[decl.fileIndex];
	Token:open = file.tokens[decl.bodyStart - 1];
	Token:close = file.tokens[decl.bodyEnd];
	usize:start = open.offset + open.length;
	usize:end = close.offset;
	if (end < start) {
		return(Status::Ok);
	}
	String:sourceText = file.sourceText;
	Status:status = out.WriteCString("#if defined(__GNUC__) || defined(__clang__)\n#pragma GCC diagnostic push\n#pragma GCC diagnostic ignored ");
	if (status == Status::Ok) {
		status = out.WriteByte(34);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("-Wunused-function");
	}
	if (status == Status::Ok) {
		status = out.WriteByte(34);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("\n#endif\n");
	}
	if (status == Status::Ok) {
		status = out.WriteString(sourceText.Slice(start, end - start));
	}
	if (status == Status::Ok) {
		status = out.WriteCString("\n#if defined(__GNUC__) || defined(__clang__)\n#pragma GCC diagnostic pop\n#endif");
	}
	if (status == Status::Ok) {
		status = out.WriteByte('\n');
	}
	return(status);
}

Status:WriteTypeUseDeclaration(ptr<CompilerContext>:program, ptr<StringBuilder>:out, ptr<TypeUse>:use) {
	if (use.emitted) {
		return(Status::Ok);
	}
	String:baseName = std::OwnedStringView(&use.baseName);
	if (baseName.EqualsCString("Soa") && use.args.len >= 1) {
		ptr<ModuleDecl>:itemDecl = FindTypeDecl(program, std::OwnedStringView(&use.args.data[0]));
		if (itemDecl == 0 || itemDecl.kind != DeclKind::Struct || itemDecl.isGeneric) {
			return(Status::Unsupported);
		}
		Status:status = out.WriteCString("struct ");
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&use.key));
		}
		if (status == Status::Ok) {
			status = out.WriteCString(" {\n");
		}
		for (usize:i = 0; i < itemDecl.fieldCount && status == Status::Ok; i++) {
			ptr<ModuleField>:field = &program.fields.data[itemDecl.firstField + i];
			if (SoaFieldUnsupported(program, field)) {
				return(Status::Unsupported);
			}
			TypeInfo:fieldInfo;
			status = RenderTypeInfo(program, field.fileIndex, field.typeStart, field.typeEnd, &fieldInfo);
			if (status == Status::Ok) {
				status = out.WriteCString("    ");
			}
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&fieldInfo.cType));
			}
			if (status == Status::Ok) {
				status = out.WriteCString("* ");
			}
			if (status == Status::Ok) {
				status = WriteToken(program, out, field.fileIndex, field.nameIndex);
			}
			if (status == Status::Ok) {
				status = out.WriteCString(";\n");
			}
			TypeInfoDestroy(&fieldInfo);
		}
		if (status == Status::Ok) {
			status = out.WriteCString("    usize len;\n    usize cap;\n    struct Allocator allocator;\n};\n");
		}
		if (status == Status::Ok) {
			use.emitted = true;
		}
		return(status);
	}
	ptr<ModuleDecl>:decl = FindTypeDecl(program, std::OwnedStringView(&use.baseName));
	if (decl == 0 || decl.kind != DeclKind::Struct) {
		return(Status::Ok);
	}
	Status:status = out.WriteCString("struct ");
	if (status == Status::Ok) {
		status = out.WriteString(std::OwnedStringView(&use.key));
	}
	if (status == Status::Ok) {
		status = out.WriteCString(" {\n");
	}
	if (status == Status::Ok) {
		status = WriteFieldsSubst(program, out, decl, use);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("};\n");
	}
	if (status == Status::Ok) {
		use.emitted = true;
	}
	return(status);
}

Status:WriteTypeUsesForArg(ptr<CompilerContext>:program, ptr<StringBuilder>:out, String:argName) {
	for (usize:i = 0; i < program.typeUses.len; i++) {
		ptr<TypeUse>:use = &program.typeUses.data[i];
		if (use.emitted || use.args.len == 0) {
			continue;
		}
		String:firstArg = OwnedStringArrayGet(&use.args, 0);
		if (firstArg.Equals(argName)) {
			Status:status = WriteTypeUseDeclaration(program, out, use);
			if (status != Status::Ok) {
				return(status);
			}
		}
	}
	return(Status::Ok);
}

bool:ShouldWritePlainTypeDecl(ptr<ModuleDecl>:decl) {
	return(decl.kind == DeclKind::Alias
		|| (decl.kind == DeclKind::Struct && !decl.isGeneric)
		|| decl.kind == DeclKind::Union
		|| decl.kind == DeclKind::Enum);
}

Status:WritePlainTypeDeclaration(ptr<CompilerContext>:program, ptr<StringBuilder>:out, ptr<ModuleDecl>:decl) {
	Status:status = Status::Ok;
	if (decl.kind == DeclKind::Alias) {
		status = WriteAliasDecl(program, out, decl);
	}
	if (decl.kind == DeclKind::Struct && !decl.isGeneric) {
		status = WriteStructDecl(program, out, decl, std::StringFromCString(""));
	}
	if (decl.kind == DeclKind::Union && !decl.isTagged) {
		status = WriteUnionDecl(program, out, decl);
	}
	if (decl.kind == DeclKind::Union && decl.isTagged) {
		status = WriteTaggedUnionDecl(program, out, decl);
	}
	if (decl.kind == DeclKind::Enum) {
		status = WriteEnumDecl(program, out, decl);
	}
	if (status == Status::Ok) {
		decl.emitted = true;
	}
	return(status);
}

Status:WriteTypeKeyDependencies(ptr<CompilerContext>:program, ptr<StringBuilder>:out, String:key);
Status:WriteTypeDeclarationWithDependencies(ptr<CompilerContext>:program, ptr<StringBuilder>:out, ptr<ModuleDecl>:decl);
Status:WriteFieldTypeDependencies(ptr<CompilerContext>:program, ptr<StringBuilder>:out, ptr<ModuleField>:field) {
	if (field.isNestedStruct) {
		return(WriteTypeRangeDependencies(program, out, field.fileIndex, field.nestedBodyStart, field.nestedBodyEnd));
	}
	return(WriteTypeRangeDependencies(program, out, field.fileIndex, field.typeStart, field.typeEnd));
}

Status:WriteTypeRangeDependencies(ptr<CompilerContext>:program, ptr<StringBuilder>:out, usize:fileIndex, usize:start, usize:end) {
	for (usize:i = start; i < end; i++) {
		Token:token = program.tokenFiles.data[fileIndex].tokens[i];
		if (!(token.kind == TokenKind::Identifier || token.kind == TokenKind::Keyword)) {
			continue;
		}
		String:name = TokenText(program, fileIndex, i);
		if (name.EqualsCString("ptr") && i + 1 < end && IsOperator(program, fileIndex, i + 1, OperatorKind::Less)) {
			usize:genericEnd = FindMatching(program, fileIndex, i + 1);
			if (i + 3 == genericEnd) {
				ptr<ModuleDecl>:inner = FindTypeDecl(program, TokenText(program, fileIndex, i + 2));
				if (inner != 0 && inner.kind != DeclKind::Struct && ShouldWritePlainTypeDecl(inner) && !inner.emitted) {
					Status:status = WriteTypeDeclarationWithDependencies(program, out, inner);
					if (status != Status::Ok) {
						return(status);
					}
				}
			}
			i = genericEnd;
			continue;
		}
		if (i + 1 < end && IsOperator(program, fileIndex, i + 1, OperatorKind::Less)) {
			usize:genericEnd = FindMatching(program, fileIndex, i + 1);
			OwnedString:key;
			Status:status = BuildTypeKey(program, fileIndex, i, genericEnd + 1, &key);
			if (status == Status::Ok) {
				status = WriteTypeKeyDependencies(program, out, std::OwnedStringView(&key));
			}
			std::DestroyOwnedString(&key);
			if (status != Status::Ok) {
				return(status);
			}
			i = genericEnd;
			continue;
		}
		ptr<ModuleDecl>:decl = FindTypeDecl(program, name);
		if (decl != 0 && ShouldWritePlainTypeDecl(decl) && !decl.emitted) {
			Status:status = WriteTypeDeclarationWithDependencies(program, out, decl);
			if (status != Status::Ok) {
				return(status);
			}
		}
	}
	return(Status::Ok);
}

Status:WriteTypeUseWithDependencies(ptr<CompilerContext>:program, ptr<StringBuilder>:out, ptr<TypeUse>:use) {
	if (use.emitted) {
		return(Status::Ok);
	}
	for (usize:i = 0; i < use.args.len; i++) {
		Status:status = WriteTypeKeyDependencies(program, out, std::OwnedStringView(&use.args.data[i]));
		if (status != Status::Ok) {
			return(status);
		}
	}
	ptr<ModuleDecl>:decl = FindTypeDecl(program, std::OwnedStringView(&use.baseName));
	if (decl == 0) {
		String:baseName = std::OwnedStringView(&use.baseName);
		if (baseName.EqualsCString("Soa") && use.args.len >= 1) {
			ptr<ModuleDecl>:itemDecl = FindTypeDecl(program, std::OwnedStringView(&use.args.data[0]));
			if (itemDecl != 0 && itemDecl.kind == DeclKind::Struct) {
				for (usize:i = 0; i < itemDecl.fieldCount; i++) {
					Status:status = WriteFieldTypeDependencies(program, out, &program.fields.data[itemDecl.firstField + i]);
					if (status != Status::Ok) {
						return(status);
					}
				}
			}
		}
	}
	if (decl != 0 && decl.kind == DeclKind::Struct) {
		for (usize:i = 0; i < decl.fieldCount; i++) {
			Status:status = WriteFieldTypeDependencies(program, out, &program.fields.data[decl.firstField + i]);
			if (status != Status::Ok) {
				return(status);
			}
		}
	}
	return(WriteTypeUseDeclaration(program, out, use));
}

Status:WriteTypeKeyDependencies(ptr<CompilerContext>:program, ptr<StringBuilder>:out, String:key) {
	String:name = key;
	while (name.len > 0 && name.data[name.len - 1] == '*') {
		name = name.Slice(0, name.len - 1);
	}
	ptr<ModuleDecl>:decl = FindTypeDecl(program, name);
	if (decl != 0 && ShouldWritePlainTypeDecl(decl) && !decl.emitted) {
		return(WriteTypeDeclarationWithDependencies(program, out, decl));
	}
	for (usize:i = 0; i < program.typeUses.len; i++) {
		String:useKey = std::OwnedStringView(&program.typeUses.data[i].key);
		if (useKey.Equals(name)) {
			return(WriteTypeUseWithDependencies(program, out, &program.typeUses.data[i]));
		}
	}
	return(Status::Ok);
}

Status:WriteTypeDeclarationWithDependencies(ptr<CompilerContext>:program, ptr<StringBuilder>:out, ptr<ModuleDecl>:decl) {
	if (decl.emitted) {
		return(Status::Ok);
	}
	Status:status = Status::Ok;
	if (decl.kind == DeclKind::Alias) {
		status = WriteTypeRangeDependencies(program, out, decl.fileIndex, decl.returnStart, decl.returnEnd);
	}
	if (decl.kind == DeclKind::Struct || decl.kind == DeclKind::Union) {
		for (usize:i = 0; i < decl.fieldCount; i++) {
			status = WriteFieldTypeDependencies(program, out, &program.fields.data[decl.firstField + i]);
			if (status != Status::Ok) {
				return(status);
			}
		}
	}
	if (status == Status::Ok) {
		status = WritePlainTypeDeclaration(program, out, decl);
	}
	return(status);
}

Status:WriteTypeDeclarations(ptr<CompilerContext>:program, ptr<StringBuilder>:out) {
	for (usize:i = 0; i < program.decls.len; i++) {
		ptr<ModuleDecl>:decl = &program.decls.data[i];
		if (decl.kind == DeclKind::ExternC) {
			Status:status = WriteExternDecl(program, out, decl);
			if (status != Status::Ok) {
				return(status);
			}
			decl.emitted = true;
		}
	}
	for (usize:i = 0; i < program.decls.len; i++) {
		ptr<ModuleDecl>:decl = &program.decls.data[i];
		if (decl.reachable && !decl.emitted && ShouldWritePlainTypeDecl(decl)) {
			Status:status = WriteTypeDeclarationWithDependencies(program, out, decl);
			if (status != Status::Ok) {
				return(status);
			}
		}
	}
	for (usize:i = 0; i < program.typeUses.len; i++) {
		ptr<TypeUse>:use = &program.typeUses.data[i];
		Status:status = WriteTypeUseWithDependencies(program, out, use);
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(Status::Ok);
}
