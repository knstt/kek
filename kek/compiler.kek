enum:u8:CDeclKind {
	Unknown,
	Alias,
	Struct,
	Union,
	Enum,
	Function,
	ExternC,
};

enum:u8:CTypeKind {
	Unknown,
	Void,
	Bool,
	Integer,
	Float,
	Pointer,
	Struct,
	Union,
	Enum,
	Alias,
};

struct:CTokenFile {
	ptr<Token>:tokens;
	usize:tokenLen;
	usize:tokenCap;
	String:sourceText;
	String:path;
	OwnedString:packageName;
	OwnedString:moduleName;
	usize:fileIndex;
};

