#import(std/lib.kek);
#import(kek/codegen.kek);

int:CompilerFail(str:text) {
	File:stderr = std::Stderr();
	std::WriteStringToFile(&stderr, std::StringFromCString(text));
	return(1);
}

int:CompilerPrintHelp() {
	File:stdout = std::Stdout();
	std::WriteStringToFile(&stdout, std::StringFromCString("kek build <input.kek> -o <output.c>\n"));
	std::WriteStringToFile(&stdout, std::StringFromCString("kek --help\n"));
	std::WriteStringToFile(&stdout, std::StringFromCString("kek --version\n"));
	return(0);
}

Status:WriteDiagnostics(ptr<CompilerContext>:program) {
	StringBuilder:builder = std::StringBuilderNew(program.allocator);
	Status:status = diagnostics::WriteDiagnosticDump(&program.diagnostics, &builder);
	if (status == Status::Ok) {
		File:stderr = std::Stderr();
		String:view = builder.View();
		Result<usize>:write = stderr.Write(view.Bytes());
		status = write.status;
	}
	builder.Destroy();
	return(status);
}

Status:CompileToCString(str:inputPath, Allocator:allocator, ptr<StringBuilder>:out, ptr<DiagnosticBag>:diagnostics) {
	CompilerContext:program;
	Status:status = ProgramInit(&program, allocator);
	if (status != Status::Ok) {
		return(status);
	}
	status = LoadSyntaxPackage(inputPath, &program);
	if (status == Status::Ok) {
		status = BuildModule(&program);
	}
	if (status == Status::Ok) {
		status = CheckModule(&program);
	}
	if (status == Status::Ok) {
		status = GenerateC(&program, out);
	}
	if (program.diagnostics.items.len > 0) {
		for (usize:i = 0; i < program.diagnostics.items.len; i++) {
			ptr<Diagnostic>:item = &program.diagnostics.items.data[i];
			diagnostics::DiagnosticAdd(diagnostics, item.severity, item.phase, item.fileIndex, item.location, std::OwnedStringView(&item.message));
		}
	}
	ProgramDestroy(&program);
	return(status);
}

Status:CompileToC(str:inputPath, str:outputPath, Allocator:allocator, ptr<DiagnosticBag>:diagnostics) {
	StringBuilder:generated = std::StringBuilderNew(allocator);
	Status:status = CompileToCString(inputPath, allocator, &generated, diagnostics);
	if (status == Status::Ok) {
		String:view = generated.View();
		status = std::WriteFile(outputPath, view);
	}
	generated.Destroy();
	return(status);
}

Status:CompileToCStringWithoutDiagnostics(str:inputPath, Allocator:allocator, ptr<StringBuilder>:out) {
	DiagnosticBag:diagnostics;
	diagnostics::DiagnosticBagInit(&diagnostics, allocator);
	Status:status = CompileToCString(inputPath, allocator, out, &diagnostics);
	diagnostics::DiagnosticBagDestroy(&diagnostics);
	return(status);
}

Status:WriteCompileDiagnostics(str:inputPath, Allocator:allocator, ptr<StringBuilder>:out) {
	StringBuilder:generated = std::StringBuilderNew(allocator);
	DiagnosticBag:diagnostics;
	diagnostics::DiagnosticBagInit(&diagnostics, allocator);
	Status:status = CompileToCString(inputPath, allocator, &generated, &diagnostics);
	Status:writeStatus = Status::Ok;
	if (diagnostics.items.len > 0) {
		writeStatus = diagnostics::WriteDiagnosticDump(&diagnostics, out);
	} else {
		if (status != Status::Ok) {
			writeStatus = out.WriteCString("diag|2|4|-1|0|0|0|0|compile failed\n");
		}
	}
	generated.Destroy();
	diagnostics::DiagnosticBagDestroy(&diagnostics);
	if (writeStatus != Status::Ok) {
		return(writeStatus);
	}
	return(Status::Ok);
}

Status:CompilerRunBuild(str:inputPath, str:outputPath) {
	Allocator:allocator = std::DefaultAllocator();
	DiagnosticBag:diagnostics;
	diagnostics::DiagnosticBagInit(&diagnostics, allocator);
	Status:status = CompileToC(inputPath, outputPath, allocator, &diagnostics);
	if (diagnostics.items.len > 0) {
		StringBuilder:dump = std::StringBuilderNew(allocator);
		diagnostics::WriteDiagnosticDump(&diagnostics, &dump);
		File:stderr = std::Stderr();
		String:view = dump.View();
		stderr.Write(view.Bytes());
		dump.Destroy();
	}
	diagnostics::DiagnosticBagDestroy(&diagnostics);
	return(status);
}

int:CompilerMain(int:argc, ptr<str>:argv) {
	if (argc < 2) {
		return(CompilerFail("missing command\n"));
	}
	String:command = std::StringFromCString(argv[1]);
	if (command.EqualsCString("--help")) {
		return(CompilerPrintHelp());
	}
	if (command.EqualsCString("--version")) {
		File:stdout = std::Stdout();
		std::WriteStringToFile(&stdout, std::StringFromCString("0.3.0-self\n"));
		return(0);
	}
	if (!command.EqualsCString("build")) {
		return(CompilerFail("unknown command\n"));
	}
	if (argc < 3) {
		return(CompilerFail("missing input\n"));
	}
	str:inputPath = argv[2];
	str:outputPath = "out.kek.c";
	usize:i = 3;
	while (i < cast<usize>(argc)) {
		String:arg = std::StringFromCString(argv[i]);
		if (arg.EqualsCString("-o")) {
			if (i + 1 >= cast<usize>(argc)) {
				return(CompilerFail("missing -o value\n"));
			}
			outputPath = argv[i + 1];
			i += 2;
			continue;
		}
		return(CompilerFail("unknown build option\n"));
	}
	Status:status = CompilerRunBuild(inputPath, outputPath);
	if (status != Status::Ok) {
		return(CompilerFail("build failed\n"));
	}
	return(0);
}
