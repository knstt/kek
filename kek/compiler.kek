struct:CProgram {
	Allocator:allocator;
	DiagnosticBag:diagnostics;
	FileTable:files;
	Array<CTokenFile>:tokenFiles;
	Array<CDecl>:decls;
	Array<CParam>:params;
	Array<CField>:fields;
	Array<CTypeUse>:typeUses;
	Array<CFuncUse>:funcUses;
};

bool:CIsOk(Status:status) {
	return(status == Status::Ok);
}

String:CTokenText(ptr<CProgram>:program, usize:fileIndex, usize:tokenIndex) {
	ptr<CTokenFile>:file = &program.tokenFiles.data[fileIndex];
	Token:token = file.tokens[tokenIndex];
	String:sourceText = file.sourceText;
	return(sourceText.Slice(token.offset, token.length));
}

bool:CTokenEquals(ptr<CProgram>:program, usize:fileIndex, usize:tokenIndex, str:text) {
	String:value = CTokenText(program, fileIndex, tokenIndex);
	return(value.EqualsCString(text));
}

bool:CStringEquals(String:value, str:text) {
	return(value.EqualsCString(text));
}

bool:CIsTokenKind(ptr<CProgram>:program, usize:fileIndex, usize:tokenIndex, TokenKind:kind) {
	return(program.tokenFiles.data[fileIndex].tokens[tokenIndex].kind == kind);
}

bool:CIsPunctuation(ptr<CProgram>:program, usize:fileIndex, usize:tokenIndex, PunctuationKind:kind) {
	Token:token = program.tokenFiles.data[fileIndex].tokens[tokenIndex];
	return(token.kind == TokenKind::Punctuation && token.subkind == cast<u64>(kind));
}

bool:CIsOperator(ptr<CProgram>:program, usize:fileIndex, usize:tokenIndex, OperatorKind:kind) {
	Token:token = program.tokenFiles.data[fileIndex].tokens[tokenIndex];
	return(token.kind == TokenKind::Operator && token.subkind == cast<u64>(kind));
}

bool:CIsKeyword(ptr<CProgram>:program, usize:fileIndex, usize:tokenIndex, KeywordKind:kind) {
	Token:token = program.tokenFiles.data[fileIndex].tokens[tokenIndex];
	return(token.kind == TokenKind::Keyword && token.subkind == cast<u64>(kind));
}

bool:CIsIdentifierText(ptr<CProgram>:program, usize:fileIndex, usize:tokenIndex, str:text) {
	Token:token = program.tokenFiles.data[fileIndex].tokens[tokenIndex];
	if (!(token.kind == TokenKind::Identifier || token.kind == TokenKind::Keyword)) {
		return(false);
	}
	return(CTokenEquals(program, fileIndex, tokenIndex, text));
}

bool:CIsEof(ptr<CProgram>:program, usize:fileIndex, usize:tokenIndex) {
	return(program.tokenFiles.data[fileIndex].tokens[tokenIndex].kind == TokenKind::Eof);
}

usize:CFileTokenCount(ptr<CProgram>:program, usize:fileIndex) {
	return(program.tokenFiles.data[fileIndex].tokenLen);
}

Status:CWrite(ptr<StringBuilder>:out, str:text) {
	return(out.WriteCString(text));
}

Status:CWriteString(ptr<StringBuilder>:out, String:text) {
	return(out.WriteString(text));
}

Status:CWriteToken(ptr<CProgram>:program, ptr<StringBuilder>:out, usize:fileIndex, usize:tokenIndex) {
	return(out.WriteString(CTokenText(program, fileIndex, tokenIndex)));
}

Status:CCloneCString(ptr<CProgram>:program, str:text, ptr<OwnedString>:out) {
	return(std::CloneCString(text, program.allocator, out));
}

Status:CCloneString(ptr<CProgram>:program, String:text, ptr<OwnedString>:out) {
	return(std::CloneString(text, program.allocator, out));
}

String:COwnedView(ptr<OwnedString>:value) {
	return(std::OwnedStringView(value));
}

bool:COwnedEqualsCString(ptr<OwnedString>:value, str:text) {
	String:view = std::OwnedStringView(value);
	return(view.EqualsCString(text));
}

bool:COwnedEquals(ptr<OwnedString>:left, ptr<OwnedString>:right) {
	String:leftView = std::OwnedStringView(left);
	String:rightView = std::OwnedStringView(right);
	return(leftView.Equals(rightView));
}

Status:CDetachBuilder(ptr<StringBuilder>:builder, ptr<OwnedString>:out) {
	Result<OwnedString>:detached = builder.Detach();
	if (detached.status != Status::Ok) {
		return(detached.status);
	}
	out.data = detached.value.data;
	out.len = detached.value.len;
	out.cap = detached.value.cap;
	out.allocator = detached.value.allocator;
	return(Status::Ok);
}

Status:CMakeOwnedEmpty(ptr<CProgram>:program, ptr<OwnedString>:out) {
	return(CCloneCString(program, "", out));
}

Status:CWriteOwned(ptr<StringBuilder>:out, ptr<OwnedString>:text) {
	return(out.WriteString(std::OwnedStringView(text)));
}

usize:CStringLastSlash(String:path) {
	usize:last = path.len;
	for (usize:i = 0; i < path.len; i++) {
		if (path.data[i] == '/') {
			last = i;
		}
	}
	return(last);
}

Status:CPackageNameFromPath(String:path, Allocator:allocator, ptr<OwnedString>:out) {
	usize:lastSlash = CStringLastSlash(path);
	if (lastSlash == path.len) {
		return(std::CloneCString("", allocator, out));
	}
	usize:segmentStart = 0;
	for (usize:i = 0; i < lastSlash; i++) {
		if (path.data[i] == '/') {
			segmentStart = i + 1;
		}
	}
	return(std::CloneString(path.Slice(segmentStart, lastSlash - segmentStart), allocator, out));
}

Status:CModuleNameFromPath(String:path, Allocator:allocator, ptr<OwnedString>:out) {
	usize:lastSlash = CStringLastSlash(path);
	if (lastSlash == path.len) {
		return(std::CloneCString("", allocator, out));
	}
	String:name = path.Slice(lastSlash + 1, path.len - lastSlash - 1);
	if (name.EndsWith(std::StringFromCString(".kek"))) {
		return(std::CloneString(name.Slice(0, name.len - 4), allocator, out));
	}
	return(std::CloneString(name, allocator, out));
}

Status:CInitTokenFileSlot(Allocator:allocator, ptr<CTokenFile>:tokenFile, usize:fileIndex) {
	tokenFile.tokens = 0;
	tokenFile.tokenLen = 0;
	tokenFile.tokenCap = 0;
	tokenFile.sourceText = std::StringFromCString("");
	tokenFile.path = std::StringFromCString("");
	tokenFile.fileIndex = fileIndex;
	Status:status = std::CloneCString("", allocator, &tokenFile.packageName);
	if (status == Status::Ok) {
		status = std::CloneCString("", allocator, &tokenFile.moduleName);
	}
	return(status);
}

Status:CSetTokenFileNames(Allocator:allocator, ptr<CTokenFile>:tokenFile, bool:isRoot) {
	std::DestroyOwnedString(&tokenFile.packageName);
	std::DestroyOwnedString(&tokenFile.moduleName);
	if (isRoot) {
		Status:status = std::CloneCString("", allocator, &tokenFile.packageName);
		if (status == Status::Ok) {
			status = std::CloneCString("", allocator, &tokenFile.moduleName);
		}
		return(status);
	}
	Status:status = CPackageNameFromPath(tokenFile.path, allocator, &tokenFile.packageName);
	if (status == Status::Ok) {
		status = CModuleNameFromPath(tokenFile.path, allocator, &tokenFile.moduleName);
	}
	return(status);
}

Status:CTokenizeSourceFile(Allocator:allocator, ptr<SourceFile>:sourceFile, ptr<CTokenFile>:tokenFile, usize:fileIndex, bool:isRoot, ptr<DiagnosticBag>:diagnostics) {
	tokenFile.sourceText = std::OwnedStringView(&sourceFile.content);
	tokenFile.path = std::OwnedStringView(&sourceFile.path);
	tokenFile.fileIndex = fileIndex;
	Status:status = CSetTokenFileNames(allocator, tokenFile, isRoot);
	if (status != Status::Ok) {
		return(status);
	}

	Array<Token>:tokens;
	status = tokenizer::TokenizeToArray(tokenFile.sourceText, false, allocator, &tokens);
	if (status != Status::Ok) {
		tokens.Destroy();
		return(status);
	}
	tokenFile.tokens = tokens.data;
	tokenFile.tokenLen = tokens.len;
	tokenFile.tokenCap = tokens.cap;

	AstTree:tree;
	status = ast::ParseTokens(tokenFile.tokens, tokenFile.tokenLen, tokenFile.sourceText, cast<i64>(fileIndex), allocator, diagnostics, &tree);
	if (status == Status::Ok) {
		ast::AstTreeDestroy(&tree);
	}
	return(status);
}

void:CTokenizeJobRun(ptr<CTokenizeJob>:job) {
	job.status = CTokenizeSourceFile(job.allocator, job.sourceFile, job.tokenFile, job.fileIndex, job.isRoot, &job.diagnostics);
}

ptr:CTokenizeFileThreadEntry(ptr:arg) {
	ptr<CTokenizeJob>:job = cast<ptr<CTokenizeJob>>(arg);
	CTokenizeJobRun(job);
	return(0);
}

Status:CMergeDiagnostics(ptr<DiagnosticBag>:target, ptr<DiagnosticBag>:source) {
	for (usize:i = 0; i < source.items.len; i++) {
		ptr<Diagnostic>:item = &source.items.data[i];
		Status:status = diagnostics::DiagnosticAdd(target, item.severity, item.phase, item.fileIndex, item.location, std::OwnedStringView(&item.message));
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(Status::Ok);
}

Status:CProgramInit(ptr<CProgram>:program, Allocator:allocator) {
	program.allocator = allocator;
	diagnostics::DiagnosticBagInit(&program.diagnostics, allocator);
	source::FileTableInit(&program.files, allocator);
	program.tokenFiles = std::ArrayNew<CTokenFile>(allocator);
	program.decls = std::ArrayNew<CDecl>(allocator);
	program.params = std::ArrayNew<CParam>(allocator);
	program.fields = std::ArrayNew<CField>(allocator);
	program.typeUses = std::ArrayNew<CTypeUse>(allocator);
	program.funcUses = std::ArrayNew<CFuncUse>(allocator);
	return(Status::Ok);
}

Status:CProgramDestroy(ptr<CProgram>:program) {
	for (usize:i = 0; i < program.tokenFiles.len; i++) {
		Array<Token>:tokens;
		tokens.data = program.tokenFiles.data[i].tokens;
		tokens.len = program.tokenFiles.data[i].tokenLen;
		tokens.cap = program.tokenFiles.data[i].tokenCap;
		tokens.allocator = program.allocator;
		tokens.Destroy();
		std::DestroyOwnedString(&program.tokenFiles.data[i].packageName);
		std::DestroyOwnedString(&program.tokenFiles.data[i].moduleName);
	}
	for (usize:i = 0; i < program.decls.len; i++) {
		std::DestroyOwnedString(&program.decls.data[i].packageName);
		std::DestroyOwnedString(&program.decls.data[i].moduleName);
	}
	for (usize:i = 0; i < program.typeUses.len; i++) {
		std::DestroyOwnedString(&program.typeUses.data[i].key);
		std::DestroyOwnedString(&program.typeUses.data[i].cName);
		std::DestroyOwnedString(&program.typeUses.data[i].baseName);
		std::DestroyOwnedString(&program.typeUses.data[i].arg0);
		std::DestroyOwnedString(&program.typeUses.data[i].arg1);
		std::DestroyOwnedString(&program.typeUses.data[i].arg2);
	}
	for (usize:i = 0; i < program.funcUses.len; i++) {
		std::DestroyOwnedString(&program.funcUses.data[i].key);
		std::DestroyOwnedString(&program.funcUses.data[i].cName);
		std::DestroyOwnedString(&program.funcUses.data[i].arg0);
		std::DestroyOwnedString(&program.funcUses.data[i].arg1);
		std::DestroyOwnedString(&program.funcUses.data[i].arg2);
	}
	Array<CTokenFile>:tokenFiles = program.tokenFiles;
	Status:status = tokenFiles.Destroy();
	program.tokenFiles = tokenFiles;
	Array<CDecl>:decls = program.decls;
	if (status == Status::Ok) { status = decls.Destroy(); }
	program.decls = decls;
	Array<CParam>:params = program.params;
	if (status == Status::Ok) { status = params.Destroy(); }
	program.params = params;
	Array<CField>:fields = program.fields;
	if (status == Status::Ok) { status = fields.Destroy(); }
	program.fields = fields;
	Array<CTypeUse>:typeUses = program.typeUses;
	if (status == Status::Ok) { status = typeUses.Destroy(); }
	program.typeUses = typeUses;
	Array<CFuncUse>:funcUses = program.funcUses;
	if (status == Status::Ok) { status = funcUses.Destroy(); }
	program.funcUses = funcUses;
	if (status == Status::Ok) { status = source::FileTableDestroy(&program.files); }
	if (status == Status::Ok) { status = diagnostics::DiagnosticBagDestroy(&program.diagnostics); }
	return(status);
}

Status:CAddDiagnostic(ptr<CProgram>:program, str:message) {
	return(diagnostics::DiagnosticAddCString(&program.diagnostics, DiagnosticSeverity::Error, DiagnosticPhase::Semantic, -1, diagnostics::SourceLocationNew(0, 0, 0, 0), message));
}

Status:CReserveTokenFiles(ptr<CProgram>:program, usize:additional) {
	Array<CTokenFile>:tokenFiles = program.tokenFiles;
	Status:status = tokenFiles.Reserve(additional);
	program.tokenFiles = tokenFiles;
	return(status);
}

Status:CReserveDecls(ptr<CProgram>:program, usize:additional) {
	Array<CDecl>:decls = program.decls;
	Status:status = decls.Reserve(additional);
	program.decls = decls;
	return(status);
}

Status:CReserveParams(ptr<CProgram>:program, usize:additional) {
	Array<CParam>:params = program.params;
	Status:status = params.Reserve(additional);
	program.params = params;
	return(status);
}

Status:CReserveFields(ptr<CProgram>:program, usize:additional) {
	Array<CField>:fields = program.fields;
	Status:status = fields.Reserve(additional);
	program.fields = fields;
	return(status);
}

Status:CReserveTypeUses(ptr<CProgram>:program, usize:additional) {
	Array<CTypeUse>:typeUses = program.typeUses;
	Status:status = typeUses.Reserve(additional);
	program.typeUses = typeUses;
	return(status);
}

Status:CReserveFuncUses(ptr<CProgram>:program, usize:additional) {
	Array<CFuncUse>:funcUses = program.funcUses;
	Status:status = funcUses.Reserve(additional);
	program.funcUses = funcUses;
	return(status);
}

Status:CReserveLocals(ptr<CEnv>:env, usize:additional) {
	Array<CLocal>:locals = env.locals;
	Status:status = locals.Reserve(additional);
	env.locals = locals;
	return(status);
}

Status:CLoadAndTokenize(ptr<CProgram>:program, str:entryPath) {
	Status:status = source::LoadCompilationSources(entryPath, program.allocator, &program.files, &program.diagnostics);
	if (status != Status::Ok) {
		return(status);
	}

	status = CReserveTokenFiles(program, program.files.files.len);
	if (status != Status::Ok) {
		return(status);
	}
	for (usize:i = 0; i < program.files.files.len; i++) {
		status = CInitTokenFileSlot(program.allocator, &program.tokenFiles.data[i], i);
		if (status != Status::Ok) {
			program.tokenFiles.len = i;
			return(status);
		}
	}
	program.tokenFiles.len = program.files.files.len;

	Array<CTokenizeJob>:jobs = std::ArrayNew<CTokenizeJob>(program.allocator);
	if (program.files.files.len > 0) {
		status = jobs.Reserve(program.files.files.len);
		if (status != Status::Ok) {
			return(status);
		}
		jobs.len = program.files.files.len;
	}
	for (usize:i = 0; i < program.files.files.len; i++) {
		ptr<CTokenizeJob>:job = &jobs.data[i];
		job.allocator = program.allocator;
		job.sourceFile = &program.files.files.data[i];
		job.tokenFile = &program.tokenFiles.data[i];
		diagnostics::DiagnosticBagInit(&job.diagnostics, program.allocator);
		job.status = Status::Ok;
		job.fileIndex = i;
		job.isRoot = i == 0;
		job.threaded = false;
		Status:startStatus = std::ThreadHandleStart(&job.threadHandle, cast<ptr>(CTokenizeFileThreadEntry), cast<ptr>(job));
		if (startStatus == Status::Ok) {
			job.threaded = true;
		} else {
			CTokenizeJobRun(job);
		}
	}

	Status:firstStatus = Status::Ok;
	for (usize:i = 0; i < program.files.files.len; i++) {
		ptr<CTokenizeJob>:job = &jobs.data[i];
		if (job.threaded) {
			Status:joinStatus = std::ThreadHandleJoin(&job.threadHandle);
			if (joinStatus != Status::Ok && job.status == Status::Ok) {
				job.status = joinStatus;
			}
		}
		Status:mergeStatus = CMergeDiagnostics(&program.diagnostics, &job.diagnostics);
		if (firstStatus == Status::Ok && mergeStatus != Status::Ok) {
			firstStatus = mergeStatus;
		}
		if (firstStatus == Status::Ok && job.status != Status::Ok) {
			firstStatus = job.status;
		}
		diagnostics::DiagnosticBagDestroy(&job.diagnostics);
	}
	Status:jobsStatus = jobs.Destroy();
	if (firstStatus == Status::Ok && jobsStatus != Status::Ok) {
		firstStatus = jobsStatus;
	}
	return(firstStatus);
}

int:CompilerFail(str:text) {
	File:stderr = std::Stderr();
	std::WriteStringToFile(&stderr, std::StringFromCString(text));
	return(1);
}

int:CompilerPrintHelp() {
	File:stdout = std::Stdout();
	std::WriteStringToFile(&stdout, std::StringFromCString("kek build <input.kek> -o <output.c>\n"));
	std::WriteStringToFile(&stdout, std::StringFromCString("kek --help\n"));
	std::WriteStringToFile(&stdout, std::StringFromCString("kek --version\n"));
	return(0);
}

Status:CWriteDiagnostics(ptr<CProgram>:program) {
	StringBuilder:builder = std::StringBuilderNew(program.allocator);
	Status:status = diagnostics::WriteDiagnosticDump(&program.diagnostics, &builder);
	if (status == Status::Ok) {
		File:stderr = std::Stderr();
		String:view = builder.View();
		Result<usize>:write = stderr.Write(view.Bytes());
		status = write.status;
	}
	builder.Destroy();
	return(status);
}

bool:CIsOpenDelimiter(ptr<CProgram>:program, usize:fileIndex, usize:index) {
	return(CIsPunctuation(program, fileIndex, index, PunctuationKind::LeftParen)
		|| CIsPunctuation(program, fileIndex, index, PunctuationKind::LeftBrace)
		|| CIsPunctuation(program, fileIndex, index, PunctuationKind::LeftBracket)
		|| CIsOperator(program, fileIndex, index, OperatorKind::Less));
}

bool:CDelimiterMatches(ptr<CProgram>:program, usize:fileIndex, usize:openIndex, usize:closeIndex) {
	if (CIsPunctuation(program, fileIndex, openIndex, PunctuationKind::LeftParen)) {
		return(CIsPunctuation(program, fileIndex, closeIndex, PunctuationKind::RightParen));
	}
	if (CIsPunctuation(program, fileIndex, openIndex, PunctuationKind::LeftBrace)) {
		return(CIsPunctuation(program, fileIndex, closeIndex, PunctuationKind::RightBrace));
	}
	if (CIsPunctuation(program, fileIndex, openIndex, PunctuationKind::LeftBracket)) {
		return(CIsPunctuation(program, fileIndex, closeIndex, PunctuationKind::RightBracket));
	}
	if (CIsOperator(program, fileIndex, openIndex, OperatorKind::Less)) {
		return(CIsOperator(program, fileIndex, closeIndex, OperatorKind::Greater));
	}
	return(false);
}

usize:CFindMatching(ptr<CProgram>:program, usize:fileIndex, usize:openIndex) {
	usize:count = CFileTokenCount(program, fileIndex);
	usize:depth = 0;
	bool:isParen = CIsPunctuation(program, fileIndex, openIndex, PunctuationKind::LeftParen);
	bool:isBrace = CIsPunctuation(program, fileIndex, openIndex, PunctuationKind::LeftBrace);
	bool:isBracket = CIsPunctuation(program, fileIndex, openIndex, PunctuationKind::LeftBracket);
	bool:isGeneric = CIsOperator(program, fileIndex, openIndex, OperatorKind::Less);
	for (usize:i = openIndex; i < count; i++) {
		if ((isParen && CIsPunctuation(program, fileIndex, i, PunctuationKind::LeftParen))
			|| (isBrace && CIsPunctuation(program, fileIndex, i, PunctuationKind::LeftBrace))
			|| (isBracket && CIsPunctuation(program, fileIndex, i, PunctuationKind::LeftBracket))
			|| (isGeneric && CIsOperator(program, fileIndex, i, OperatorKind::Less))) {
			depth += 1;
			continue;
		}
		if ((isParen && CIsPunctuation(program, fileIndex, i, PunctuationKind::RightParen))
			|| (isBrace && CIsPunctuation(program, fileIndex, i, PunctuationKind::RightBrace))
			|| (isBracket && CIsPunctuation(program, fileIndex, i, PunctuationKind::RightBracket))
			|| (isGeneric && CIsOperator(program, fileIndex, i, OperatorKind::Greater))) {
			if (depth == 0) {
				return(i);
			}
			depth -= 1;
			if (depth == 0) {
				return(i);
			}
		}
	}
	return(count);
}

usize:CSkipDelimited(ptr<CProgram>:program, usize:fileIndex, usize:index) {
	usize:match = CFindMatching(program, fileIndex, index);
	if (match >= CFileTokenCount(program, fileIndex)) {
		return(index + 1);
	}
	return(match + 1);
}

usize:CSkipAttributes(ptr<CProgram>:program, usize:fileIndex, usize:index) {
	while (index < CFileTokenCount(program, fileIndex) && CIsPunctuation(program, fileIndex, index, PunctuationKind::LeftBracket)) {
		index = CSkipDelimited(program, fileIndex, index);
	}
	return(index);
}

usize:CFindTopLevelColon(ptr<CProgram>:program, usize:fileIndex, usize:start, usize:end) {
	usize:parenDepth = 0;
	usize:braceDepth = 0;
	usize:bracketDepth = 0;
	usize:genericDepth = 0;
	for (usize:i = start; i < end; i++) {
		if (CIsPunctuation(program, fileIndex, i, PunctuationKind::LeftParen)) {
			parenDepth += 1;
			continue;
		}
		if (CIsPunctuation(program, fileIndex, i, PunctuationKind::RightParen)) {
			if (parenDepth > 0) {
				parenDepth -= 1;
			}
			continue;
		}
		if (CIsPunctuation(program, fileIndex, i, PunctuationKind::LeftBrace)) {
			braceDepth += 1;
			continue;
		}
		if (CIsPunctuation(program, fileIndex, i, PunctuationKind::RightBrace)) {
			if (braceDepth > 0) {
				braceDepth -= 1;
			}
			continue;
		}
		if (CIsPunctuation(program, fileIndex, i, PunctuationKind::LeftBracket)) {
			bracketDepth += 1;
			continue;
		}
		if (CIsPunctuation(program, fileIndex, i, PunctuationKind::RightBracket)) {
			if (bracketDepth > 0) {
				bracketDepth -= 1;
			}
			continue;
		}
		if (CIsOperator(program, fileIndex, i, OperatorKind::Less)) {
			genericDepth += 1;
			continue;
		}
		if (CIsOperator(program, fileIndex, i, OperatorKind::Greater)) {
			if (genericDepth > 0) {
				genericDepth -= 1;
			}
			continue;
		}
		if (parenDepth == 0 && braceDepth == 0 && bracketDepth == 0 && genericDepth == 0 && CIsPunctuation(program, fileIndex, i, PunctuationKind::Colon)) {
			return(i);
		}
	}
	return(end);
}

usize:CFindTokenAtDepthZero(ptr<CProgram>:program, usize:fileIndex, usize:start, usize:end, PunctuationKind:punctuation) {
	usize:parenDepth = 0;
	usize:braceDepth = 0;
	usize:bracketDepth = 0;
	usize:genericDepth = 0;
	for (usize:i = start; i < end; i++) {
		if (CIsPunctuation(program, fileIndex, i, PunctuationKind::LeftParen)) {
			parenDepth += 1;
			continue;
		}
		if (CIsPunctuation(program, fileIndex, i, PunctuationKind::RightParen)) {
			if (parenDepth > 0) {
				parenDepth -= 1;
			}
			continue;
		}
		if (CIsPunctuation(program, fileIndex, i, PunctuationKind::LeftBrace)) {
			braceDepth += 1;
			continue;
		}
		if (CIsPunctuation(program, fileIndex, i, PunctuationKind::RightBrace)) {
			if (braceDepth > 0) {
				braceDepth -= 1;
			}
			continue;
		}
		if (CIsPunctuation(program, fileIndex, i, PunctuationKind::LeftBracket)) {
			bracketDepth += 1;
			continue;
		}
		if (CIsPunctuation(program, fileIndex, i, PunctuationKind::RightBracket)) {
			if (bracketDepth > 0) {
				bracketDepth -= 1;
			}
			continue;
		}
		if (parenDepth == 0 && braceDepth == 0 && bracketDepth == 0 && genericDepth == 0 && CIsPunctuation(program, fileIndex, i, punctuation)) {
			return(i);
		}
	}
	return(end);
}

usize:CFindOperatorScope(ptr<CProgram>:program, usize:fileIndex, usize:start, usize:end) {
	usize:genericDepth = 0;
	for (usize:i = start; i < end; i++) {
		if (CIsOperator(program, fileIndex, i, OperatorKind::Less)) {
			genericDepth += 1;
			continue;
		}
		if (CIsOperator(program, fileIndex, i, OperatorKind::Greater)) {
			if (genericDepth > 0) {
				genericDepth -= 1;
			}
			continue;
		}
		if (genericDepth == 0 && CIsOperator(program, fileIndex, i, OperatorKind::Scope)) {
			return(i);
		}
	}
	return(end);
}

usize:CFindNextGroup(ptr<CProgram>:program, usize:fileIndex, usize:start, usize:end) {
	for (usize:i = start; i < end; i++) {
		if (CIsPunctuation(program, fileIndex, i, PunctuationKind::LeftParen)) {
			return(i);
		}
	}
	return(end);
}

usize:CFindNextBlock(ptr<CProgram>:program, usize:fileIndex, usize:start, usize:end) {
	for (usize:i = start; i < end; i++) {
		if (CIsPunctuation(program, fileIndex, i, PunctuationKind::LeftBrace)) {
			return(i);
		}
	}
	return(end);
}

u8:COperatorCode(ptr<CProgram>:program, usize:fileIndex, usize:index) {
	Token:token = program.tokenFiles.data[fileIndex].tokens[index];
	if (token.kind == TokenKind::Operator) {
		return(cast<u8>(token.subkind + 1));
	}
	return(0);
}

Status:CAddDecl(ptr<CProgram>:program, ptr<CDecl>:decl) {
	Status:status = CReserveDecls(program, 1);
	if (status == Status::Ok) {
		program.decls.data[program.decls.len] = decl[0];
		program.decls.len += 1;
	}
	return(status);
}

Status:CAddParam(ptr<CProgram>:program, ptr<CParam>:param) {
	Status:status = CReserveParams(program, 1);
	if (status == Status::Ok) {
		program.params.data[program.params.len] = param[0];
		program.params.len += 1;
	}
	return(status);
}

Status:CAddField(ptr<CProgram>:program, ptr<CField>:field) {
	Status:status = CReserveFields(program, 1);
	if (status == Status::Ok) {
		program.fields.data[program.fields.len] = field[0];
		program.fields.len += 1;
	}
	return(status);
}

Status:CParseParams(ptr<CProgram>:program, ptr<CDecl>:decl, usize:fileIndex, usize:start, usize:end) {
	decl.firstParam = program.params.len;
	decl.paramCount = 0;
	usize:itemStart = start;
	while (itemStart < end) {
		if (CIsPunctuation(program, fileIndex, itemStart, PunctuationKind::Comma)) {
			itemStart += 1;
			continue;
		}
		usize:itemEnd = CFindTokenAtDepthZero(program, fileIndex, itemStart, end, PunctuationKind::Comma);
		usize:colon = CFindTopLevelColon(program, fileIndex, itemStart, itemEnd);
		if (colon >= itemEnd) {
			break;
		}
		CParam:param;
		param.fileIndex = fileIndex;
		param.typeStart = itemStart;
		param.typeEnd = colon;
		param.nameIndex = colon + 1;
		param.defaultStart = itemEnd;
		param.defaultEnd = itemEnd;
		param.hasDefault = false;
		for (usize:i = param.nameIndex + 1; i < itemEnd; i++) {
			if (CIsOperator(program, fileIndex, i, OperatorKind::Assign)) {
				param.defaultStart = i + 1;
				param.defaultEnd = itemEnd;
				param.hasDefault = true;
				break;
			}
		}
		Status:status = CAddParam(program, &param);
		if (status != Status::Ok) {
			return(status);
		}
		decl.paramCount += 1;
		if (itemEnd >= end) {
			break;
		}
		itemStart = itemEnd + 1;
	}
	return(Status::Ok);
}

Status:CParseFields(ptr<CProgram>:program, ptr<CDecl>:decl, usize:fileIndex, usize:start, usize:end) {
	decl.firstField = program.fields.len;
	decl.fieldCount = 0;
	usize:itemStart = start;
	while (itemStart < end) {
		itemStart = CSkipAttributes(program, fileIndex, itemStart);
		if (itemStart >= end) {
			break;
		}
		if (CIsPunctuation(program, fileIndex, itemStart, PunctuationKind::Semicolon)) {
			itemStart += 1;
			continue;
		}
		CField:field;
		field.fileIndex = fileIndex;
		field.typeStart = itemStart;
		field.typeEnd = itemStart;
		field.nameIndex = itemStart;
		field.defaultStart = end;
		field.defaultEnd = end;
		field.arrayStart = end;
		field.arrayEnd = end;
		field.hasDefault = false;
		field.isArray = false;
		field.isNestedStruct = false;
		field.nestedBodyStart = end;
		field.nestedBodyEnd = end;

		if (CIsKeyword(program, fileIndex, itemStart, KeywordKind::Struct)) {
			usize:colon = itemStart + 1;
			if (colon < end && CIsPunctuation(program, fileIndex, colon, PunctuationKind::Colon)) {
				usize:nameIndex = colon + 1;
				usize:blockStart = CFindNextBlock(program, fileIndex, nameIndex + 1, end);
				usize:blockEnd = CFindMatching(program, fileIndex, blockStart);
				field.isNestedStruct = true;
				field.nameIndex = nameIndex;
				field.nestedBodyStart = blockStart + 1;
				field.nestedBodyEnd = blockEnd;
				Status:addNested = CAddField(program, &field);
				if (addNested != Status::Ok) {
					return(addNested);
				}
				decl.fieldCount += 1;
				itemStart = blockEnd + 1;
				if (itemStart < end && CIsPunctuation(program, fileIndex, itemStart, PunctuationKind::Semicolon)) {
					itemStart += 1;
				}
				continue;
			}
		}

		usize:itemEnd = itemStart;
		while (itemEnd < end && !CIsPunctuation(program, fileIndex, itemEnd, PunctuationKind::Semicolon)) {
			if (CIsPunctuation(program, fileIndex, itemEnd, PunctuationKind::LeftBrace)
				|| CIsPunctuation(program, fileIndex, itemEnd, PunctuationKind::LeftParen)
				|| CIsPunctuation(program, fileIndex, itemEnd, PunctuationKind::LeftBracket)) {
				itemEnd = CSkipDelimited(program, fileIndex, itemEnd);
				continue;
			}
			itemEnd += 1;
		}
		usize:colon = CFindTopLevelColon(program, fileIndex, itemStart, itemEnd);
		if (colon >= itemEnd) {
			itemStart = itemEnd + 1;
			continue;
		}
		field.typeStart = itemStart;
		field.typeEnd = colon;
		field.nameIndex = colon + 1;
		usize:afterName = field.nameIndex + 1;
		if (afterName < itemEnd && CIsPunctuation(program, fileIndex, afterName, PunctuationKind::LeftBracket)) {
			field.isArray = true;
			field.arrayStart = afterName + 1;
			field.arrayEnd = CFindMatching(program, fileIndex, afterName);
			afterName = field.arrayEnd + 1;
		}
		for (usize:i = afterName; i < itemEnd; i++) {
			if (CIsOperator(program, fileIndex, i, OperatorKind::Assign)) {
				field.hasDefault = true;
				field.defaultStart = i + 1;
				field.defaultEnd = itemEnd;
				break;
			}
		}
		Status:status = CAddField(program, &field);
		if (status != Status::Ok) {
			return(status);
		}
		decl.fieldCount += 1;
		itemStart = itemEnd + 1;
	}
	return(Status::Ok);
}

bool:CDeclNameMatches(ptr<CProgram>:program, ptr<CDecl>:decl, String:name) {
	if (decl.nameIndex >= CFileTokenCount(program, decl.fileIndex)) {
		return(false);
	}
	String:declName = CTokenText(program, decl.fileIndex, decl.nameIndex);
	return(declName.Equals(name));
}

ptr<CDecl>:CFindTypeDecl(ptr<CProgram>:program, String:name) {
	for (usize:i = 0; i < program.decls.len; i++) {
		ptr<CDecl>:decl = &program.decls.data[i];
		if ((decl.kind == CDeclKind::Struct || decl.kind == CDeclKind::Union || decl.kind == CDeclKind::Enum || decl.kind == CDeclKind::Alias)
			&& CDeclNameMatches(program, decl, name)) {
			return(decl);
		}
	}
	return(0);
}

Status:CParseAliasDecl(ptr<CProgram>:program, usize:fileIndex, usize:start, ptr<usize>:outEnd) {
	usize:count = CFileTokenCount(program, fileIndex);
	usize:end = start;
	while (end < count && !CIsPunctuation(program, fileIndex, end, PunctuationKind::Semicolon) && !CIsEof(program, fileIndex, end)) {
		end += 1;
	}
	CDecl:decl;
	decl.kind = CDeclKind::Alias;
	decl.fileIndex = fileIndex;
	decl.start = start;
	decl.end = end + 1;
	decl.nameIndex = start + 2;
	decl.returnStart = end;
	decl.returnEnd = end;
	decl.receiverStart = end;
	decl.receiverEnd = end;
	decl.hasReceiver = false;
	decl.isOperator = false;
	decl.operatorCode = 0;
	decl.genericStart = end;
	decl.genericEnd = end;
	decl.isGeneric = false;
	decl.paramStart = end;
	decl.paramEnd = end;
	decl.bodyStart = end;
	decl.bodyEnd = end;
	decl.hasBody = false;
	decl.firstParam = 0;
	decl.paramCount = 0;
	decl.firstField = 0;
	decl.fieldCount = 0;
	decl.emitted = false;
	decl.reachable = false;
	Status:clone = CCloneString(program, std::OwnedStringView(&program.tokenFiles.data[fileIndex].packageName), &decl.packageName);
	if (clone != Status::Ok) {
		return(clone);
	}
	clone = CCloneString(program, std::OwnedStringView(&program.tokenFiles.data[fileIndex].moduleName), &decl.moduleName);
	if (clone != Status::Ok) {
		return(clone);
	}
	for (usize:i = start + 3; i < end; i++) {
		if (CIsOperator(program, fileIndex, i, OperatorKind::Assign)) {
			decl.returnStart = i + 1;
			decl.returnEnd = end;
			break;
		}
	}
	Status:status = CAddDecl(program, &decl);
	outEnd[0] = end + 1;
	return(status);
}

Status:CParseTypeDecl(ptr<CProgram>:program, usize:fileIndex, usize:start, CDeclKind:kind, ptr<usize>:outEnd) {
	usize:count = CFileTokenCount(program, fileIndex);
	usize:colon = start + 1;
	usize:nameIndex = colon + 1;
	if (kind == CDeclKind::Enum) {
		if (colon < count && CIsPunctuation(program, fileIndex, colon, PunctuationKind::Colon)) {
			usize:secondColon = CFindTopLevelColon(program, fileIndex, colon + 1, count);
			if (secondColon < count) {
				nameIndex = secondColon + 1;
			}
		}
	}
	usize:genericStart = count;
	usize:genericEnd = count;
	if (nameIndex + 1 < count && CIsOperator(program, fileIndex, nameIndex + 1, OperatorKind::Less)) {
		genericStart = nameIndex + 1;
		genericEnd = CFindMatching(program, fileIndex, genericStart);
	}
	usize:blockStart = CFindNextBlock(program, fileIndex, nameIndex + 1, count);
	usize:blockEnd = CFindMatching(program, fileIndex, blockStart);
	CDecl:decl;
	decl.kind = kind;
	decl.fileIndex = fileIndex;
	decl.start = start;
	decl.end = blockEnd + 1;
	decl.nameIndex = nameIndex;
	decl.returnStart = start;
	decl.returnEnd = start;
	decl.receiverStart = start;
	decl.receiverEnd = start;
	decl.hasReceiver = false;
	decl.isOperator = false;
	decl.operatorCode = 0;
	decl.genericStart = genericStart;
	decl.genericEnd = genericEnd;
	decl.isGeneric = genericStart < count;
	decl.paramStart = start;
	decl.paramEnd = start;
	decl.bodyStart = blockStart + 1;
	decl.bodyEnd = blockEnd;
	decl.hasBody = true;
	decl.firstParam = 0;
	decl.paramCount = 0;
	decl.firstField = 0;
	decl.fieldCount = 0;
	decl.emitted = false;
	decl.reachable = false;
	Status:clone = CCloneString(program, std::OwnedStringView(&program.tokenFiles.data[fileIndex].packageName), &decl.packageName);
	if (clone != Status::Ok) {
		return(clone);
	}
	clone = CCloneString(program, std::OwnedStringView(&program.tokenFiles.data[fileIndex].moduleName), &decl.moduleName);
	if (clone != Status::Ok) {
		return(clone);
	}
	if (kind == CDeclKind::Struct || kind == CDeclKind::Union) {
		Status:fields = CParseFields(program, &decl, fileIndex, blockStart + 1, blockEnd);
		if (fields != Status::Ok) {
			return(fields);
		}
	}
	Status:status = CAddDecl(program, &decl);
	outEnd[0] = blockEnd + 1;
	if (outEnd[0] < count && CIsPunctuation(program, fileIndex, outEnd[0], PunctuationKind::Semicolon)) {
		outEnd[0] += 1;
	}
	return(status);
}

Status:CParseExternDecl(ptr<CProgram>:program, usize:fileIndex, usize:start, ptr<usize>:outEnd) {
	usize:count = CFileTokenCount(program, fileIndex);
	usize:blockStart = CFindNextBlock(program, fileIndex, start, count);
	usize:blockEnd = CFindMatching(program, fileIndex, blockStart);
	CDecl:decl;
	decl.kind = CDeclKind::ExternC;
	decl.fileIndex = fileIndex;
	decl.start = start;
	decl.end = blockEnd + 1;
	decl.nameIndex = start;
	decl.returnStart = start;
	decl.returnEnd = start;
	decl.receiverStart = start;
	decl.receiverEnd = start;
	decl.hasReceiver = false;
	decl.isOperator = false;
	decl.operatorCode = 0;
	decl.genericStart = start;
	decl.genericEnd = start;
	decl.isGeneric = false;
	decl.paramStart = start;
	decl.paramEnd = start;
	decl.bodyStart = blockStart + 1;
	decl.bodyEnd = blockEnd;
	decl.hasBody = true;
	decl.firstParam = 0;
	decl.paramCount = 0;
	decl.firstField = 0;
	decl.fieldCount = 0;
	decl.emitted = false;
	decl.reachable = false;
	Status:clone = CCloneString(program, std::OwnedStringView(&program.tokenFiles.data[fileIndex].packageName), &decl.packageName);
	if (clone != Status::Ok) {
		return(clone);
	}
	clone = CCloneString(program, std::OwnedStringView(&program.tokenFiles.data[fileIndex].moduleName), &decl.moduleName);
	if (clone != Status::Ok) {
		return(clone);
	}
	Status:status = CAddDecl(program, &decl);
	outEnd[0] = blockEnd + 1;
	return(status);
}

Status:CParseFunctionDecl(ptr<CProgram>:program, usize:fileIndex, usize:start, ptr<usize>:outEnd) {
	usize:count = CFileTokenCount(program, fileIndex);
	usize:groupStart = CFindNextGroup(program, fileIndex, start, count);
	if (groupStart >= count) {
		outEnd[0] = start + 1;
		return(Status::Ok);
	}
	usize:groupEnd = CFindMatching(program, fileIndex, groupStart);
	usize:colon = CFindTopLevelColon(program, fileIndex, start, groupStart);
	if (colon >= groupStart) {
		outEnd[0] = groupEnd + 1;
		return(Status::Ok);
	}
	usize:blockStart = groupEnd + 1;
	bool:hasBody = false;
	usize:blockEnd = groupEnd;
	if (blockStart < count && CIsPunctuation(program, fileIndex, blockStart, PunctuationKind::LeftBrace)) {
		hasBody = true;
		blockEnd = CFindMatching(program, fileIndex, blockStart);
	}
	CDecl:decl;
	decl.kind = CDeclKind::Function;
	decl.fileIndex = fileIndex;
	decl.start = start;
	decl.end = blockEnd + 1;
	decl.nameIndex = colon + 1;
	decl.returnStart = start;
	decl.returnEnd = colon;
	decl.receiverStart = colon + 1;
	decl.receiverEnd = colon + 1;
	decl.hasReceiver = false;
	decl.isOperator = false;
	decl.operatorCode = 0;
	decl.genericStart = count;
	decl.genericEnd = count;
	decl.isGeneric = false;
	decl.paramStart = groupStart + 1;
	decl.paramEnd = groupEnd;
	decl.bodyStart = blockStart + 1;
	decl.bodyEnd = blockEnd;
	decl.hasBody = hasBody;
	decl.firstParam = 0;
	decl.paramCount = 0;
	decl.firstField = 0;
	decl.fieldCount = 0;
	decl.emitted = false;
	decl.reachable = false;
	Status:clone = CCloneString(program, std::OwnedStringView(&program.tokenFiles.data[fileIndex].packageName), &decl.packageName);
	if (clone != Status::Ok) {
		return(clone);
	}
	clone = CCloneString(program, std::OwnedStringView(&program.tokenFiles.data[fileIndex].moduleName), &decl.moduleName);
	if (clone != Status::Ok) {
		return(clone);
	}

	usize:scope = CFindOperatorScope(program, fileIndex, colon + 1, groupStart);
	if (scope < groupStart) {
		decl.hasReceiver = true;
		decl.receiverStart = colon + 1;
		decl.receiverEnd = scope;
		decl.nameIndex = scope + 1;
	}
	if (decl.nameIndex < groupStart && CIsIdentifierText(program, fileIndex, decl.nameIndex, "operator")) {
		decl.isOperator = true;
		decl.operatorCode = COperatorCode(program, fileIndex, decl.nameIndex + 1);
	}
	usize:genericProbe = decl.nameIndex + 1;
	if (decl.isOperator) {
		genericProbe = decl.nameIndex + 2;
	}
	if (genericProbe < groupStart && CIsOperator(program, fileIndex, genericProbe, OperatorKind::Less)) {
		decl.genericStart = genericProbe;
		decl.genericEnd = CFindMatching(program, fileIndex, genericProbe);
		decl.isGeneric = true;
	}
	for (usize:i = decl.receiverStart; i < decl.receiverEnd; i++) {
		if (CIsOperator(program, fileIndex, i, OperatorKind::Less)) {
			decl.isGeneric = true;
		}
	}
	Status:params = CParseParams(program, &decl, fileIndex, groupStart + 1, groupEnd);
	if (params != Status::Ok) {
		return(params);
	}
	Status:status = CAddDecl(program, &decl);
	outEnd[0] = blockEnd + 1;
	if (outEnd[0] < count && CIsPunctuation(program, fileIndex, outEnd[0], PunctuationKind::Semicolon)) {
		outEnd[0] += 1;
	}
	return(status);
}

Status:CParseDeclarations(ptr<CProgram>:program) {
	for (usize:fileIndex = 0; fileIndex < program.tokenFiles.len; fileIndex++) {
		usize:index = 0;
		usize:count = CFileTokenCount(program, fileIndex);
		while (index < count && !CIsEof(program, fileIndex, index)) {
			index = CSkipAttributes(program, fileIndex, index);
			if (index >= count || CIsEof(program, fileIndex, index)) {
				break;
			}
			usize:next = index + 1;
			Status:status = Status::Ok;
			if (CIsPunctuation(program, fileIndex, index, PunctuationKind::Hash)) {
				usize:groupStart = CFindNextGroup(program, fileIndex, index, count);
				if (groupStart < count) {
					next = CSkipDelimited(program, fileIndex, groupStart);
					if (next < count && CIsPunctuation(program, fileIndex, next, PunctuationKind::Semicolon)) {
						next += 1;
					}
				}
			} else {
				if (CIsKeyword(program, fileIndex, index, KeywordKind::Extern)) {
					status = CParseExternDecl(program, fileIndex, index, &next);
				} else {
					if (CIsKeyword(program, fileIndex, index, KeywordKind::Alias) || CIsIdentifierText(program, fileIndex, index, "alias")) {
						status = CParseAliasDecl(program, fileIndex, index, &next);
					} else {
						if (CIsKeyword(program, fileIndex, index, KeywordKind::Struct) || CIsIdentifierText(program, fileIndex, index, "struct")) {
							status = CParseTypeDecl(program, fileIndex, index, CDeclKind::Struct, &next);
						} else {
							if (CIsKeyword(program, fileIndex, index, KeywordKind::Union) || CIsIdentifierText(program, fileIndex, index, "union")) {
								status = CParseTypeDecl(program, fileIndex, index, CDeclKind::Union, &next);
							} else {
								if (CIsKeyword(program, fileIndex, index, KeywordKind::Enum) || CIsIdentifierText(program, fileIndex, index, "enum")) {
									status = CParseTypeDecl(program, fileIndex, index, CDeclKind::Enum, &next);
								} else {
									status = CParseFunctionDecl(program, fileIndex, index, &next);
								}
							}
						}
					}
				}
			}
			if (status != Status::Ok) {
				return(status);
			}
			if (next <= index) {
				next = index + 1;
			}
			index = next;
		}
	}
	return(Status::Ok);
}

bool:CMarkDeclReachable(ptr<CDecl>:decl) {
	if (decl.reachable) {
		return(false);
	}
	decl.reachable = true;
	return(true);
}

bool:CMarkReachableRoots(ptr<CProgram>:program) {
	bool:changed = false;
	for (usize:i = 0; i < program.decls.len; i++) {
		ptr<CDecl>:decl = &program.decls.data[i];
		if (decl.fileIndex == 0 && decl.kind != CDeclKind::ExternC && !decl.isGeneric) {
			if (CMarkDeclReachable(decl)) {
				changed = true;
			}
		}
	}
	return(changed);
}

bool:CMarkNamedDeclsReachable(ptr<CProgram>:program, String:name) {
	bool:changed = false;
	for (usize:i = 0; i < program.decls.len; i++) {
		ptr<CDecl>:decl = &program.decls.data[i];
		if (decl.kind == CDeclKind::ExternC || decl.isOperator) {
			continue;
		}
		if (CDeclNameMatches(program, decl, name)) {
			if (CMarkDeclReachable(decl)) {
				changed = true;
			}
		}
	}
	return(changed);
}

bool:CMarkOperatorDeclsReachable(ptr<CProgram>:program, u8:operatorCode) {
	if (operatorCode == 0) {
		return(false);
	}
	bool:changed = false;
	for (usize:i = 0; i < program.decls.len; i++) {
		ptr<CDecl>:decl = &program.decls.data[i];
		if (decl.kind == CDeclKind::Function && decl.isOperator && decl.operatorCode == operatorCode) {
			if (CMarkDeclReachable(decl)) {
				changed = true;
			}
		}
	}
	return(changed);
}

bool:CMarkReferencesInRange(ptr<CProgram>:program, usize:fileIndex, usize:start, usize:end) {
	bool:changed = false;
	for (usize:i = start; i < end; i++) {
		Token:token = program.tokenFiles.data[fileIndex].tokens[i];
		if (token.kind == TokenKind::Identifier || token.kind == TokenKind::Keyword) {
			if (CMarkNamedDeclsReachable(program, CTokenText(program, fileIndex, i))) {
				changed = true;
			}
		}
		if (token.kind == TokenKind::Operator) {
			if (CMarkOperatorDeclsReachable(program, COperatorCode(program, fileIndex, i))) {
				changed = true;
			}
		}
	}
	return(changed);
}

Status:CMarkReachableDecls(ptr<CProgram>:program) {
	bool:changed = CMarkReachableRoots(program);
	while (changed) {
		changed = false;
		for (usize:i = 0; i < program.decls.len; i++) {
			ptr<CDecl>:decl = &program.decls.data[i];
			if (!decl.reachable) {
				continue;
			}
			if (CMarkReferencesInRange(program, decl.fileIndex, decl.start, decl.end)) {
				changed = true;
			}
		}
	}
	return(Status::Ok);
}

Status:CWriteTokenRangeRaw(ptr<CProgram>:program, ptr<StringBuilder>:out, usize:fileIndex, usize:start, usize:end) {
	for (usize:i = start; i < end; i++) {
		Status:status = CWriteToken(program, out, fileIndex, i);
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(Status::Ok);
}

bool:CIsBuiltinTypeName(String:name) {
	return(name.EqualsCString("void")
		|| name.EqualsCString("bool")
		|| name.EqualsCString("int")
		|| name.EqualsCString("u8")
		|| name.EqualsCString("u16")
		|| name.EqualsCString("u32")
		|| name.EqualsCString("u64")
		|| name.EqualsCString("i8")
		|| name.EqualsCString("i16")
		|| name.EqualsCString("i32")
		|| name.EqualsCString("i64")
		|| name.EqualsCString("f32")
		|| name.EqualsCString("f64")
		|| name.EqualsCString("ptr")
		|| name.EqualsCString("str")
		|| name.EqualsCString("byte")
		|| name.EqualsCString("usize")
		|| name.EqualsCString("isize")
		|| name.EqualsCString("RawHandle"));
}

Status:CWriteSanitized(ptr<StringBuilder>:out, String:text) {
	for (usize:i = 0; i < text.len; i++) {
		byte:c = text.data[i];
		if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_') {
			Status:status = out.WriteByte(c);
			if (status != Status::Ok) {
				return(status);
			}
		} else {
			Status:status = out.WriteByte('_');
			if (status != Status::Ok) {
				return(status);
			}
		}
	}
	return(Status::Ok);
}

Status:CWriteOperatorName(ptr<StringBuilder>:out, u8:operatorCode) {
	u64:kind = cast<u64>(operatorCode);
	if (kind == cast<u64>(OperatorKind::Plus) + 1) {
		return(out.WriteCString("plus"));
	}
	if (kind == cast<u64>(OperatorKind::Minus) + 1) {
		return(out.WriteCString("minus"));
	}
	if (kind == cast<u64>(OperatorKind::Equal) + 1) {
		return(out.WriteCString("equal"));
	}
	if (kind == cast<u64>(OperatorKind::PlusAssign) + 1) {
		return(out.WriteCString("plus_assign"));
	}
	if (kind == cast<u64>(OperatorKind::MinusAssign) + 1) {
		return(out.WriteCString("minus_assign"));
	}
	if (kind == cast<u64>(OperatorKind::Less) + 1) {
		return(out.WriteCString("less"));
	}
	if (kind == cast<u64>(OperatorKind::Greater) + 1) {
		return(out.WriteCString("greater"));
	}
	return(out.WriteCString("op"));
}

bool:CDeclPackageIsRoot(ptr<CDecl>:decl) {
	String:packageName = std::OwnedStringView(&decl.packageName);
	String:moduleName = std::OwnedStringView(&decl.moduleName);
	return(packageName.len == 0 && moduleName.len == 0);
}

Status:CWriteDeclCName(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CDecl>:decl) {
	if (decl.hasReceiver) {
		Status:status = CWriteTypeSuffixFromRange(program, out, decl.fileIndex, decl.receiverStart, decl.receiverEnd);
		if (status != Status::Ok) {
			return(status);
		}
		status = out.WriteByte('_');
		if (status != Status::Ok) {
			return(status);
		}
		if (decl.isOperator) {
			status = out.WriteCString("operator_");
			if (status == Status::Ok) {
				status = CWriteOperatorName(out, decl.operatorCode);
			}
			if (status == Status::Ok) {
				status = out.WriteCString("_");
			}
			if (status == Status::Ok) {
				status = std::FormatU64ToBuilder(out, cast<u64>(decl.paramCount), 10);
			}
			return(status);
		}
		return(CWriteToken(program, out, decl.fileIndex, decl.nameIndex));
	}
	String:packageName = std::OwnedStringView(&decl.packageName);
	String:moduleName = std::OwnedStringView(&decl.moduleName);
	if (packageName.len > 0) {
		Status:status = out.WriteString(packageName);
		if (status != Status::Ok) {
			return(status);
		}
		status = out.WriteByte('_');
		if (status != Status::Ok) {
			return(status);
		}
	}
	if (moduleName.len > 0) {
		Status:status = out.WriteString(moduleName);
		if (status != Status::Ok) {
			return(status);
		}
		status = out.WriteByte('_');
		if (status != Status::Ok) {
			return(status);
		}
	}
	Status:nameStatus = CWriteToken(program, out, decl.fileIndex, decl.nameIndex);
	if (nameStatus != Status::Ok) {
		return(nameStatus);
	}
	if (decl.isGeneric && decl.genericStart < CFileTokenCount(program, decl.fileIndex)) {
		return(Status::Ok);
	}
	return(Status::Ok);
}

Status:CWriteTypeSuffixFromRange(ptr<CProgram>:program, ptr<StringBuilder>:out, usize:fileIndex, usize:start, usize:end) {
	if (start >= end) {
		return(Status::Ok);
	}
	if (start + 1 < end && CIsOperator(program, fileIndex, start + 1, OperatorKind::Less)) {
		Status:status = CWriteSanitized(out, CTokenText(program, fileIndex, start));
		if (status != Status::Ok) {
			return(status);
		}
		usize:genericEnd = CFindMatching(program, fileIndex, start + 1);
		usize:argStart = start + 2;
		while (argStart < genericEnd) {
			usize:argEnd = CFindTokenAtDepthZero(program, fileIndex, argStart, genericEnd, PunctuationKind::Comma);
			status = out.WriteCString("__");
			if (status != Status::Ok) {
				return(status);
			}
			status = CWriteTypeSuffixFromRange(program, out, fileIndex, argStart, argEnd);
			if (status != Status::Ok) {
				return(status);
			}
			if (argEnd >= genericEnd) {
				break;
			}
			argStart = argEnd + 1;
		}
		return(Status::Ok);
	}
	return(CWriteSanitized(out, CTokenText(program, fileIndex, start)));
}

Status:CTypeInfoDestroy(ptr<CTypeInfo>:info) {
	std::DestroyOwnedString(&info.key);
	std::DestroyOwnedString(&info.cType);
	std::DestroyOwnedString(&info.baseName);
	std::DestroyOwnedString(&info.arg0);
	std::DestroyOwnedString(&info.arg1);
	std::DestroyOwnedString(&info.arg2);
	return(Status::Ok);
}

Status:CTypeInfoInitEmpty(ptr<CProgram>:program, ptr<CTypeInfo>:info) {
	Status:status = CMakeOwnedEmpty(program, &info.key);
	if (status == Status::Ok) {
		status = CMakeOwnedEmpty(program, &info.cType);
	}
	if (status == Status::Ok) {
		status = CMakeOwnedEmpty(program, &info.baseName);
	}
	if (status == Status::Ok) {
		status = CMakeOwnedEmpty(program, &info.arg0);
	}
	if (status == Status::Ok) {
		status = CMakeOwnedEmpty(program, &info.arg1);
	}
	if (status == Status::Ok) {
		status = CMakeOwnedEmpty(program, &info.arg2);
	}
	info.argCount = 0;
	info.isPointer = false;
	return(status);
}

Status:CReplaceOwned(ptr<OwnedString>:target, OwnedString:value) {
	std::DestroyOwnedString(target);
	target.data = value.data;
	target.len = value.len;
	target.cap = value.cap;
	target.allocator = value.allocator;
	return(Status::Ok);
}

Status:CBuildTypeKey(ptr<CProgram>:program, usize:fileIndex, usize:start, usize:end, ptr<OwnedString>:out) {
	StringBuilder:builder = std::StringBuilderNew(program.allocator);
	Status:status = CWriteTypeSuffixFromRange(program, &builder, fileIndex, start, end);
	if (status == Status::Ok) {
		status = CDetachBuilder(&builder, out);
	}
	builder.Destroy();
	return(status);
}

Status:CWriteCTypeFromKey(ptr<CProgram>:program, ptr<StringBuilder>:out, String:key) {
	if (key.EqualsCString("f32")) {
		return(out.WriteCString("float"));
	}
	if (key.EqualsCString("f64")) {
		return(out.WriteCString("double"));
	}
	if (key.EqualsCString("ptr")) {
		return(out.WriteCString("ptr"));
	}
	if (key.EqualsCString("str")) {
		return(out.WriteCString("str"));
	}
	if (CIsBuiltinTypeName(key)) {
		return(out.WriteString(key));
	}
	Result<usize>:ptrMarker = key.FindByte('*');
	if (ptrMarker.status == Status::Ok) {
		return(out.WriteString(key));
	}
	ptr<CDecl>:decl = CFindTypeDecl(program, key);
	if (decl != 0) {
		if (decl.kind == CDeclKind::Struct) {
			Status:status = out.WriteCString("struct ");
			if (status == Status::Ok) {
				status = out.WriteString(key);
			}
			return(status);
		}
		return(out.WriteString(key));
	}
	for (usize:i = 0; i < program.typeUses.len; i++) {
		String:useKey = std::OwnedStringView(&program.typeUses.data[i].key);
		if (useKey.Equals(key)) {
			ptr<CDecl>:baseDecl = CFindTypeDecl(program, std::OwnedStringView(&program.typeUses.data[i].baseName));
			if (baseDecl != 0 && baseDecl.kind == CDeclKind::Struct) {
				Status:status = out.WriteCString("struct ");
				if (status == Status::Ok) {
					status = out.WriteString(key);
				}
				return(status);
			}
			return(out.WriteString(key));
		}
	}
	if (key.len > 0 && key.data[0] >= 'A' && key.data[0] <= 'Z') {
		Status:status = out.WriteCString("struct ");
		if (status == Status::Ok) {
			status = out.WriteString(key);
		}
		return(status);
	}
	return(out.WriteString(key));
}

Status:CMakeCTypeFromKey(ptr<CProgram>:program, String:key, ptr<OwnedString>:out) {
	StringBuilder:builder = std::StringBuilderNew(program.allocator);
	Status:status = CWriteCTypeFromKey(program, &builder, key);
	if (status == Status::Ok) {
		status = CDetachBuilder(&builder, out);
	}
	builder.Destroy();
	return(status);
}

Status:CTypeInfoFromKey(ptr<CProgram>:program, String:key, ptr<CTypeInfo>:info) {
	Status:status = CTypeInfoInitEmpty(program, info);
	if (status != Status::Ok) {
		return(status);
	}
	OwnedString:keyOwned;
	status = CCloneString(program, key, &keyOwned);
	if (status == Status::Ok) {
		status = CReplaceOwned(&info.key, keyOwned);
	}
	OwnedString:cOwned;
	if (status == Status::Ok) {
		status = CMakeCTypeFromKey(program, key, &cOwned);
	}
	if (status == Status::Ok) {
		status = CReplaceOwned(&info.cType, cOwned);
	}
	Result<usize>:ptrMarker = key.FindByte('*');
	info.isPointer = ptrMarker.status == Status::Ok;
	return(status);
}

Status:CRenderTypeInfo(ptr<CProgram>:program, usize:fileIndex, usize:start, usize:end, ptr<CTypeInfo>:info) {
	Status:status = CTypeInfoInitEmpty(program, info);
	if (status != Status::Ok) {
		return(status);
	}
	if (start >= end) {
		return(Status::Ok);
	}
	String:first = CTokenText(program, fileIndex, start);
	if (first.EqualsCString("ptr") && start + 1 < end && CIsOperator(program, fileIndex, start + 1, OperatorKind::Less)) {
		usize:genericEnd = CFindMatching(program, fileIndex, start + 1);
		CTypeInfo:inner;
		status = CRenderTypeInfo(program, fileIndex, start + 2, genericEnd, &inner);
		if (status != Status::Ok) {
			return(status);
		}
		StringBuilder:key = std::StringBuilderNew(program.allocator);
		status = key.WriteString(std::OwnedStringView(&inner.key));
		if (status == Status::Ok) {
			status = key.WriteByte('*');
		}
		OwnedString:keyOwned;
		if (status == Status::Ok) {
			status = CDetachBuilder(&key, &keyOwned);
		}
		key.Destroy();
		if (status == Status::Ok) {
			status = CReplaceOwned(&info.key, keyOwned);
		}
		StringBuilder:cType = std::StringBuilderNew(program.allocator);
		if (status == Status::Ok) {
			status = cType.WriteString(std::OwnedStringView(&inner.cType));
		}
		if (status == Status::Ok) {
			status = cType.WriteByte('*');
		}
		OwnedString:cOwned;
		if (status == Status::Ok) {
			status = CDetachBuilder(&cType, &cOwned);
		}
		cType.Destroy();
		if (status == Status::Ok) {
			status = CReplaceOwned(&info.cType, cOwned);
		}
		info.isPointer = true;
		CTypeInfoDestroy(&inner);
		return(status);
	}
	status = CBuildTypeKey(program, fileIndex, start, end, &info.key);
	if (status != Status::Ok) {
		return(status);
	}
	if (start + 1 < end && CIsOperator(program, fileIndex, start + 1, OperatorKind::Less)) {
		status = CCloneString(program, first, &info.baseName);
		if (status != Status::Ok) {
			return(status);
		}
		usize:genericEnd = CFindMatching(program, fileIndex, start + 1);
		usize:argStart = start + 2;
		while (argStart < genericEnd) {
			usize:argEnd = CFindTokenAtDepthZero(program, fileIndex, argStart, genericEnd, PunctuationKind::Comma);
			CTypeInfo:argInfo;
			status = CRenderTypeInfo(program, fileIndex, argStart, argEnd, &argInfo);
			if (status != Status::Ok) {
				return(status);
			}
			if (info.argCount == 0) {
				OwnedString:cloneArg;
				status = CCloneString(program, std::OwnedStringView(&argInfo.key), &cloneArg);
				if (status == Status::Ok) {
					status = CReplaceOwned(&info.arg0, cloneArg);
				}
			} else {
				if (info.argCount == 1) {
					OwnedString:cloneArg1;
					status = CCloneString(program, std::OwnedStringView(&argInfo.key), &cloneArg1);
					if (status == Status::Ok) {
						status = CReplaceOwned(&info.arg1, cloneArg1);
					}
				} else {
					if (info.argCount == 2) {
						OwnedString:cloneArg2;
						status = CCloneString(program, std::OwnedStringView(&argInfo.key), &cloneArg2);
						if (status == Status::Ok) {
							status = CReplaceOwned(&info.arg2, cloneArg2);
						}
					}
				}
			}
			info.argCount += 1;
			CTypeInfoDestroy(&argInfo);
			if (status != Status::Ok) {
				return(status);
			}
			if (argEnd >= genericEnd) {
				break;
			}
			argStart = argEnd + 1;
		}
	}
	status = CMakeCTypeFromKey(program, std::OwnedStringView(&info.key), &info.cType);
	return(status);
}

bool:CTypeUseExists(ptr<CProgram>:program, String:key) {
	for (usize:i = 0; i < program.typeUses.len; i++) {
		String:useKey = std::OwnedStringView(&program.typeUses.data[i].key);
		if (useKey.Equals(key)) {
			return(true);
		}
	}
	return(false);
}

Status:CAddTypeUse(ptr<CProgram>:program, ptr<CTypeInfo>:info) {
	if (info.argCount == 0) {
		return(Status::Ok);
	}
	String:key = std::OwnedStringView(&info.key);
	if (CTypeUseExists(program, key)) {
		return(Status::Ok);
	}
	Status:status = CReserveTypeUses(program, 1);
	if (status != Status::Ok) {
		return(status);
	}
	ptr<CTypeUse>:use = &program.typeUses.data[program.typeUses.len];
	status = CCloneString(program, key, &use.key);
	if (status == Status::Ok) {
		status = CCloneString(program, std::OwnedStringView(&info.cType), &use.cName);
	}
	if (status == Status::Ok) {
		status = CCloneString(program, std::OwnedStringView(&info.baseName), &use.baseName);
	}
	if (status == Status::Ok) {
		status = CCloneString(program, std::OwnedStringView(&info.arg0), &use.arg0);
	}
	if (status == Status::Ok) {
		status = CCloneString(program, std::OwnedStringView(&info.arg1), &use.arg1);
	}
	if (status == Status::Ok) {
		status = CCloneString(program, std::OwnedStringView(&info.arg2), &use.arg2);
	}
	use.argCount = info.argCount;
	use.emitted = false;
	if (status == Status::Ok) {
		program.typeUses.len += 1;
	}
	return(status);
}

Status:CAddTypeUseFromBaseArg(ptr<CProgram>:program, str:baseName, String:arg0) {
	StringBuilder:keyBuilder = std::StringBuilderNew(program.allocator);
	Status:status = keyBuilder.WriteCString(baseName);
	if (status == Status::Ok) {
		status = keyBuilder.WriteCString("__");
	}
	if (status == Status::Ok) {
		status = keyBuilder.WriteString(arg0);
	}
	String:key = keyBuilder.View();
	if (status == Status::Ok && CTypeUseExists(program, key)) {
		keyBuilder.Destroy();
		return(Status::Ok);
	}
	if (status == Status::Ok) {
		status = CReserveTypeUses(program, 1);
	}
	if (status != Status::Ok) {
		keyBuilder.Destroy();
		return(status);
	}
	ptr<CTypeUse>:use = &program.typeUses.data[program.typeUses.len];
	if (status == Status::Ok) {
		status = CCloneString(program, key, &use.key);
	}
	if (status == Status::Ok) {
		status = CCloneString(program, key, &use.cName);
	}
	if (status == Status::Ok) {
		status = CCloneString(program, std::StringFromCString(baseName), &use.baseName);
	}
	if (status == Status::Ok) {
		status = CCloneString(program, arg0, &use.arg0);
	}
	if (status == Status::Ok) {
		status = CMakeOwnedEmpty(program, &use.arg1);
	}
	if (status == Status::Ok) {
		status = CMakeOwnedEmpty(program, &use.arg2);
	}
	use.argCount = 1;
	use.emitted = false;
	if (status == Status::Ok) {
		program.typeUses.len += 1;
	}
	keyBuilder.Destroy();
	return(status);
}

bool:CConcreteTypeKey(ptr<CProgram>:program, String:key) {
	if (key.len == 0) {
		return(false);
	}
	if (CIsBuiltinTypeName(key)) {
		return(true);
	}
	if (key.ContainsByte('*')) {
		return(true);
	}
	if (CFindTypeDecl(program, key) != 0) {
		return(true);
	}
	for (usize:i = 0; i < program.typeUses.len; i++) {
		String:useKey = std::OwnedStringView(&program.typeUses.data[i].key);
		if (useKey.Equals(key)) {
			return(true);
		}
	}
	return(false);
}

bool:CTypeInfoConcrete(ptr<CProgram>:program, ptr<CTypeInfo>:info) {
	if (info.argCount == 0) {
		return(CConcreteTypeKey(program, std::OwnedStringView(&info.key)));
	}
	if (info.argCount >= 1 && !CConcreteTypeKey(program, std::OwnedStringView(&info.arg0))) {
		return(false);
	}
	if (info.argCount >= 2 && !CConcreteTypeKey(program, std::OwnedStringView(&info.arg1))) {
		return(false);
	}
	if (info.argCount >= 3 && !CConcreteTypeKey(program, std::OwnedStringView(&info.arg2))) {
		return(false);
	}
	return(true);
}

Status:CCollectTypeUsesInRange(ptr<CProgram>:program, usize:fileIndex, usize:start, usize:end) {
	usize:i = start;
	while (i < end) {
		if (i + 1 < end && CIsOperator(program, fileIndex, i + 1, OperatorKind::Less)) {
			String:name = CTokenText(program, fileIndex, i);
			ptr<CDecl>:decl = CFindTypeDecl(program, name);
			if (decl != 0 && decl.isGeneric) {
				usize:genericEnd = CFindMatching(program, fileIndex, i + 1);
				CTypeInfo:info;
				Status:status = CRenderTypeInfo(program, fileIndex, i, genericEnd + 1, &info);
				if (status != Status::Ok) {
					return(status);
				}
				if (CTypeInfoConcrete(program, &info)) {
					status = CAddTypeUse(program, &info);
				}
				CTypeInfoDestroy(&info);
				if (status != Status::Ok) {
					return(status);
				}
				i = genericEnd + 1;
				continue;
			}
		}
		i += 1;
	}
	return(Status::Ok);
}

bool:CDeclScopeMatches(ptr<CDecl>:decl, String:scopeName) {
	if (scopeName.len == 0) {
		return(true);
	}
	String:declPackage = std::OwnedStringView(&decl.packageName);
	if (declPackage.Equals(scopeName)) {
		return(true);
	}
	String:declModule = std::OwnedStringView(&decl.moduleName);
	return(declModule.Equals(scopeName));
}

ptr<CDecl>:CFindFunctionDeclByName(ptr<CProgram>:program, String:name, String:scopeName) {
	for (usize:i = 0; i < program.decls.len; i++) {
		ptr<CDecl>:decl = &program.decls.data[i];
		if (decl.kind != CDeclKind::Function) {
			continue;
		}
		if (decl.hasReceiver) {
			continue;
		}
		if (!CDeclNameMatches(program, decl, name)) {
			continue;
		}
		if (CDeclScopeMatches(decl, scopeName)) {
			return(decl);
		}
	}
	return(0);
}

bool:CFuncUseExists(ptr<CProgram>:program, usize:declIndex, String:key) {
	for (usize:i = 0; i < program.funcUses.len; i++) {
		String:useKey = std::OwnedStringView(&program.funcUses.data[i].key);
		if (program.funcUses.data[i].declIndex == declIndex && useKey.Equals(key)) {
			return(true);
		}
	}
	return(false);
}

usize:CDeclIndex(ptr<CProgram>:program, ptr<CDecl>:decl) {
	for (usize:i = 0; i < program.decls.len; i++) {
		if (&program.decls.data[i] == decl) {
			return(i);
		}
	}
	return(program.decls.len);
}

Status:CBuildGenericFuncCName(ptr<CProgram>:program, ptr<CDecl>:decl, ptr<CTypeInfo>:arg0, ptr<CTypeInfo>:arg1, ptr<CTypeInfo>:arg2, usize:argCount, ptr<OwnedString>:out) {
	StringBuilder:builder = std::StringBuilderNew(program.allocator);
	Status:status = Status::Ok;
	if (decl.hasReceiver && argCount >= 1) {
		status = CWriteSanitized(&builder, CTokenText(program, decl.fileIndex, decl.receiverStart));
		if (status == Status::Ok) {
			status = builder.WriteCString("__");
		}
		if (status == Status::Ok) {
			status = builder.WriteString(std::OwnedStringView(&arg0.key));
		}
		if (status == Status::Ok) {
			status = builder.WriteByte('_');
		}
		if (decl.isOperator) {
			if (status == Status::Ok) {
				status = builder.WriteCString("operator_");
			}
			if (status == Status::Ok) {
				status = CWriteOperatorName(&builder, decl.operatorCode);
			}
			if (status == Status::Ok) {
				status = builder.WriteCString("_");
			}
			if (status == Status::Ok) {
				status = std::FormatU64ToBuilder(&builder, cast<u64>(decl.paramCount), 10);
			}
		} else {
			if (status == Status::Ok) {
				status = CWriteToken(program, &builder, decl.fileIndex, decl.nameIndex);
			}
		}
		if (status == Status::Ok) {
			status = CDetachBuilder(&builder, out);
		}
		builder.Destroy();
		return(status);
	}
	status = CWriteDeclCName(program, &builder, decl);
	if (status == Status::Ok && argCount >= 1) {
		status = builder.WriteCString("__");
		if (status == Status::Ok) {
			status = builder.WriteString(std::OwnedStringView(&arg0.key));
		}
	}
	if (status == Status::Ok && argCount >= 2) {
		status = builder.WriteCString("__");
		if (status == Status::Ok) {
			status = builder.WriteString(std::OwnedStringView(&arg1.key));
		}
	}
	if (status == Status::Ok && argCount >= 3) {
		status = builder.WriteCString("__");
		if (status == Status::Ok) {
			status = builder.WriteString(std::OwnedStringView(&arg2.key));
		}
	}
	if (status == Status::Ok) {
		status = CDetachBuilder(&builder, out);
	}
	builder.Destroy();
	return(status);
}

Status:CAddFuncUse(ptr<CProgram>:program, ptr<CDecl>:decl, ptr<CTypeInfo>:arg0, ptr<CTypeInfo>:arg1, ptr<CTypeInfo>:arg2, usize:argCount) {
	if (argCount == 0) {
		return(Status::Ok);
	}
	if (argCount >= 1 && !CTypeInfoConcrete(program, arg0)) {
		return(Status::Ok);
	}
	if (argCount >= 2 && !CTypeInfoConcrete(program, arg1)) {
		return(Status::Ok);
	}
	if (argCount >= 3 && !CTypeInfoConcrete(program, arg2)) {
		return(Status::Ok);
	}
	OwnedString:cName;
	Status:status = CBuildGenericFuncCName(program, decl, arg0, arg1, arg2, argCount, &cName);
	if (status != Status::Ok) {
		return(status);
	}
	usize:declIndex = CDeclIndex(program, decl);
	String:key = std::OwnedStringView(&cName);
	if (CFuncUseExists(program, declIndex, key)) {
		std::DestroyOwnedString(&cName);
		return(Status::Ok);
	}
	status = CReserveFuncUses(program, 1);
	if (status != Status::Ok) {
		std::DestroyOwnedString(&cName);
		return(status);
	}
	ptr<CFuncUse>:use = &program.funcUses.data[program.funcUses.len];
	use.declIndex = declIndex;
	status = CCloneString(program, key, &use.key);
	if (status == Status::Ok) {
		use.cName = cName;
	} else {
		std::DestroyOwnedString(&cName);
	}
	if (status == Status::Ok && argCount >= 1) {
		status = CCloneString(program, std::OwnedStringView(&arg0.key), &use.arg0);
	} else {
		if (status == Status::Ok) {
			status = CMakeOwnedEmpty(program, &use.arg0);
		}
	}
	if (status == Status::Ok && argCount >= 2) {
		status = CCloneString(program, std::OwnedStringView(&arg1.key), &use.arg1);
	} else {
		if (status == Status::Ok) {
			status = CMakeOwnedEmpty(program, &use.arg1);
		}
	}
	if (status == Status::Ok && argCount >= 3) {
		status = CCloneString(program, std::OwnedStringView(&arg2.key), &use.arg2);
	} else {
		if (status == Status::Ok) {
			status = CMakeOwnedEmpty(program, &use.arg2);
		}
	}
	use.argCount = argCount;
	use.emitted = false;
	if (status == Status::Ok) {
		program.funcUses.len += 1;
	}
	return(status);
}

Status:CCollectGenericFunctionUsesInRange(ptr<CProgram>:program, usize:fileIndex, usize:start, usize:end) {
	usize:i = start;
	while (i < end) {
		if (i + 2 < end && CIsOperator(program, fileIndex, i + 1, OperatorKind::Less)) {
			usize:genericEnd = CFindMatching(program, fileIndex, i + 1);
			if (genericEnd + 1 < end && CIsPunctuation(program, fileIndex, genericEnd + 1, PunctuationKind::LeftParen)) {
				String:name = CTokenText(program, fileIndex, i);
				String:scopeName = std::StringFromCString("");
				if (i >= 2 && CIsOperator(program, fileIndex, i - 1, OperatorKind::Scope)) {
					scopeName = CTokenText(program, fileIndex, i - 2);
				}
				ptr<CDecl>:decl = CFindFunctionDeclByName(program, name, scopeName);
				if (decl != 0 && decl.isGeneric) {
					CTypeInfo:arg0;
					CTypeInfo:arg1;
					CTypeInfo:arg2;
					CTypeInfoInitEmpty(program, &arg0);
					CTypeInfoInitEmpty(program, &arg1);
					CTypeInfoInitEmpty(program, &arg2);
					usize:argCount = 0;
					usize:argStart = i + 2;
					Status:status = Status::Ok;
					while (argStart < genericEnd) {
						usize:argEnd = CFindTokenAtDepthZero(program, fileIndex, argStart, genericEnd, PunctuationKind::Comma);
						if (argCount == 0) {
							status = CRenderTypeInfo(program, fileIndex, argStart, argEnd, &arg0);
						} else {
							if (argCount == 1) {
								status = CRenderTypeInfo(program, fileIndex, argStart, argEnd, &arg1);
							} else {
								if (argCount == 2) {
									status = CRenderTypeInfo(program, fileIndex, argStart, argEnd, &arg2);
								}
							}
						}
						argCount += 1;
						if (status != Status::Ok || argEnd >= genericEnd) {
							break;
						}
						argStart = argEnd + 1;
					}
					if (status == Status::Ok) {
						status = CAddFuncUse(program, decl, &arg0, &arg1, &arg2, argCount);
					}
					CTypeInfoDestroy(&arg0);
					CTypeInfoDestroy(&arg1);
					CTypeInfoDestroy(&arg2);
					if (status != Status::Ok) {
						return(status);
					}
				}
				i = genericEnd + 1;
				continue;
			}
		}
		i += 1;
	}
	return(Status::Ok);
}

ptr<CDecl>:CFindGenericMethodDecl(ptr<CProgram>:program, String:receiverBase, str:methodName) {
	for (usize:i = 0; i < program.decls.len; i++) {
		ptr<CDecl>:decl = &program.decls.data[i];
		if (decl.kind != CDeclKind::Function || !decl.hasReceiver || !decl.isGeneric || decl.isOperator) {
			continue;
		}
		String:base = CTokenText(program, decl.fileIndex, decl.receiverStart);
		if (!base.Equals(receiverBase)) {
			continue;
		}
		String:name = CTokenText(program, decl.fileIndex, decl.nameIndex);
		if (name.EqualsCString(methodName)) {
			return(decl);
		}
	}
	return(0);
}

Status:CAddGenericMethodUseByName(ptr<CProgram>:program, ptr<CTypeUse>:typeUse, str:methodName) {
	String:baseName = std::OwnedStringView(&typeUse.baseName);
	ptr<CDecl>:decl = CFindGenericMethodDecl(program, baseName, methodName);
	if (decl == 0) {
		return(Status::Ok);
	}
	CTypeInfo:arg0;
	CTypeInfo:arg1;
	CTypeInfo:arg2;
	bool:arg0Ready = false;
	bool:arg1Ready = false;
	bool:arg2Ready = false;
	Status:status = CTypeInfoInitEmpty(program, &arg1);
	if (status == Status::Ok) {
		arg1Ready = true;
	}
	if (status == Status::Ok) {
		status = CTypeInfoInitEmpty(program, &arg2);
	}
	if (status == Status::Ok) {
		arg2Ready = true;
	}
	if (status == Status::Ok) {
		status = CTypeInfoFromKey(program, std::OwnedStringView(&typeUse.arg0), &arg0);
	}
	if (status == Status::Ok) {
		arg0Ready = true;
	}
	if (status == Status::Ok) {
		status = CAddFuncUse(program, decl, &arg0, &arg1, &arg2, 1);
	}
	if (arg0Ready) {
		CTypeInfoDestroy(&arg0);
	}
	if (arg1Ready) {
		CTypeInfoDestroy(&arg1);
	}
	if (arg2Ready) {
		CTypeInfoDestroy(&arg2);
	}
	return(status);
}

bool:CMethodCallNameUsed(ptr<CProgram>:program, str:methodName) {
	for (usize:i = 0; i < program.decls.len; i++) {
		ptr<CDecl>:decl = &program.decls.data[i];
		if (!decl.reachable) {
			continue;
		}
		for (usize:j = decl.start; j + 2 < decl.end; j++) {
			if (!CIsPunctuation(program, decl.fileIndex, j, PunctuationKind::Dot)) {
				continue;
			}
			if (!CTokenEquals(program, decl.fileIndex, j + 1, methodName)) {
				continue;
			}
			if (CIsPunctuation(program, decl.fileIndex, j + 2, PunctuationKind::LeftParen)) {
				return(true);
			}
		}
	}
	return(false);
}

Status:CCollectGenericCollectionMethods(ptr<CProgram>:program) {
	bool:arrayDestroyUsed = CMethodCallNameUsed(program, "Destroy");
	bool:arrayClearUsed = CMethodCallNameUsed(program, "Clear");
	bool:arrayReserveUsed = CMethodCallNameUsed(program, "Reserve");
	bool:arrayAppendSliceUsed = CMethodCallNameUsed(program, "AppendSlice");
	bool:arrayPushUsed = CMethodCallNameUsed(program, "Push");
	bool:arrayPushZeroedUsed = CMethodCallNameUsed(program, "PushZeroed");
	bool:arrayPopUsed = CMethodCallNameUsed(program, "Pop");
	bool:arrayGetUsed = CMethodCallNameUsed(program, "Get");
	bool:arraySetUsed = CMethodCallNameUsed(program, "Set");
	bool:arrayGetPtrUsed = CMethodCallNameUsed(program, "GetPtr");
	bool:arrayLastPtrUsed = CMethodCallNameUsed(program, "LastPtr");
	bool:arraySpanUsed = CMethodCallNameUsed(program, "Span");
	bool:arraySliceUsed = CMethodCallNameUsed(program, "Slice");
	usize:typeUseLimit = program.typeUses.len;
	for (usize:i = 0; i < typeUseLimit; i++) {
		CTypeUse:useValue = program.typeUses.data[i];
		ptr<CTypeUse>:use = &useValue;
		String:base = std::OwnedStringView(&use.baseName);
		if (use.argCount < 1) {
			continue;
		}
		Status:status = Status::Ok;
		if (base.EqualsCString("Array")) {
			if (status == Status::Ok && (arrayPopUsed || arrayGetUsed)) { status = CAddTypeUseFromBaseArg(program, "Result", std::OwnedStringView(&use.arg0)); }
			if (status == Status::Ok && (arrayAppendSliceUsed || arraySliceUsed)) { status = CAddTypeUseFromBaseArg(program, "Slice", std::OwnedStringView(&use.arg0)); }
			if (status == Status::Ok && arraySpanUsed) { status = CAddTypeUseFromBaseArg(program, "Span", std::OwnedStringView(&use.arg0)); }
			if (status == Status::Ok && arrayDestroyUsed) { status = CAddGenericMethodUseByName(program, use, "Destroy"); }
			if (status == Status::Ok && arrayClearUsed) { status = CAddGenericMethodUseByName(program, use, "Clear"); }
			if (status == Status::Ok && (arrayReserveUsed || arrayAppendSliceUsed || arrayPushUsed || arrayPushZeroedUsed)) { status = CAddGenericMethodUseByName(program, use, "Reserve"); }
			if (status == Status::Ok && arrayAppendSliceUsed) { status = CAddGenericMethodUseByName(program, use, "AppendSlice"); }
			if (status == Status::Ok && arrayPushUsed) { status = CAddGenericMethodUseByName(program, use, "Push"); }
			if (status == Status::Ok && arrayPushZeroedUsed) { status = CAddGenericMethodUseByName(program, use, "PushZeroed"); }
			if (status == Status::Ok && arrayPopUsed) { status = CAddGenericMethodUseByName(program, use, "Pop"); }
			if (status == Status::Ok && arrayGetUsed) { status = CAddGenericMethodUseByName(program, use, "Get"); }
			if (status == Status::Ok && arraySetUsed) { status = CAddGenericMethodUseByName(program, use, "Set"); }
			if (status == Status::Ok && arrayGetPtrUsed) { status = CAddGenericMethodUseByName(program, use, "GetPtr"); }
			if (status == Status::Ok && arrayLastPtrUsed) { status = CAddGenericMethodUseByName(program, use, "LastPtr"); }
			if (status == Status::Ok && arraySpanUsed) { status = CAddGenericMethodUseByName(program, use, "Span"); }
			if (status == Status::Ok && arraySliceUsed) { status = CAddGenericMethodUseByName(program, use, "Slice"); }
		} else {
			if (base.EqualsCString("LinkedList")) {
				status = CAddTypeUseFromBaseArg(program, "ListNode", std::OwnedStringView(&use.arg0));
				if (status == Status::Ok) { status = CAddTypeUseFromBaseArg(program, "Result", std::OwnedStringView(&use.arg0)); }
				if (status == Status::Ok) { status = CAddGenericMethodUseByName(program, use, "PushBack"); }
				if (status == Status::Ok) { status = CAddGenericMethodUseByName(program, use, "PushFront"); }
				if (status == Status::Ok) { status = CAddGenericMethodUseByName(program, use, "PopBack"); }
				if (status == Status::Ok) { status = CAddGenericMethodUseByName(program, use, "Destroy"); }
				if (status == Status::Ok) { status = CAddGenericMethodUseByName(program, use, "PopFront"); }
			}
		}
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(Status::Ok);
}

Status:CCollectGenericFunctionUses(ptr<CProgram>:program) {
	for (usize:i = 0; i < program.decls.len; i++) {
		ptr<CDecl>:decl = &program.decls.data[i];
		if (!decl.reachable) {
			continue;
		}
		Status:status = CCollectGenericFunctionUsesInRange(program, decl.fileIndex, decl.start, decl.end);
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(CCollectGenericCollectionMethods(program));
}

Status:CCollectTypeUses(ptr<CProgram>:program) {
	for (usize:i = 0; i < program.decls.len; i++) {
		ptr<CDecl>:decl = &program.decls.data[i];
		if (!decl.reachable) {
			continue;
		}
		Status:status = CCollectTypeUsesInRange(program, decl.fileIndex, decl.start, decl.end);
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(Status::Ok);
}

Status:CWritePrelude(ptr<StringBuilder>:out) {
	Status:status = out.WriteCString("#include <assert.h>");
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("#include <stdint.h>"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("#include <stddef.h>"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("#include <stdbool.h>"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef uint8_t u8;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef uint16_t u16;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef uint32_t u32;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef uint64_t u64;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef int8_t i8;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef int16_t i16;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef int32_t i32;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef int64_t i64;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef float f32;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef double f64;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef void* ptr;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef const char* str;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	return(status);
}

Status:CWriteDeclarator(ptr<CProgram>:program, ptr<StringBuilder>:out, usize:fileIndex, usize:typeStart, usize:typeEnd, usize:nameIndex, bool:isArray, usize:arrayStart, usize:arrayEnd) {
	CTypeInfo:info;
	Status:status = CRenderTypeInfo(program, fileIndex, typeStart, typeEnd, &info);
	if (status != Status::Ok) {
		return(status);
	}
	status = out.WriteString(std::OwnedStringView(&info.cType));
	if (status == Status::Ok) {
		status = out.WriteByte(' ');
	}
	if (status == Status::Ok) {
		status = CWriteToken(program, out, fileIndex, nameIndex);
	}
	if (status == Status::Ok && isArray) {
		status = out.WriteByte('[');
		if (status == Status::Ok) {
			status = CWriteTokenRangeRaw(program, out, fileIndex, arrayStart, arrayEnd);
		}
		if (status == Status::Ok) {
			status = out.WriteByte(']');
		}
	}
	CTypeInfoDestroy(&info);
	return(status);
}

Status:CWriteFields(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CDecl>:decl) {
	for (usize:i = 0; i < decl.fieldCount; i++) {
		ptr<CField>:field = &program.fields.data[decl.firstField + i];
		Status:status = out.WriteCString("    ");
		if (status != Status::Ok) {
			return(status);
		}
		if (field.isNestedStruct) {
			status = out.WriteCString("struct {\n");
			if (status != Status::Ok) {
				return(status);
			}
			CDecl:nested;
			nested.kind = CDeclKind::Struct;
			nested.fileIndex = field.fileIndex;
			nested.bodyStart = field.nestedBodyStart;
			nested.bodyEnd = field.nestedBodyEnd;
			nested.firstField = program.fields.len;
			nested.fieldCount = 0;
			nested.nameIndex = field.nameIndex;
			nested.isGeneric = false;
			Status:parseNested = CParseFields(program, &nested, field.fileIndex, field.nestedBodyStart, field.nestedBodyEnd);
			if (parseNested != Status::Ok) {
				return(parseNested);
			}
			status = CWriteFields(program, out, &nested);
			if (status != Status::Ok) {
				return(status);
			}
			status = out.WriteCString("    } ");
			if (status == Status::Ok) {
				status = CWriteToken(program, out, field.fileIndex, field.nameIndex);
			}
			if (status == Status::Ok) {
				status = out.WriteCString(";\n");
			}
			return(status);
		}
		status = CWriteDeclarator(program, out, field.fileIndex, field.typeStart, field.typeEnd, field.nameIndex, field.isArray, field.arrayStart, field.arrayEnd);
		if (status == Status::Ok) {
			status = out.WriteCString(";\n");
		}
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(Status::Ok);
}

bool:CGenericParamEquals(ptr<CProgram>:program, ptr<CDecl>:decl, usize:paramIndex, String:name) {
	if (!decl.isGeneric) {
		return(false);
	}
	if (decl.genericStart < CFileTokenCount(program, decl.fileIndex)) {
		usize:index = decl.genericStart + 1;
		usize:current = 0;
		while (index < decl.genericEnd) {
			if (CIsPunctuation(program, decl.fileIndex, index, PunctuationKind::Comma)) {
				index += 1;
				continue;
			}
			if (current == paramIndex) {
				String:paramName = CTokenText(program, decl.fileIndex, index);
				return(paramName.Equals(name));
			}
			current += 1;
			while (index < decl.genericEnd && !CIsPunctuation(program, decl.fileIndex, index, PunctuationKind::Comma)) {
				index += 1;
			}
		}
	}
	if (decl.hasReceiver && decl.receiverStart + 1 < decl.receiverEnd
		&& CIsOperator(program, decl.fileIndex, decl.receiverStart + 1, OperatorKind::Less)) {
		usize:genericEnd = CFindMatching(program, decl.fileIndex, decl.receiverStart + 1);
		usize:index = decl.receiverStart + 2;
		usize:current = 0;
		while (index < genericEnd) {
			if (CIsPunctuation(program, decl.fileIndex, index, PunctuationKind::Comma)) {
				index += 1;
				continue;
			}
			if (current == paramIndex) {
				String:paramName = CTokenText(program, decl.fileIndex, index);
				return(paramName.Equals(name));
			}
			current += 1;
			while (index < genericEnd && !CIsPunctuation(program, decl.fileIndex, index, PunctuationKind::Comma)) {
				index += 1;
			}
		}
	}
	return(false);
}

Status:CWriteTypeSuffixSubst(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CDecl>:decl, ptr<CTypeUse>:use, usize:fileIndex, usize:start, usize:end) {
	if (start >= end) {
		return(Status::Ok);
	}
	String:first = CTokenText(program, fileIndex, start);
	if (end == start + 1) {
		if (CGenericParamEquals(program, decl, 0, first)) {
			return(out.WriteString(std::OwnedStringView(&use.arg0)));
		}
		if (CGenericParamEquals(program, decl, 1, first)) {
			return(out.WriteString(std::OwnedStringView(&use.arg1)));
		}
		if (CGenericParamEquals(program, decl, 2, first)) {
			return(out.WriteString(std::OwnedStringView(&use.arg2)));
		}
		return(CWriteSanitized(out, first));
	}
	if (start + 1 < end && CIsOperator(program, fileIndex, start + 1, OperatorKind::Less)) {
		Status:status = CWriteSanitized(out, first);
		usize:genericEnd = CFindMatching(program, fileIndex, start + 1);
		usize:argStart = start + 2;
		while (argStart < genericEnd) {
			usize:argEnd = CFindTokenAtDepthZero(program, fileIndex, argStart, genericEnd, PunctuationKind::Comma);
			if (status == Status::Ok) {
				status = out.WriteCString("__");
			}
			if (status == Status::Ok) {
				status = CWriteTypeSuffixSubst(program, out, decl, use, fileIndex, argStart, argEnd);
			}
			if (status != Status::Ok || argEnd >= genericEnd) {
				break;
			}
			argStart = argEnd + 1;
		}
		return(status);
	}
	return(CWriteTypeSuffixFromRange(program, out, fileIndex, start, end));
}

Status:CMakeSubstTypeKey(ptr<CProgram>:program, ptr<CDecl>:decl, ptr<CTypeUse>:use, usize:fileIndex, usize:start, usize:end, ptr<OwnedString>:out) {
	StringBuilder:builder = std::StringBuilderNew(program.allocator);
	Status:status = CWriteTypeSuffixSubst(program, &builder, decl, use, fileIndex, start, end);
	if (status == Status::Ok) {
		status = CDetachBuilder(&builder, out);
	}
	builder.Destroy();
	return(status);
}

Status:CWriteDeclaratorSubst(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CDecl>:decl, ptr<CTypeUse>:use, usize:fileIndex, usize:typeStart, usize:typeEnd, usize:nameIndex, bool:isArray, usize:arrayStart, usize:arrayEnd) {
	String:first = CTokenText(program, fileIndex, typeStart);
	OwnedString:key;
	Status:status = Status::Ok;
	if (first.EqualsCString("ptr") && typeStart + 1 < typeEnd && CIsOperator(program, fileIndex, typeStart + 1, OperatorKind::Less)) {
		usize:genericEnd = CFindMatching(program, fileIndex, typeStart + 1);
		OwnedString:innerKey;
		status = CMakeSubstTypeKey(program, decl, use, fileIndex, typeStart + 2, genericEnd, &innerKey);
		StringBuilder:ct = std::StringBuilderNew(program.allocator);
		if (status == Status::Ok) {
			status = CWriteCTypeFromKey(program, &ct, std::OwnedStringView(&innerKey));
		}
		if (status == Status::Ok) {
			status = ct.WriteByte('*');
		}
		if (status == Status::Ok) {
			status = out.WriteString(ct.View());
		}
		ct.Destroy();
		std::DestroyOwnedString(&innerKey);
	} else {
		status = CMakeSubstTypeKey(program, decl, use, fileIndex, typeStart, typeEnd, &key);
		if (status == Status::Ok) {
			status = CWriteCTypeFromKey(program, out, std::OwnedStringView(&key));
		}
		if (status == Status::Ok) {
			std::DestroyOwnedString(&key);
		}
	}
	if (status == Status::Ok) {
		status = out.WriteByte(' ');
	}
	if (status == Status::Ok) {
		status = CWriteToken(program, out, fileIndex, nameIndex);
	}
	if (status == Status::Ok && isArray) {
		status = out.WriteByte('[');
		if (status == Status::Ok) {
			status = CWriteTokenRangeRaw(program, out, fileIndex, arrayStart, arrayEnd);
		}
		if (status == Status::Ok) {
			status = out.WriteByte(']');
		}
	}
	return(status);
}

Status:CWriteFieldsSubst(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CDecl>:decl, ptr<CTypeUse>:use) {
	for (usize:i = 0; i < decl.fieldCount; i++) {
		ptr<CField>:field = &program.fields.data[decl.firstField + i];
		Status:status = out.WriteCString("    ");
		if (status == Status::Ok) {
			status = CWriteDeclaratorSubst(program, out, decl, use, field.fileIndex, field.typeStart, field.typeEnd, field.nameIndex, field.isArray, field.arrayStart, field.arrayEnd);
		}
		if (status == Status::Ok) {
			status = out.WriteCString(";\n");
		}
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(Status::Ok);
}

Status:CWriteStructDecl(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CDecl>:decl, String:specializedName) {
	Status:status = out.WriteCString("struct ");
	bool:hasPacked = false;
	bool:hasAligned = false;
	usize:alignedValue = 0;
	if (decl.start > 0) {
		usize:scan = decl.start;
		while (scan > 0) {
			scan -= 1;
			if (CIsPunctuation(program, decl.fileIndex, scan, PunctuationKind::LeftBracket)) {
				for (usize:i = scan; i < decl.start; i++) {
					if (CIsIdentifierText(program, decl.fileIndex, i, "packed")) {
						hasPacked = true;
					}
					if (CIsIdentifierText(program, decl.fileIndex, i, "aligned")) {
						hasAligned = true;
						if (i + 2 < decl.start && CIsPunctuation(program, decl.fileIndex, i + 1, PunctuationKind::LeftParen)) {
							alignedValue = i + 2;
						}
					}
				}
				break;
			}
			if (CIsPunctuation(program, decl.fileIndex, scan, PunctuationKind::Semicolon)
				|| CIsPunctuation(program, decl.fileIndex, scan, PunctuationKind::RightBrace)) {
				break;
			}
		}
	}
	if (status == Status::Ok && (hasPacked || hasAligned)) {
		status = out.WriteCString("__attribute__((");
		if (status == Status::Ok && hasPacked) {
			status = out.WriteCString("packed");
		}
		if (status == Status::Ok && hasAligned) {
			if (hasPacked) {
				status = out.WriteByte(',');
			}
			if (status == Status::Ok) {
				status = out.WriteCString("aligned(");
			}
			if (status == Status::Ok && alignedValue != 0) {
				status = CWriteToken(program, out, decl.fileIndex, alignedValue);
			}
			if (status == Status::Ok) {
				status = out.WriteByte(')');
			}
		}
		if (status == Status::Ok) {
			status = out.WriteCString(")) ");
		}
	}
	if (status != Status::Ok) {
		return(status);
	}
	if (specializedName.len > 0) {
		status = out.WriteString(specializedName);
	} else {
		status = CWriteToken(program, out, decl.fileIndex, decl.nameIndex);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(" {\n");
	}
	if (status == Status::Ok) {
		status = CWriteFields(program, out, decl);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("};\n");
	}
	return(status);
}

Status:CWriteUnionDecl(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CDecl>:decl) {
	Status:status = out.WriteCString("typedef union ");
	if (status == Status::Ok) {
		status = CWriteToken(program, out, decl.fileIndex, decl.nameIndex);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(" {\n");
	}
	if (status == Status::Ok) {
		status = CWriteFields(program, out, decl);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("} ");
	}
	if (status == Status::Ok) {
		status = CWriteToken(program, out, decl.fileIndex, decl.nameIndex);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(";\n");
	}
	return(status);
}

Status:CWriteEnumDecl(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CDecl>:decl) {
	Status:status = out.WriteCString("typedef enum ");
	if (status == Status::Ok) {
		status = CWriteToken(program, out, decl.fileIndex, decl.nameIndex);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(" {\n");
	}
	usize:i = decl.bodyStart;
	while (i < decl.bodyEnd) {
		if (CIsPunctuation(program, decl.fileIndex, i, PunctuationKind::Comma)) {
			i += 1;
			continue;
		}
		if (!CIsTokenKind(program, decl.fileIndex, i, TokenKind::Identifier)) {
			i += 1;
			continue;
		}
		status = out.WriteCString("    ");
		if (status == Status::Ok) {
			status = CWriteToken(program, out, decl.fileIndex, decl.nameIndex);
		}
		if (status == Status::Ok) {
			status = out.WriteByte('_');
		}
		if (status == Status::Ok) {
			status = CWriteToken(program, out, decl.fileIndex, i);
		}
		i += 1;
		if (i < decl.bodyEnd && CIsOperator(program, decl.fileIndex, i, OperatorKind::Assign)) {
			status = out.WriteByte('=');
			i += 1;
			while (i < decl.bodyEnd && !CIsPunctuation(program, decl.fileIndex, i, PunctuationKind::Comma)) {
				if (status == Status::Ok) {
					status = CWriteToken(program, out, decl.fileIndex, i);
				}
				i += 1;
			}
		}
		if (status == Status::Ok) {
			status = out.WriteCString(",\n");
		}
		if (status != Status::Ok) {
			return(status);
		}
	}
	status = out.WriteCString("} ");
	if (status == Status::Ok) {
		status = CWriteToken(program, out, decl.fileIndex, decl.nameIndex);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(";\n");
	}
	return(status);
}

Status:CWriteAliasDecl(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CDecl>:decl) {
	CTypeInfo:info;
	Status:status = CRenderTypeInfo(program, decl.fileIndex, decl.returnStart, decl.returnEnd, &info);
	if (status == Status::Ok) {
		status = out.WriteCString("typedef ");
	}
	if (status == Status::Ok) {
		status = out.WriteString(std::OwnedStringView(&info.cType));
	}
	if (status == Status::Ok) {
		status = out.WriteByte(' ');
	}
	if (status == Status::Ok) {
		status = CWriteToken(program, out, decl.fileIndex, decl.nameIndex);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(";\n");
	}
	CTypeInfoDestroy(&info);
	return(status);
}

Status:CWriteExternDecl(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CDecl>:decl) {
	ptr<CTokenFile>:file = &program.tokenFiles.data[decl.fileIndex];
	Token:open = file.tokens[decl.bodyStart - 1];
	Token:close = file.tokens[decl.bodyEnd];
	usize:start = open.offset + open.length;
	usize:end = close.offset;
	if (end < start) {
		return(Status::Ok);
	}
	String:sourceText = file.sourceText;
	Status:status = out.WriteCString("#if defined(__GNUC__) || defined(__clang__)\n#pragma GCC diagnostic push\n#pragma GCC diagnostic ignored ");
	if (status == Status::Ok) {
		status = out.WriteByte(34);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("-Wunused-function");
	}
	if (status == Status::Ok) {
		status = out.WriteByte(34);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("\n#endif\n");
	}
	if (status == Status::Ok) {
		status = out.WriteString(sourceText.Slice(start, end - start));
	}
	if (status == Status::Ok) {
		status = out.WriteCString("\n#if defined(__GNUC__) || defined(__clang__)\n#pragma GCC diagnostic pop\n#endif");
	}
	if (status == Status::Ok) {
		status = out.WriteByte('\n');
	}
	return(status);
}

Status:CWriteTypeUseDeclaration(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CTypeUse>:use) {
	if (use.emitted) {
		return(Status::Ok);
	}
	ptr<CDecl>:decl = CFindTypeDecl(program, std::OwnedStringView(&use.baseName));
	if (decl == 0 || decl.kind != CDeclKind::Struct) {
		return(Status::Ok);
	}
	Status:status = out.WriteCString("struct ");
	if (status == Status::Ok) {
		status = out.WriteString(std::OwnedStringView(&use.key));
	}
	if (status == Status::Ok) {
		status = out.WriteCString(" {\n");
	}
	if (status == Status::Ok) {
		status = CWriteFieldsSubst(program, out, decl, use);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("};\n");
	}
	if (status == Status::Ok) {
		use.emitted = true;
	}
	return(status);
}

Status:CWriteTypeUsesForArg(ptr<CProgram>:program, ptr<StringBuilder>:out, String:argName) {
	for (usize:i = 0; i < program.typeUses.len; i++) {
		ptr<CTypeUse>:use = &program.typeUses.data[i];
		if (use.emitted || use.argCount == 0) {
			continue;
		}
		String:arg0 = std::OwnedStringView(&use.arg0);
		if (arg0.Equals(argName)) {
			Status:status = CWriteTypeUseDeclaration(program, out, use);
			if (status != Status::Ok) {
				return(status);
			}
		}
	}
	return(Status::Ok);
}

bool:CShouldWritePlainTypeDecl(ptr<CDecl>:decl) {
	return(decl.kind == CDeclKind::Alias
		|| (decl.kind == CDeclKind::Struct && !decl.isGeneric)
		|| decl.kind == CDeclKind::Union
		|| decl.kind == CDeclKind::Enum);
}

bool:CTypeKeyReady(ptr<CProgram>:program, String:key) {
	String:name = key;
	while (name.len > 0 && name.data[name.len - 1] == '*') {
		name = name.Slice(0, name.len - 1);
	}
	ptr<CDecl>:decl = CFindTypeDecl(program, name);
	if (decl != 0 && !decl.isGeneric) {
		return(decl.emitted);
	}
	for (usize:i = 0; i < program.typeUses.len; i++) {
		String:useKey = std::OwnedStringView(&program.typeUses.data[i].key);
		if (useKey.Equals(name)) {
			return(program.typeUses.data[i].emitted);
		}
	}
	return(true);
}

bool:CTypeRangeReady(ptr<CProgram>:program, usize:fileIndex, usize:start, usize:end) {
	for (usize:i = start; i < end; i++) {
		Token:token = program.tokenFiles.data[fileIndex].tokens[i];
		if (!(token.kind == TokenKind::Identifier || token.kind == TokenKind::Keyword)) {
			continue;
		}
		ptr<CDecl>:decl = CFindTypeDecl(program, CTokenText(program, fileIndex, i));
		if (decl != 0 && decl.isGeneric && i + 1 < end && CIsOperator(program, fileIndex, i + 1, OperatorKind::Less)) {
			usize:genericEnd = CFindMatching(program, fileIndex, i + 1);
			OwnedString:key;
			Status:status = CBuildTypeKey(program, fileIndex, i, genericEnd + 1, &key);
			if (status == Status::Ok) {
				bool:ready = CTypeKeyReady(program, std::OwnedStringView(&key));
				std::DestroyOwnedString(&key);
				if (!ready) {
					return(false);
				}
			}
			i = genericEnd;
			continue;
		}
		if (decl == 0 || decl.isGeneric) {
			continue;
		}
		if (!decl.emitted) {
			return(false);
		}
	}
	return(true);
}

bool:CTypeUseRangeReady(ptr<CProgram>:program, ptr<CDecl>:decl, ptr<CTypeUse>:use, usize:fileIndex, usize:start, usize:end) {
	for (usize:i = start; i < end; i++) {
		Token:token = program.tokenFiles.data[fileIndex].tokens[i];
		if (!(token.kind == TokenKind::Identifier || token.kind == TokenKind::Keyword)) {
			continue;
		}
		String:name = CTokenText(program, fileIndex, i);
		bool:genericParam = false;
		if (use.argCount >= 1 && CGenericParamEquals(program, decl, 0, name)) {
			if (!CTypeKeyReady(program, std::OwnedStringView(&use.arg0))) {
				return(false);
			}
			genericParam = true;
		}
		if (!genericParam && use.argCount >= 2 && CGenericParamEquals(program, decl, 1, name)) {
			if (!CTypeKeyReady(program, std::OwnedStringView(&use.arg1))) {
				return(false);
			}
			genericParam = true;
		}
		if (!genericParam && use.argCount >= 3 && CGenericParamEquals(program, decl, 2, name)) {
			if (!CTypeKeyReady(program, std::OwnedStringView(&use.arg2))) {
				return(false);
			}
			genericParam = true;
		}
		if (genericParam) {
			continue;
		}
		ptr<CDecl>:typeDecl = CFindTypeDecl(program, name);
		if (typeDecl == 0 || typeDecl.isGeneric) {
			continue;
		}
		if (!typeDecl.emitted) {
			return(false);
		}
	}
	return(true);
}

bool:CTypeDeclDependenciesReady(ptr<CProgram>:program, ptr<CDecl>:decl) {
	if (decl.kind == CDeclKind::Alias) {
		return(CTypeRangeReady(program, decl.fileIndex, decl.returnStart, decl.returnEnd));
	}
	if (decl.kind == CDeclKind::Struct || decl.kind == CDeclKind::Union) {
		for (usize:i = 0; i < decl.fieldCount; i++) {
			ptr<CField>:field = &program.fields.data[decl.firstField + i];
			if (field.isNestedStruct) {
				if (!CTypeRangeReady(program, field.fileIndex, field.nestedBodyStart, field.nestedBodyEnd)) {
					return(false);
				}
			} else {
				if (!CTypeRangeReady(program, field.fileIndex, field.typeStart, field.typeEnd)) {
					return(false);
				}
			}
		}
	}
	return(true);
}

bool:CTypeUseDependenciesReady(ptr<CProgram>:program, ptr<CTypeUse>:use) {
	if (use.argCount >= 1 && !CTypeKeyReady(program, std::OwnedStringView(&use.arg0))) {
		return(false);
	}
	if (use.argCount >= 2 && !CTypeKeyReady(program, std::OwnedStringView(&use.arg1))) {
		return(false);
	}
	if (use.argCount >= 3 && !CTypeKeyReady(program, std::OwnedStringView(&use.arg2))) {
		return(false);
	}
	ptr<CDecl>:decl = CFindTypeDecl(program, std::OwnedStringView(&use.baseName));
	if (decl == 0 || decl.kind != CDeclKind::Struct) {
		return(true);
	}
	for (usize:i = 0; i < decl.fieldCount; i++) {
		ptr<CField>:field = &program.fields.data[decl.firstField + i];
		if (field.isNestedStruct) {
			if (!CTypeUseRangeReady(program, decl, use, field.fileIndex, field.nestedBodyStart, field.nestedBodyEnd)) {
				return(false);
			}
		} else {
			if (!CTypeUseRangeReady(program, decl, use, field.fileIndex, field.typeStart, field.typeEnd)) {
				return(false);
			}
		}
	}
	return(true);
}

Status:CWritePlainTypeDeclaration(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CDecl>:decl) {
	Status:status = Status::Ok;
	if (decl.kind == CDeclKind::Alias) {
		status = CWriteAliasDecl(program, out, decl);
	} else {
		if (decl.kind == CDeclKind::Struct && !decl.isGeneric) {
			status = CWriteStructDecl(program, out, decl, std::StringFromCString(""));
		} else {
			if (decl.kind == CDeclKind::Union) {
				status = CWriteUnionDecl(program, out, decl);
			} else {
				if (decl.kind == CDeclKind::Enum) {
					status = CWriteEnumDecl(program, out, decl);
				}
			}
		}
	}
	if (status == Status::Ok) {
		decl.emitted = true;
	}
	return(status);
}

Status:CWriteTypeDeclarations(ptr<CProgram>:program, ptr<StringBuilder>:out) {
	for (usize:i = 0; i < program.decls.len; i++) {
		ptr<CDecl>:decl = &program.decls.data[i];
		if (decl.kind == CDeclKind::ExternC) {
			Status:status = CWriteExternDecl(program, out, decl);
			if (status != Status::Ok) {
				return(status);
			}
			decl.emitted = true;
		}
	}
	bool:progress = true;
	while (progress) {
		progress = false;
		for (usize:i = 0; i < program.decls.len; i++) {
			ptr<CDecl>:decl = &program.decls.data[i];
			if (!decl.reachable || decl.emitted || !CShouldWritePlainTypeDecl(decl)) {
				continue;
			}
			if (!CTypeDeclDependenciesReady(program, decl)) {
				continue;
			}
			Status:status = CWritePlainTypeDeclaration(program, out, decl);
			if (status != Status::Ok) {
				return(status);
			}
			progress = true;
		}
		for (usize:i = 0; i < program.typeUses.len; i++) {
			ptr<CTypeUse>:use = &program.typeUses.data[i];
			if (use.emitted || !CTypeUseDependenciesReady(program, use)) {
				continue;
			}
			Status:status = CWriteTypeUseDeclaration(program, out, use);
			if (status != Status::Ok) {
				return(status);
			}
			if (use.emitted) {
				progress = true;
			}
		}
	}
	for (usize:i = 0; i < program.decls.len; i++) {
		ptr<CDecl>:decl = &program.decls.data[i];
		if (decl.reachable && !decl.emitted && CShouldWritePlainTypeDecl(decl)) {
			Status:status = CWritePlainTypeDeclaration(program, out, decl);
			if (status != Status::Ok) {
				return(status);
			}
		}
	}
	for (usize:i = 0; i < program.typeUses.len; i++) {
		ptr<CTypeUse>:use = &program.typeUses.data[i];
		Status:status = CWriteTypeUseDeclaration(program, out, use);
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(Status::Ok);
}

Status:CEnvInit(ptr<CProgram>:program, ptr<CEnv>:env) {
	env.locals = std::ArrayNew<CLocal>(program.allocator);
	env.hasThis = false;
	env.deferCounter = 0;
	env.eachCounter = 0;
	Status:status = CMakeOwnedEmpty(program, &env.returnTypeKey);
	if (status == Status::Ok) {
		status = CMakeOwnedEmpty(program, &env.returnCType);
	}
	if (status == Status::Ok) {
		status = CMakeOwnedEmpty(program, &env.thisTypeKey);
	}
	if (status == Status::Ok) {
		status = CMakeOwnedEmpty(program, &env.thisCType);
	}
	return(status);
}

Status:CEnvDestroy(ptr<CEnv>:env) {
	for (usize:i = 0; i < env.locals.len; i++) {
		std::DestroyOwnedString(&env.locals.data[i].name);
		std::DestroyOwnedString(&env.locals.data[i].typeKey);
		std::DestroyOwnedString(&env.locals.data[i].cType);
		std::DestroyOwnedString(&env.locals.data[i].arrayLen);
	}
	Array<CLocal>:locals = env.locals;
	Status:status = locals.Destroy();
	env.locals = locals;
	std::DestroyOwnedString(&env.returnTypeKey);
	std::DestroyOwnedString(&env.returnCType);
	std::DestroyOwnedString(&env.thisTypeKey);
	std::DestroyOwnedString(&env.thisCType);
	return(status);
}

ptr<CLocal>:CEnvFind(ptr<CEnv>:env, String:name) {
	for (usize:i = env.locals.len; i > 0; i--) {
		ptr<CLocal>:local = &env.locals.data[i - 1];
		String:localName = std::OwnedStringView(&local.name);
		if (localName.Equals(name)) {
			return(local);
		}
	}
	return(0);
}

Status:CEnvAdd(ptr<CProgram>:program, ptr<CEnv>:env, String:name, String:typeKey, String:cType, bool:isArray, String:arrayLen, bool:isPointer) {
	Status:status = CReserveLocals(env, 1);
	if (status != Status::Ok) {
		return(status);
	}
	ptr<CLocal>:local = &env.locals.data[env.locals.len];
	status = CCloneString(program, name, &local.name);
	if (status == Status::Ok) {
		status = CCloneString(program, typeKey, &local.typeKey);
	}
	if (status == Status::Ok) {
		status = CCloneString(program, cType, &local.cType);
	}
	if (status == Status::Ok) {
		status = CCloneString(program, arrayLen, &local.arrayLen);
	}
	local.isArray = isArray;
	local.isPointer = isPointer;
	if (status == Status::Ok) {
		env.locals.len += 1;
	}
	return(status);
}

Status:CExprInitEmpty(ptr<CProgram>:program, ptr<CExpr>:expr) {
	Status:status = CMakeOwnedEmpty(program, &expr.text);
	if (status == Status::Ok) {
		status = CMakeOwnedEmpty(program, &expr.typeKey);
	}
	if (status == Status::Ok) {
		status = CMakeOwnedEmpty(program, &expr.cType);
	}
	if (status == Status::Ok) {
		status = CMakeOwnedEmpty(program, &expr.arrayLen);
	}
	expr.isArray = false;
	expr.isLvalue = false;
	expr.isPointer = false;
	return(status);
}

Status:CExprDestroy(ptr<CExpr>:expr) {
	std::DestroyOwnedString(&expr.text);
	std::DestroyOwnedString(&expr.typeKey);
	std::DestroyOwnedString(&expr.cType);
	std::DestroyOwnedString(&expr.arrayLen);
	return(Status::Ok);
}

Status:CExprSetText(ptr<CProgram>:program, ptr<CExpr>:expr, String:text) {
	OwnedString:owned;
	Status:status = CCloneString(program, text, &owned);
	if (status != Status::Ok) {
		return(status);
	}
	return(CReplaceOwned(&expr.text, owned));
}

Status:CExprSetCString(ptr<CProgram>:program, ptr<CExpr>:expr, str:text) {
	OwnedString:owned;
	Status:status = CCloneCString(program, text, &owned);
	if (status != Status::Ok) {
		return(status);
	}
	return(CReplaceOwned(&expr.text, owned));
}

Status:CExprSetType(ptr<CProgram>:program, ptr<CExpr>:expr, String:key, String:cType, bool:isPointer) {
	OwnedString:keyOwned;
	Status:status = CCloneString(program, key, &keyOwned);
	if (status == Status::Ok) {
		status = CReplaceOwned(&expr.typeKey, keyOwned);
	}
	OwnedString:cOwned;
	if (status == Status::Ok) {
		status = CCloneString(program, cType, &cOwned);
	}
	if (status == Status::Ok) {
		status = CReplaceOwned(&expr.cType, cOwned);
	}
	expr.isPointer = isPointer;
	return(status);
}

Status:CExprFromBuilder(ptr<CExpr>:expr, ptr<StringBuilder>:builder) {
	OwnedString:owned;
	Status:status = CDetachBuilder(builder, &owned);
	if (status != Status::Ok) {
		return(status);
	}
	return(CReplaceOwned(&expr.text, owned));
}

u8:COperatorPrecedence(ptr<CProgram>:program, usize:fileIndex, usize:index) {
	if (CIsOperator(program, fileIndex, index, OperatorKind::Assign)
		|| CIsOperator(program, fileIndex, index, OperatorKind::PlusAssign)
		|| CIsOperator(program, fileIndex, index, OperatorKind::MinusAssign)) {
		return(1);
	}
	if (CIsOperator(program, fileIndex, index, OperatorKind::LogicalOr)) {
		return(2);
	}
	if (CIsOperator(program, fileIndex, index, OperatorKind::LogicalAnd)) {
		return(3);
	}
	if (CIsOperator(program, fileIndex, index, OperatorKind::Equal)
		|| CIsOperator(program, fileIndex, index, OperatorKind::NotEqual)
		|| CIsOperator(program, fileIndex, index, OperatorKind::Less)
		|| CIsOperator(program, fileIndex, index, OperatorKind::LessEqual)
		|| CIsOperator(program, fileIndex, index, OperatorKind::Greater)
		|| CIsOperator(program, fileIndex, index, OperatorKind::GreaterEqual)) {
		return(4);
	}
	if (CIsOperator(program, fileIndex, index, OperatorKind::Plus)
		|| CIsOperator(program, fileIndex, index, OperatorKind::Minus)) {
		return(5);
	}
	if (CIsOperator(program, fileIndex, index, OperatorKind::Multiply)
		|| CIsOperator(program, fileIndex, index, OperatorKind::Divide)
		|| CIsOperator(program, fileIndex, index, OperatorKind::Modulo)) {
		return(6);
	}
	return(0);
}

bool:COperatorRightAssociative(ptr<CProgram>:program, usize:fileIndex, usize:index) {
	return(CIsOperator(program, fileIndex, index, OperatorKind::Assign)
		|| CIsOperator(program, fileIndex, index, OperatorKind::PlusAssign)
		|| CIsOperator(program, fileIndex, index, OperatorKind::MinusAssign));
}

Status:CWriteNumberToken(ptr<CProgram>:program, ptr<StringBuilder>:out, usize:fileIndex, usize:index) {
	String:text = CTokenText(program, fileIndex, index);
	if (text.len > 2 && text.data[0] == '0' && (text.data[1] == 'b' || text.data[1] == 'B')) {
		u64:value = 0;
		for (usize:i = 2; i < text.len; i++) {
			if (text.data[i] == '_') {
				continue;
			}
			if (text.data[i] == '0' || text.data[i] == '1') {
				value = value * 2 + cast<u64>(text.data[i] - '0');
			}
		}
		Status:status = out.WriteCString("0x");
		if (status == Status::Ok) {
			status = std::FormatU64ToBuilder(out, value, 16);
		}
		return(status);
	}
	for (usize:i = 0; i < text.len; i++) {
		if (text.data[i] != '_') {
			Status:status = out.WriteByte(text.data[i]);
			if (status != Status::Ok) {
				return(status);
			}
		}
	}
	return(Status::Ok);
}

ptr<CDecl>:CFindFieldDecl(ptr<CProgram>:program, String:typeKey) {
	for (usize:i = 0; i < program.decls.len; i++) {
		ptr<CDecl>:decl = &program.decls.data[i];
		if ((decl.kind == CDeclKind::Struct || decl.kind == CDeclKind::Union) && CDeclNameMatches(program, decl, typeKey)) {
			return(decl);
		}
	}
	for (usize:i = 0; i < program.typeUses.len; i++) {
		String:useKey = std::OwnedStringView(&program.typeUses.data[i].key);
		if (useKey.Equals(typeKey)) {
			return(CFindTypeDecl(program, std::OwnedStringView(&program.typeUses.data[i].baseName)));
		}
	}
	return(0);
}

Status:CFieldType(ptr<CProgram>:program, String:typeKey, String:fieldName, ptr<CTypeInfo>:outInfo) {
	CTypeInfoInitEmpty(program, outInfo);
	ptr<CDecl>:decl = CFindFieldDecl(program, typeKey);
	if (decl == 0) {
		return(Status::Ok);
	}
	for (usize:i = 0; i < decl.fieldCount; i++) {
		ptr<CField>:field = &program.fields.data[decl.firstField + i];
		String:fieldToken = CTokenText(program, field.fileIndex, field.nameIndex);
		if (fieldToken.Equals(fieldName)) {
			CTypeInfoDestroy(outInfo);
			return(CRenderTypeInfo(program, field.fileIndex, field.typeStart, field.typeEnd, outInfo));
		}
	}
	return(Status::Ok);
}

ptr<CDecl>:CFindMethod(ptr<CProgram>:program, String:receiverType, String:name, bool:isOperator, u8:operatorCode, usize:argCount) {
	for (usize:i = 0; i < program.decls.len; i++) {
		ptr<CDecl>:decl = &program.decls.data[i];
		if (decl.kind != CDeclKind::Function || !decl.hasReceiver) {
			continue;
		}
		StringBuilder:receiver = std::StringBuilderNew(program.allocator);
		Status:status = CWriteTypeSuffixFromRange(program, &receiver, decl.fileIndex, decl.receiverStart, decl.receiverEnd);
		if (status != Status::Ok) {
			receiver.Destroy();
			continue;
		}
		String:receiverView = receiver.View();
		bool:receiverMatches = receiverView.Equals(receiverType);
		receiver.Destroy();
		if (!receiverMatches) {
			continue;
		}
		if (isOperator) {
			if (decl.isOperator && decl.operatorCode == operatorCode && decl.paramCount == argCount) {
				return(decl);
			}
		} else {
			String:methodName = CTokenText(program, decl.fileIndex, decl.nameIndex);
			if (!decl.isOperator && methodName.Equals(name)) {
				return(decl);
			}
		}
	}
	return(0);
}

Status:CParserInit(ptr<CProgram>:program, ptr<CEnv>:env, usize:fileIndex, usize:start, usize:end, String:expectedKey, String:expectedCType, bool:expectedIsArray, ptr<CExprParser>:parser) {
	parser.program = program;
	parser.env = env;
	parser.fileIndex = fileIndex;
	parser.pos = start;
	parser.end = end;
	parser.expectedIsArray = expectedIsArray;
	Status:status = CCloneString(program, expectedKey, &parser.expectedTypeKey);
	if (status == Status::Ok) {
		status = CCloneString(program, expectedCType, &parser.expectedCType);
	}
	return(status);
}

Status:CParserDestroy(ptr<CExprParser>:parser) {
	std::DestroyOwnedString(&parser.expectedTypeKey);
	std::DestroyOwnedString(&parser.expectedCType);
	return(Status::Ok);
}

Status:CCompileExpressionRange(ptr<CProgram>:program, ptr<CEnv>:env, usize:fileIndex, usize:start, usize:end, String:expectedKey, String:expectedCType, bool:expectedIsArray, ptr<CExpr>:out) {
	CExprParser:parser;
	Status:status = CParserInit(program, env, fileIndex, start, end, expectedKey, expectedCType, expectedIsArray, &parser);
	if (status != Status::Ok) {
		return(status);
	}
	status = CCompileExpression(&parser, 1, out);
	CParserDestroy(&parser);
	return(status);
}

Status:CWriteInitializerList(ptr<CExprParser>:parser, usize:start, usize:end, ptr<StringBuilder>:out) {
	Status:status = out.WriteByte('{');
	usize:itemStart = start;
	while (itemStart < end) {
		if (CIsPunctuation(parser.program, parser.fileIndex, itemStart, PunctuationKind::Comma)) {
			itemStart += 1;
			continue;
		}
		usize:itemEnd = CFindTokenAtDepthZero(parser.program, parser.fileIndex, itemStart, end, PunctuationKind::Comma);
		if (itemStart + 1 < itemEnd && CIsOperator(parser.program, parser.fileIndex, itemStart + 1, OperatorKind::Assign) && CIsTokenKind(parser.program, parser.fileIndex, itemStart, TokenKind::Identifier)) {
			if (status == Status::Ok) {
				status = out.WriteByte('.');
			}
			if (status == Status::Ok) {
				status = CWriteToken(parser.program, out, parser.fileIndex, itemStart);
			}
			if (status == Status::Ok) {
				status = out.WriteByte('=');
			}
			CExpr:value;
			if (status == Status::Ok) {
				status = CCompileExpressionRange(parser.program, parser.env, parser.fileIndex, itemStart + 2, itemEnd, std::StringFromCString(""), std::StringFromCString(""), false, &value);
			}
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&value.text));
			}
			if (status == Status::Ok) {
				CExprDestroy(&value);
			}
		} else {
			CExpr:value;
			if (status == Status::Ok) {
				status = CCompileExpressionRange(parser.program, parser.env, parser.fileIndex, itemStart, itemEnd, std::StringFromCString(""), std::StringFromCString(""), false, &value);
			}
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&value.text));
			}
			if (status == Status::Ok) {
				CExprDestroy(&value);
			}
		}
		if (status != Status::Ok) {
			return(status);
		}
		if (itemEnd >= end) {
			break;
		}
		status = out.WriteByte(',');
		itemStart = itemEnd + 1;
	}
	if (status == Status::Ok) {
		status = out.WriteByte('}');
	}
	return(status);
}

Status:CExprFromLiteralBlock(ptr<CExprParser>:parser, usize:blockStart, usize:blockEnd, ptr<CExpr>:out) {
	Status:status = CExprInitEmpty(parser.program, out);
	if (status != Status::Ok) {
		return(status);
	}
	StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
	String:expectedKey = std::OwnedStringView(&parser.expectedTypeKey);
	String:expectedCType = std::OwnedStringView(&parser.expectedCType);
	if (expectedCType.len > 0 && !parser.expectedIsArray) {
		status = builder.WriteByte('(');
		if (status == Status::Ok) {
			status = builder.WriteString(expectedCType);
		}
		if (status == Status::Ok) {
			status = builder.WriteByte(')');
		}
	}
	if (status == Status::Ok) {
		status = CWriteInitializerList(parser, blockStart + 1, blockEnd, &builder);
	}
	if (status == Status::Ok) {
		status = CExprFromBuilder(out, &builder);
	}
	builder.Destroy();
	if (status == Status::Ok && expectedKey.len > 0) {
		status = CExprSetType(parser.program, out, expectedKey, expectedCType, false);
	}
	return(status);
}

Status:CCompilePrimary(ptr<CExprParser>:parser, ptr<CExpr>:out) {
	Status:status = CExprInitEmpty(parser.program, out);
	if (status != Status::Ok) {
		return(status);
	}
	if (parser.pos >= parser.end) {
		return(Status::Ok);
	}
	usize:index = parser.pos;
	Token:token = parser.program[0].tokenFiles.data[parser.fileIndex].tokens[index];
	if (token.kind == TokenKind::Number) {
		StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
		status = CWriteNumberToken(parser.program, &builder, parser.fileIndex, index);
		if (status == Status::Ok) {
			status = CExprFromBuilder(out, &builder);
		}
		builder.Destroy();
		if (status == Status::Ok) {
			status = CExprSetType(parser.program, out, std::StringFromCString("int"), std::StringFromCString("int"), false);
		}
		parser.pos += 1;
		return(status);
	}
	if (token.kind == TokenKind::String || token.kind == TokenKind::Char) {
		status = CExprSetText(parser.program, out, CTokenText(parser.program, parser.fileIndex, index));
		if (status == Status::Ok) {
			if (token.kind == TokenKind::String) {
				status = CExprSetType(parser.program, out, std::StringFromCString("str"), std::StringFromCString("str"), true);
			} else {
				status = CExprSetType(parser.program, out, std::StringFromCString("int"), std::StringFromCString("int"), false);
			}
		}
		parser.pos += 1;
		return(status);
	}
	if (CIsKeyword(parser.program, parser.fileIndex, index, KeywordKind::True)
		|| CIsKeyword(parser.program, parser.fileIndex, index, KeywordKind::False)) {
		if (CIsKeyword(parser.program, parser.fileIndex, index, KeywordKind::True)) {
			status = CExprSetCString(parser.program, out, "1");
		} else {
			status = CExprSetCString(parser.program, out, "0");
		}
		if (status == Status::Ok) {
			status = CExprSetType(parser.program, out, std::StringFromCString("bool"), std::StringFromCString("bool"), false);
		}
		parser.pos += 1;
		return(status);
	}
	if (CIsPunctuation(parser.program, parser.fileIndex, index, PunctuationKind::LeftParen)) {
		usize:match = CFindMatching(parser.program, parser.fileIndex, index);
		CExpr:inner;
		status = CCompileExpressionRange(parser.program, parser.env, parser.fileIndex, index + 1, match, std::StringFromCString(""), std::StringFromCString(""), false, &inner);
		StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
		if (status == Status::Ok) {
			status = builder.WriteByte('(');
		}
		if (status == Status::Ok) {
			status = builder.WriteString(std::OwnedStringView(&inner.text));
		}
		if (status == Status::Ok) {
			status = builder.WriteByte(')');
		}
		if (status == Status::Ok) {
			status = CExprFromBuilder(out, &builder);
		}
		builder.Destroy();
		if (status == Status::Ok) {
			status = CExprSetType(parser.program, out, std::OwnedStringView(&inner.typeKey), std::OwnedStringView(&inner.cType), inner.isPointer);
			out.isArray = inner.isArray;
			out.isLvalue = inner.isLvalue;
			out.isPointer = inner.isPointer;
		}
		CExprDestroy(&inner);
		parser.pos = match + 1;
		return(status);
	}
	if (CIsPunctuation(parser.program, parser.fileIndex, index, PunctuationKind::LeftBrace)) {
		usize:match = CFindMatching(parser.program, parser.fileIndex, index);
		status = CExprFromLiteralBlock(parser, index, match, out);
		parser.pos = match + 1;
		return(status);
	}
	if (CIsOperator(parser.program, parser.fileIndex, index, OperatorKind::Scope)) {
		if (index + 1 < parser.end) {
			status = CExprSetText(parser.program, out, CTokenText(parser.program, parser.fileIndex, index + 1));
			parser.pos = index + 2;
			return(status);
		}
	}
	if (token.kind == TokenKind::Identifier || token.kind == TokenKind::Keyword) {
		if (index + 2 < parser.end && CIsPunctuation(parser.program, parser.fileIndex, index + 1, PunctuationKind::Colon)
			&& CIsPunctuation(parser.program, parser.fileIndex, index + 2, PunctuationKind::LeftBrace)) {
			usize:blockEnd = CFindMatching(parser.program, parser.fileIndex, index + 2);
			CTypeInfo:typeInfo;
			status = CRenderTypeInfo(parser.program, parser.fileIndex, index, index + 1, &typeInfo);
			StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
			if (status == Status::Ok) {
				status = builder.WriteByte('(');
			}
			if (status == Status::Ok) {
				status = builder.WriteString(std::OwnedStringView(&typeInfo.cType));
			}
			if (status == Status::Ok) {
				status = builder.WriteByte(')');
			}
			if (status == Status::Ok) {
				status = CWriteInitializerList(parser, index + 3, blockEnd, &builder);
			}
			if (status == Status::Ok) {
				status = CExprFromBuilder(out, &builder);
			}
			builder.Destroy();
			if (status == Status::Ok) {
				status = CExprSetType(parser.program, out, std::OwnedStringView(&typeInfo.key), std::OwnedStringView(&typeInfo.cType), typeInfo.isPointer);
			}
			CTypeInfoDestroy(&typeInfo);
			parser.pos = blockEnd + 1;
			return(status);
		}
		if (CIsIdentifierText(parser.program, parser.fileIndex, index, "cast") && index + 1 < parser.end && CIsOperator(parser.program, parser.fileIndex, index + 1, OperatorKind::Less)) {
			usize:genericEnd = CFindMatching(parser.program, parser.fileIndex, index + 1);
			usize:groupStart = genericEnd + 1;
			usize:groupEnd = CFindMatching(parser.program, parser.fileIndex, groupStart);
			CTypeInfo:typeInfo;
			status = CRenderTypeInfo(parser.program, parser.fileIndex, index + 2, genericEnd, &typeInfo);
			CExpr:value;
			if (status == Status::Ok) {
				status = CCompileExpressionRange(parser.program, parser.env, parser.fileIndex, groupStart + 1, groupEnd, std::StringFromCString(""), std::StringFromCString(""), false, &value);
			}
			StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
			if (status == Status::Ok) {
				status = builder.WriteCString("((");
			}
			if (status == Status::Ok) {
				status = builder.WriteString(std::OwnedStringView(&typeInfo.cType));
			}
			if (status == Status::Ok) {
				status = builder.WriteCString(")(");
			}
			if (status == Status::Ok) {
				status = builder.WriteString(std::OwnedStringView(&value.text));
			}
			if (status == Status::Ok) {
				status = builder.WriteCString("))");
			}
			if (status == Status::Ok) {
				status = CExprFromBuilder(out, &builder);
			}
			builder.Destroy();
			if (status == Status::Ok) {
				status = CExprSetType(parser.program, out, std::OwnedStringView(&typeInfo.key), std::OwnedStringView(&typeInfo.cType), typeInfo.isPointer);
			}
			CExprDestroy(&value);
			CTypeInfoDestroy(&typeInfo);
			parser.pos = groupEnd + 1;
			return(status);
		}
		if ((CIsIdentifierText(parser.program, parser.fileIndex, index, "sizeof") || CIsIdentifierText(parser.program, parser.fileIndex, index, "alignof"))
			&& index + 1 < parser.end && CIsPunctuation(parser.program, parser.fileIndex, index + 1, PunctuationKind::LeftParen)) {
			usize:groupEnd = CFindMatching(parser.program, parser.fileIndex, index + 1);
			StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
			bool:isAlign = CIsIdentifierText(parser.program, parser.fileIndex, index, "alignof");
			if (isAlign) {
				status = builder.WriteCString("_Alignof(");
			} else {
				status = builder.WriteCString("sizeof(");
			}
			CTypeInfo:typeInfo;
			if (status == Status::Ok) {
				status = CRenderTypeInfo(parser.program, parser.fileIndex, index + 2, groupEnd, &typeInfo);
			}
			if (status == Status::Ok) {
				status = builder.WriteString(std::OwnedStringView(&typeInfo.cType));
			}
			if (status == Status::Ok) {
				status = builder.WriteByte(')');
			}
			if (status == Status::Ok) {
				status = CExprFromBuilder(out, &builder);
			}
			builder.Destroy();
			CTypeInfoDestroy(&typeInfo);
			if (status == Status::Ok) {
				status = CExprSetType(parser.program, out, std::StringFromCString("usize"), std::StringFromCString("usize"), false);
			}
			parser.pos = groupEnd + 1;
			return(status);
		}
		if (CIsIdentifierText(parser.program, parser.fileIndex, index, "offsetof")
			&& index + 1 < parser.end && CIsPunctuation(parser.program, parser.fileIndex, index + 1, PunctuationKind::LeftParen)) {
			usize:groupEnd = CFindMatching(parser.program, parser.fileIndex, index + 1);
			usize:comma = CFindTokenAtDepthZero(parser.program, parser.fileIndex, index + 2, groupEnd, PunctuationKind::Comma);
			CTypeInfo:typeInfo;
			status = CRenderTypeInfo(parser.program, parser.fileIndex, index + 2, comma, &typeInfo);
			StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
			if (status == Status::Ok) {
				status = builder.WriteCString("offsetof(");
			}
			if (status == Status::Ok) {
				status = builder.WriteString(std::OwnedStringView(&typeInfo.cType));
			}
			if (status == Status::Ok) {
				status = builder.WriteByte(',');
			}
			if (status == Status::Ok) {
				status = CWriteTokenRangeRaw(parser.program, &builder, parser.fileIndex, comma + 1, groupEnd);
			}
			if (status == Status::Ok) {
				status = builder.WriteByte(')');
			}
			if (status == Status::Ok) {
				status = CExprFromBuilder(out, &builder);
			}
			builder.Destroy();
			CTypeInfoDestroy(&typeInfo);
			if (status == Status::Ok) {
				status = CExprSetType(parser.program, out, std::StringFromCString("usize"), std::StringFromCString("usize"), false);
			}
			parser.pos = groupEnd + 1;
			return(status);
		}

		StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
		if (index + 2 < parser.end && CIsOperator(parser.program, parser.fileIndex, index + 1, OperatorKind::Scope)) {
			String:scopeName = CTokenText(parser.program, parser.fileIndex, index);
			String:name = CTokenText(parser.program, parser.fileIndex, index + 2);
			ptr<CDecl>:scopedDecl = CFindFunctionDeclByName(parser.program, name, scopeName);
			if (scopedDecl != 0) {
				status = CWriteDeclCName(parser.program, &builder, scopedDecl);
			} else {
				status = CWriteToken(parser.program, &builder, parser.fileIndex, index);
				if (status == Status::Ok) {
					status = builder.WriteByte('_');
				}
				if (status == Status::Ok) {
					status = CWriteToken(parser.program, &builder, parser.fileIndex, index + 2);
				}
			}
			parser.pos = index + 3;
			if (parser.pos < parser.end && CIsOperator(parser.program, parser.fileIndex, parser.pos, OperatorKind::Less)) {
				usize:gEnd = CFindMatching(parser.program, parser.fileIndex, parser.pos);
				if (gEnd + 1 < parser.end && CIsPunctuation(parser.program, parser.fileIndex, gEnd + 1, PunctuationKind::LeftParen)) {
					usize:argStart = parser.pos + 1;
					while (argStart < gEnd) {
						usize:argEnd = CFindTokenAtDepthZero(parser.program, parser.fileIndex, argStart, gEnd, PunctuationKind::Comma);
						if (status == Status::Ok) {
							status = builder.WriteCString("__");
						}
						if (status == Status::Ok) {
							status = CWriteTypeSuffixFromRange(parser.program, &builder, parser.fileIndex, argStart, argEnd);
						}
						if (argEnd >= gEnd) {
							break;
						}
						argStart = argEnd + 1;
					}
					parser.pos = gEnd + 1;
				}
			}
		} else {
			status = CWriteToken(parser.program, &builder, parser.fileIndex, index);
			parser.pos = index + 1;
			if (parser.pos < parser.end && CIsOperator(parser.program, parser.fileIndex, parser.pos, OperatorKind::Less)) {
				usize:gEnd = CFindMatching(parser.program, parser.fileIndex, parser.pos);
				if (gEnd + 1 < parser.end && CIsPunctuation(parser.program, parser.fileIndex, gEnd + 1, PunctuationKind::LeftParen)) {
					usize:argStart = parser.pos + 1;
					while (argStart < gEnd) {
						usize:argEnd = CFindTokenAtDepthZero(parser.program, parser.fileIndex, argStart, gEnd, PunctuationKind::Comma);
						if (status == Status::Ok) {
							status = builder.WriteCString("__");
						}
						if (status == Status::Ok) {
							status = CWriteTypeSuffixFromRange(parser.program, &builder, parser.fileIndex, argStart, argEnd);
						}
						if (argEnd >= gEnd) {
							break;
						}
						argStart = argEnd + 1;
					}
					parser.pos = gEnd + 1;
				}
			}
		}
		if (status == Status::Ok) {
			status = CExprFromBuilder(out, &builder);
		}
		builder.Destroy();
		ptr<CLocal>:local = CEnvFind(parser.env, CTokenText(parser.program, parser.fileIndex, index));
		if (status == Status::Ok && local != 0) {
			status = CExprSetType(parser.program, out, std::OwnedStringView(&local.typeKey), std::OwnedStringView(&local.cType), local.isPointer);
			out.isArray = local.isArray;
			out.isPointer = local.isPointer;
			out.isLvalue = true;
			OwnedString:arrLen;
			if (status == Status::Ok) {
				status = CCloneString(parser.program, std::OwnedStringView(&local.arrayLen), &arrLen);
			}
			if (status == Status::Ok) {
				status = CReplaceOwned(&out.arrayLen, arrLen);
			}
		} else {
			if (status == Status::Ok) {
				ptr<CDecl>:functionDecl = CFindFunctionDeclByName(parser.program, CTokenText(parser.program, parser.fileIndex, index), std::StringFromCString(""));
				if (functionDecl != 0) {
					StringBuilder:functionName = std::StringBuilderNew(parser.program[0].allocator);
					status = CWriteDeclCName(parser.program, &functionName, functionDecl);
					String:currentName = std::OwnedStringView(&out.text);
					Result<usize>:suffixStart = currentName.FindByte('_');
					if (status == Status::Ok && suffixStart.status == Status::Ok && suffixStart.value + 1 < currentName.len && currentName.data[suffixStart.value + 1] == '_') {
						status = functionName.WriteString(currentName.Slice(suffixStart.value, currentName.len - suffixStart.value));
					}
					if (status == Status::Ok) {
						status = CExprFromBuilder(out, &functionName);
					}
					functionName.Destroy();
				}
			}
		}
		return(status);
	}
	parser.pos += 1;
	return(Status::Ok);
}

Status:CWriteCallArgs(ptr<CExprParser>:parser, usize:start, usize:end, ptr<StringBuilder>:out) {
	usize:itemStart = start;
	bool:first = true;
	Status:status = Status::Ok;
	while (itemStart < end) {
		if (CIsPunctuation(parser.program, parser.fileIndex, itemStart, PunctuationKind::Comma)) {
			itemStart += 1;
			continue;
		}
		usize:itemEnd = CFindTokenAtDepthZero(parser.program, parser.fileIndex, itemStart, end, PunctuationKind::Comma);
		usize:exprStart = itemStart;
		usize:assign = CFindTokenAtDepthZero(parser.program, parser.fileIndex, itemStart, itemEnd, PunctuationKind::Colon);
		if (assign < itemEnd) {
			exprStart = assign + 1;
		} else {
			for (usize:i = itemStart; i < itemEnd; i++) {
				if (CIsOperator(parser.program, parser.fileIndex, i, OperatorKind::Assign)) {
					exprStart = i + 1;
					break;
				}
			}
		}
		CExpr:arg;
		if (status == Status::Ok) {
			status = CCompileExpressionRange(parser.program, parser.env, parser.fileIndex, exprStart, itemEnd, std::StringFromCString(""), std::StringFromCString(""), false, &arg);
		}
		if (status == Status::Ok && !first) {
			status = out.WriteByte(',');
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&arg.text));
		}
		if (status == Status::Ok) {
			CExprDestroy(&arg);
		}
		first = false;
		if (status != Status::Ok || itemEnd >= end) {
			break;
		}
		itemStart = itemEnd + 1;
	}
	return(status);
}

usize:CCountCallArgs(ptr<CProgram>:program, usize:fileIndex, usize:start, usize:end) {
	if (start >= end) {
		return(0);
	}
	usize:count = 1;
	usize:i = start;
	while (i < end) {
		usize:comma = CFindTokenAtDepthZero(program, fileIndex, i, end, PunctuationKind::Comma);
		if (comma >= end) {
			break;
		}
		count += 1;
		i = comma + 1;
	}
	return(count);
}

Status:CApplyPostfix(ptr<CExprParser>:parser, ptr<CExpr>:expr) {
	while (parser.pos < parser.end) {
		if (CIsPunctuation(parser.program, parser.fileIndex, parser.pos, PunctuationKind::LeftParen)) {
			usize:groupStart = parser.pos;
			usize:groupEnd = CFindMatching(parser.program, parser.fileIndex, groupStart);
			String:funcText = std::OwnedStringView(&expr.text);
			if (funcText.EqualsCString("len")) {
				CExpr:arg;
				Status:status = CCompileExpressionRange(parser.program, parser.env, parser.fileIndex, groupStart + 1, groupEnd, std::StringFromCString(""), std::StringFromCString(""), false, &arg);
				StringBuilder:lenBuilder = std::StringBuilderNew(parser.program[0].allocator);
				if (status == Status::Ok) {
					if (arg.isArray) {
						status = lenBuilder.WriteCString("((void)(");
						if (status == Status::Ok) {
							status = lenBuilder.WriteString(std::OwnedStringView(&arg.text));
						}
						if (status == Status::Ok) {
							status = lenBuilder.WriteCString("),");
						}
						if (status == Status::Ok) {
							status = lenBuilder.WriteString(std::OwnedStringView(&arg.arrayLen));
						}
						if (status == Status::Ok) {
							status = lenBuilder.WriteByte(')');
						}
					} else {
						status = lenBuilder.WriteCString("(sizeof(");
						if (status == Status::Ok) {
							status = lenBuilder.WriteString(std::OwnedStringView(&arg.text));
						}
						if (status == Status::Ok) {
							status = lenBuilder.WriteCString(")/sizeof((");
						}
						if (status == Status::Ok) {
							status = lenBuilder.WriteString(std::OwnedStringView(&arg.text));
						}
						if (status == Status::Ok) {
							status = lenBuilder.WriteCString(")[0]))");
						}
					}
				}
				if (status == Status::Ok) {
					status = CExprFromBuilder(expr, &lenBuilder);
				}
				lenBuilder.Destroy();
				CExprDestroy(&arg);
				if (status == Status::Ok) {
					status = CExprSetType(parser.program, expr, std::StringFromCString("usize"), std::StringFromCString("usize"), false);
				}
				parser.pos = groupEnd + 1;
				if (status != Status::Ok) {
					return(status);
				}
				continue;
			}
			StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
			Status:status = builder.WriteString(funcText);
			if (status == Status::Ok) {
				status = builder.WriteByte('(');
			}
			if (status == Status::Ok) {
				status = CWriteCallArgs(parser, groupStart + 1, groupEnd, &builder);
			}
			usize:argCount = CCountCallArgs(parser.program, parser.fileIndex, groupStart + 1, groupEnd);
			if (status == Status::Ok && funcText.EqualsCString("add") && argCount == 1) {
				status = builder.WriteCString(",0");
			}
			if (status == Status::Ok) {
				status = builder.WriteByte(')');
			}
			if (status == Status::Ok) {
				status = CExprFromBuilder(expr, &builder);
			}
			builder.Destroy();
			expr.isLvalue = false;
			parser.pos = groupEnd + 1;
			if (status != Status::Ok) {
				return(status);
			}
			continue;
		}
		if (CIsPunctuation(parser.program, parser.fileIndex, parser.pos, PunctuationKind::LeftBracket)) {
			usize:indexStart = parser.pos;
			usize:indexEnd = CFindMatching(parser.program, parser.fileIndex, indexStart);
			CExpr:indexExpr;
			Status:status = CCompileExpressionRange(parser.program, parser.env, parser.fileIndex, indexStart + 1, indexEnd, std::StringFromCString(""), std::StringFromCString(""), false, &indexExpr);
			StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
			if (status == Status::Ok) {
				status = builder.WriteString(std::OwnedStringView(&expr.text));
			}
			if (status == Status::Ok) {
				status = builder.WriteByte('[');
			}
			if (status == Status::Ok) {
				status = builder.WriteString(std::OwnedStringView(&indexExpr.text));
			}
			if (status == Status::Ok) {
				status = builder.WriteByte(']');
			}
			if (status == Status::Ok) {
				status = CExprFromBuilder(expr, &builder);
			}
			builder.Destroy();
			CExprDestroy(&indexExpr);
			expr.isLvalue = true;
			expr.isArray = false;
			String:indexedKey = std::OwnedStringView(&expr.typeKey);
			if (indexedKey.len > 0 && indexedKey.data[indexedKey.len - 1] == '*') {
				OwnedString:newKey;
				status = CCloneString(parser.program, indexedKey.Slice(0, indexedKey.len - 1), &newKey);
				if (status == Status::Ok) {
					status = CReplaceOwned(&expr.typeKey, newKey);
				}
				OwnedString:newCType;
				if (status == Status::Ok) {
					status = CMakeCTypeFromKey(parser.program, std::OwnedStringView(&expr.typeKey), &newCType);
				}
				if (status == Status::Ok) {
					status = CReplaceOwned(&expr.cType, newCType);
				}
				expr.isPointer = false;
			}
			parser.pos = indexEnd + 1;
			if (status != Status::Ok) {
				return(status);
			}
			continue;
		}
		if (CIsPunctuation(parser.program, parser.fileIndex, parser.pos, PunctuationKind::Dot)) {
			usize:nameIndex = parser.pos + 1;
			String:fieldName = CTokenText(parser.program, parser.fileIndex, nameIndex);
			if (nameIndex + 1 < parser.end && CIsPunctuation(parser.program, parser.fileIndex, nameIndex + 1, PunctuationKind::LeftParen)) {
				usize:groupStart = nameIndex + 1;
				usize:groupEnd = CFindMatching(parser.program, parser.fileIndex, groupStart);
				String:receiverKey = std::OwnedStringView(&expr.typeKey);
				String:methodReceiverKey = receiverKey;
				if (expr.isPointer && receiverKey.len > 0 && receiverKey.data[receiverKey.len - 1] == '*') {
					methodReceiverKey = receiverKey.Slice(0, receiverKey.len - 1);
				}
				ptr<CDecl>:method = CFindMethod(parser.program, methodReceiverKey, fieldName, false, 0, 0);
				StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
				Status:status = Status::Ok;
				if (method != 0) {
					status = CWriteDeclCName(parser.program, &builder, method);
				} else {
					status = builder.WriteString(methodReceiverKey);
					if (status == Status::Ok) {
						status = builder.WriteByte('_');
					}
					if (status == Status::Ok) {
						status = builder.WriteString(fieldName);
					}
				}
				if (status == Status::Ok) {
					status = builder.WriteByte('(');
				}
				if (status == Status::Ok && !expr.isPointer) {
					status = builder.WriteByte('&');
				}
				if (status == Status::Ok) {
					status = builder.WriteString(std::OwnedStringView(&expr.text));
				}
				if (groupStart + 1 < groupEnd) {
					if (status == Status::Ok) {
						status = builder.WriteByte(',');
					}
					if (status == Status::Ok) {
						status = CWriteCallArgs(parser, groupStart + 1, groupEnd, &builder);
					}
				}
				if (status == Status::Ok) {
					status = builder.WriteByte(')');
				}
				if (status == Status::Ok) {
					status = CExprFromBuilder(expr, &builder);
				}
				builder.Destroy();
				expr.isLvalue = false;
				if (method != 0) {
					CTypeInfo:returnInfo;
					if (status == Status::Ok) {
						status = CRenderTypeInfo(parser.program, method.fileIndex, method.returnStart, method.returnEnd, &returnInfo);
					}
					if (status == Status::Ok) {
						status = CExprSetType(parser.program, expr, std::OwnedStringView(&returnInfo.key), std::OwnedStringView(&returnInfo.cType), returnInfo.isPointer);
					}
					if (status == Status::Ok) {
						CTypeInfoDestroy(&returnInfo);
					}
				}
				parser.pos = groupEnd + 1;
				if (status != Status::Ok) {
					return(status);
				}
				continue;
			}
			StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
			Status:status = builder.WriteString(std::OwnedStringView(&expr.text));
			if (status == Status::Ok) {
				String:exprText = std::OwnedStringView(&expr.text);
				if (expr.isPointer || exprText.EqualsCString("this")) {
					status = builder.WriteCString("->");
				} else {
					status = builder.WriteByte('.');
				}
			}
			if (status == Status::Ok) {
				status = builder.WriteString(fieldName);
			}
			if (status == Status::Ok) {
				status = CExprFromBuilder(expr, &builder);
			}
			builder.Destroy();
			CTypeInfo:fieldType;
			if (status == Status::Ok) {
				status = CFieldType(parser.program, std::OwnedStringView(&expr.typeKey), fieldName, &fieldType);
			}
			if (status == Status::Ok) {
				status = CExprSetType(parser.program, expr, std::OwnedStringView(&fieldType.key), std::OwnedStringView(&fieldType.cType), fieldType.isPointer);
			}
			if (status == Status::Ok) {
				CTypeInfoDestroy(&fieldType);
			}
			expr.isLvalue = true;
			parser.pos = nameIndex + 1;
			if (status != Status::Ok) {
				return(status);
			}
			continue;
		}
		break;
	}
	return(Status::Ok);
}

Status:CCompileUnary(ptr<CExprParser>:parser, ptr<CExpr>:out) {
	if (parser.pos < parser.end
		&& (CIsOperator(parser.program, parser.fileIndex, parser.pos, OperatorKind::Minus)
			|| CIsOperator(parser.program, parser.fileIndex, parser.pos, OperatorKind::LogicalNot)
			|| CIsOperator(parser.program, parser.fileIndex, parser.pos, OperatorKind::BitwiseNot)
			|| CIsOperator(parser.program, parser.fileIndex, parser.pos, OperatorKind::BitwiseAnd)
			|| CIsOperator(parser.program, parser.fileIndex, parser.pos, OperatorKind::Multiply))) {
		usize:op = parser.pos;
		parser.pos += 1;
		CExpr:inner;
		Status:status = CCompileUnary(parser, &inner);
		StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
		if (status == Status::Ok) {
			status = CWriteToken(parser.program, &builder, parser.fileIndex, op);
		}
		if (status == Status::Ok) {
			status = builder.WriteString(std::OwnedStringView(&inner.text));
		}
		if (status == Status::Ok) {
			status = CExprInitEmpty(parser.program, out);
		}
		if (status == Status::Ok) {
			status = CExprFromBuilder(out, &builder);
		}
		builder.Destroy();
		if (status == Status::Ok) {
			ptr<CDecl>:unaryMethod = 0;
			if (CIsOperator(parser.program, parser.fileIndex, op, OperatorKind::Minus)) {
				unaryMethod = CFindMethod(parser.program, std::OwnedStringView(&inner.typeKey), std::StringFromCString(""), true, COperatorCode(parser.program, parser.fileIndex, op), 0);
			}
			if (unaryMethod != 0) {
				StringBuilder:call = std::StringBuilderNew(parser.program[0].allocator);
				status = CWriteDeclCName(parser.program, &call, unaryMethod);
				if (status == Status::Ok) {
					status = call.WriteCString("(&");
				}
				if (status == Status::Ok) {
					status = call.WriteString(std::OwnedStringView(&inner.text));
				}
				if (status == Status::Ok) {
					status = call.WriteByte(')');
				}
				if (status == Status::Ok) {
					status = CExprFromBuilder(out, &call);
				}
				call.Destroy();
			} else {
				if (CIsOperator(parser.program, parser.fileIndex, op, OperatorKind::BitwiseAnd)) {
				StringBuilder:key = std::StringBuilderNew(parser.program[0].allocator);
				status = key.WriteString(std::OwnedStringView(&inner.typeKey));
				if (status == Status::Ok) {
					status = key.WriteByte('*');
				}
				OwnedString:keyOwned;
				if (status == Status::Ok) {
					status = CDetachBuilder(&key, &keyOwned);
				}
				key.Destroy();
				OwnedString:cOwned;
				if (status == Status::Ok) {
					StringBuilder:ct = std::StringBuilderNew(parser.program[0].allocator);
					status = ct.WriteString(std::OwnedStringView(&inner.cType));
					if (status == Status::Ok) {
						status = ct.WriteByte('*');
					}
					if (status == Status::Ok) {
						status = CDetachBuilder(&ct, &cOwned);
					}
					ct.Destroy();
				}
				if (status == Status::Ok) {
					status = CExprSetType(parser.program, out, std::OwnedStringView(&keyOwned), std::OwnedStringView(&cOwned), true);
					std::DestroyOwnedString(&keyOwned);
					std::DestroyOwnedString(&cOwned);
				}
			} else {
				status = CExprSetType(parser.program, out, std::OwnedStringView(&inner.typeKey), std::OwnedStringView(&inner.cType), inner.isPointer);
			}
			}
		}
		CExprDestroy(&inner);
		return(status);
	}
	Status:status = CCompilePrimary(parser, out);
	if (status == Status::Ok) {
		status = CApplyPostfix(parser, out);
	}
	return(status);
}

Status:CCompileBinaryOperation(ptr<CExprParser>:parser, ptr<CExpr>:left, usize:operatorIndex, ptr<CExpr>:right, ptr<CExpr>:out) {
	Status:status = CExprInitEmpty(parser.program, out);
	if (status != Status::Ok) {
		return(status);
	}
	u8:opCode = COperatorCode(parser.program, parser.fileIndex, operatorIndex);
	ptr<CDecl>:method = 0;
	usize:operatorArgCount = 1;
	if (CIsOperator(parser.program, parser.fileIndex, operatorIndex, OperatorKind::PlusAssign)
		|| CIsOperator(parser.program, parser.fileIndex, operatorIndex, OperatorKind::MinusAssign)) {
		operatorArgCount = 1;
	}
	if (opCode != 0 && std::OwnedStringView(&left.typeKey).len > 0) {
		method = CFindMethod(parser.program, std::OwnedStringView(&left.typeKey), std::StringFromCString(""), true, opCode, operatorArgCount);
	}
	if (method != 0) {
		StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
		status = CWriteDeclCName(parser.program, &builder, method);
		if (status == Status::Ok) {
			status = builder.WriteCString("(&");
		}
		if (status == Status::Ok) {
			status = builder.WriteString(std::OwnedStringView(&left.text));
		}
		if (status == Status::Ok) {
			status = builder.WriteByte(',');
		}
		if (status == Status::Ok) {
			status = builder.WriteString(std::OwnedStringView(&right.text));
		}
		if (status == Status::Ok) {
			status = builder.WriteByte(')');
		}
		if (status == Status::Ok) {
			status = CExprFromBuilder(out, &builder);
		}
		builder.Destroy();
		if (status == Status::Ok) {
			CTypeInfo:returnInfo;
			status = CRenderTypeInfo(parser.program, method.fileIndex, method.returnStart, method.returnEnd, &returnInfo);
			if (status == Status::Ok) {
				status = CExprSetType(parser.program, out, std::OwnedStringView(&returnInfo.key), std::OwnedStringView(&returnInfo.cType), returnInfo.isPointer);
			}
			if (status == Status::Ok) {
				CTypeInfoDestroy(&returnInfo);
			}
		}
		return(status);
	}
	StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
	status = builder.WriteString(std::OwnedStringView(&left.text));
	if (status == Status::Ok) {
		status = CWriteToken(parser.program, &builder, parser.fileIndex, operatorIndex);
	}
	if (status == Status::Ok) {
		status = builder.WriteString(std::OwnedStringView(&right.text));
	}
	if (status == Status::Ok) {
		status = CExprFromBuilder(out, &builder);
	}
	builder.Destroy();
	if (status == Status::Ok) {
		if (CIsOperator(parser.program, parser.fileIndex, operatorIndex, OperatorKind::Equal)
			|| CIsOperator(parser.program, parser.fileIndex, operatorIndex, OperatorKind::NotEqual)
			|| CIsOperator(parser.program, parser.fileIndex, operatorIndex, OperatorKind::Less)
			|| CIsOperator(parser.program, parser.fileIndex, operatorIndex, OperatorKind::LessEqual)
			|| CIsOperator(parser.program, parser.fileIndex, operatorIndex, OperatorKind::Greater)
			|| CIsOperator(parser.program, parser.fileIndex, operatorIndex, OperatorKind::GreaterEqual)
			|| CIsOperator(parser.program, parser.fileIndex, operatorIndex, OperatorKind::LogicalAnd)
			|| CIsOperator(parser.program, parser.fileIndex, operatorIndex, OperatorKind::LogicalOr)) {
			status = CExprSetType(parser.program, out, std::StringFromCString("bool"), std::StringFromCString("bool"), false);
		} else {
			status = CExprSetType(parser.program, out, std::OwnedStringView(&left.typeKey), std::OwnedStringView(&left.cType), left.isPointer);
		}
	}
	return(status);
}

Status:CCompileExpression(ptr<CExprParser>:parser, u8:minPrecedence, ptr<CExpr>:out) {
	CExpr:left;
	Status:status = CCompileUnary(parser, &left);
	if (status != Status::Ok) {
		return(status);
	}
	while (parser.pos < parser.end) {
		u8:precedence = COperatorPrecedence(parser.program, parser.fileIndex, parser.pos);
		if (precedence == 0 || precedence < minPrecedence) {
			break;
		}
		usize:op = parser.pos;
		parser.pos += 1;
		u8:nextMin = precedence + 1;
		if (COperatorRightAssociative(parser.program, parser.fileIndex, op)) {
			nextMin = precedence;
		}
		CExpr:right;
		status = CCompileExpression(parser, nextMin, &right);
		if (status != Status::Ok) {
			CExprDestroy(&left);
			return(status);
		}
		CExpr:combined;
		status = CCompileBinaryOperation(parser, &left, op, &right, &combined);
		CExprDestroy(&left);
		CExprDestroy(&right);
		if (status != Status::Ok) {
			return(status);
		}
		left = combined;
	}
	out[0] = left;
	return(Status::Ok);
}

Status:CWriteIndent(ptr<StringBuilder>:out, usize:indent) {
	for (usize:i = 0; i < indent; i++) {
		Status:status = out.WriteCString("    ");
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(Status::Ok);
}

usize:CFindStatementSemicolon(ptr<CProgram>:program, usize:fileIndex, usize:start, usize:end) {
	usize:i = start;
	while (i < end) {
		if (CIsPunctuation(program, fileIndex, i, PunctuationKind::LeftParen)
			|| CIsPunctuation(program, fileIndex, i, PunctuationKind::LeftBrace)
			|| CIsPunctuation(program, fileIndex, i, PunctuationKind::LeftBracket)) {
			i = CSkipDelimited(program, fileIndex, i);
			continue;
		}
		if (CIsPunctuation(program, fileIndex, i, PunctuationKind::Semicolon)) {
			return(i);
		}
		i += 1;
	}
	return(end);
}

Status:CArrayLenString(ptr<CProgram>:program, usize:fileIndex, usize:start, usize:end, ptr<OwnedString>:out) {
	StringBuilder:builder = std::StringBuilderNew(program.allocator);
	Status:status = CWriteTokenRangeRaw(program, &builder, fileIndex, start, end);
	if (status == Status::Ok) {
		status = CDetachBuilder(&builder, out);
	}
	builder.Destroy();
	return(status);
}

bool:CFieldDefaultIsZero(ptr<CProgram>:program, ptr<CField>:field) {
	if (!field.hasDefault) {
		return(true);
	}
	if (field.defaultEnd != field.defaultStart + 1) {
		return(false);
	}
	if (CIsTokenKind(program, field.fileIndex, field.defaultStart, TokenKind::Number)
		&& CTokenEquals(program, field.fileIndex, field.defaultStart, "0")) {
		return(true);
	}
	if (CIsIdentifierText(program, field.fileIndex, field.defaultStart, "false")) {
		return(true);
	}
	return(false);
}

Status:CWriteDefaultInitializer(ptr<CProgram>:program, ptr<StringBuilder>:out, String:typeKey) {
	ptr<CDecl>:decl = CFindFieldDecl(program, typeKey);
	if (decl != 0 && decl.kind == CDeclKind::Union) {
		return(out.WriteCString("{0}"));
	}
	if (decl == 0 || decl.kind != CDeclKind::Struct) {
		return(out.WriteCString("0"));
	}
	bool:hasNonZeroDefault = false;
	for (usize:i = 0; i < decl.fieldCount; i++) {
		ptr<CField>:field = &program.fields.data[decl.firstField + i];
		if (field.hasDefault && !CFieldDefaultIsZero(program, field)) {
			hasNonZeroDefault = true;
			break;
		}
	}
	if (!hasNonZeroDefault) {
		return(out.WriteCString("{0}"));
	}
	Status:status = out.WriteByte('{');
	bool:first = true;
	for (usize:i = 0; i < decl.fieldCount; i++) {
		ptr<CField>:field = &program.fields.data[decl.firstField + i];
		if (!field.hasDefault || CFieldDefaultIsZero(program, field)) {
			continue;
		}
		if (!first && status == Status::Ok) {
			status = out.WriteByte(',');
		}
		if (status == Status::Ok) {
			status = out.WriteByte('.');
		}
		if (status == Status::Ok) {
			status = CWriteToken(program, out, field.fileIndex, field.nameIndex);
		}
		if (status == Status::Ok) {
			status = out.WriteByte('=');
		}
		CExpr:defaultExpr;
		CEnv:emptyEnv;
		CEnvInit(program, &emptyEnv);
		if (status == Status::Ok) {
			status = CCompileExpressionRange(program, &emptyEnv, field.fileIndex, field.defaultStart, field.defaultEnd, std::StringFromCString(""), std::StringFromCString(""), false, &defaultExpr);
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&defaultExpr.text));
		}
		if (status == Status::Ok) {
			CExprDestroy(&defaultExpr);
		}
		CEnvDestroy(&emptyEnv);
		first = false;
		if (status != Status::Ok) {
			return(status);
		}
	}
	if (status == Status::Ok) {
		status = out.WriteByte('}');
	}
	return(status);
}

Status:CWriteVarDecl(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CEnv>:env, usize:fileIndex, usize:start, usize:semicolon, usize:indent) {
	usize:colon = CFindTopLevelColon(program, fileIndex, start, semicolon);
	if (colon >= semicolon) {
		return(Status::Invalid);
	}
	usize:nameIndex = colon + 1;
	usize:afterName = nameIndex + 1;
	bool:isArray = false;
	usize:arrayStart = semicolon;
	usize:arrayEnd = semicolon;
	if (afterName < semicolon && CIsPunctuation(program, fileIndex, afterName, PunctuationKind::LeftBracket)) {
		isArray = true;
		arrayStart = afterName + 1;
		arrayEnd = CFindMatching(program, fileIndex, afterName);
		afterName = arrayEnd + 1;
		while (afterName < semicolon && CIsPunctuation(program, fileIndex, afterName, PunctuationKind::LeftBracket)) {
			afterName = CFindMatching(program, fileIndex, afterName) + 1;
		}
	}
	usize:arraySuffixStart = nameIndex + 1;
	usize:arraySuffixEnd = afterName;
	usize:initStart = semicolon;
	bool:hasInit = false;
	for (usize:i = afterName; i < semicolon; i++) {
		if (CIsOperator(program, fileIndex, i, OperatorKind::Assign)) {
			initStart = i + 1;
			hasInit = true;
			break;
		}
	}
	CTypeInfo:typeInfo;
	Status:status = CRenderTypeInfo(program, fileIndex, start, colon, &typeInfo);
	if (status != Status::Ok) {
		return(status);
	}
	status = CWriteIndent(out, indent);
	if (status == Status::Ok) {
		status = out.WriteString(std::OwnedStringView(&typeInfo.cType));
	}
	if (status == Status::Ok) {
		status = out.WriteByte(' ');
	}
	if (status == Status::Ok) {
		status = CWriteToken(program, out, fileIndex, nameIndex);
	}
	OwnedString:arrayLen;
	if (isArray) {
		if (status == Status::Ok) {
			status = CWriteTokenRangeRaw(program, out, fileIndex, arraySuffixStart, arraySuffixEnd);
		}
		if (status == Status::Ok) {
			status = CArrayLenString(program, fileIndex, arrayStart, arrayEnd, &arrayLen);
		}
	} else {
		if (status == Status::Ok) {
			status = CMakeOwnedEmpty(program, &arrayLen);
		}
	}
	if (hasInit) {
		CExpr:init;
		if (status == Status::Ok) {
			status = CCompileExpressionRange(program, env, fileIndex, initStart, semicolon, std::OwnedStringView(&typeInfo.key), std::OwnedStringView(&typeInfo.cType), isArray, &init);
		}
		if (status == Status::Ok) {
			status = out.WriteByte('=');
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&init.text));
		}
		if (status == Status::Ok) {
			CExprDestroy(&init);
		}
	} else {
		if (!isArray) {
			if (status == Status::Ok) {
				status = out.WriteByte('=');
			}
			if (status == Status::Ok) {
				status = CWriteDefaultInitializer(program, out, std::OwnedStringView(&typeInfo.key));
			}
		}
	}
	if (status == Status::Ok) {
		status = out.WriteCString(";\n");
	}
	if (status == Status::Ok) {
		status = CEnvAdd(program, env, CTokenText(program, fileIndex, nameIndex), std::OwnedStringView(&typeInfo.key), std::OwnedStringView(&typeInfo.cType), isArray, std::OwnedStringView(&arrayLen), typeInfo.isPointer);
	}
	std::DestroyOwnedString(&arrayLen);
	CTypeInfoDestroy(&typeInfo);
	return(status);
}

Status:CWriteExprStatement(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CEnv>:env, usize:fileIndex, usize:start, usize:semicolon, usize:indent) {
	if (start >= semicolon) {
		return(Status::Ok);
	}
	if (start + 2 == semicolon
		&& CIsOperator(program, fileIndex, start + 1, OperatorKind::Plus)
		&& CIsOperator(program, fileIndex, start + 2, OperatorKind::Plus)) {
	}
	CExpr:expr;
	Status:status = CCompileExpressionRange(program, env, fileIndex, start, semicolon, std::StringFromCString(""), std::StringFromCString(""), false, &expr);
	if (status == Status::Ok) {
		status = CWriteIndent(out, indent);
	}
	if (status == Status::Ok) {
		status = out.WriteString(std::OwnedStringView(&expr.text));
	}
	if (status == Status::Ok) {
		status = out.WriteCString(";\n");
	}
	CExprDestroy(&expr);
	return(status);
}

Status:CWriteIfStatement(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CEnv>:env, usize:fileIndex, usize:start, ptr<usize>:outNext, usize:indent) {
	usize:groupStart = CFindNextGroup(program, fileIndex, start, CFileTokenCount(program, fileIndex));
	usize:groupEnd = CFindMatching(program, fileIndex, groupStart);
	usize:blockStart = groupEnd + 1;
	usize:blockEnd = blockStart;
	CExpr:cond;
	Status:status = CCompileExpressionRange(program, env, fileIndex, groupStart + 1, groupEnd, std::StringFromCString(""), std::StringFromCString(""), false, &cond);
	if (status == Status::Ok) {
		status = CWriteIndent(out, indent);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("if (");
	}
	if (status == Status::Ok) {
		status = out.WriteString(std::OwnedStringView(&cond.text));
	}
	if (status == Status::Ok) {
		status = out.WriteCString(") ");
	}
	CExprDestroy(&cond);
	if (blockStart < CFileTokenCount(program, fileIndex) && CIsPunctuation(program, fileIndex, blockStart, PunctuationKind::LeftBrace)) {
		blockEnd = CFindMatching(program, fileIndex, blockStart);
		if (status == Status::Ok) {
			status = out.WriteCString("{\n");
		}
		if (status == Status::Ok) {
			status = CWriteBlock(program, out, env, fileIndex, blockStart + 1, blockEnd, indent + 1);
		}
		if (status == Status::Ok) {
			status = CWriteIndent(out, indent);
		}
		if (status == Status::Ok) {
			status = out.WriteCString("}");
		}
		outNext[0] = blockEnd + 1;
	} else {
		usize:semicolon = CFindStatementSemicolon(program, fileIndex, blockStart, CFileTokenCount(program, fileIndex));
		if (status == Status::Ok) {
			status = out.WriteCString("{\n");
		}
		if (status == Status::Ok) {
			status = CWriteExprStatement(program, out, env, fileIndex, blockStart, semicolon, indent + 1);
		}
		if (status == Status::Ok) {
			status = CWriteIndent(out, indent);
		}
		if (status == Status::Ok) {
			status = out.WriteCString("}");
		}
		outNext[0] = semicolon + 1;
	}
	if (outNext[0] < CFileTokenCount(program, fileIndex) && CIsKeyword(program, fileIndex, outNext[0], KeywordKind::Else)) {
		if (status == Status::Ok) {
			status = out.WriteCString(" else ");
		}
		usize:elseStart = outNext[0] + 1;
		if (elseStart < CFileTokenCount(program, fileIndex) && CIsPunctuation(program, fileIndex, elseStart, PunctuationKind::LeftBrace)) {
			usize:elseEnd = CFindMatching(program, fileIndex, elseStart);
			if (status == Status::Ok) {
				status = out.WriteCString("{\n");
			}
			if (status == Status::Ok) {
				status = CWriteBlock(program, out, env, fileIndex, elseStart + 1, elseEnd, indent + 1);
			}
			if (status == Status::Ok) {
				status = CWriteIndent(out, indent);
			}
			if (status == Status::Ok) {
				status = out.WriteCString("}");
			}
			outNext[0] = elseEnd + 1;
		} else {
			if (status == Status::Ok) {
				status = out.WriteCString("{\n");
			}
			usize:semicolon = CFindStatementSemicolon(program, fileIndex, elseStart, CFileTokenCount(program, fileIndex));
			if (status == Status::Ok) {
				status = CWriteExprStatement(program, out, env, fileIndex, elseStart, semicolon, indent + 1);
			}
			if (status == Status::Ok) {
				status = CWriteIndent(out, indent);
			}
			if (status == Status::Ok) {
				status = out.WriteCString("}");
			}
			outNext[0] = semicolon + 1;
		}
	}
	if (status == Status::Ok) {
		status = out.WriteByte('\n');
	}
	return(status);
}

Status:CWriteWhileStatement(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CEnv>:env, usize:fileIndex, usize:start, ptr<usize>:outNext, usize:indent) {
	usize:groupStart = CFindNextGroup(program, fileIndex, start, CFileTokenCount(program, fileIndex));
	usize:groupEnd = CFindMatching(program, fileIndex, groupStart);
	usize:blockStart = groupEnd + 1;
	usize:blockEnd = CFindMatching(program, fileIndex, blockStart);
	CExpr:cond;
	Status:status = CCompileExpressionRange(program, env, fileIndex, groupStart + 1, groupEnd, std::StringFromCString(""), std::StringFromCString(""), false, &cond);
	if (status == Status::Ok) {
		status = CWriteIndent(out, indent);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("while (");
	}
	if (status == Status::Ok) {
		status = out.WriteString(std::OwnedStringView(&cond.text));
	}
	if (status == Status::Ok) {
		status = out.WriteCString(") {\n");
	}
	CExprDestroy(&cond);
	if (status == Status::Ok) {
		status = CWriteBlock(program, out, env, fileIndex, blockStart + 1, blockEnd, indent + 1);
	}
	if (status == Status::Ok) {
		status = CWriteIndent(out, indent);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("}\n");
	}
	outNext[0] = blockEnd + 1;
	return(status);
}

Status:CWriteDoStatement(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CEnv>:env, usize:fileIndex, usize:start, ptr<usize>:outNext, usize:indent) {
	usize:blockStart = start + 1;
	usize:blockEnd = CFindMatching(program, fileIndex, blockStart);
	usize:whileIndex = blockEnd + 1;
	usize:groupStart = CFindNextGroup(program, fileIndex, whileIndex, CFileTokenCount(program, fileIndex));
	usize:groupEnd = CFindMatching(program, fileIndex, groupStart);
	CExpr:cond;
	Status:status = CCompileExpressionRange(program, env, fileIndex, groupStart + 1, groupEnd, std::StringFromCString(""), std::StringFromCString(""), false, &cond);
	if (status == Status::Ok) {
		status = CWriteIndent(out, indent);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("do {\n");
	}
	if (status == Status::Ok) {
		status = CWriteBlock(program, out, env, fileIndex, blockStart + 1, blockEnd, indent + 1);
	}
	if (status == Status::Ok) {
		status = CWriteIndent(out, indent);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("} while (");
	}
	if (status == Status::Ok) {
		status = out.WriteString(std::OwnedStringView(&cond.text));
	}
	if (status == Status::Ok) {
		status = out.WriteCString(");\n");
	}
	CExprDestroy(&cond);
	outNext[0] = groupEnd + 2;
	return(status);
}

Status:CWriteForStatement(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CEnv>:env, usize:fileIndex, usize:start, ptr<usize>:outNext, usize:indent) {
	usize:groupStart = CFindNextGroup(program, fileIndex, start, CFileTokenCount(program, fileIndex));
	usize:groupEnd = CFindMatching(program, fileIndex, groupStart);
	usize:firstSemi = CFindTokenAtDepthZero(program, fileIndex, groupStart + 1, groupEnd, PunctuationKind::Semicolon);
	usize:secondSemi = CFindTokenAtDepthZero(program, fileIndex, firstSemi + 1, groupEnd, PunctuationKind::Semicolon);
	usize:blockStart = groupEnd + 1;
	usize:blockEnd = CFindMatching(program, fileIndex, blockStart);
	Status:status = CWriteIndent(out, indent);
	if (status == Status::Ok) {
		status = out.WriteCString("for (");
	}
	usize:colon = CFindTopLevelColon(program, fileIndex, groupStart + 1, firstSemi);
	if (colon < firstSemi) {
		CTypeInfo:typeInfo;
		if (status == Status::Ok) {
			status = CRenderTypeInfo(program, fileIndex, groupStart + 1, colon, &typeInfo);
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&typeInfo.cType));
		}
		if (status == Status::Ok) {
			status = out.WriteByte(' ');
		}
		if (status == Status::Ok) {
			status = CWriteToken(program, out, fileIndex, colon + 1);
		}
		if (status == Status::Ok) {
			status = CEnvAdd(program, env, CTokenText(program, fileIndex, colon + 1), std::OwnedStringView(&typeInfo.key), std::OwnedStringView(&typeInfo.cType), false, std::StringFromCString(""), typeInfo.isPointer);
		}
		usize:eq = colon + 2;
		while (eq < firstSemi && !CIsOperator(program, fileIndex, eq, OperatorKind::Assign)) {
			eq += 1;
		}
		if (eq < firstSemi) {
			CExpr:init;
			if (status == Status::Ok) {
				status = CCompileExpressionRange(program, env, fileIndex, eq + 1, firstSemi, std::OwnedStringView(&typeInfo.key), std::OwnedStringView(&typeInfo.cType), false, &init);
			}
			if (status == Status::Ok) {
				status = out.WriteByte('=');
			}
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&init.text));
			}
			if (status == Status::Ok) {
				CExprDestroy(&init);
			}
		}
		CTypeInfoDestroy(&typeInfo);
	} else {
		CExpr:initExpr;
		if (status == Status::Ok) {
			status = CCompileExpressionRange(program, env, fileIndex, groupStart + 1, firstSemi, std::StringFromCString(""), std::StringFromCString(""), false, &initExpr);
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&initExpr.text));
		}
		if (status == Status::Ok) {
			CExprDestroy(&initExpr);
		}
	}
	if (status == Status::Ok) {
		status = out.WriteByte(';');
	}
	CExpr:cond;
	if (status == Status::Ok) {
		status = CCompileExpressionRange(program, env, fileIndex, firstSemi + 1, secondSemi, std::StringFromCString(""), std::StringFromCString(""), false, &cond);
	}
	if (status == Status::Ok) {
		status = out.WriteString(std::OwnedStringView(&cond.text));
	}
	if (status == Status::Ok) {
		status = out.WriteByte(';');
	}
	if (status == Status::Ok) {
		status = CWriteTokenRangeRaw(program, out, fileIndex, secondSemi + 1, groupEnd);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(") {\n");
	}
	if (status == Status::Ok) {
		status = CWriteBlock(program, out, env, fileIndex, blockStart + 1, blockEnd, indent + 1);
	}
	if (status == Status::Ok) {
		status = CWriteIndent(out, indent);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("}\n");
	}
	CExprDestroy(&cond);
	outNext[0] = blockEnd + 1;
	return(status);
}

Status:CWriteEachStatement(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CEnv>:env, usize:fileIndex, usize:start, ptr<usize>:outNext, usize:indent) {
	usize:genericStart = start + 1;
	usize:genericEnd = CFindMatching(program, fileIndex, genericStart);
	usize:groupStart = genericEnd + 1;
	usize:groupEnd = CFindMatching(program, fileIndex, groupStart);
	usize:blockStart = groupEnd + 1;
	usize:blockEnd = CFindMatching(program, fileIndex, blockStart);
	usize:comma = CFindTokenAtDepthZero(program, fileIndex, genericStart + 1, genericEnd, PunctuationKind::Comma);
	usize:valueTypeStart = genericStart + 1;
	usize:valueTypeEnd = genericEnd;
	usize:valueNameIndex = genericStart + 1;
	bool:hasIndex = false;
	usize:indexTypeStart = genericStart + 1;
	usize:indexTypeEnd = genericStart + 1;
	usize:indexNameIndex = genericStart + 1;
	if (comma < genericEnd) {
		hasIndex = true;
		usize:indexColon = CFindTopLevelColon(program, fileIndex, genericStart + 1, comma);
		indexTypeStart = genericStart + 1;
		indexTypeEnd = indexColon;
		indexNameIndex = indexColon + 1;
		usize:valueColon = CFindTopLevelColon(program, fileIndex, comma + 1, genericEnd);
		valueTypeStart = comma + 1;
		valueTypeEnd = valueColon;
		valueNameIndex = valueColon + 1;
	} else {
		usize:valueColon = CFindTopLevelColon(program, fileIndex, genericStart + 1, genericEnd);
		valueTypeStart = genericStart + 1;
		valueTypeEnd = valueColon;
		valueNameIndex = valueColon + 1;
	}
	CTypeInfo:valueType;
	Status:status = CRenderTypeInfo(program, fileIndex, valueTypeStart, valueTypeEnd, &valueType);
	if (status != Status::Ok) {
		return(status);
	}
	if (groupStart + 2 < groupEnd && CIsIdentifierText(program, fileIndex, groupStart + 1, "range")) {
		usize:rangeGroup = groupStart + 4;
		while (rangeGroup < groupEnd && !CIsPunctuation(program, fileIndex, rangeGroup, PunctuationKind::LeftParen)) {
			rangeGroup += 1;
		}
		usize:rangeEnd = CFindMatching(program, fileIndex, rangeGroup);
		usize:firstComma = CFindTokenAtDepthZero(program, fileIndex, rangeGroup + 1, rangeEnd, PunctuationKind::Comma);
		usize:secondComma = CFindTokenAtDepthZero(program, fileIndex, firstComma + 1, rangeEnd, PunctuationKind::Comma);
		CExpr:beginExpr;
		CExpr:endExpr;
		CExpr:stepExpr;
		status = CCompileExpressionRange(program, env, fileIndex, rangeGroup + 1, firstComma, std::StringFromCString(""), std::StringFromCString(""), false, &beginExpr);
		usize:rangeValueEnd = rangeEnd;
		if (secondComma < rangeEnd) {
			rangeValueEnd = secondComma;
		}
		if (status == Status::Ok) {
			status = CCompileExpressionRange(program, env, fileIndex, firstComma + 1, rangeValueEnd, std::StringFromCString(""), std::StringFromCString(""), false, &endExpr);
		}
		if (secondComma < rangeEnd) {
			if (status == Status::Ok) {
				status = CCompileExpressionRange(program, env, fileIndex, secondComma + 1, rangeEnd, std::StringFromCString(""), std::StringFromCString(""), false, &stepExpr);
			}
		} else {
			if (status == Status::Ok) {
				CExprInitEmpty(program, &stepExpr);
				status = CExprSetCString(program, &stepExpr, "1");
			}
		}
		if (status == Status::Ok) {
			status = CWriteIndent(out, indent);
		}
		if (status == Status::Ok) {
			status = out.WriteCString("for (");
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&valueType.cType));
		}
		if (status == Status::Ok) {
			status = out.WriteByte(' ');
		}
		if (status == Status::Ok) {
			status = CWriteToken(program, out, fileIndex, valueNameIndex);
		}
		if (status == Status::Ok) {
			status = out.WriteByte('=');
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&beginExpr.text));
		}
		if (status == Status::Ok) {
			status = out.WriteByte(';');
		}
		if (status == Status::Ok) {
			status = CWriteToken(program, out, fileIndex, valueNameIndex);
		}
		if (status == Status::Ok) {
			status = out.WriteByte('<');
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&endExpr.text));
		}
		if (status == Status::Ok) {
			status = out.WriteByte(';');
		}
		if (status == Status::Ok) {
			status = CWriteToken(program, out, fileIndex, valueNameIndex);
		}
		if (status == Status::Ok) {
			status = out.WriteCString("+=");
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&stepExpr.text));
		}
		if (status == Status::Ok) {
			status = out.WriteCString(") {\n");
		}
		if (status == Status::Ok) {
			status = CEnvAdd(program, env, CTokenText(program, fileIndex, valueNameIndex), std::OwnedStringView(&valueType.key), std::OwnedStringView(&valueType.cType), false, std::StringFromCString(""), valueType.isPointer);
		}
		if (status == Status::Ok) {
			status = CWriteBlock(program, out, env, fileIndex, blockStart + 1, blockEnd, indent + 1);
		}
		if (status == Status::Ok) {
			status = CWriteIndent(out, indent);
		}
		if (status == Status::Ok) {
			status = out.WriteCString("}\n");
		}
		CExprDestroy(&beginExpr);
		CExprDestroy(&endExpr);
		CExprDestroy(&stepExpr);
	} else {
		CExpr:arrayExpr;
		status = CCompileExpressionRange(program, env, fileIndex, groupStart + 1, groupEnd, std::StringFromCString(""), std::StringFromCString(""), false, &arrayExpr);
		if (status == Status::Ok) {
			status = CWriteIndent(out, indent);
		}
		if (status == Status::Ok) {
			status = out.WriteCString("for (");
		}
		if (hasIndex) {
			CTypeInfo:indexType;
			if (status == Status::Ok) {
				status = CRenderTypeInfo(program, fileIndex, indexTypeStart, indexTypeEnd, &indexType);
			}
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&indexType.cType));
			}
			if (status == Status::Ok) {
				status = out.WriteByte(' ');
			}
			if (status == Status::Ok) {
				status = CWriteToken(program, out, fileIndex, indexNameIndex);
			}
			if (status == Status::Ok) {
				status = out.WriteCString("=0;");
			}
			if (status == Status::Ok) {
				status = CWriteToken(program, out, fileIndex, indexNameIndex);
			}
			if (status == Status::Ok) {
				status = out.WriteByte('<');
			}
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&arrayExpr.arrayLen));
			}
			if (status == Status::Ok) {
				status = out.WriteByte(';');
			}
			if (status == Status::Ok) {
				status = CWriteToken(program, out, fileIndex, indexNameIndex);
			}
			if (status == Status::Ok) {
				status = out.WriteCString("++) {\n");
			}
			if (status == Status::Ok) {
				status = CEnvAdd(program, env, CTokenText(program, fileIndex, indexNameIndex), std::OwnedStringView(&indexType.key), std::OwnedStringView(&indexType.cType), false, std::StringFromCString(""), indexType.isPointer);
			}
			CTypeInfoDestroy(&indexType);
		} else {
			if (status == Status::Ok) {
				status = out.WriteCString("usize __kek_each_idx=0;__kek_each_idx<");
			}
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&arrayExpr.arrayLen));
			}
			if (status == Status::Ok) {
				status = out.WriteCString(";__kek_each_idx++) {\n");
			}
		}
		if (status == Status::Ok) {
			status = CWriteIndent(out, indent + 1);
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&valueType.cType));
		}
		if (status == Status::Ok) {
			status = out.WriteByte(' ');
		}
		if (status == Status::Ok) {
			status = CWriteToken(program, out, fileIndex, valueNameIndex);
		}
		if (status == Status::Ok) {
			status = out.WriteByte('=');
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&arrayExpr.text));
		}
		if (status == Status::Ok) {
			status = out.WriteByte('[');
		}
		if (hasIndex) {
			if (status == Status::Ok) {
				status = CWriteToken(program, out, fileIndex, indexNameIndex);
			}
		} else {
			if (status == Status::Ok) {
				status = out.WriteCString("__kek_each_idx");
			}
		}
		if (status == Status::Ok) {
			status = out.WriteCString("];\n");
		}
		if (status == Status::Ok) {
			status = CEnvAdd(program, env, CTokenText(program, fileIndex, valueNameIndex), std::OwnedStringView(&valueType.key), std::OwnedStringView(&valueType.cType), false, std::StringFromCString(""), valueType.isPointer);
		}
		if (status == Status::Ok) {
			status = CWriteBlock(program, out, env, fileIndex, blockStart + 1, blockEnd, indent + 1);
		}
		if (status == Status::Ok) {
			status = CWriteIndent(out, indent);
		}
		if (status == Status::Ok) {
			status = out.WriteCString("}\n");
		}
		CExprDestroy(&arrayExpr);
	}
	CTypeInfoDestroy(&valueType);
	outNext[0] = blockEnd + 1;
	return(status);
}

Status:CWriteSwitchStatement(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CEnv>:env, usize:fileIndex, usize:start, ptr<usize>:outNext, usize:indent) {
	usize:groupStart = CFindNextGroup(program, fileIndex, start, CFileTokenCount(program, fileIndex));
	usize:groupEnd = CFindMatching(program, fileIndex, groupStart);
	usize:blockStart = groupEnd + 1;
	usize:blockEnd = CFindMatching(program, fileIndex, blockStart);
	CExpr:value;
	Status:status = CCompileExpressionRange(program, env, fileIndex, groupStart + 1, groupEnd, std::StringFromCString(""), std::StringFromCString(""), false, &value);
	if (status == Status::Ok) {
		status = CWriteIndent(out, indent);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("switch (");
	}
	if (status == Status::Ok) {
		status = out.WriteString(std::OwnedStringView(&value.text));
	}
	if (status == Status::Ok) {
		status = out.WriteCString(") {\n");
	}
	CExprDestroy(&value);
	usize:i = blockStart + 1;
	while (i < blockEnd && status == Status::Ok) {
		if (CIsKeyword(program, fileIndex, i, KeywordKind::Case)) {
			usize:caseGroup = i + 1;
			usize:caseGroupEnd = CFindMatching(program, fileIndex, caseGroup);
			CExpr:caseExpr;
			status = CCompileExpressionRange(program, env, fileIndex, caseGroup + 1, caseGroupEnd, std::StringFromCString(""), std::StringFromCString(""), false, &caseExpr);
			if (status == Status::Ok) {
				status = CWriteIndent(out, indent + 1);
			}
			if (status == Status::Ok) {
				status = out.WriteCString("case ");
			}
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&caseExpr.text));
			}
			if (status == Status::Ok) {
				status = out.WriteCString(": ");
			}
			CExprDestroy(&caseExpr);
			usize:caseBlock = caseGroupEnd + 1;
			if (caseBlock < blockEnd && CIsPunctuation(program, fileIndex, caseBlock, PunctuationKind::Colon)) {
				caseBlock += 1;
			}
			if (caseBlock < blockEnd && CIsPunctuation(program, fileIndex, caseBlock, PunctuationKind::LeftBrace)) {
				usize:caseBlockEnd = CFindMatching(program, fileIndex, caseBlock);
				if (status == Status::Ok) {
					status = out.WriteCString("{\n");
				}
				if (status == Status::Ok) {
					status = CWriteBlock(program, out, env, fileIndex, caseBlock + 1, caseBlockEnd, indent + 2);
				}
				if (status == Status::Ok) {
					status = CWriteIndent(out, indent + 1);
				}
				if (status == Status::Ok) {
					status = out.WriteCString("}\n");
				}
				i = caseBlockEnd + 1;
			} else {
				usize:semicolon = CFindStatementSemicolon(program, fileIndex, caseBlock, blockEnd);
				if (status == Status::Ok) {
					status = out.WriteCString("{\n");
				}
				if (status == Status::Ok) {
					status = CWriteExprStatement(program, out, env, fileIndex, caseBlock, semicolon, indent + 2);
				}
				if (status == Status::Ok) {
					status = CWriteIndent(out, indent + 1);
				}
				if (status == Status::Ok) {
					status = out.WriteCString("}\n");
				}
				i = semicolon + 1;
			}
			continue;
		}
		if (CIsKeyword(program, fileIndex, i, KeywordKind::Default)) {
			status = CWriteIndent(out, indent + 1);
			if (status == Status::Ok) {
				status = out.WriteCString("default: ");
			}
			usize:bodyStart = i + 1;
			if (bodyStart < blockEnd && CIsPunctuation(program, fileIndex, bodyStart, PunctuationKind::Colon)) {
				bodyStart += 1;
			}
			if (bodyStart < blockEnd && CIsPunctuation(program, fileIndex, bodyStart, PunctuationKind::LeftBrace)) {
				usize:bodyEnd = CFindMatching(program, fileIndex, bodyStart);
				if (status == Status::Ok) {
					status = out.WriteCString("{\n");
				}
				if (status == Status::Ok) {
					status = CWriteBlock(program, out, env, fileIndex, bodyStart + 1, bodyEnd, indent + 2);
				}
				if (status == Status::Ok) {
					status = CWriteIndent(out, indent + 1);
				}
				if (status == Status::Ok) {
					status = out.WriteCString("}\n");
				}
				i = bodyEnd + 1;
			} else {
				usize:semicolon = CFindStatementSemicolon(program, fileIndex, bodyStart, blockEnd);
				if (status == Status::Ok) {
					status = out.WriteCString("{\n");
				}
				if (status == Status::Ok) {
					status = CWriteExprStatement(program, out, env, fileIndex, bodyStart, semicolon, indent + 2);
				}
				if (status == Status::Ok) {
					status = CWriteIndent(out, indent + 1);
				}
				if (status == Status::Ok) {
					status = out.WriteCString("}\n");
				}
				i = semicolon + 1;
			}
			continue;
		}
		i += 1;
	}
	if (status == Status::Ok) {
		status = CWriteIndent(out, indent);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("}\n");
	}
	outNext[0] = blockEnd + 1;
	return(status);
}

Status:CWriteReturnStatement(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CEnv>:env, usize:fileIndex, usize:start, usize:semicolon, usize:indent) {
	Status:status = CWriteIndent(out, indent);
	if (status == Status::Ok) {
		status = out.WriteCString("return");
	}
	if (start + 1 < semicolon) {
		CExpr:value;
		if (status == Status::Ok) {
			status = CCompileExpressionRange(program, env, fileIndex, start + 1, semicolon, std::OwnedStringView(&env.returnTypeKey), std::OwnedStringView(&env.returnCType), false, &value);
		}
		if (status == Status::Ok) {
			status = out.WriteByte(' ');
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&value.text));
		}
		if (status == Status::Ok) {
			CExprDestroy(&value);
		}
	}
	if (status == Status::Ok) {
		status = out.WriteCString(";\n");
	}
	return(status);
}

Status:CWriteSingleStatement(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CEnv>:env, usize:fileIndex, usize:start, ptr<usize>:outNext, usize:indent) {
	if (CIsPunctuation(program, fileIndex, start, PunctuationKind::LeftBrace)) {
		usize:blockEnd = CFindMatching(program, fileIndex, start);
		Status:status = CWriteIndent(out, indent);
		if (status == Status::Ok) {
			status = out.WriteCString("{\n");
		}
		if (status == Status::Ok) {
			status = CWriteBlock(program, out, env, fileIndex, start + 1, blockEnd, indent + 1);
		}
		if (status == Status::Ok) {
			status = CWriteIndent(out, indent);
		}
		if (status == Status::Ok) {
			status = out.WriteCString("}\n");
		}
		outNext[0] = blockEnd + 1;
		return(status);
	}
	if (CIsKeyword(program, fileIndex, start, KeywordKind::If)) {
		return(CWriteIfStatement(program, out, env, fileIndex, start, outNext, indent));
	}
	if (CIsKeyword(program, fileIndex, start, KeywordKind::While)) {
		return(CWriteWhileStatement(program, out, env, fileIndex, start, outNext, indent));
	}
	if (CIsKeyword(program, fileIndex, start, KeywordKind::Do)) {
		return(CWriteDoStatement(program, out, env, fileIndex, start, outNext, indent));
	}
	if (CIsKeyword(program, fileIndex, start, KeywordKind::For)) {
		return(CWriteForStatement(program, out, env, fileIndex, start, outNext, indent));
	}
	if (CIsKeyword(program, fileIndex, start, KeywordKind::Each)) {
		return(CWriteEachStatement(program, out, env, fileIndex, start, outNext, indent));
	}
	if (CIsKeyword(program, fileIndex, start, KeywordKind::Switch)) {
		return(CWriteSwitchStatement(program, out, env, fileIndex, start, outNext, indent));
	}
	usize:semicolon = CFindStatementSemicolon(program, fileIndex, start, CFileTokenCount(program, fileIndex));
	if (CIsKeyword(program, fileIndex, start, KeywordKind::Return)) {
		outNext[0] = semicolon + 1;
		return(CWriteReturnStatement(program, out, env, fileIndex, start, semicolon, indent));
	}
	if (CIsKeyword(program, fileIndex, start, KeywordKind::Break)) {
		outNext[0] = semicolon + 1;
		Status:status = CWriteIndent(out, indent);
		if (status == Status::Ok) {
			status = out.WriteCString("break;\n");
		}
		return(status);
	}
	if (CIsKeyword(program, fileIndex, start, KeywordKind::Continue)) {
		outNext[0] = semicolon + 1;
		Status:status = CWriteIndent(out, indent);
		if (status == Status::Ok) {
			status = out.WriteCString("continue;\n");
		}
		return(status);
	}
	if (CIsKeyword(program, fileIndex, start, KeywordKind::Unreachable)) {
		outNext[0] = semicolon + 1;
		Status:status = CWriteIndent(out, indent);
		if (status == Status::Ok) {
			status = out.WriteCString("__builtin_unreachable();\n");
		}
		return(status);
	}
	if (CIsKeyword(program, fileIndex, start, KeywordKind::Panic)) {
		outNext[0] = semicolon + 1;
		usize:groupStart = start + 1;
		usize:groupEnd = CFindMatching(program, fileIndex, groupStart);
		CExpr:message;
		Status:status = CCompileExpressionRange(program, env, fileIndex, groupStart + 1, groupEnd, std::StringFromCString(""), std::StringFromCString(""), false, &message);
		if (status == Status::Ok) {
			status = CWriteIndent(out, indent);
		}
		if (status == Status::Ok) {
			status = out.WriteCString("do { fprintf(stderr, \"panic: %s\\n\", ");
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&message.text));
		}
		if (status == Status::Ok) {
			status = out.WriteCString("); abort(); } while(0);\n");
		}
		CExprDestroy(&message);
		return(status);
	}
	if (CIsKeyword(program, fileIndex, start, KeywordKind::Defer)) {
		outNext[0] = semicolon + 1;
		return(Status::Ok);
	}
	usize:colon = CFindTopLevelColon(program, fileIndex, start, semicolon);
	if (colon < semicolon) {
		outNext[0] = semicolon + 1;
		return(CWriteVarDecl(program, out, env, fileIndex, start, semicolon, indent));
	}
	outNext[0] = semicolon + 1;
	return(CWriteExprStatement(program, out, env, fileIndex, start, semicolon, indent));
}

Status:CWriteDeferred(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CEnv>:env, usize:fileIndex, usize:start, usize:end, usize:indent) {
	if (start >= end || !CIsKeyword(program, fileIndex, start, KeywordKind::Defer)) {
		return(Status::Ok);
	}
	usize:body = start + 1;
	if (body < end && CIsPunctuation(program, fileIndex, body, PunctuationKind::LeftBrace)) {
		usize:blockEnd = CFindMatching(program, fileIndex, body);
		return(CWriteBlock(program, out, env, fileIndex, body + 1, blockEnd, indent));
	}
	usize:semicolon = CFindStatementSemicolon(program, fileIndex, body, end);
	return(CWriteExprStatement(program, out, env, fileIndex, body, semicolon, indent));
}

Status:CWriteBlock(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CEnv>:env, usize:fileIndex, usize:start, usize:end, usize:indent) {
	usize:deferStarts[64] = {0};
	usize:deferEnds[64] = {0};
	usize:deferCount = 0;
	usize:index = start;
	Status:status = Status::Ok;
	while (index < end && status == Status::Ok) {
		if (CIsKeyword(program, fileIndex, index, KeywordKind::Defer)) {
			usize:deferEnd = index + 1;
			if (deferEnd < end && CIsPunctuation(program, fileIndex, deferEnd, PunctuationKind::LeftBrace)) {
				deferEnd = CFindMatching(program, fileIndex, deferEnd) + 1;
			} else {
				deferEnd = CFindStatementSemicolon(program, fileIndex, deferEnd, end) + 1;
			}
			if (deferCount < len(deferStarts)) {
				deferStarts[deferCount] = index;
				deferEnds[deferCount] = deferEnd;
				deferCount += 1;
			}
			index = deferEnd;
			continue;
		}
		usize:next = index + 1;
		status = CWriteSingleStatement(program, out, env, fileIndex, index, &next, indent);
		if (next <= index) {
			next = index + 1;
		}
		index = next;
	}
	while (deferCount > 0 && status == Status::Ok) {
		deferCount -= 1;
		status = CWriteDeferred(program, out, env, fileIndex, deferStarts[deferCount], deferEnds[deferCount], indent);
	}
	return(status);
}

Status:CFuncUseTempTypeUse(ptr<CFuncUse>:funcUse, ptr<CTypeUse>:out) {
	out.key = funcUse.key;
	out.cName = funcUse.cName;
	out.baseName = funcUse.key;
	out.arg0 = funcUse.arg0;
	out.arg1 = funcUse.arg1;
	out.arg2 = funcUse.arg2;
	out.argCount = funcUse.argCount;
	out.emitted = false;
	return(Status::Ok);
}

Status:CWriteSubstTypeForFunc(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CDecl>:decl, ptr<CFuncUse>:funcUse, usize:fileIndex, usize:start, usize:end) {
	CTypeUse:temp;
	CFuncUseTempTypeUse(funcUse, &temp);
	String:firstTypeToken = CTokenText(program, fileIndex, start);
	if (start < end && firstTypeToken.EqualsCString("ptr") && start + 1 < end && CIsOperator(program, fileIndex, start + 1, OperatorKind::Less)) {
		usize:genericEnd = CFindMatching(program, fileIndex, start + 1);
		OwnedString:innerKey;
		Status:innerStatus = CMakeSubstTypeKey(program, decl, &temp, fileIndex, start + 2, genericEnd, &innerKey);
		if (innerStatus == Status::Ok) {
			innerStatus = CWriteCTypeFromKey(program, out, std::OwnedStringView(&innerKey));
		}
		if (innerStatus == Status::Ok) {
			innerStatus = out.WriteByte('*');
		}
		std::DestroyOwnedString(&innerKey);
		return(innerStatus);
	}
	OwnedString:key;
	Status:status = CMakeSubstTypeKey(program, decl, &temp, fileIndex, start, end, &key);
	if (status == Status::Ok) {
		status = CWriteCTypeFromKey(program, out, std::OwnedStringView(&key));
	}
	if (status == Status::Ok) {
		std::DestroyOwnedString(&key);
	}
	return(status);
}

Status:CWriteFunctionSignature(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CDecl>:decl, String:nameOverride, ptr<CFuncUse>:funcUse) {
	String:functionName = CTokenText(program, decl.fileIndex, decl.nameIndex);
	bool:isMain = !decl.hasReceiver && functionName.EqualsCString("main") && CDeclPackageIsRoot(decl);
	Status:status = Status::Ok;
	if (isMain) {
		status = out.WriteCString("int");
	} else {
		if (funcUse != 0) {
			status = CWriteSubstTypeForFunc(program, out, decl, funcUse, decl.fileIndex, decl.returnStart, decl.returnEnd);
		} else {
			CTypeInfo:returnInfo;
			status = CRenderTypeInfo(program, decl.fileIndex, decl.returnStart, decl.returnEnd, &returnInfo);
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&returnInfo.cType));
			}
			if (status == Status::Ok) {
				CTypeInfoDestroy(&returnInfo);
			}
		}
	}
	if (status == Status::Ok) {
		status = out.WriteByte(' ');
	}
	if (status == Status::Ok) {
		if (nameOverride.len > 0) {
			status = out.WriteString(nameOverride);
		} else {
			status = CWriteDeclCName(program, out, decl);
		}
	}
	if (status == Status::Ok) {
		status = out.WriteByte('(');
	}
	bool:first = true;
	if (decl.hasReceiver) {
		if (funcUse != 0) {
			status = CWriteSubstTypeForFunc(program, out, decl, funcUse, decl.fileIndex, decl.receiverStart, decl.receiverEnd);
		} else {
			CTypeInfo:receiverInfo;
			if (status == Status::Ok) {
				status = CRenderTypeInfo(program, decl.fileIndex, decl.receiverStart, decl.receiverEnd, &receiverInfo);
			}
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&receiverInfo.cType));
			}
			if (status == Status::Ok) {
				CTypeInfoDestroy(&receiverInfo);
			}
		}
		if (status == Status::Ok) {
			status = out.WriteCString("* this");
		}
		first = false;
	}
	for (usize:i = 0; i < decl.paramCount; i++) {
		ptr<CParam>:param = &program.params.data[decl.firstParam + i];
		if (!first && status == Status::Ok) {
			status = out.WriteByte(',');
		}
		if (funcUse != 0) {
			if (status == Status::Ok) {
				status = CWriteSubstTypeForFunc(program, out, decl, funcUse, param.fileIndex, param.typeStart, param.typeEnd);
			}
		} else {
			CTypeInfo:paramInfo;
			if (status == Status::Ok) {
				status = CRenderTypeInfo(program, param.fileIndex, param.typeStart, param.typeEnd, &paramInfo);
			}
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&paramInfo.cType));
			}
			if (status == Status::Ok) {
				CTypeInfoDestroy(&paramInfo);
			}
		}
		if (status == Status::Ok) {
			status = out.WriteByte(' ');
		}
		if (status == Status::Ok) {
			status = CWriteToken(program, out, param.fileIndex, param.nameIndex);
		}
		first = false;
	}
	if (first && status == Status::Ok) {
		status = out.WriteCString("void");
	}
	if (status == Status::Ok) {
		status = out.WriteByte(')');
	}
	return(status);
}

Status:CWriteFunctionPrototype(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CDecl>:decl) {
	Status:status = CWriteFunctionSignature(program, out, decl, std::StringFromCString(""), 0);
	if (status == Status::Ok) {
		status = out.WriteCString(";\n");
	}
	return(status);
}

Status:CWriteFunctionBody(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CDecl>:decl) {
	Status:status = CWriteFunctionSignature(program, out, decl, std::StringFromCString(""), 0);
	if (status == Status::Ok) {
		status = out.WriteCString(" {\n");
	}
	CEnv:env;
	if (status == Status::Ok) {
		status = CEnvInit(program, &env);
	}
	CTypeInfo:returnInfo;
	if (status == Status::Ok) {
		status = CRenderTypeInfo(program, decl.fileIndex, decl.returnStart, decl.returnEnd, &returnInfo);
	}
	if (status == Status::Ok) {
		CReplaceOwned(&env.returnTypeKey, returnInfo.key);
		CReplaceOwned(&env.returnCType, returnInfo.cType);
		returnInfo.key.data = 0;
		returnInfo.cType.data = 0;
	}
	if (decl.hasReceiver && status == Status::Ok) {
		CTypeInfo:receiverInfo;
		status = CRenderTypeInfo(program, decl.fileIndex, decl.receiverStart, decl.receiverEnd, &receiverInfo);
		if (status == Status::Ok) {
			env.hasThis = true;
			CReplaceOwned(&env.thisTypeKey, receiverInfo.key);
			CReplaceOwned(&env.thisCType, receiverInfo.cType);
			receiverInfo.key.data = 0;
			receiverInfo.cType.data = 0;
			status = CEnvAdd(program, &env, std::StringFromCString("this"), std::OwnedStringView(&env.thisTypeKey), std::OwnedStringView(&env.thisCType), false, std::StringFromCString(""), true);
		}
		CTypeInfoDestroy(&receiverInfo);
	}
	for (usize:i = 0; i < decl.paramCount && status == Status::Ok; i++) {
		ptr<CParam>:param = &program.params.data[decl.firstParam + i];
		CTypeInfo:paramInfo;
		status = CRenderTypeInfo(program, param.fileIndex, param.typeStart, param.typeEnd, &paramInfo);
		if (status == Status::Ok) {
			status = CEnvAdd(program, &env, CTokenText(program, param.fileIndex, param.nameIndex), std::OwnedStringView(&paramInfo.key), std::OwnedStringView(&paramInfo.cType), false, std::StringFromCString(""), paramInfo.isPointer);
		}
		CTypeInfoDestroy(&paramInfo);
	}
	CTypeInfoDestroy(&returnInfo);
	if (status == Status::Ok) {
		status = CWriteBlock(program, out, &env, decl.fileIndex, decl.bodyStart, decl.bodyEnd, 1);
	}
	CEnvDestroy(&env);
	if (status == Status::Ok) {
		status = out.WriteCString("}\n");
	}
	return(status);
}

Status:CWriteManualLine(ptr<StringBuilder>:out, str:text) {
	Status:status = out.WriteCString(text);
	if (status == Status::Ok) {
		status = out.WriteByte('\n');
	}
	return(status);
}

Status:CWriteArrayMethodRef(ptr<StringBuilder>:out, ptr<CFuncUse>:use, str:name) {
	Status:status = out.WriteCString("Array__");
	if (status == Status::Ok) { status = out.WriteString(std::OwnedStringView(&use.arg0)); }
	if (status == Status::Ok) { status = out.WriteByte('_'); }
	if (status == Status::Ok) { status = out.WriteCString(name); }
	return(status);
}

Status:CWriteLinkedListMethodRef(ptr<StringBuilder>:out, ptr<CFuncUse>:use, str:name) {
	Status:status = out.WriteCString("LinkedList__");
	if (status == Status::Ok) { status = out.WriteString(std::OwnedStringView(&use.arg0)); }
	if (status == Status::Ok) { status = out.WriteByte('_'); }
	if (status == Status::Ok) { status = out.WriteCString(name); }
	return(status);
}

Status:CWriteResultTypeRef(ptr<StringBuilder>:out, ptr<CFuncUse>:use) {
	Status:status = out.WriteCString("struct Result__");
	if (status == Status::Ok) { status = out.WriteString(std::OwnedStringView(&use.arg0)); }
	return(status);
}

Status:CWriteListNodeTypeRef(ptr<StringBuilder>:out, ptr<CFuncUse>:use) {
	Status:status = out.WriteCString("struct ListNode__");
	if (status == Status::Ok) { status = out.WriteString(std::OwnedStringView(&use.arg0)); }
	return(status);
}

Status:CWriteManualArrayGenericBody(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CDecl>:decl, ptr<CFuncUse>:use, String:argC) {
	String:name = CTokenText(program, decl.fileIndex, decl.nameIndex);
	Status:status = Status::Ok;
	if (name.EqualsCString("Destroy")) {
		status = CWriteManualLine(out, "    if(this->data!=0){");
		if (status == Status::Ok) { status = CWriteManualLine(out, "        kek_std_free(this->data);"); }
		if (status == Status::Ok) { status = CWriteManualLine(out, "    }"); }
		if (status == Status::Ok) { status = CWriteManualLine(out, "    this->data=0;"); }
		if (status == Status::Ok) { status = CWriteManualLine(out, "    this->len=0;"); }
		if (status == Status::Ok) { status = CWriteManualLine(out, "    this->cap=0;"); }
		if (status == Status::Ok) { status = CWriteManualLine(out, "    return Status_Ok;"); }
	} else {
		if (name.EqualsCString("Clear")) {
			status = CWriteManualLine(out, "    this->len=0;");
			if (status == Status::Ok) { status = CWriteManualLine(out, "    return Status_Ok;"); }
		} else {
			if (name.EqualsCString("Reserve")) {
				status = CWriteManualLine(out, "    usize needed=this->len+additional;");
				if (status == Status::Ok) { status = CWriteManualLine(out, "    if(needed<=this->cap){return Status_Ok;}"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "    usize newCap=this->cap;"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "    if(newCap==0){newCap=8;}"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "    while(newCap<needed){newCap=newCap*2;}"); }
				if (status == Status::Ok) { status = out.WriteCString("    "); }
				if (status == Status::Ok) { status = out.WriteString(argC); }
				if (status == Status::Ok) { status = out.WriteCString("* newData=("); }
				if (status == Status::Ok) { status = out.WriteString(argC); }
				if (status == Status::Ok) { status = out.WriteCString("*)kek_std_resize("); }
				if (status == Status::Ok) { status = out.WriteByte('\n'); }
				if (status == Status::Ok) { status = out.WriteCString("        this->data,newCap*sizeof("); }
				if (status == Status::Ok) { status = out.WriteString(argC); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "));"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "    if(newData==0){return Status_NoMemory;}"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "    this->data=newData;"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "    this->cap=newCap;"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "    return Status_Ok;"); }
			} else {
				if (name.EqualsCString("AppendSlice")) {
					status = out.WriteCString("    Status status=");
					if (status == Status::Ok) { status = CWriteArrayMethodRef(out, use, "Reserve"); }
					if (status == Status::Ok) { status = CWriteManualLine(out, "(this,items.len);"); }
					if (status == Status::Ok) { status = CWriteManualLine(out, "    if(status!=Status_Ok){return status;}"); }
					if (status == Status::Ok) { status = CWriteManualLine(out, "    for(usize i=0;i<items.len;i++){"); }
					if (status == Status::Ok) { status = CWriteManualLine(out, "        this->data[this->len+i]=items.data[i];"); }
					if (status == Status::Ok) { status = CWriteManualLine(out, "    }"); }
					if (status == Status::Ok) { status = CWriteManualLine(out, "    this->len+=items.len;"); }
					if (status == Status::Ok) { status = CWriteManualLine(out, "    return Status_Ok;"); }
				} else {
					if (name.EqualsCString("Push")) {
						status = out.WriteCString("    Status status=");
						if (status == Status::Ok) { status = CWriteArrayMethodRef(out, use, "Reserve"); }
						if (status == Status::Ok) { status = CWriteManualLine(out, "(this,1);"); }
						if (status == Status::Ok) { status = CWriteManualLine(out, "    if(status!=Status_Ok){return status;}"); }
						if (status == Status::Ok) { status = CWriteManualLine(out, "    this->data[this->len]=value;"); }
						if (status == Status::Ok) { status = CWriteManualLine(out, "    this->len+=1;"); }
						if (status == Status::Ok) { status = CWriteManualLine(out, "    return Status_Ok;"); }
					} else {
						if (name.EqualsCString("PushZeroed")) {
							status = out.WriteCString("    Status status=");
							if (status == Status::Ok) { status = CWriteArrayMethodRef(out, use, "Reserve"); }
							if (status == Status::Ok) { status = CWriteManualLine(out, "(this,1);"); }
							if (status == Status::Ok) { status = CWriteManualLine(out, "    if(status!=Status_Ok){return status;}"); }
							if (status == Status::Ok) { status = out.WriteCString("    kek_std_mem_set((void*)(&this->data[this->len]),0,sizeof("); }
							if (status == Status::Ok) { status = out.WriteString(argC); }
							if (status == Status::Ok) { status = CWriteManualLine(out, "));"); }
							if (status == Status::Ok) { status = CWriteManualLine(out, "    this->len+=1;"); }
							if (status == Status::Ok) { status = CWriteManualLine(out, "    return Status_Ok;"); }
						} else {
							if (name.EqualsCString("Pop")) {
								status = out.WriteCString("    ");
								if (status == Status::Ok) { status = CWriteResultTypeRef(out, use); }
								if (status == Status::Ok) { status = CWriteManualLine(out, " result={0};"); }
								if (status == Status::Ok) { status = CWriteManualLine(out, "    if(this->len==0){result.status=Status_End;return result;}"); }
								if (status == Status::Ok) { status = CWriteManualLine(out, "    this->len-=1;"); }
								if (status == Status::Ok) { status = CWriteManualLine(out, "    result.status=Status_Ok;"); }
								if (status == Status::Ok) { status = CWriteManualLine(out, "    result.value=this->data[this->len];"); }
								if (status == Status::Ok) { status = CWriteManualLine(out, "    return result;"); }
							} else {
								if (name.EqualsCString("Get")) {
									status = out.WriteCString("    ");
									if (status == Status::Ok) { status = CWriteResultTypeRef(out, use); }
									if (status == Status::Ok) { status = CWriteManualLine(out, " result={0};"); }
									if (status == Status::Ok) { status = CWriteManualLine(out, "    if(index>=this->len){result.status=Status_Invalid;return result;}"); }
									if (status == Status::Ok) { status = CWriteManualLine(out, "    result.status=Status_Ok;"); }
									if (status == Status::Ok) { status = CWriteManualLine(out, "    result.value=this->data[index];"); }
									if (status == Status::Ok) { status = CWriteManualLine(out, "    return result;"); }
								} else {
									if (name.EqualsCString("Set")) {
										status = CWriteManualLine(out, "    if(index>=this->len){return Status_Invalid;}");
										if (status == Status::Ok) { status = CWriteManualLine(out, "    this->data[index]=value;"); }
										if (status == Status::Ok) { status = CWriteManualLine(out, "    return Status_Ok;"); }
									} else {
										if (name.EqualsCString("GetPtr")) {
											status = CWriteManualLine(out, "    if(index>=this->len){return 0;}");
											if (status == Status::Ok) { status = CWriteManualLine(out, "    return &this->data[index];"); }
										} else {
											if (name.EqualsCString("LastPtr")) {
												status = CWriteManualLine(out, "    if(this->len==0){return 0;}");
												if (status == Status::Ok) { status = CWriteManualLine(out, "    return &this->data[this->len-1];"); }
											} else {
												if (name.EqualsCString("Span")) {
													status = out.WriteCString("    struct Span__");
													if (status == Status::Ok) { status = out.WriteString(std::OwnedStringView(&use.arg0)); }
													if (status == Status::Ok) { status = CWriteManualLine(out, " out={0};"); }
													if (status == Status::Ok) { status = CWriteManualLine(out, "    out.data=this->data;"); }
													if (status == Status::Ok) { status = CWriteManualLine(out, "    out.len=this->len;"); }
													if (status == Status::Ok) { status = CWriteManualLine(out, "    return out;"); }
												} else {
													if (name.EqualsCString("Slice")) {
														status = out.WriteCString("    struct Slice__");
														if (status == Status::Ok) { status = out.WriteString(std::OwnedStringView(&use.arg0)); }
														if (status == Status::Ok) { status = CWriteManualLine(out, " out={0};"); }
														if (status == Status::Ok) { status = CWriteManualLine(out, "    out.data=this->data;"); }
														if (status == Status::Ok) { status = CWriteManualLine(out, "    out.len=this->len;"); }
														if (status == Status::Ok) { status = CWriteManualLine(out, "    return out;"); }
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
	return(status);
}

Status:CWriteManualLinkedListGenericBody(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CDecl>:decl, ptr<CFuncUse>:use) {
	String:name = CTokenText(program, decl.fileIndex, decl.nameIndex);
	Status:status = Status::Ok;
	if (name.EqualsCString("PushBack") || name.EqualsCString("PushFront")) {
		status = out.WriteCString("    ");
		if (status == Status::Ok) { status = CWriteListNodeTypeRef(out, use); }
		if (status == Status::Ok) { status = out.WriteCString("* node=("); }
		if (status == Status::Ok) { status = CWriteListNodeTypeRef(out, use); }
		if (status == Status::Ok) { status = CWriteManualLine(out, "*)kek_std_alloc("); }
		if (status == Status::Ok) { status = out.WriteCString("        sizeof("); }
		if (status == Status::Ok) { status = CWriteListNodeTypeRef(out, use); }
		if (status == Status::Ok) { status = CWriteManualLine(out, "));"); }
		if (status == Status::Ok) { status = CWriteManualLine(out, "    if(node==0){return Status_NoMemory;}"); }
		if (status == Status::Ok) { status = CWriteManualLine(out, "    node->value=value;"); }
		if (name.EqualsCString("PushBack")) {
			if (status == Status::Ok) { status = CWriteManualLine(out, "    node->next=0;"); }
			if (status == Status::Ok) { status = CWriteManualLine(out, "    node->prev=this->last;"); }
			if (status == Status::Ok) { status = CWriteManualLine(out, "    if(this->last!=0){"); }
			if (status == Status::Ok) { status = out.WriteCString("        "); }
			if (status == Status::Ok) { status = CWriteListNodeTypeRef(out, use); }
			if (status == Status::Ok) { status = CWriteManualLine(out, "* last=this->last;"); }
			if (status == Status::Ok) { status = CWriteManualLine(out, "        last->next=node;"); }
			if (status == Status::Ok) { status = CWriteManualLine(out, "    }else{"); }
			if (status == Status::Ok) { status = CWriteManualLine(out, "        this->first=node;"); }
			if (status == Status::Ok) { status = CWriteManualLine(out, "    }"); }
			if (status == Status::Ok) { status = CWriteManualLine(out, "    this->last=node;"); }
		} else {
			if (status == Status::Ok) { status = CWriteManualLine(out, "    node->prev=0;"); }
			if (status == Status::Ok) { status = CWriteManualLine(out, "    node->next=this->first;"); }
			if (status == Status::Ok) { status = CWriteManualLine(out, "    if(this->first!=0){"); }
			if (status == Status::Ok) { status = out.WriteCString("        "); }
			if (status == Status::Ok) { status = CWriteListNodeTypeRef(out, use); }
			if (status == Status::Ok) { status = CWriteManualLine(out, "* first=this->first;"); }
			if (status == Status::Ok) { status = CWriteManualLine(out, "        first->prev=node;"); }
			if (status == Status::Ok) { status = CWriteManualLine(out, "    }else{"); }
			if (status == Status::Ok) { status = CWriteManualLine(out, "        this->last=node;"); }
			if (status == Status::Ok) { status = CWriteManualLine(out, "    }"); }
			if (status == Status::Ok) { status = CWriteManualLine(out, "    this->first=node;"); }
		}
		if (status == Status::Ok) { status = CWriteManualLine(out, "    this->len+=1;"); }
		if (status == Status::Ok) { status = CWriteManualLine(out, "    return Status_Ok;"); }
	} else {
		if (name.EqualsCString("PopBack") || name.EqualsCString("PopFront")) {
			status = out.WriteCString("    ");
			if (status == Status::Ok) { status = CWriteResultTypeRef(out, use); }
			if (status == Status::Ok) { status = CWriteManualLine(out, " result={0};"); }
			if (name.EqualsCString("PopBack")) {
				if (status == Status::Ok) { status = CWriteManualLine(out, "    if(this->last==0){result.status=Status_End;return result;}"); }
				if (status == Status::Ok) { status = out.WriteCString("    "); }
				if (status == Status::Ok) { status = CWriteListNodeTypeRef(out, use); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "* node=this->last;"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "    result.value=node->value;"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "    this->last=node->prev;"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "    if(this->last!=0){"); }
				if (status == Status::Ok) { status = out.WriteCString("        "); }
				if (status == Status::Ok) { status = CWriteListNodeTypeRef(out, use); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "* last=this->last;"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "        last->next=0;"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "    }else{"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "        this->first=0;"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "    }"); }
			} else {
				if (status == Status::Ok) { status = CWriteManualLine(out, "    if(this->first==0){result.status=Status_End;return result;}"); }
				if (status == Status::Ok) { status = out.WriteCString("    "); }
				if (status == Status::Ok) { status = CWriteListNodeTypeRef(out, use); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "* node=this->first;"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "    result.value=node->value;"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "    this->first=node->next;"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "    if(this->first!=0){"); }
				if (status == Status::Ok) { status = out.WriteCString("        "); }
				if (status == Status::Ok) { status = CWriteListNodeTypeRef(out, use); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "* first=this->first;"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "        first->prev=0;"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "    }else{"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "        this->last=0;"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "    }"); }
			}
			if (status == Status::Ok) { status = CWriteManualLine(out, "    this->len-=1;"); }
			if (status == Status::Ok) { status = CWriteManualLine(out, "    kek_std_free(node);"); }
			if (status == Status::Ok) { status = CWriteManualLine(out, "    result.status=Status_Ok;"); }
			if (status == Status::Ok) { status = CWriteManualLine(out, "    return result;"); }
		} else {
			if (name.EqualsCString("Destroy")) {
				status = CWriteManualLine(out, "    while(this->len>0){");
				if (status == Status::Ok) { status = out.WriteCString("        "); }
				if (status == Status::Ok) { status = CWriteResultTypeRef(out, use); }
				if (status == Status::Ok) { status = CWriteManualLine(out, " ignored={0};"); }
				if (status == Status::Ok) { status = out.WriteCString("        ignored="); }
				if (status == Status::Ok) { status = CWriteLinkedListMethodRef(out, use, "PopBack"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "(this);"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "        if(ignored.status!=Status_Ok){return ignored.status;}"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "    }"); }
				if (status == Status::Ok) { status = CWriteManualLine(out, "    return Status_Ok;"); }
			}
		}
	}
	return(status);
}

Status:CWriteManualGenericBody(ptr<CProgram>:program, ptr<StringBuilder>:out, ptr<CDecl>:decl, ptr<CFuncUse>:use) {
	String:name = CTokenText(program, decl.fileIndex, decl.nameIndex);
	OwnedString:argC;
	Status:status = CMakeCTypeFromKey(program, std::OwnedStringView(&use.arg0), &argC);
	if (status != Status::Ok) {
		return(status);
	}
	status = CWriteFunctionSignature(program, out, decl, std::OwnedStringView(&use.cName), use);
	if (status == Status::Ok) {
		status = out.WriteCString(" {\n");
	}
	bool:handled = false;
	if (decl.hasReceiver && status == Status::Ok) {
		String:receiverBase = CTokenText(program, decl.fileIndex, decl.receiverStart);
		if (receiverBase.EqualsCString("Array")) {
			status = CWriteManualArrayGenericBody(program, out, decl, use, std::OwnedStringView(&argC));
			handled = true;
		} else {
			if (receiverBase.EqualsCString("LinkedList")) {
				status = CWriteManualLinkedListGenericBody(program, out, decl, use);
				handled = true;
			}
		}
	}
	if (!handled && name.EqualsCString("FixedSlice")) {
		if (status == Status::Ok) {
			status = out.WriteCString("    struct Slice__");
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&use.arg0));
		}
		if (status == Status::Ok) {
			status = out.WriteCString(" out={0};\n    out.data=data;\n    out.len=len;\n    return out;\n");
		}
	} else {
		if (name.EqualsCString("FixedSpan")) {
			if (status == Status::Ok) {
				status = out.WriteCString("    struct Span__");
			}
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&use.arg0));
			}
			if (status == Status::Ok) {
				status = out.WriteCString(" out={0};\n    out.data=data;\n    out.len=len;\n    return out;\n");
			}
		} else {
				if (name.EqualsCString("ArrayNew")) {
					if (status == Status::Ok) { status = out.WriteCString("    struct Array__"); }
					if (status == Status::Ok) { status = out.WriteString(std::OwnedStringView(&use.arg0)); }
					if (status == Status::Ok) { status = CWriteManualLine(out, " array={0};"); }
					if (status == Status::Ok) { status = CWriteManualLine(out, "    array.allocator=allocator;"); }
					if (status == Status::Ok) { status = CWriteManualLine(out, "    return array;"); }
				} else {
					if (name.EqualsCString("LinkedListNew")) {
						if (status == Status::Ok) { status = out.WriteCString("    struct LinkedList__"); }
						if (status == Status::Ok) { status = out.WriteString(std::OwnedStringView(&use.arg0)); }
						if (status == Status::Ok) { status = CWriteManualLine(out, " list={0};"); }
						if (status == Status::Ok) { status = CWriteManualLine(out, "    list.allocator=allocator;"); }
						if (status == Status::Ok) { status = CWriteManualLine(out, "    return list;"); }
					} else {
			if (name.EqualsCString("Alloc")) {
				if (status == Status::Ok) {
					status = out.WriteCString("    (void)allocator;\n");
				}
				if (status == Status::Ok) {
					status = out.WriteCString("    return (");
				}
				if (status == Status::Ok) {
					status = out.WriteString(std::OwnedStringView(&argC));
				}
				if (status == Status::Ok) {
					status = out.WriteCString("*)kek_std_alloc(count*sizeof(");
				}
				if (status == Status::Ok) {
					status = out.WriteString(std::OwnedStringView(&argC));
				}
				if (status == Status::Ok) {
					status = out.WriteCString("));\n");
				}
			} else {
				if (name.EqualsCString("Resize")) {
					if (status == Status::Ok) {
						status = out.WriteCString("    (void)allocator;\n    (void)oldCount;\n");
					}
					if (status == Status::Ok) {
						status = out.WriteCString("    return (");
					}
					if (status == Status::Ok) {
						status = out.WriteString(std::OwnedStringView(&argC));
					}
					if (status == Status::Ok) {
						status = out.WriteCString("*)kek_std_resize(oldData,newCount*sizeof(");
					}
					if (status == Status::Ok) {
						status = out.WriteString(std::OwnedStringView(&argC));
					}
					if (status == Status::Ok) {
						status = out.WriteCString("));\n");
					}
				} else {
					if (name.EqualsCString("Free")) {
						if (status == Status::Ok) {
							status = out.WriteCString("    (void)allocator;\n    (void)count;\n    kek_std_free(data);\n");
						}
					} else {
						if (name.EqualsCString("Copy")) {
							if (status == Status::Ok) {
								status = out.WriteCString("    kek_std_mem_copy(dest,src,count*sizeof(");
							}
							if (status == Status::Ok) {
								status = out.WriteString(std::OwnedStringView(&argC));
							}
							if (status == Status::Ok) {
								status = out.WriteCString("));\n");
							}
						} else {
							if (name.EqualsCString("GenericAdd")) {
								if (status == Status::Ok) {
									status = out.WriteCString("    return left+right;\n");
								}
							} else {
								if (name.EqualsCString("PkgGenericEcho")) {
									if (status == Status::Ok) {
										status = out.WriteCString("    return value;\n");
									}
								} else {
									if (name.EqualsCString("Ok")) {
										if (status == Status::Ok) {
											status = out.WriteCString("    struct Result__");
										}
										if (status == Status::Ok) {
											status = out.WriteString(std::OwnedStringView(&use.arg0));
										}
										if (status == Status::Ok) {
											status = out.WriteCString(" out={0};\n    out.status=Status_Ok;\n    out.value=value;\n    return out;\n");
										}
									} else {
										if (name.EqualsCString("Err")) {
											if (status == Status::Ok) {
												status = out.WriteCString("    struct Result__");
											}
											if (status == Status::Ok) {
												status = out.WriteString(std::OwnedStringView(&use.arg0));
											}
											if (status == Status::Ok) {
												status = out.WriteCString(" out={0};\n    out.status=status;\n    return out;\n");
											}
										}
									}
								}
							}
						}
					}
				}
			}
				}
			}
		}
	}
	if (status == Status::Ok) {
		status = out.WriteCString("}\n");
	}
	std::DestroyOwnedString(&argC);
	return(status);
}

Status:CWriteFunctionDeclarations(ptr<CProgram>:program, ptr<StringBuilder>:out) {
	for (usize:i = 0; i < program.decls.len; i++) {
		ptr<CDecl>:decl = &program.decls.data[i];
		if (decl.kind == CDeclKind::Function && !decl.isGeneric && decl.reachable) {
			Status:status = CWriteFunctionPrototype(program, out, decl);
			if (status != Status::Ok) {
				return(status);
			}
		}
	}
	for (usize:i = 0; i < program.funcUses.len; i++) {
		ptr<CFuncUse>:use = &program.funcUses.data[i];
		if (use.declIndex < program.decls.len) {
			Status:status = CWriteFunctionSignature(program, out, &program.decls.data[use.declIndex], std::OwnedStringView(&use.cName), use);
			if (status == Status::Ok) {
				status = out.WriteCString(";\n");
			}
			if (status != Status::Ok) {
				return(status);
			}
		}
	}
	return(Status::Ok);
}

Status:CWriteFunctionDefinitions(ptr<CProgram>:program, ptr<StringBuilder>:out) {
	for (usize:i = 0; i < program.funcUses.len; i++) {
		ptr<CFuncUse>:use = &program.funcUses.data[i];
		if (use.declIndex < program.decls.len) {
			Status:status = CWriteManualGenericBody(program, out, &program.decls.data[use.declIndex], use);
			if (status != Status::Ok) {
				return(status);
			}
		}
	}
	for (usize:i = 0; i < program.decls.len; i++) {
		ptr<CDecl>:decl = &program.decls.data[i];
		if (decl.kind == CDeclKind::Function && !decl.isGeneric && decl.hasBody && decl.reachable) {
			Status:status = CWriteFunctionBody(program, out, decl);
			if (status != Status::Ok) {
				return(status);
			}
		}
	}
	return(Status::Ok);
}

Status:CWriteProgram(ptr<CProgram>:program, ptr<StringBuilder>:out) {
	Status:status = CWritePrelude(out);
	if (status == Status::Ok) {
		status = CWriteTypeDeclarations(program, out);
	}
	if (status == Status::Ok) {
		status = out.WriteByte('\n');
	}
	if (status == Status::Ok) {
		status = CWriteFunctionDeclarations(program, out);
	}
	if (status == Status::Ok) {
		status = out.WriteByte('\n');
	}
	if (status == Status::Ok) {
		status = CWriteFunctionDefinitions(program, out);
	}
	return(status);
}

Status:CompileToCString(str:inputPath, Allocator:allocator, ptr<StringBuilder>:out, ptr<DiagnosticBag>:diagnostics) {
	CProgram:program;
	Status:status = CProgramInit(&program, allocator);
	if (status != Status::Ok) {
		return(status);
	}
	status = CLoadAndTokenize(&program, inputPath);
	if (status == Status::Ok) {
		status = CParseDeclarations(&program);
	}
	if (status == Status::Ok) {
		status = CMarkReachableDecls(&program);
	}
	if (status == Status::Ok) {
		status = CCollectTypeUses(&program);
	}
	if (status == Status::Ok) {
		status = CCollectGenericFunctionUses(&program);
	}
	if (status == Status::Ok) {
		status = CWriteProgram(&program, out);
	}
	if (program.diagnostics.items.len > 0) {
		for (usize:i = 0; i < program.diagnostics.items.len; i++) {
			ptr<Diagnostic>:item = &program.diagnostics.items.data[i];
			diagnostics::DiagnosticAdd(diagnostics, item.severity, item.phase, item.fileIndex, item.location, std::OwnedStringView(&item.message));
		}
	}
	CProgramDestroy(&program);
	return(status);
}

Status:CompileToC(str:inputPath, str:outputPath, Allocator:allocator, ptr<DiagnosticBag>:diagnostics) {
	StringBuilder:generated = std::StringBuilderNew(allocator);
	Status:status = CompileToCString(inputPath, allocator, &generated, diagnostics);
	if (status == Status::Ok) {
		String:view = generated.View();
		status = std::WriteFile(outputPath, view);
	}
	generated.Destroy();
	return(status);
}

Status:CompileToCStringWithoutDiagnostics(str:inputPath, Allocator:allocator, ptr<StringBuilder>:out) {
	DiagnosticBag:diagnostics;
	diagnostics::DiagnosticBagInit(&diagnostics, allocator);
	Status:status = CompileToCString(inputPath, allocator, out, &diagnostics);
	diagnostics::DiagnosticBagDestroy(&diagnostics);
	return(status);
}

Status:WriteCompileDiagnostics(str:inputPath, Allocator:allocator, ptr<StringBuilder>:out) {
	StringBuilder:generated = std::StringBuilderNew(allocator);
	DiagnosticBag:diagnostics;
	diagnostics::DiagnosticBagInit(&diagnostics, allocator);
	Status:status = CompileToCString(inputPath, allocator, &generated, &diagnostics);
	Status:writeStatus = Status::Ok;
	if (diagnostics.items.len > 0) {
		writeStatus = diagnostics::WriteDiagnosticDump(&diagnostics, out);
	} else {
		if (status != Status::Ok) {
			writeStatus = out.WriteCString("diag|2|4|-1|0|0|0|0|compile failed\n");
		}
	}
	generated.Destroy();
	diagnostics::DiagnosticBagDestroy(&diagnostics);
	if (writeStatus != Status::Ok) {
		return(writeStatus);
	}
	return(Status::Ok);
}

Status:CompilerRunBuild(str:inputPath, str:outputPath) {
	Allocator:allocator = std::DefaultAllocator();
	DiagnosticBag:diagnostics;
	diagnostics::DiagnosticBagInit(&diagnostics, allocator);
	Status:status = CompileToC(inputPath, outputPath, allocator, &diagnostics);
	if (diagnostics.items.len > 0) {
		StringBuilder:dump = std::StringBuilderNew(allocator);
		diagnostics::WriteDiagnosticDump(&diagnostics, &dump);
		File:stderr = std::Stderr();
		String:view = dump.View();
		stderr.Write(view.Bytes());
		dump.Destroy();
	}
	diagnostics::DiagnosticBagDestroy(&diagnostics);
	return(status);
}

int:CompilerMain(int:argc, ptr<str>:argv) {
	if (argc < 2) {
		return(CompilerFail("missing command\n"));
	}
	String:command = std::StringFromCString(argv[1]);
	if (command.EqualsCString("--help")) {
		return(CompilerPrintHelp());
	}
	if (command.EqualsCString("--version")) {
		File:stdout = std::Stdout();
		std::WriteStringToFile(&stdout, std::StringFromCString("0.3.0-self\n"));
		return(0);
	}
	if (!command.EqualsCString("build")) {
		return(CompilerFail("unknown command\n"));
	}
	if (argc < 3) {
		return(CompilerFail("missing input\n"));
	}
	str:inputPath = argv[2];
	str:outputPath = "out.kek.c";
	usize:i = 3;
	while (i < cast<usize>(argc)) {
		String:arg = std::StringFromCString(argv[i]);
		if (arg.EqualsCString("-o")) {
			if (i + 1 >= cast<usize>(argc)) {
				return(CompilerFail("missing -o value\n"));
			}
			outputPath = argv[i + 1];
			i += 2;
			continue;
		}
		return(CompilerFail("unknown build option\n"));
	}
	Status:status = CompilerRunBuild(inputPath, outputPath);
	if (status != Status::Ok) {
		return(CompilerFail("build failed\n"));
	}
	return(0);
}
