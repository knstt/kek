#import(kek/codegen_state.kek);

struct:CodeWriter {
	ptr<StringBuilder>:out;
	Status:status;
};

CodeWriter:CodeWriterNew(ptr<StringBuilder>:out) {
	CodeWriter:writer;
	writer.out = out;
	writer.status = Status::Ok;
	return(writer);
}

void:CodeWriter::CString(str:text) {
	if (this.status == Status::Ok) {
		this.status = this.out.WriteCString(text);
	}
}

void:CodeWriter::String(String:text) {
	if (this.status == Status::Ok) {
		this.status = this.out.WriteString(text);
	}
}

void:CodeWriter::Byte(byte:value) {
	if (this.status == Status::Ok) {
		this.status = this.out.WriteByte(value);
	}
}

void:CodeWriter::Indent(usize:indent) {
	if (this.status == Status::Ok) {
		this.status = WriteIndent(this.out, indent);
	}
}

void:CodeWriter::Token(ptr<CompilerContext>:program, usize:fileIndex, usize:index) {
	if (this.status == Status::Ok) {
		this.status = WriteToken(program, this.out, fileIndex, index);
	}
}

void:CodeWriter::TokenRangeRaw(ptr<CompilerContext>:program, usize:fileIndex, usize:start, usize:end) {
	if (this.status == Status::Ok) {
		this.status = WriteTokenRangeRaw(program, this.out, fileIndex, start, end);
	}
}

Status:WritePrelude(ptr<StringBuilder>:out) {
	TemplateArg:args[1] = {
		std::TemplateArgNew(std::StringFromCString("ptr_type"), std::StringFromCString("void*")),
	};
	TemplateContext:ctx = std::TemplateContextNew(args, len(args), 0, 0);
	return(std::RenderTemplateToBuilder(out, std::StringFromCString("""#include <assert.h>
#include <stdint.h>
#include <stddef.h>
#include <stdbool.h>

typedef uint8_t u8;
typedef uint16_t u16;
typedef uint32_t u32;
typedef uint64_t u64;
typedef int8_t i8;
typedef int16_t i16;
typedef int32_t i32;
typedef int64_t i64;
typedef float f32;
typedef double f64;
typedef {ptr_type} ptr;
typedef const char* str;

"""), ctx));
}

Status:WriteIndent(ptr<StringBuilder>:out, usize:indent) {
	return(out.WriteIndent(indent * 4));
}

Status:WriteManualLine(ptr<StringBuilder>:out, str:text) {
	CodeWriter:w = CodeWriterNew(out);
	w.CString(text);
	w.Byte('\n');
	return(w.status);
}
