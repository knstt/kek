#import(std/core.kek);
#import(std/mem.kek);
#import(std/string.kek);
#import(std/array.kek);
#import(std/format.kek);

enum:u8:DiagnosticSeverity {
	Note,
	Warning,
	Error,
};

enum:u8:DiagnosticPhase {
	Source,
	Lex,
	Parse,
	TypedParse,
	Semantic,
	Codegen,
};

struct:SourceLocation {
	usize:line;
	usize:column;
	usize:offset;
	usize:length;
};

struct:Diagnostic {
	DiagnosticSeverity:severity;
	DiagnosticPhase:phase;
	i64:fileIndex;
	SourceLocation:location;
	OwnedString:message;
};

struct:DiagnosticBag {
	Array<Diagnostic>:items;
	usize:errorCount;
};

SourceLocation:SourceLocationNew(usize:line, usize:column, usize:offset, usize:length) {
	SourceLocation:location;
	location.line = line;
	location.column = column;
	location.offset = offset;
	location.length = length;
	return(location);
}

void:DiagnosticBagInit(ptr<DiagnosticBag>:bag, Allocator:allocator) {
	bag.items = std::ArrayNew<Diagnostic>(allocator);
	bag.errorCount = 0;
}

Status:DiagnosticBagDestroy(ptr<DiagnosticBag>:bag) {
	for (usize:i = 0; i < bag.items.len; i++) {
		std::DestroyOwnedString(&bag.items.data[i].message);
	}
	Array<Diagnostic>:items = bag.items;
	Status:status = items.Destroy();
	bag.items = items;
	bag.errorCount = 0;
	return(status);
}

Status:DiagnosticBagReserve(ptr<DiagnosticBag>:bag, usize:additional) {
	Array<Diagnostic>:items = bag.items;
	Status:status = items.Reserve(additional);
	bag.items = items;
	return(status);
}

Status:DiagnosticAdd(ptr<DiagnosticBag>:bag, DiagnosticSeverity:severity, DiagnosticPhase:phase, i64:fileIndex, SourceLocation:location, String:message) {
	Status:status = DiagnosticBagReserve(bag, 1);
	if (status != Status::Ok) {
		return(status);
	}
	ptr<Diagnostic>:diagnostic = &bag.items.data[bag.items.len];
	diagnostic.severity = severity;
	diagnostic.phase = phase;
	diagnostic.fileIndex = fileIndex;
	diagnostic.location = location;
	status = std::CloneString(message, bag.items.allocator, &diagnostic.message);
	if (status != Status::Ok) {
		return(status);
	}
	bag.items.len += 1;
	if (severity == DiagnosticSeverity::Error) {
		bag.errorCount += 1;
	}
	return(Status::Ok);
}

Status:DiagnosticAddCString(ptr<DiagnosticBag>:bag, DiagnosticSeverity:severity, DiagnosticPhase:phase, i64:fileIndex, SourceLocation:location, str:message) {
	return(DiagnosticAdd(bag, severity, phase, fileIndex, location, std::StringFromCString(message)));
}

Status:DiagnosticAddPathMessage(ptr<DiagnosticBag>:bag, DiagnosticSeverity:severity, DiagnosticPhase:phase, i64:fileIndex, SourceLocation:location, str:prefix, String:path) {
	StringBuilder:builder = std::StringBuilderNew(bag.items.allocator);
	Status:status = builder.WriteCString(prefix);
	if (status == Status::Ok) {
		status = builder.WriteString(path);
	}
	if (status != Status::Ok) {
		builder.Destroy();
		return(status);
	}
	String:message = builder.View();
	status = DiagnosticAdd(bag, severity, phase, fileIndex, location, message);
	builder.Destroy();
	return(status);
}

Status:WriteU64Field(ptr<StringBuilder>:out, u64:value, bool:separator) {
	Status:status = std::FormatU64ToBuilder(out, value, 10);
	if (status != Status::Ok) {
		return(status);
	}
	if (separator) {
		return(out.WriteByte('|'));
	}
	return(Status::Ok);
}

Status:WriteI64Field(ptr<StringBuilder>:out, i64:value, bool:separator) {
	Status:status = std::FormatI64ToBuilder(out, value);
	if (status != Status::Ok) {
		return(status);
	}
	if (separator) {
		return(out.WriteByte('|'));
	}
	return(Status::Ok);
}

Status:WriteDiagnosticDump(ptr<DiagnosticBag>:bag, ptr<StringBuilder>:out) {
	for (usize:i = 0; i < bag.items.len; i++) {
		ptr<Diagnostic>:diagnostic = &bag.items.data[i];
		Status:status = out.WriteCString("diag|");
		if (status != Status::Ok) {
			return(status);
		}
		status = WriteU64Field(out, cast<u64>(diagnostic.severity), true);
		if (status != Status::Ok) {
			return(status);
		}
		status = WriteU64Field(out, cast<u64>(diagnostic.phase), true);
		if (status != Status::Ok) {
			return(status);
		}
		status = WriteI64Field(out, diagnostic.fileIndex, true);
		if (status != Status::Ok) {
			return(status);
		}
		status = WriteU64Field(out, cast<u64>(diagnostic.location.line), true);
		if (status != Status::Ok) {
			return(status);
		}
		status = WriteU64Field(out, cast<u64>(diagnostic.location.column), true);
		if (status != Status::Ok) {
			return(status);
		}
		status = WriteU64Field(out, cast<u64>(diagnostic.location.offset), true);
		if (status != Status::Ok) {
			return(status);
		}
		status = WriteU64Field(out, cast<u64>(diagnostic.location.length), true);
		if (status != Status::Ok) {
			return(status);
		}
		String:message = std::OwnedStringView(&diagnostic.message);
		status = out.WriteString(message);
		if (status != Status::Ok) {
			return(status);
		}
		status = out.WriteByte('\n');
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(Status::Ok);
}
