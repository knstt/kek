#import(std/core.kek);
#import(std/mem.kek);
#import(std/string.kek);
#import(std/array.kek);
#import(std/file.kek);
#import(kek/diagnostics.kek);

struct:SourceFile {
	OwnedString:path;
	OwnedString:content;
	usize:fileIndex;
};

struct:FileTable {
	Array<SourceFile>:files;
};

void:FileTableInit(ptr<FileTable>:table, Allocator:allocator) {
	table.files = std::ArrayNew<SourceFile>(allocator);
}

Status:FileTableDestroy(ptr<FileTable>:table) {
	for (usize:i = 0; i < table.files.len; i++) {
		std::DestroyOwnedString(&table.files.data[i].path);
		std::DestroyOwnedString(&table.files.data[i].content);
	}
	Array<SourceFile>:files = table.files;
	Status:status = files.Destroy();
	table.files = files;
	return(status);
}

bool:StringEndsWithCString(String:text, str:suffixText) {
	String:suffix = std::StringFromCString(suffixText);
	return(text.EndsWith(suffix));
}

Status:NormalizePath(String:path, Allocator:allocator, ptr<OwnedString>:out) {
	StringBuilder:builder = std::StringBuilderNew(allocator);
	bool:previousSlash = false;
	usize:i = 0;
	while (i < path.len) {
		byte:c = path.data[i];
		if (c == '\\') {
			c = '/';
		}
		if (c == '/' && previousSlash) {
			i += 1;
			continue;
		}
		if (c == '.' && i + 1 < path.len && path.data[i + 1] == '/') {
			i += 2;
			continue;
		}
		Status:status = builder.WriteByte(c);
		if (status != Status::Ok) {
			builder.Destroy();
			return(status);
		}
		previousSlash = c == '/';
		i += 1;
	}
	Status:termStatus = builder.WriteByte(0);
	if (termStatus != Status::Ok) {
		builder.Destroy();
		return(termStatus);
	}
	Result<OwnedString>:detached = builder.Detach();
	if (detached.status != Status::Ok) {
		builder.Destroy();
		return(detached.status);
	}
	out.data = detached.value.data;
	out.len = detached.value.len - 1;
	out.cap = detached.value.cap;
	out.allocator = detached.value.allocator;
	return(Status::Ok);
}

bool:FileAlreadyLoaded(ptr<FileTable>:table, String:path) {
	for (usize:i = 0; i < table.files.len; i++) {
		String:filePath = std::OwnedStringView(&table.files.data[i].path);
		if (filePath.Equals(path)) {
			return(true);
		}
	}
	return(false);
}

Status:FileTableReserve(ptr<FileTable>:table, usize:additional) {
	Array<SourceFile>:files = table.files;
	Status:status = files.Reserve(additional);
	table.files = files;
	return(status);
}

Status:AddSourceDiagnostic(ptr<DiagnosticBag>:diagnostics, str:message) {
	return(diagnostics::DiagnosticAddCString(diagnostics, DiagnosticSeverity::Error, DiagnosticPhase::Source, -1, diagnostics::SourceLocationNew(0, 0, 0, 0), message));
}

Status:ReadFile(String:path, ptr<FileTable>:table, ptr<DiagnosticBag>:diagnostics) {
	OwnedString:normalized;
	Status:status = NormalizePath(path, table.files.allocator, &normalized);
	if (status != Status::Ok) {
		return(status);
	}

	String:normalizedPath = std::OwnedStringView(&normalized);
	if (FileAlreadyLoaded(table, normalizedPath)) {
		std::DestroyOwnedString(&normalized);
		return(Status::Ok);
	}
	status = FileTableReserve(table, 1);
	if (status != Status::Ok) {
		std::DestroyOwnedString(&normalized);
		return(status);
	}

	Result<File>:opened = std::FileOpen(cast<str>(normalized.data), FileMode::Read);
	if (opened.status != Status::Ok) {
		status = diagnostics::DiagnosticAddPathMessage(diagnostics, DiagnosticSeverity::Error, DiagnosticPhase::Source, -1, diagnostics::SourceLocationNew(0, 0, 0, 0), "could not open file ", normalizedPath);
		std::DestroyOwnedString(&normalized);
		return(status);
	}

	OwnedString:content;
	File:file = opened.value;
	status = std::ReadAllToOwnedString(file, table.files.allocator, &content);
	Status:closeStatus = file.Close();
	if (status != Status::Ok) {
		diagnostics::DiagnosticAddPathMessage(diagnostics, DiagnosticSeverity::Error, DiagnosticPhase::Source, -1, diagnostics::SourceLocationNew(0, 0, 0, 0), "could not read file ", normalizedPath);
		std::DestroyOwnedString(&normalized);
		return(status);
	}
	if (closeStatus != Status::Ok) {
		std::DestroyOwnedString(&content);
		std::DestroyOwnedString(&normalized);
		return(closeStatus);
	}

	ptr<SourceFile>:source = &table.files.data[table.files.len];
	source.path = normalized;
	source.content = content;
	source.fileIndex = table.files.len;
	table.files.len += 1;
	return(Status::Ok);
}

bool:ImportDirectiveAt(String:source, usize:cursor) {
	usize:lineStart = cursor;
	while (lineStart > 0 && source.data[lineStart - 1] != '\n' && source.data[lineStart - 1] != '\r') {
		lineStart -= 1;
	}
	for (usize:i = lineStart; i < cursor; i++) {
		byte:c = source.data[i];
		if (c != ' ' && c != '\t') {
			return(false);
		}
	}
	return(true);
}

Status:LoadImportFile(ptr<FileTable>:table, String:path, ptr<DiagnosticBag>:diagnostics, i64:fileIndex, SourceLocation:location) {
	if (!StringEndsWithCString(path, ".kek")) {
		return(diagnostics::DiagnosticAddPathMessage(diagnostics, DiagnosticSeverity::Error, DiagnosticPhase::Source, fileIndex, location, "import path must name a .kek file ", path));
	}
	usize:before = table.files.len;
	Status:status = ReadFile(path, table, diagnostics);
	if (status != Status::Ok) {
		return(status);
	}
	if (table.files.len > before) {
		return(LoadImports(table, &table.files.data[before], diagnostics));
	}
	return(Status::Ok);
}

Status:LoadImports(ptr<FileTable>:table, ptr<SourceFile>:file, ptr<DiagnosticBag>:diagnostics) {
	String:source = std::OwnedStringView(&file.content);
	usize:currentFileIndex = file.fileIndex;
	String:prefix = std::StringFromCString("#import");
	usize:cursor = 0;
	while (cursor + prefix.len + 1 <= source.len) {
		bool:matched = true;
		for (usize:i = 0; i < prefix.len; i++) {
			if (source.data[cursor + i] != prefix.data[i]) {
				matched = false;
				break;
			}
		}
		if (!matched) {
			cursor += 1;
			continue;
		}

		if (!ImportDirectiveAt(source, cursor)) {
			cursor += 1;
			continue;
		}

		if (source.data[cursor + prefix.len] != '(') {
			cursor += 1;
			continue;
		}

		usize:start = cursor + prefix.len + 1;
		usize:end = start;
		while (end < source.len && source.data[end] != ')') {
			end += 1;
		}
		SourceLocation:location = diagnostics::SourceLocationNew(1, 1, cursor, prefix.len);
		if (end >= source.len) {
			return(diagnostics::DiagnosticAddCString(diagnostics, DiagnosticSeverity::Error, DiagnosticPhase::Source, cast<i64>(currentFileIndex), location, "unterminated import"));
		}
		usize:length = end - start;
		if (length == 0) {
			return(diagnostics::DiagnosticAddCString(diagnostics, DiagnosticSeverity::Error, DiagnosticPhase::Source, cast<i64>(currentFileIndex), location, "invalid import path"));
		}
		String:importPath = source.Slice(start, length);
		Status:status = LoadImportFile(table, importPath, diagnostics, cast<i64>(currentFileIndex), location);
		if (status != Status::Ok) {
			return(status);
		}
		cursor = end + 1;
	}
	return(Status::Ok);
}

Status:LoadCompilationSources(str:entryPath, Allocator:allocator, ptr<FileTable>:table, ptr<DiagnosticBag>:diagnostics) {
	FileTableInit(table, allocator);
	Status:status = ReadFile(std::StringFromCString(entryPath), table, diagnostics);
	if (status != Status::Ok) {
		return(status);
	}
	return(LoadImports(table, &table.files.data[0], diagnostics));
}

Status:WriteSourceDump(ptr<FileTable>:table, ptr<DiagnosticBag>:diagnostics, ptr<StringBuilder>:out) {
	for (usize:i = 0; i < table.files.len; i++) {
		ptr<SourceFile>:file = &table.files.data[i];
		Status:status = out.WriteCString("file|");
		if (status != Status::Ok) {
			return(status);
		}
		status = diagnostics::WriteU64Field(out, cast<u64>(file.fileIndex), true);
		if (status != Status::Ok) {
			return(status);
		}
		String:filePath = std::OwnedStringView(&file.path);
		status = out.WriteString(filePath);
		if (status != Status::Ok) {
			return(status);
		}
		status = out.WriteByte('|');
		if (status != Status::Ok) {
			return(status);
		}
		status = diagnostics::WriteU64Field(out, cast<u64>(file.content.len), false);
		if (status != Status::Ok) {
			return(status);
		}
		status = out.WriteByte('\n');
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(diagnostics::WriteDiagnosticDump(diagnostics, out));
}
