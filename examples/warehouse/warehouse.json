{
  "version": 1,
  "enums": [
    {
      "name": "Direction",
      "values": ["None", "North", "South", "West", "East"]
    },
    {
      "name": "PackageStatus",
      "values": ["Waiting", "Carried", "Delivered"]
    }
  ],
  "states": [
    { "name": "standard_input", "type": "StandardInput", "config": { "buffer_size": 1000 } },
    { "name": "standard_output", "type": "StandardOutput", "config": { "buffer_size": 1000 } },
    {
      "name": "PlayerCommand",
      "fields": [
        {
          "name": "dx",
          "type": "i32",
          "default": 0,
          "min": -1,
          "max": 1
        },
        {
          "name": "dy",
          "type": "i32",
          "default": 0,
          "min": -1,
          "max": 1
        },
        {
          "name": "reset_requested",
          "type": "bool",
          "default": false
        },
        {
          "name": "quit_requested",
          "type": "bool",
          "default": false
        },
        {
          "name": "recent_directions",
          "type": "Direction",
          "array": 4,
          "default": ["None", "None", "None", "None"]
        },
        {
          "name": "sequence",
          "type": "i32",
          "default": 0,
          "min": 0
        }
      ],
      "constructors": []
    },
    {
      "name": "Worker",
      "fields": [
        {
          "name": "x",
          "type": "i32",
          "default": 1,
          "min": 1,
          "max": 8
        },
        {
          "name": "y",
          "type": "i32",
          "default": 1,
          "min": 1,
          "max": 5
        },
        {
          "name": "energy",
          "type": "i32",
          "default": 20,
          "min": 0,
          "max": 20
        },
        {
          "name": "score",
          "type": "i32",
          "default": 0,
          "min": 0,
          "max": 999
        },
        {
          "name": "carrying",
          "type": "bool",
          "default": false
        },
        {
          "name": "facing",
          "type": "Direction",
          "default": "East"
        }
      ],
      "constructors": []
    },
    {
      "name": "WarehouseMap",
      "fields": [
        {
          "name": "width",
          "type": "i32",
          "default": 10,
          "min": 10,
          "max": 10
        },
        {
          "name": "height",
          "type": "i32",
          "default": 7,
          "min": 7,
          "max": 7
        }
      ],
      "constructors": []
    },
    {
      "name": "Package",
      "fields": [
        {
          "name": "package_x",
          "type": "i32",
          "default": 7,
          "min": 1,
          "max": 8
        },
        {
          "name": "package_y",
          "type": "i32",
          "default": 1,
          "min": 1,
          "max": 5
        },
        {
          "name": "status",
          "type": "PackageStatus",
          "default": "Waiting"
        }
      ],
      "constructors": [
        {
          "name": "south_shelf",
          "values": {
            "package_x": 2,
            "package_y": 5
          }
        }
      ]
    },
    {
      "name": "DeliveryZone",
      "fields": [
        {
          "name": "zone_x",
          "type": "i32",
          "default": 8,
          "min": 1,
          "max": 8
        },
        {
          "name": "zone_y",
          "type": "i32",
          "default": 5,
          "min": 1,
          "max": 5
        }
      ],
      "constructors": [
        {
          "name": "west_dock",
          "values": {
            "zone_x": 1,
            "zone_y": 5
          }
        }
      ]
    },
    {
      "name": "GameStatus",
      "fields": [
        {
          "name": "turn",
          "type": "i32",
          "default": 0,
          "min": 0
        },
        {
          "name": "message",
          "type": "String",
          "default": "Pick up the package and deliver it before your energy runs out.",
          "max": 240
        },
        {
          "name": "game_over",
          "type": "bool",
          "default": false
        },
        {
          "name": "won",
          "type": "bool",
          "default": false
        }
      ],
      "constructors": []
    }
  ],
  "instances": [
    { "name": "player_command", "state": "PlayerCommand" },
    { "name": "worker", "state": "Worker" },
    { "name": "warehouse_map", "state": "WarehouseMap" },
    { "name": "package_a", "state": "Package" },
    { "name": "package_b", "state": "Package", "constructor": "south_shelf" },
    { "name": "delivery_zone_a", "state": "DeliveryZone" },
    { "name": "delivery_zone_b", "state": "DeliveryZone", "constructor": "west_dock" },
    { "name": "game_status", "state": "GameStatus" }
  ],
  "hooks": [
    {
      "name": "ApplyCommandChanged",
      "on": {
        "state": "PlayerCommand",
        "event": "changed"
      },
      "reads": [
        "PlayerCommand",
        "Worker",
        "WarehouseMap",
        "GameStatus"
      ],
      "writes": [
        "Worker",
        "GameStatus"
      ]
    },
    {
      "name": "UpdatePackageAfterWorkerChanged",
      "on": {
        "state": "Worker",
        "event": "changed"
      },
      "reads": [
        "Worker",
        "Package",
        "DeliveryZone"
      ],
      "writes": [
        "Package",
        "Worker",
        "GameStatus"
      ]
    },
    {
      "name": "UpdateStatusAfterPackageChanged",
      "on": {
        "state": "Package",
        "event": "changed"
      },
      "reads": [
        "Package",
        "Worker",
        "GameStatus"
      ],
      "writes": [
        "GameStatus"
      ]
    },
    {
      "name": "RenderAfterStatusChanged",
      "on": {
        "state": "GameStatus",
        "event": "changed"
      },
      "reads": [
        "Worker",
        "WarehouseMap",
        "Package",
        "DeliveryZone",
        "GameStatus"
      ],
      "writes": [
        "StandardOutput"
      ]
    },
    {
      "name": "HandleInputChanged",
      "on": {
        "state": "StandardInput",
        "event": "changed"
      },
      "reads": [
        "StandardInput"
      ],
      "writes": [
        "PlayerCommand"
      ]
    }
  ]
}
