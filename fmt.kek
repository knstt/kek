#import(std);

extern "C" {
#include <stdio.h>
}

i32: main() {

    Result<File>: file_open;
    file_open = std::FileOpen("test.txt", FileMode::Read);
    if (file_open.status != Status::Ok) {
        printf("Failed to open file");
        return(1);
    }

    File: file = file_open.value;

    defer {
        file.Close();
    }


    Span<byte>:buffer;
    Result<usize>:read_result = file.Read(buffer);
    if (read_result.status != Status::Ok) {
        printf("Failed to read file");
        return(1);
    }

    File: stdout = std::Stdout();
    Result<usize>:write_result = stdout.Write(std::FixedSlice<byte>(buffer.data, buffer.len));
    if (write_result.status != Status::Ok) {
        printf("Failed to write to stdout");
        return(1);
    }

    return(0);
}