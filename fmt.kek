#import(std);

extern "C" {
    #include <stdio.h>

    static int kek_fmt_fprintf_stderr(const char* text) {
        return fprintf(stderr, "%s", text);
    }
}

struct: Formatter {
    String: input;
    StringBuilder: out;
    Status: status;
    usize: pos;
    usize: indent;
    bool: lineStart;
    bool: stringLiteral;
    bool: escape;
    bool: lineComment;
    bool: blockComment;
};

void: FormatterWriteByte(ptr<Formatter>: formatter, byte: c) {
    if (formatter.status == Status::Ok) {
        formatter.status = std::WriteByteToBuilder(&formatter.out, c);
    }
}

void: FormatterWriteIndent(ptr<Formatter>: formatter, usize: indent) {
    for (usize: i = 0; i < indent * 4 && formatter.status == Status::Ok; i++) {
        FormatterWriteByte(formatter, 32);
    }
}

byte: FormatterFirstLineByte(ptr<Formatter>: formatter) {
    usize: i = formatter.pos;
    while (i < formatter.input.len && (formatter.input.data[i] == 32 || formatter.input.data[i] == 9)) {
        i += 1;
    }
    if (i >= formatter.input.len || formatter.input.data[i] == 10) {
        return(0);
    }
    return(formatter.input.data[i]);
}

void: FormatterBeginLine(ptr<Formatter>: formatter) {
    while (formatter.pos < formatter.input.len && (formatter.input.data[formatter.pos] == 32 || formatter.input.data[formatter.pos] == 9)) {
        formatter.pos += 1;
    }

    byte: first = FormatterFirstLineByte(formatter);
    if (first == 0) {
        formatter.lineStart = false;
    } else {
        usize: lineIndent = formatter.indent;
        if (!formatter.blockComment && first == 125 && lineIndent > 0) {
            lineIndent -= 1;
        }
        FormatterWriteIndent(formatter, lineIndent);
        formatter.lineStart = false;
    }
}

void: FormatterWriteColon(ptr<Formatter>: formatter) {
    FormatterWriteByte(formatter, 58);
    formatter.pos += 1;
    if (formatter.pos < formatter.input.len && formatter.input.data[formatter.pos] == 58) {
        FormatterWriteByte(formatter, 58);
        formatter.pos += 1;
    } else {
        if (formatter.pos < formatter.input.len && formatter.input.data[formatter.pos] != 10 && formatter.input.data[formatter.pos] != 32 && formatter.input.data[formatter.pos] != 9) {
            FormatterWriteByte(formatter, 32);
        }
    }
}

void: FormatterWriteStringByte(ptr<Formatter>: formatter, byte: c) {
    FormatterWriteByte(formatter, c);
    formatter.pos += 1;
    if (formatter.escape) {
        formatter.escape = false;
    } else {
        if (c == 92) {
            formatter.escape = true;
        } else {
            if (c == 34) {
                formatter.stringLiteral = false;
            }
        }
    }
}

void: FormatterWriteCodeByte(ptr<Formatter>: formatter, byte: c) {
    bool: handled = false;
    if (c == 58) {
        FormatterWriteColon(formatter);
        handled = true;
    }

    if (!handled && c == 34) {
        formatter.stringLiteral = true;
        formatter.escape = false;
        FormatterWriteByte(formatter, c);
        formatter.pos += 1;
        handled = true;
    }

    if (!handled && c == 47 && formatter.pos + 1 < formatter.input.len && formatter.input.data[formatter.pos + 1] == 47) {
        formatter.lineComment = true;
        FormatterWriteByte(formatter, c);
        formatter.pos += 1;
        handled = true;
    }

    if (!handled && c == 47 && formatter.pos + 1 < formatter.input.len && formatter.input.data[formatter.pos + 1] == 42) {
        formatter.blockComment = true;
        FormatterWriteByte(formatter, c);
        formatter.pos += 1;
        handled = true;
    }

    if (!handled) {
        if (c == 123) {
            formatter.indent += 1;
        } else {
            if (c == 125 && formatter.indent > 0) {
                formatter.indent -= 1;
            }
        }
        FormatterWriteByte(formatter, c);
        formatter.pos += 1;
    }
}

void: FormatterWriteCommentByte(ptr<Formatter>: formatter, byte: c) {
    FormatterWriteByte(formatter, c);
    formatter.pos += 1;
    if (formatter.blockComment && c == 42 && formatter.pos < formatter.input.len && formatter.input.data[formatter.pos] == 47) {
        FormatterWriteByte(formatter, 47);
        formatter.pos += 1;
        formatter.blockComment = false;
    }
}

Status: FormatterFormat(ptr<Formatter>: formatter) {
    while (formatter.pos < formatter.input.len && formatter.status == Status::Ok) {
        if (formatter.lineStart) {
            FormatterBeginLine(formatter);
        }

        if (formatter.pos >= formatter.input.len) {
            break;
        }

        byte: c = formatter.input.data[formatter.pos];
        if (c == 10) {
            FormatterWriteByte(formatter, c);
            formatter.pos += 1;
            formatter.lineStart = true;
            formatter.lineComment = false;
            continue;
        }

        if (formatter.stringLiteral) {
            FormatterWriteStringByte(formatter, c);
            continue;
        }

        if (formatter.lineComment || formatter.blockComment) {
            FormatterWriteCommentByte(formatter, c);
            continue;
        }

        FormatterWriteCodeByte(formatter, c);
    }
    return(formatter.status);
}

int: main(int: argc, ptr<str>: argv) {
    Allocator: allocator = std::DefaultAllocator();
    File: input;
    bool: closeInput = false;

    if (argc > 1) {
        Result<File>: opened = std::FileOpen(argv[1], FileMode::Read);
        if (opened.status != Status::Ok) {
            ::kek_fmt_fprintf_stderr("fmt.kek: could not open input\n");
            return(1);
        }
        input = opened.value;
        closeInput = true;
    } else {
        input = std::Stdin();
    }

    OwnedString: source;
    Status: readStatus = std::ReadAllToOwnedString(input, allocator, &source);
    if (closeInput) {
        input.Close();
    }
    if (readStatus != Status::Ok) {
        ::kek_fmt_fprintf_stderr("fmt.kek: could not read input\n");
        return(1);
    }

    Formatter: formatter;
    formatter.input = source.View();
    formatter.out = std::StringBuilderNew(allocator);
    formatter.status = Status::Ok;
    formatter.pos = 0;
    formatter.indent = 0;
    formatter.lineStart = true;
    formatter.stringLiteral = false;
    formatter.escape = false;
    formatter.lineComment = false;
    formatter.blockComment = false;

    Status: formatStatus = FormatterFormat(&formatter);
    if (formatStatus != Status::Ok) {
        ::kek_fmt_fprintf_stderr("fmt.kek: out of memory\n");
        source.Destroy();
        return(1);
    }

    String: formatted;
    formatted.data = formatter.out.data;
    formatted.len = formatter.out.len;

    Status: writeStatus = Status::Ok;
    if (argc > 1) {
        Result<File>: opened = std::FileOpen(argv[1], FileMode::Write);
        if (opened.status != Status::Ok) {
            ::kek_fmt_fprintf_stderr("fmt.kek: could not open output\n");
            std::DestroyStringBuilder(&formatter.out);
            source.Destroy();
            return(1);
        }
        File: output = opened.value;
        writeStatus = output.Write(formatted.Bytes()).status;
        output.Close();
    } else {
        File: stdout = std::Stdout();
        writeStatus = stdout.Write(formatted.Bytes()).status;
    }
    if (writeStatus != Status::Ok) {
        ::kek_fmt_fprintf_stderr("fmt.kek: could not write output\n");
        std::DestroyStringBuilder(&formatter.out);
        source.Destroy();
        return(1);
    }

    std::DestroyStringBuilder(&formatter.out);
    source.Destroy();
    return(0);
}
