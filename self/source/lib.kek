struct:SelfSourceFile {
	OwnedString:path;
	OwnedString:content;
	usize:fileIndex;
};

struct:SelfFileTable {
	SelfSourceFile:files[64];
	usize:count;
	Allocator:allocator;
};

void:SelfFileTableInit(ptr<SelfFileTable>:table, Allocator:allocator) {
	table.count = 0;
	table.allocator = allocator;
}

Status:SelfFileTableDestroy(ptr<SelfFileTable>:table) {
	for (usize:i = 0; i < table.count; i++) {
		std::DestroyOwnedString(&table.files[i].path);
		std::DestroyOwnedString(&table.files[i].content);
	}
	table.count = 0;
	return(Status::Ok);
}

bool:SelfStringEndsWithCString(String:text, str:suffixText) {
	String:suffix = std::StringFromCString(suffixText);
	return(text.EndsWith(suffix));
}

int:SelfStdlibImportRank(String:name) {
	if (name.EqualsCString("core.kek")) {
		return(0);
	}
	if (name.EqualsCString("mem.kek")) {
		return(1);
	}
	if (name.EqualsCString("file.kek")) {
		return(2);
	}
	if (name.EqualsCString("io.kek")) {
		return(3);
	}
	if (name.EqualsCString("string.kek")) {
		return(4);
	}
	if (name.EqualsCString("scan.kek")) {
		return(5);
	}
	if (name.EqualsCString("array.kek")) {
		return(6);
	}
	if (name.EqualsCString("list.kek")) {
		return(7);
	}
	if (name.EqualsCString("hash.kek")) {
		return(8);
	}
	if (name.EqualsCString("collections.kek")) {
		return(9);
	}
	if (name.EqualsCString("format.kek")) {
		return(10);
	}
	return(1000);
}

int:SelfCompareImportName(String:left, String:right) {
	int:leftRank = SelfStdlibImportRank(left);
	int:rightRank = SelfStdlibImportRank(right);
	if (leftRank < rightRank) {
		return(-1);
	}
	if (leftRank > rightRank) {
		return(1);
	}
	return(left.Compare(right));
}

Status:SelfNormalizePath(String:path, Allocator:allocator, ptr<OwnedString>:out) {
	StringBuilder:builder = std::StringBuilderNew(allocator);
	bool:previousSlash = false;
	usize:i = 0;
	while (i < path.len) {
		byte:c = path.data[i];
		if (c == '\\') {
			c = '/';
		}
		if (c == '/' && previousSlash) {
			i += 1;
			continue;
		}
		if (c == '.' && i + 1 < path.len && path.data[i + 1] == '/') {
			i += 2;
			continue;
		}
		Status:status = builder.WriteByte(c);
		if (status != Status::Ok) {
			builder.Destroy();
			return(status);
		}
		previousSlash = c == '/';
		i += 1;
	}
	Status:termStatus = builder.WriteByte(0);
	if (termStatus != Status::Ok) {
		builder.Destroy();
		return(termStatus);
	}
	Result<OwnedString>:detached = builder.Detach();
	if (detached.status != Status::Ok) {
		builder.Destroy();
		return(detached.status);
	}
	out.data = detached.value.data;
	out.len = detached.value.len - 1;
	out.cap = detached.value.cap;
	out.allocator = detached.value.allocator;
	return(Status::Ok);
}

bool:SelfFileAlreadyLoaded(ptr<SelfFileTable>:table, String:path) {
	for (usize:i = 0; i < table.count; i++) {
		String:filePath = std::OwnedStringView(&table.files[i].path);
		if (filePath.Equals(path)) {
			return(true);
		}
	}
	return(false);
}

Status:SelfAddSourceDiagnostic(ptr<SelfDiagnosticBag>:diagnostics, str:message) {
	return(diagnostics::SelfDiagnosticAddCString(diagnostics, SelfDiagnosticSeverity::Error, SelfDiagnosticPhase::Source, -1, diagnostics::SelfSourceLocationNew(0, 0, 0, 0), message));
}

Status:SelfReadFile(String:path, ptr<SelfFileTable>:table, ptr<SelfDiagnosticBag>:diagnostics) {
	if (table.count >= len(table.files)) {
		return(SelfAddSourceDiagnostic(diagnostics, "file table is full"));
	}

	OwnedString:normalized;
	Status:status = SelfNormalizePath(path, table.allocator, &normalized);
	if (status != Status::Ok) {
		return(status);
	}

	Result<File>:opened = std::FileOpen(cast<str>(normalized.data), FileMode::Read);
	if (opened.status != Status::Ok) {
		String:normalizedPath = std::OwnedStringView(&normalized);
		status = diagnostics::SelfDiagnosticAddPathMessage(diagnostics, SelfDiagnosticSeverity::Error, SelfDiagnosticPhase::Source, -1, diagnostics::SelfSourceLocationNew(0, 0, 0, 0), "could not open file ", normalizedPath);
		std::DestroyOwnedString(&normalized);
		return(status);
	}

	OwnedString:content;
	File:file = opened.value;
	status = std::ReadAllToOwnedString(file, table.allocator, &content);
	Status:closeStatus = file.Close();
	if (status != Status::Ok) {
		String:normalizedPath = std::OwnedStringView(&normalized);
		diagnostics::SelfDiagnosticAddPathMessage(diagnostics, SelfDiagnosticSeverity::Error, SelfDiagnosticPhase::Source, -1, diagnostics::SelfSourceLocationNew(0, 0, 0, 0), "could not read file ", normalizedPath);
		std::DestroyOwnedString(&normalized);
		return(status);
	}
	if (closeStatus != Status::Ok) {
		std::DestroyOwnedString(&content);
		std::DestroyOwnedString(&normalized);
		return(closeStatus);
	}

	ptr<SelfSourceFile>:source = &table.files[table.count];
	source.path = normalized;
	source.content = content;
	source.fileIndex = table.count;
	table.count += 1;
	return(Status::Ok);
}

Status:SelfBuildPath(String:directory, String:name, Allocator:allocator, ptr<OwnedString>:out) {
	StringBuilder:builder = std::StringBuilderNew(allocator);
	Status:status = builder.WriteString(directory);
	if (status == Status::Ok && (directory.len == 0 || directory.data[directory.len - 1] != '/')) {
		status = builder.WriteByte('/');
	}
	if (status == Status::Ok) {
		status = builder.WriteString(name);
	}
	if (status == Status::Ok) {
		status = builder.WriteByte(0);
	}
	if (status != Status::Ok) {
		builder.Destroy();
		return(status);
	}
	Result<OwnedString>:detached = builder.Detach();
	if (detached.status != Status::Ok) {
		builder.Destroy();
		return(detached.status);
	}
	out.data = detached.value.data;
	out.len = detached.value.len - 1;
	out.cap = detached.value.cap;
	out.allocator = detached.value.allocator;
	return(Status::Ok);
}

void:SelfSortImportNames(ptr<OwnedString>:names, usize:count) {
	for (usize:i = 1; i < count; i++) {
		OwnedString:key = names[i];
		usize:j = i;
		String:keyView = std::OwnedStringView(&key);
		while (j > 0 && SelfCompareImportName(std::OwnedStringView(&names[j - 1]), keyView) > 0) {
			names[j] = names[j - 1];
			j -= 1;
		}
		names[j] = key;
	}
}

void:SelfDestroyImportNames(ptr<OwnedString>:names, usize:start, usize:count) {
	for (usize:i = start; i < count; i++) {
		std::DestroyOwnedString(&names[i]);
	}
}

void:SelfFreeImportNames(Allocator:allocator, ptr<OwnedString>:names) {
	if (names != 0) {
		std::Free<OwnedString>(allocator, names, 256);
	}
}

Status:SelfLoadImportDirectory(ptr<SelfFileTable>:table, String:path, ptr<SelfDiagnosticBag>:diagnostics) {
	OwnedString:normalizedPath;
	Status:pathStatus = SelfNormalizePath(path, table.allocator, &normalizedPath);
	if (pathStatus != Status::Ok) {
		return(pathStatus);
	}
	String:directoryPath = std::OwnedStringView(&normalizedPath);

	Result<Directory>:opened = std::DirectoryOpen(cast<str>(normalizedPath.data));
	if (opened.status != Status::Ok) {
		Status:status = diagnostics::SelfDiagnosticAddPathMessage(diagnostics, SelfDiagnosticSeverity::Error, SelfDiagnosticPhase::Source, -1, diagnostics::SelfSourceLocationNew(0, 0, 0, 0), "could not open import directory ", directoryPath);
		std::DestroyOwnedString(&normalizedPath);
		return(status);
	}

	Directory:directory = opened.value;
	ptr<OwnedString>:names = std::Alloc<OwnedString>(table.allocator, 256);
	if (names == 0) {
		directory.Close();
		std::DestroyOwnedString(&normalizedPath);
		return(Status::NoMemory);
	}
	std::SetBytes(cast<ptr>(names), 0, sizeof(OwnedString) * 256);
	usize:nameCount = 0;
	while (true) {
		Result<String>:read = directory.ReadName();
		if (read.status == Status::End) {
			break;
		}
		if (read.status != Status::Ok) {
			directory.Close();
			SelfDestroyImportNames(names, 0, nameCount);
			SelfFreeImportNames(table.allocator, names);
			std::DestroyOwnedString(&normalizedPath);
			return(read.status);
		}
		String:name = read.value;
		if (name.len == 0 || name.data[0] == '.') {
			continue;
		}
		if (!SelfStringEndsWithCString(name, ".kek")) {
			continue;
		}
		if (nameCount >= 256) {
			directory.Close();
			SelfDestroyImportNames(names, 0, nameCount);
			SelfFreeImportNames(table.allocator, names);
			Status:status = diagnostics::SelfDiagnosticAddPathMessage(diagnostics, SelfDiagnosticSeverity::Error, SelfDiagnosticPhase::Source, -1, diagnostics::SelfSourceLocationNew(0, 0, 0, 0), "too many import files in ", directoryPath);
			std::DestroyOwnedString(&normalizedPath);
			return(status);
		}
		Status:cloneStatus = std::CloneString(name, table.allocator, &names[nameCount]);
		if (cloneStatus != Status::Ok) {
			directory.Close();
			SelfDestroyImportNames(names, 0, nameCount);
			SelfFreeImportNames(table.allocator, names);
			std::DestroyOwnedString(&normalizedPath);
			return(cloneStatus);
		}
		nameCount += 1;
	}
	Status:closeStatus = directory.Close();
	if (closeStatus != Status::Ok) {
		SelfDestroyImportNames(names, 0, nameCount);
		SelfFreeImportNames(table.allocator, names);
		std::DestroyOwnedString(&normalizedPath);
		return(closeStatus);
	}

	SelfSortImportNames(names, nameCount);

	for (usize:i = 0; i < nameCount; i++) {
		OwnedString:filePath;
		String:name = std::OwnedStringView(&names[i]);
		Status:status = SelfBuildPath(directoryPath, name, table.allocator, &filePath);
		if (status != Status::Ok) {
			SelfDestroyImportNames(names, i, nameCount);
			SelfFreeImportNames(table.allocator, names);
			std::DestroyOwnedString(&normalizedPath);
			return(status);
		}
		String:filePathView = std::OwnedStringView(&filePath);
		if (!SelfFileAlreadyLoaded(table, filePathView)) {
			status = SelfReadFile(filePathView, table, diagnostics);
			if (status != Status::Ok) {
				std::DestroyOwnedString(&filePath);
				SelfDestroyImportNames(names, i, nameCount);
				SelfFreeImportNames(table.allocator, names);
				std::DestroyOwnedString(&normalizedPath);
				return(status);
			}
		}
		std::DestroyOwnedString(&filePath);
		std::DestroyOwnedString(&names[i]);
	}
	SelfFreeImportNames(table.allocator, names);
	std::DestroyOwnedString(&normalizedPath);
	return(Status::Ok);
}

Status:SelfLoadImports(ptr<SelfFileTable>:table, ptr<SelfSourceFile>:file, ptr<SelfDiagnosticBag>:diagnostics) {
	String:source = std::OwnedStringView(&file.content);
	String:prefix = std::StringFromCString("#import");
	usize:cursor = 0;
	while (cursor + prefix.len + 1 <= source.len) {
		bool:matched = true;
		for (usize:i = 0; i < prefix.len; i++) {
			if (source.data[cursor + i] != prefix.data[i]) {
				matched = false;
				break;
			}
		}
		if (!matched) {
			cursor += 1;
			continue;
		}

		if (source.data[cursor + prefix.len] != '(') {
			cursor += 1;
			continue;
		}

		usize:start = cursor + prefix.len + 1;
		usize:end = start;
		while (end < source.len && source.data[end] != ')') {
			end += 1;
		}
		SelfSourceLocation:location = diagnostics::SelfSourceLocationNew(1, 1, cursor, prefix.len);
		if (end >= source.len) {
			return(diagnostics::SelfDiagnosticAddCString(diagnostics, SelfDiagnosticSeverity::Error, SelfDiagnosticPhase::Source, cast<i64>(file.fileIndex), location, "unterminated import"));
		}
		usize:length = end - start;
		if (length == 0) {
			return(diagnostics::SelfDiagnosticAddCString(diagnostics, SelfDiagnosticSeverity::Error, SelfDiagnosticPhase::Source, cast<i64>(file.fileIndex), location, "invalid import path"));
		}
		String:importPath = source.Slice(start, length);
		Status:status = SelfLoadImportDirectory(table, importPath, diagnostics);
		if (status != Status::Ok) {
			return(status);
		}
		cursor = end + 1;
	}
	return(Status::Ok);
}

Status:SelfLoadCompilationSources(str:entryPath, Allocator:allocator, ptr<SelfFileTable>:table, ptr<SelfDiagnosticBag>:diagnostics) {
	SelfFileTableInit(table, allocator);
	Status:status = SelfReadFile(std::StringFromCString(entryPath), table, diagnostics);
	if (status != Status::Ok) {
		return(status);
	}
	usize:nextImportScan = 0;
	while (nextImportScan < table.count) {
		status = SelfLoadImports(table, &table.files[nextImportScan], diagnostics);
		if (status != Status::Ok) {
			return(status);
		}
		nextImportScan += 1;
	}
	return(Status::Ok);
}

Status:SelfWriteSourceDump(ptr<SelfFileTable>:table, ptr<SelfDiagnosticBag>:diagnostics, ptr<StringBuilder>:out) {
	for (usize:i = 0; i < table.count; i++) {
		ptr<SelfSourceFile>:file = &table.files[i];
		Status:status = out.WriteCString("file|");
		if (status != Status::Ok) {
			return(status);
		}
		status = diagnostics::SelfWriteU64Field(out, cast<u64>(file.fileIndex), true);
		if (status != Status::Ok) {
			return(status);
		}
		String:filePath = std::OwnedStringView(&file.path);
		status = out.WriteString(filePath);
		if (status != Status::Ok) {
			return(status);
		}
		status = out.WriteByte('|');
		if (status != Status::Ok) {
			return(status);
		}
		status = diagnostics::SelfWriteU64Field(out, cast<u64>(file.content.len), false);
		if (status != Status::Ok) {
			return(status);
		}
		status = out.WriteByte('\n');
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(diagnostics::SelfWriteDiagnosticDump(diagnostics, out));
}
