#import(std);
#import(self/typed);

int:TypedSummaryFail(str:text) {
	File:stderr = std::Stderr();
	std::WriteStringToFile(&stderr, std::StringFromCString(text));
	return(1);
}

int:main(int:argc, ptr<str>:argv) {
	if (argc < 2) {
		return(TypedSummaryFail("usage: typed_summary <input.kek>\n"));
	}

	Allocator:allocator = std::DefaultAllocator();
	StringBuilder:summary = std::StringBuilderNew(allocator);
	Status:status = typed::SelfWriteTypedModuleSummary(argv[1], allocator, &summary);
	if (status != Status::Ok) {
		summary.Destroy();
		return(TypedSummaryFail("typed_summary: could not build summary\n"));
	}

	File:stdout = std::Stdout();
	String:view = summary.View();
	Slice<byte>:bytes = view.Bytes();
	Result<usize>:write = stdout.Write(bytes);
	summary.Destroy();
	if (write.status != Status::Ok) {
		return(TypedSummaryFail("typed_summary: could not write summary\n"));
	}
	return(0);
}
