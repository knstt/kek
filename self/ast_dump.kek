#import(std);
#import(self/diagnostics);
#import(self/tokenizer);
#import(self/ast);

int:AstDumpFail(str:text) {
	File:stderr = std::Stderr();
	std::WriteStringToFile(&stderr, std::StringFromCString(text));
	return(1);
}

int:main(int:argc, ptr<str>:argv) {
	if (argc < 2) {
		return(AstDumpFail("usage: ast_dump <input.kek>\n"));
	}

	Allocator:allocator = std::DefaultAllocator();
	OwnedString:source;
	Status:readStatus = std::ReadFileToOwnedString(argv[1], allocator, &source);
	if (readStatus != Status::Ok) {
		return(AstDumpFail("ast_dump: could not read input\n"));
	}

	StringBuilder:dump = std::StringBuilderNew(allocator);
	Status:dumpStatus = ast::SelfWriteAstBridgeDump(source.View(), &dump);
	if (dumpStatus != Status::Ok) {
		dump.Destroy();
		source.Destroy();
		return(AstDumpFail("ast_dump: could not create dump\n"));
	}

	File:stdout = std::Stdout();
	String:view = dump.View();
	Slice<byte>:bytes = view.Bytes();
	Result<usize>:write = stdout.Write(bytes);
	dump.Destroy();
	source.Destroy();
	if (write.status != Status::Ok) {
		return(AstDumpFail("ast_dump: could not write dump\n"));
	}
	return(0);
}
