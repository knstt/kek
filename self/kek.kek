#import(std);

int:SelfKekFail(str:text) {
	File:stderr = std::Stderr();
	std::WriteStringToFile(&stderr, std::StringFromCString(text));
	return(1);
}

Status:SelfKekBuildPassthroughCommand(int:argc, ptr<str>:argv, ptr<StringBuilder>:out) {
	Status:status = out.WriteCString("bin/kek");
	for (int:i = 1; i < argc && status == Status::Ok; i++) {
		status = out.WriteByte(' ');
		if (status == Status::Ok) {
			status = out.WriteCString(argv[i]);
		}
	}
	if (status == Status::Ok) {
		status = out.WriteByte(0);
	}
	return(status);
}

int:SelfKekPrintHelp() {
	File:stdout = std::Stdout();
	std::WriteStringToFile(&stdout, std::StringFromCString("kek build <input.kek> [options]\n"));
	std::WriteStringToFile(&stdout, std::StringFromCString("kek --version\n"));
	return(0);
}

int:main(int:argc, ptr<str>:argv) {
	if (argc < 2) {
		return(SelfKekFail("missing command\n"));
	}

	String:command = std::StringFromCString(argv[1]);
	if (command.EqualsCString("--help")) {
		return(SelfKekPrintHelp());
	}
	if (command.EqualsCString("--version")) {
		File:stdout = std::Stdout();
		std::WriteStringToFile(&stdout, std::StringFromCString("0.2.0\n"));
		return(0);
	}
	if (!command.EqualsCString("build")) {
		return(SelfKekFail("unknown command\n"));
	}

	Allocator:allocator = std::DefaultAllocator();
	StringBuilder:passthrough = std::StringBuilderNew(allocator);
	Status:status = SelfKekBuildPassthroughCommand(argc, argv, &passthrough);
	if (status != Status::Ok) {
		passthrough.Destroy();
		return(SelfKekFail("could not build command\n"));
	}
	String:commandText = passthrough.View();
	int:result = std::ProcessRun(cast<str>(commandText.data));
	passthrough.Destroy();
	return(result);
}
