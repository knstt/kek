#import(std);
#import(self/platform);

struct:FfiGuard {
	String:source;
	usize:pos;
	bool:inExternC;
	bool:failed;
};

int:FfiGuardFail(str:text) {
	File:stderr = std::Stderr();
	std::WriteStringToFile(&stderr, std::StringFromCString(text));
	return(1);
}

bool:FfiStartsWith(String:source, usize:pos, str:text) {
	usize:i = 0;
	while (text[i] != 0) {
		if (pos + i >= source.len || source.data[pos + i] != text[i]) {
			return(false);
		}
		i += 1;
	}
	return(true);
}

bool:FfiContains(String:source, str:text) {
	for (usize:i = 0; i < source.len; i++) {
		if (FfiStartsWith(source, i, text)) {
			return(true);
		}
	}
	return(false);
}

usize:FfiFindMatchingBrace(String:source, usize:openPos) {
	usize:depth = 0;
	for (usize:i = openPos; i < source.len; i++) {
		if (source.data[i] == '{') {
			depth += 1;
		}
		if (source.data[i] == '}') {
			if (depth == 0) {
				return(source.len);
			}
			depth -= 1;
			if (depth == 0) {
				return(i);
			}
		}
	}
	return(source.len);
}

bool:FfiBlockHasRawC(String:block) {
	if (FfiContains(block, "#include")) {
		return(true);
	}
	if (FfiContains(block, "typedef")) {
		return(true);
	}
	if (FfiContains(block, "static ")) {
		return(true);
	}
	if (FfiContains(block, "return ")) {
		return(true);
	}
	if (FfiContains(block, "){")) {
		return(true);
	}
	if (FfiContains(block, ") {")) {
		return(true);
	}
	return(false);
}

bool:FfiSourceHasRawExternC(String:source) {
	usize:pos = 0;
	while (pos < source.len) {
		if (!FfiStartsWith(source, pos, "extern \"C\"")) {
			pos += 1;
			continue;
		}
		usize:open = pos;
		while (open < source.len && source.data[open] != '{') {
			open += 1;
		}
		if (open >= source.len) {
			return(false);
		}
		usize:close = FfiFindMatchingBrace(source, open);
		if (close >= source.len) {
			return(true);
		}
		String:block = source.Slice(open, close - open + 1);
		if (FfiBlockHasRawC(block)) {
			return(true);
		}
		pos = close + 1;
	}
	return(false);
}

int:main(int:argc, ptr<str>:argv) {
	if (argc < 2) {
		return(FfiGuardFail("usage: ffi_guard <input.kek>\n"));
	}

	Allocator:allocator = std::DefaultAllocator();
	OwnedString:source;
	Status:status = std::ReadFileToOwnedString(argv[1], allocator, &source);
	if (status != Status::Ok) {
		return(FfiGuardFail("ffi_guard: could not read input\n"));
	}

	bool:hasRaw = FfiSourceHasRawExternC(source.View());
	source.Destroy();
	if (hasRaw) {
		return(FfiGuardFail("ffi_guard: raw extern C implementation block rejected\n"));
	}
	return(0);
}
