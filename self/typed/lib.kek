Status:SelfBuildTypedSummaryCommand(str:inputPath, str:summaryPath, ptr<StringBuilder>:out) {
	Status:status = out.WriteCString("bin/kek build ");
	if (status == Status::Ok) {
		status = out.WriteCString(inputPath);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(" -o out/self_typed_summary_tmp.c --ast-json out/self_typed_summary_tmp.json --summary ");
	}
	if (status == Status::Ok) {
		status = out.WriteCString(summaryPath);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(" > out/self_typed_summary_cmd.stdout 2> out/self_typed_summary_cmd.stderr");
	}
	return(status);
}

Status:SelfWriteTypedModuleSummary(str:inputPath, Allocator:allocator, ptr<StringBuilder>:out) {
	str:summaryPath = "out/self_typed_summary_tmp.txt";
	StringBuilder:command = std::StringBuilderNew(allocator);
	Status:status = SelfBuildTypedSummaryCommand(inputPath, summaryPath, &command);
	if (status != Status::Ok) {
		command.Destroy();
		return(status);
	}
	status = command.WriteByte(0);
	if (status != Status::Ok) {
		command.Destroy();
		return(status);
	}

	String:commandView = command.View();
	if (std::ProcessRun(cast<str>(commandView.data)) != 0) {
		command.Destroy();
		return(Status::Invalid);
	}
	command.Destroy();

	OwnedString:summary;
	status = std::ReadFileToOwnedString(summaryPath, allocator, &summary);
	if (status != Status::Ok) {
		return(status);
	}
	String:summaryView = summary.View();
	status = out.WriteString(summaryView);
	summary.Destroy();
	return(status);
}
