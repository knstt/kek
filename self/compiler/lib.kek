#import(std);
#import(self/diagnostics);
#import(self/source);
#import(self/tokenizer);
#import(self/ast);

enum:u8:SelfCDeclKind {
	Unknown,
	Alias,
	Struct,
	Union,
	Enum,
	Function,
	ExternC,
};

enum:u8:SelfCTypeKind {
	Unknown,
	Void,
	Bool,
	Integer,
	Float,
	Pointer,
	Struct,
	Union,
	Enum,
	Alias,
};

struct:SelfCTokenFile {
	ptr<Token>:tokens;
	usize:tokenLen;
	usize:tokenCap;
	String:sourceText;
	String:path;
	OwnedString:packageName;
	usize:fileIndex;
};

struct:SelfCTypeUse {
	OwnedString:key;
	OwnedString:cName;
	OwnedString:baseName;
	OwnedString:arg0;
	OwnedString:arg1;
	OwnedString:arg2;
	usize:argCount;
	bool:emitted;
};

struct:SelfCFuncUse {
	usize:declIndex;
	OwnedString:key;
	OwnedString:cName;
	OwnedString:arg0;
	OwnedString:arg1;
	OwnedString:arg2;
	usize:argCount;
	bool:emitted;
};

struct:SelfCParam {
	usize:fileIndex;
	usize:typeStart;
	usize:typeEnd;
