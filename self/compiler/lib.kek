	ptr<SelfCProgram>:program;
	ptr<SelfCEnv>:env;
	usize:fileIndex;
	usize:pos;
	usize:end;
	OwnedString:expectedTypeKey;
	OwnedString:expectedCType;
	bool:expectedIsArray;
};

struct:SelfCTypeInfo {
	OwnedString:key;
	OwnedString:cType;
	OwnedString:baseName;
	OwnedString:arg0;
	OwnedString:arg1;
	OwnedString:arg2;
	usize:argCount;
	bool:isPointer;
};

struct:SelfCProgram {
	Allocator:allocator;
	SelfDiagnosticBag:diagnostics;
	SelfFileTable:files;
	SelfCTokenFile:tokenFiles[96];
	usize:tokenFileCount;
	SelfCDecl:decls[4096];
	usize:declCount;
	SelfCParam:params[4096];
	usize:paramCount;
	SelfCField:fields[8192];
	usize:fieldCount;
	SelfCTypeUse:typeUses[2048];
	usize:typeUseCount;
	SelfCFuncUse:funcUses[2048];
	usize:funcUseCount;
};

bool:SelfCIsOk(Status:status) {
	return(status == Status::Ok);
}

String:SelfCTokenText(ptr<SelfCProgram>:program, usize:fileIndex, usize:tokenIndex) {
	ptr<SelfCTokenFile>:file = &program.tokenFiles[fileIndex];
	Token:token = file.tokens[tokenIndex];
	String:sourceText = file.sourceText;
	return(sourceText.Slice(token.offset, token.length));
}

bool:SelfCTokenEquals(ptr<SelfCProgram>:program, usize:fileIndex, usize:tokenIndex, str:text) {
	String:value = SelfCTokenText(program, fileIndex, tokenIndex);
	return(value.EqualsCString(text));
}

bool:SelfCStringEquals(String:value, str:text) {
	return(value.EqualsCString(text));
}

bool:SelfCIsTokenKind(ptr<SelfCProgram>:program, usize:fileIndex, usize:tokenIndex, TokenKind:kind) {
	return(program.tokenFiles[fileIndex].tokens[tokenIndex].kind == kind);
}

bool:SelfCIsPunctuation(ptr<SelfCProgram>:program, usize:fileIndex, usize:tokenIndex, PunctuationKind:kind) {
	Token:token = program.tokenFiles[fileIndex].tokens[tokenIndex];
	return(token.kind == TokenKind::Punctuation && token.subkind == cast<u64>(kind));
}

bool:SelfCIsOperator(ptr<SelfCProgram>:program, usize:fileIndex, usize:tokenIndex, OperatorKind:kind) {
	Token:token = program.tokenFiles[fileIndex].tokens[tokenIndex];
	return(token.kind == TokenKind::Operator && token.subkind == cast<u64>(kind));
}

bool:SelfCIsKeyword(ptr<SelfCProgram>:program, usize:fileIndex, usize:tokenIndex, KeywordKind:kind) {
	Token:token = program.tokenFiles[fileIndex].tokens[tokenIndex];
	return(token.kind == TokenKind::Keyword && token.subkind == cast<u64>(kind));
}

bool:SelfCIsIdentifierText(ptr<SelfCProgram>:program, usize:fileIndex, usize:tokenIndex, str:text) {
	Token:token = program.tokenFiles[fileIndex].tokens[tokenIndex];
	if (!(token.kind == TokenKind::Identifier || token.kind == TokenKind::Keyword)) {
		return(false);
	}
	return(SelfCTokenEquals(program, fileIndex, tokenIndex, text));
}

bool:SelfCIsEof(ptr<SelfCProgram>:program, usize:fileIndex, usize:tokenIndex) {
	return(program.tokenFiles[fileIndex].tokens[tokenIndex].kind == TokenKind::Eof);
}

usize:SelfCFileTokenCount(ptr<SelfCProgram>:program, usize:fileIndex) {
	return(program.tokenFiles[fileIndex].tokenLen);
}

Status:SelfCWrite(ptr<StringBuilder>:out, str:text) {
	return(out.WriteCString(text));
}

Status:SelfCWriteString(ptr<StringBuilder>:out, String:text) {
	return(out.WriteString(text));
}

Status:SelfCWriteToken(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, usize:fileIndex, usize:tokenIndex) {
	return(out.WriteString(SelfCTokenText(program, fileIndex, tokenIndex)));
}

Status:SelfCCloneCString(ptr<SelfCProgram>:program, str:text, ptr<OwnedString>:out) {
	return(std::CloneCString(text, program.allocator, out));
}

Status:SelfCCloneString(ptr<SelfCProgram>:program, String:text, ptr<OwnedString>:out) {
	return(std::CloneString(text, program.allocator, out));
}

String:SelfCOwnedView(ptr<OwnedString>:value) {
	return(std::OwnedStringView(value));
}

bool:SelfCOwnedEqualsCString(ptr<OwnedString>:value, str:text) {
	String:view = std::OwnedStringView(value);
	return(view.EqualsCString(text));
}

bool:SelfCOwnedEquals(ptr<OwnedString>:left, ptr<OwnedString>:right) {
	String:leftView = std::OwnedStringView(left);
	String:rightView = std::OwnedStringView(right);
	return(leftView.Equals(rightView));
}

Status:SelfCDetachBuilder(ptr<StringBuilder>:builder, ptr<OwnedString>:out) {
	Result<OwnedString>:detached = builder.Detach();
	if (detached.status != Status::Ok) {
		return(detached.status);
	}
	out.data = detached.value.data;
	out.len = detached.value.len;
	out.cap = detached.value.cap;
	out.allocator = detached.value.allocator;
	return(Status::Ok);
}

Status:SelfCMakeOwnedEmpty(ptr<SelfCProgram>:program, ptr<OwnedString>:out) {
	return(SelfCCloneCString(program, "", out));
}

Status:SelfCWriteOwned(ptr<StringBuilder>:out, ptr<OwnedString>:text) {
	return(out.WriteString(std::OwnedStringView(text)));
}

usize:SelfCStringLastSlash(String:path) {
	usize:last = path.len;
	for (usize:i = 0; i < path.len; i++) {
		if (path.data[i] == '/') {
			last = i;
		}
	}
	return(last);
}

Status:SelfCPackageNameFromPath(String:path, Allocator:allocator, ptr<OwnedString>:out) {
	usize:lastSlash = SelfCStringLastSlash(path);
	if (lastSlash == path.len) {
		return(std::CloneCString("", allocator, out));
	}
	if (path.StartsWith(std::StringFromCString("std/"))) {
		return(std::CloneCString("std", allocator, out));
	}
	usize:segmentStart = 0;
	for (usize:i = 0; i < lastSlash; i++) {
		if (path.data[i] == '/') {
			segmentStart = i + 1;
		}
	}
	return(std::CloneString(path.Slice(segmentStart, lastSlash - segmentStart), allocator, out));
}

Status:SelfCProgramInit(ptr<SelfCProgram>:program, Allocator:allocator) {
	program.allocator = allocator;
	diagnostics::SelfDiagnosticBagInit(&program.diagnostics, allocator);
	source::SelfFileTableInit(&program.files, allocator);
	program.tokenFileCount = 0;
	program.declCount = 0;
	program.paramCount = 0;
	program.fieldCount = 0;
	program.typeUseCount = 0;
	program.funcUseCount = 0;
	return(Status::Ok);
}

Status:SelfCProgramDestroy(ptr<SelfCProgram>:program) {
	for (usize:i = 0; i < program.tokenFileCount; i++) {
		Array<Token>:tokens;
		tokens.data = program.tokenFiles[i].tokens;
		tokens.len = program.tokenFiles[i].tokenLen;
		tokens.cap = program.tokenFiles[i].tokenCap;
		tokens.allocator = program.allocator;
		tokenizer::TokenArrayDestroy(&tokens);
		std::DestroyOwnedString(&program.tokenFiles[i].packageName);
	}
	for (usize:i = 0; i < program.declCount; i++) {
		std::DestroyOwnedString(&program.decls[i].packageName);
	}
	for (usize:i = 0; i < program.typeUseCount; i++) {
		std::DestroyOwnedString(&program.typeUses[i].key);
		std::DestroyOwnedString(&program.typeUses[i].cName);
		std::DestroyOwnedString(&program.typeUses[i].baseName);
		std::DestroyOwnedString(&program.typeUses[i].arg0);
		std::DestroyOwnedString(&program.typeUses[i].arg1);
		std::DestroyOwnedString(&program.typeUses[i].arg2);
	}
	for (usize:i = 0; i < program.funcUseCount; i++) {
		std::DestroyOwnedString(&program.funcUses[i].key);
		std::DestroyOwnedString(&program.funcUses[i].cName);
		std::DestroyOwnedString(&program.funcUses[i].arg0);
		std::DestroyOwnedString(&program.funcUses[i].arg1);
		std::DestroyOwnedString(&program.funcUses[i].arg2);
	}
	source::SelfFileTableDestroy(&program.files);
	diagnostics::SelfDiagnosticBagDestroy(&program.diagnostics);
	return(Status::Ok);
}

Status:SelfCAddDiagnostic(ptr<SelfCProgram>:program, str:message) {
	return(diagnostics::SelfDiagnosticAddCString(&program.diagnostics, SelfDiagnosticSeverity::Error, SelfDiagnosticPhase::Semantic, -1, diagnostics::SelfSourceLocationNew(0, 0, 0, 0), message));
}

Status:SelfCLoadAndTokenize(ptr<SelfCProgram>:program, str:entryPath) {
	Status:status = source::SelfLoadCompilationSources(entryPath, program.allocator, &program.files, &program.diagnostics);
	if (status != Status::Ok) {
		return(status);
	}
	for (usize:i = 0; i < program.files.count; i++) {
		if (program.tokenFileCount >= len(program.tokenFiles)) {
			return(SelfCAddDiagnostic(program, "too many source files"));
		}
		ptr<SelfSourceFile>:sourceFile = &program.files.files[i];
		ptr<SelfCTokenFile>:tokenFile = &program.tokenFiles[program.tokenFileCount];
		tokenFile.sourceText = std::OwnedStringView(&sourceFile.content);
		tokenFile.path = std::OwnedStringView(&sourceFile.path);
		tokenFile.fileIndex = program.tokenFileCount;
		status = SelfCPackageNameFromPath(tokenFile.path, program.allocator, &tokenFile.packageName);
		if (status != Status::Ok) {
			return(status);
		}
		if (i == 0) {
			std::DestroyOwnedString(&tokenFile.packageName);
			status = SelfCMakeOwnedEmpty(program, &tokenFile.packageName);
			if (status != Status::Ok) {
				return(status);
			}
		}
		Array<Token>:tokens;
		status = tokenizer::TokenizeToArray(tokenFile.sourceText, false, program.allocator, &tokens);
		if (status != Status::Ok) {
			return(status);
		}
		tokenFile.tokens = tokens.data;
		tokenFile.tokenLen = tokens.len;
		tokenFile.tokenCap = tokens.cap;
		SelfAstTree:tree;
		status = ast::SelfParseTokens(tokenFile.tokens, tokenFile.tokenLen, tokenFile.sourceText, cast<i64>(program.tokenFileCount), program.allocator, &program.diagnostics, &tree);
		if (status == Status::Ok) {
			ast::SelfAstTreeDestroy(&tree);
		}
		if (status != Status::Ok) {
			return(status);
		}
		program.tokenFileCount += 1;
	}
	return(Status::Ok);
}

int:SelfCompilerFail(str:text) {
	File:stderr = std::Stderr();
	std::WriteStringToFile(&stderr, std::StringFromCString(text));
	return(1);
}

int:SelfCompilerPrintHelp() {
	File:stdout = std::Stdout();
	std::WriteStringToFile(&stdout, std::StringFromCString("kek build <input.kek> -o <output.c>\n"));
	std::WriteStringToFile(&stdout, std::StringFromCString("kek --help\n"));
	std::WriteStringToFile(&stdout, std::StringFromCString("kek --version\n"));
	return(0);
}

Status:SelfCWriteDiagnostics(ptr<SelfCProgram>:program) {
	StringBuilder:builder = std::StringBuilderNew(program.allocator);
	Status:status = diagnostics::SelfWriteDiagnosticDump(&program.diagnostics, &builder);
	if (status == Status::Ok) {
		File:stderr = std::Stderr();
		String:view = builder.View();
		Result<usize>:write = stderr.Write(view.Bytes());
		status = write.status;
	}
	builder.Destroy();
	return(status);
}

bool:SelfCIsOpenDelimiter(ptr<SelfCProgram>:program, usize:fileIndex, usize:index) {
	return(SelfCIsPunctuation(program, fileIndex, index, PunctuationKind::LeftParen)
		|| SelfCIsPunctuation(program, fileIndex, index, PunctuationKind::LeftBrace)
		|| SelfCIsPunctuation(program, fileIndex, index, PunctuationKind::LeftBracket)
		|| SelfCIsOperator(program, fileIndex, index, OperatorKind::Less));
}

bool:SelfCDelimiterMatches(ptr<SelfCProgram>:program, usize:fileIndex, usize:openIndex, usize:closeIndex) {
	if (SelfCIsPunctuation(program, fileIndex, openIndex, PunctuationKind::LeftParen)) {
		return(SelfCIsPunctuation(program, fileIndex, closeIndex, PunctuationKind::RightParen));
	}
	if (SelfCIsPunctuation(program, fileIndex, openIndex, PunctuationKind::LeftBrace)) {
		return(SelfCIsPunctuation(program, fileIndex, closeIndex, PunctuationKind::RightBrace));
	}
	if (SelfCIsPunctuation(program, fileIndex, openIndex, PunctuationKind::LeftBracket)) {
		return(SelfCIsPunctuation(program, fileIndex, closeIndex, PunctuationKind::RightBracket));
	}
	if (SelfCIsOperator(program, fileIndex, openIndex, OperatorKind::Less)) {
		return(SelfCIsOperator(program, fileIndex, closeIndex, OperatorKind::Greater));
	}
	return(false);
}

usize:SelfCFindMatching(ptr<SelfCProgram>:program, usize:fileIndex, usize:openIndex) {
	usize:count = SelfCFileTokenCount(program, fileIndex);
	usize:depth = 0;
	bool:isParen = SelfCIsPunctuation(program, fileIndex, openIndex, PunctuationKind::LeftParen);
	bool:isBrace = SelfCIsPunctuation(program, fileIndex, openIndex, PunctuationKind::LeftBrace);
	bool:isBracket = SelfCIsPunctuation(program, fileIndex, openIndex, PunctuationKind::LeftBracket);
	bool:isGeneric = SelfCIsOperator(program, fileIndex, openIndex, OperatorKind::Less);
	for (usize:i = openIndex; i < count; i++) {
		if ((isParen && SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::LeftParen))
			|| (isBrace && SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::LeftBrace))
			|| (isBracket && SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::LeftBracket))
			|| (isGeneric && SelfCIsOperator(program, fileIndex, i, OperatorKind::Less))) {
			depth += 1;
			continue;
		}
		if ((isParen && SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::RightParen))
			|| (isBrace && SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::RightBrace))
			|| (isBracket && SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::RightBracket))
			|| (isGeneric && SelfCIsOperator(program, fileIndex, i, OperatorKind::Greater))) {
			if (depth == 0) {
				return(i);
			}
			depth -= 1;
			if (depth == 0) {
				return(i);
			}
		}
	}
	return(count);
}

usize:SelfCSkipDelimited(ptr<SelfCProgram>:program, usize:fileIndex, usize:index) {
	usize:match = SelfCFindMatching(program, fileIndex, index);
	if (match >= SelfCFileTokenCount(program, fileIndex)) {
		return(index + 1);
	}
	return(match + 1);
}

usize:SelfCSkipAttributes(ptr<SelfCProgram>:program, usize:fileIndex, usize:index) {
	while (index < SelfCFileTokenCount(program, fileIndex) && SelfCIsPunctuation(program, fileIndex, index, PunctuationKind::LeftBracket)) {
		index = SelfCSkipDelimited(program, fileIndex, index);
	}
	return(index);
}

usize:SelfCFindTopLevelColon(ptr<SelfCProgram>:program, usize:fileIndex, usize:start, usize:end) {
	usize:parenDepth = 0;
	usize:braceDepth = 0;
	usize:bracketDepth = 0;
	usize:genericDepth = 0;
	for (usize:i = start; i < end; i++) {
		if (SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::LeftParen)) {
			parenDepth += 1;
			continue;
		}
		if (SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::RightParen)) {
			if (parenDepth > 0) {
				parenDepth -= 1;
			}
			continue;
		}
		if (SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::LeftBrace)) {
			braceDepth += 1;
			continue;
		}
		if (SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::RightBrace)) {
			if (braceDepth > 0) {
				braceDepth -= 1;
			}
			continue;
		}
		if (SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::LeftBracket)) {
			bracketDepth += 1;
			continue;
		}
		if (SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::RightBracket)) {
			if (bracketDepth > 0) {
				bracketDepth -= 1;
			}
			continue;
		}
		if (SelfCIsOperator(program, fileIndex, i, OperatorKind::Less)) {
			genericDepth += 1;
			continue;
		}
		if (SelfCIsOperator(program, fileIndex, i, OperatorKind::Greater)) {
			if (genericDepth > 0) {
				genericDepth -= 1;
			}
			continue;
		}
		if (parenDepth == 0 && braceDepth == 0 && bracketDepth == 0 && genericDepth == 0 && SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::Colon)) {
			return(i);
		}
	}
	return(end);
}

usize:SelfCFindTokenAtDepthZero(ptr<SelfCProgram>:program, usize:fileIndex, usize:start, usize:end, PunctuationKind:punctuation) {
	usize:parenDepth = 0;
	usize:braceDepth = 0;
	usize:bracketDepth = 0;
	usize:genericDepth = 0;
	for (usize:i = start; i < end; i++) {
		if (SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::LeftParen)) {
			parenDepth += 1;
			continue;
		}
		if (SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::RightParen)) {
			if (parenDepth > 0) {
				parenDepth -= 1;
			}
			continue;
		}
		if (SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::LeftBrace)) {
			braceDepth += 1;
			continue;
		}
		if (SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::RightBrace)) {
			if (braceDepth > 0) {
				braceDepth -= 1;
			}
			continue;
		}
		if (SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::LeftBracket)) {
			bracketDepth += 1;
			continue;
		}
		if (SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::RightBracket)) {
			if (bracketDepth > 0) {
				bracketDepth -= 1;
			}
			continue;
		}
		if (parenDepth == 0 && braceDepth == 0 && bracketDepth == 0 && genericDepth == 0 && SelfCIsPunctuation(program, fileIndex, i, punctuation)) {
			return(i);
		}
	}
	return(end);
}

usize:SelfCFindOperatorScope(ptr<SelfCProgram>:program, usize:fileIndex, usize:start, usize:end) {
	usize:genericDepth = 0;
	for (usize:i = start; i < end; i++) {
		if (SelfCIsOperator(program, fileIndex, i, OperatorKind::Less)) {
			genericDepth += 1;
			continue;
		}
		if (SelfCIsOperator(program, fileIndex, i, OperatorKind::Greater)) {
			if (genericDepth > 0) {
				genericDepth -= 1;
			}
			continue;
		}
		if (genericDepth == 0 && SelfCIsOperator(program, fileIndex, i, OperatorKind::Scope)) {
			return(i);
		}
	}
	return(end);
}

usize:SelfCFindNextGroup(ptr<SelfCProgram>:program, usize:fileIndex, usize:start, usize:end) {
	for (usize:i = start; i < end; i++) {
		if (SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::LeftParen)) {
			return(i);
		}
	}
	return(end);
}

usize:SelfCFindNextBlock(ptr<SelfCProgram>:program, usize:fileIndex, usize:start, usize:end) {
	for (usize:i = start; i < end; i++) {
		if (SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::LeftBrace)) {
			return(i);
		}
	}
	return(end);
}

u8:SelfCOperatorCode(ptr<SelfCProgram>:program, usize:fileIndex, usize:index) {
	Token:token = program.tokenFiles[fileIndex].tokens[index];
	if (token.kind == TokenKind::Operator) {
		return(cast<u8>(token.subkind + 1));
	}
	return(0);
}

Status:SelfCAddDecl(ptr<SelfCProgram>:program, ptr<SelfCDecl>:decl) {
	if (program.declCount >= len(program.decls)) {
		return(SelfCAddDiagnostic(program, "too many declarations"));
	}
	program.decls[program.declCount] = decl[0];
	program.declCount += 1;
	return(Status::Ok);
}

Status:SelfCAddParam(ptr<SelfCProgram>:program, ptr<SelfCParam>:param) {
	if (program.paramCount >= len(program.params)) {
		return(SelfCAddDiagnostic(program, "too many parameters"));
	}
	program.params[program.paramCount] = param[0];
	program.paramCount += 1;
	return(Status::Ok);
}

Status:SelfCAddField(ptr<SelfCProgram>:program, ptr<SelfCField>:field) {
	if (program.fieldCount >= len(program.fields)) {
		return(SelfCAddDiagnostic(program, "too many fields"));
	}
	program.fields[program.fieldCount] = field[0];
	program.fieldCount += 1;
	return(Status::Ok);
}

Status:SelfCParseParams(ptr<SelfCProgram>:program, ptr<SelfCDecl>:decl, usize:fileIndex, usize:start, usize:end) {
	decl.firstParam = program.paramCount;
	decl.paramCount = 0;
	usize:itemStart = start;
	while (itemStart < end) {
		if (SelfCIsPunctuation(program, fileIndex, itemStart, PunctuationKind::Comma)) {
			itemStart += 1;
			continue;
		}
		usize:itemEnd = SelfCFindTokenAtDepthZero(program, fileIndex, itemStart, end, PunctuationKind::Comma);
		usize:colon = SelfCFindTopLevelColon(program, fileIndex, itemStart, itemEnd);
		if (colon >= itemEnd) {
			break;
		}
		SelfCParam:param;
		param.fileIndex = fileIndex;
		param.typeStart = itemStart;
		param.typeEnd = colon;
		param.nameIndex = colon + 1;
		param.defaultStart = itemEnd;
		param.defaultEnd = itemEnd;
		param.hasDefault = false;
		for (usize:i = param.nameIndex + 1; i < itemEnd; i++) {
			if (SelfCIsOperator(program, fileIndex, i, OperatorKind::Assign)) {
				param.defaultStart = i + 1;
				param.defaultEnd = itemEnd;
				param.hasDefault = true;
				break;
			}
		}
		Status:status = SelfCAddParam(program, &param);
		if (status != Status::Ok) {
			return(status);
		}
		decl.paramCount += 1;
		if (itemEnd >= end) {
			break;
		}
		itemStart = itemEnd + 1;
	}
	return(Status::Ok);
}

Status:SelfCParseFields(ptr<SelfCProgram>:program, ptr<SelfCDecl>:decl, usize:fileIndex, usize:start, usize:end) {
	decl.firstField = program.fieldCount;
	decl.fieldCount = 0;
	usize:itemStart = start;
	while (itemStart < end) {
		itemStart = SelfCSkipAttributes(program, fileIndex, itemStart);
		if (itemStart >= end) {
			break;
		}
		if (SelfCIsPunctuation(program, fileIndex, itemStart, PunctuationKind::Semicolon)) {
			itemStart += 1;
			continue;
		}
		SelfCField:field;
		field.fileIndex = fileIndex;
		field.typeStart = itemStart;
		field.typeEnd = itemStart;
		field.nameIndex = itemStart;
		field.defaultStart = end;
		field.defaultEnd = end;
		field.arrayStart = end;
		field.arrayEnd = end;
		field.hasDefault = false;
		field.isArray = false;
		field.isNestedStruct = false;
		field.nestedBodyStart = end;
		field.nestedBodyEnd = end;

		if (SelfCIsKeyword(program, fileIndex, itemStart, KeywordKind::Struct)) {
			usize:colon = itemStart + 1;
			if (colon < end && SelfCIsPunctuation(program, fileIndex, colon, PunctuationKind::Colon)) {
				usize:nameIndex = colon + 1;
				usize:blockStart = SelfCFindNextBlock(program, fileIndex, nameIndex + 1, end);
				usize:blockEnd = SelfCFindMatching(program, fileIndex, blockStart);
				field.isNestedStruct = true;
				field.nameIndex = nameIndex;
				field.nestedBodyStart = blockStart + 1;
				field.nestedBodyEnd = blockEnd;
				Status:addNested = SelfCAddField(program, &field);
				if (addNested != Status::Ok) {
					return(addNested);
				}
				decl.fieldCount += 1;
				itemStart = blockEnd + 1;
				if (itemStart < end && SelfCIsPunctuation(program, fileIndex, itemStart, PunctuationKind::Semicolon)) {
					itemStart += 1;
				}
				continue;
			}
		}

		usize:itemEnd = itemStart;
		while (itemEnd < end && !SelfCIsPunctuation(program, fileIndex, itemEnd, PunctuationKind::Semicolon)) {
			if (SelfCIsPunctuation(program, fileIndex, itemEnd, PunctuationKind::LeftBrace)
				|| SelfCIsPunctuation(program, fileIndex, itemEnd, PunctuationKind::LeftParen)
				|| SelfCIsPunctuation(program, fileIndex, itemEnd, PunctuationKind::LeftBracket)) {
				itemEnd = SelfCSkipDelimited(program, fileIndex, itemEnd);
				continue;
			}
			itemEnd += 1;
		}
		usize:colon = SelfCFindTopLevelColon(program, fileIndex, itemStart, itemEnd);
		if (colon >= itemEnd) {
			itemStart = itemEnd + 1;
			continue;
		}
		field.typeStart = itemStart;
		field.typeEnd = colon;
		field.nameIndex = colon + 1;
		usize:afterName = field.nameIndex + 1;
		if (afterName < itemEnd && SelfCIsPunctuation(program, fileIndex, afterName, PunctuationKind::LeftBracket)) {
			field.isArray = true;
			field.arrayStart = afterName + 1;
			field.arrayEnd = SelfCFindMatching(program, fileIndex, afterName);
			afterName = field.arrayEnd + 1;
		}
		for (usize:i = afterName; i < itemEnd; i++) {
			if (SelfCIsOperator(program, fileIndex, i, OperatorKind::Assign)) {
				field.hasDefault = true;
				field.defaultStart = i + 1;
				field.defaultEnd = itemEnd;
				break;
			}
		}
		Status:status = SelfCAddField(program, &field);
		if (status != Status::Ok) {
			return(status);
		}
		decl.fieldCount += 1;
		itemStart = itemEnd + 1;
	}
	return(Status::Ok);
}

bool:SelfCDeclNameMatches(ptr<SelfCProgram>:program, ptr<SelfCDecl>:decl, String:name) {
	if (decl.nameIndex >= SelfCFileTokenCount(program, decl.fileIndex)) {
		return(false);
	}
	String:declName = SelfCTokenText(program, decl.fileIndex, decl.nameIndex);
	return(declName.Equals(name));
}

ptr<SelfCDecl>:SelfCFindTypeDecl(ptr<SelfCProgram>:program, String:name) {
	for (usize:i = 0; i < program.declCount; i++) {
		ptr<SelfCDecl>:decl = &program.decls[i];
		if ((decl.kind == SelfCDeclKind::Struct || decl.kind == SelfCDeclKind::Union || decl.kind == SelfCDeclKind::Enum || decl.kind == SelfCDeclKind::Alias)
			&& SelfCDeclNameMatches(program, decl, name)) {
			return(decl);
		}
	}
	return(0);
}

Status:SelfCParseAliasDecl(ptr<SelfCProgram>:program, usize:fileIndex, usize:start, ptr<usize>:outEnd) {
	usize:count = SelfCFileTokenCount(program, fileIndex);
	usize:end = start;
	while (end < count && !SelfCIsPunctuation(program, fileIndex, end, PunctuationKind::Semicolon) && !SelfCIsEof(program, fileIndex, end)) {
		end += 1;
	}
	SelfCDecl:decl;
	decl.kind = SelfCDeclKind::Alias;
	decl.fileIndex = fileIndex;
	decl.start = start;
	decl.end = end + 1;
	decl.nameIndex = start + 2;
	decl.returnStart = end;
	decl.returnEnd = end;
	decl.receiverStart = end;
	decl.receiverEnd = end;
	decl.hasReceiver = false;
	decl.isOperator = false;
	decl.operatorCode = 0;
	decl.genericStart = end;
	decl.genericEnd = end;
	decl.isGeneric = false;
	decl.paramStart = end;
	decl.paramEnd = end;
	decl.bodyStart = end;
	decl.bodyEnd = end;
	decl.hasBody = false;
	decl.firstParam = 0;
	decl.paramCount = 0;
	decl.firstField = 0;
	decl.fieldCount = 0;
	decl.emitted = false;
	Status:clone = SelfCCloneString(program, std::OwnedStringView(&program.tokenFiles[fileIndex].packageName), &decl.packageName);
	if (clone != Status::Ok) {
		return(clone);
	}
	for (usize:i = start + 3; i < end; i++) {
		if (SelfCIsOperator(program, fileIndex, i, OperatorKind::Assign)) {
			decl.returnStart = i + 1;
			decl.returnEnd = end;
			break;
		}
	}
	Status:status = SelfCAddDecl(program, &decl);
	outEnd[0] = end + 1;
	return(status);
}

Status:SelfCParseTypeDecl(ptr<SelfCProgram>:program, usize:fileIndex, usize:start, SelfCDeclKind:kind, ptr<usize>:outEnd) {
	usize:count = SelfCFileTokenCount(program, fileIndex);
	usize:colon = start + 1;
	usize:nameIndex = colon + 1;
	if (kind == SelfCDeclKind::Enum) {
		if (colon < count && SelfCIsPunctuation(program, fileIndex, colon, PunctuationKind::Colon)) {
			usize:secondColon = SelfCFindTopLevelColon(program, fileIndex, colon + 1, count);
			if (secondColon < count) {
				nameIndex = secondColon + 1;
			}
		}
	}
	usize:genericStart = count;
	usize:genericEnd = count;
	if (nameIndex + 1 < count && SelfCIsOperator(program, fileIndex, nameIndex + 1, OperatorKind::Less)) {
		genericStart = nameIndex + 1;
		genericEnd = SelfCFindMatching(program, fileIndex, genericStart);
	}
	usize:blockStart = SelfCFindNextBlock(program, fileIndex, nameIndex + 1, count);
	usize:blockEnd = SelfCFindMatching(program, fileIndex, blockStart);
	SelfCDecl:decl;
	decl.kind = kind;
	decl.fileIndex = fileIndex;
	decl.start = start;
	decl.end = blockEnd + 1;
	decl.nameIndex = nameIndex;
	decl.returnStart = start;
	decl.returnEnd = start;
	decl.receiverStart = start;
	decl.receiverEnd = start;
	decl.hasReceiver = false;
	decl.isOperator = false;
	decl.operatorCode = 0;
	decl.genericStart = genericStart;
	decl.genericEnd = genericEnd;
	decl.isGeneric = genericStart < count;
	decl.paramStart = start;
	decl.paramEnd = start;
	decl.bodyStart = blockStart + 1;
	decl.bodyEnd = blockEnd;
	decl.hasBody = true;
	decl.firstParam = 0;
	decl.paramCount = 0;
	decl.firstField = 0;
	decl.fieldCount = 0;
	decl.emitted = false;
	Status:clone = SelfCCloneString(program, std::OwnedStringView(&program.tokenFiles[fileIndex].packageName), &decl.packageName);
	if (clone != Status::Ok) {
		return(clone);
	}
	if (kind == SelfCDeclKind::Struct || kind == SelfCDeclKind::Union) {
		Status:fields = SelfCParseFields(program, &decl, fileIndex, blockStart + 1, blockEnd);
		if (fields != Status::Ok) {
			return(fields);
		}
	}
	Status:status = SelfCAddDecl(program, &decl);
	outEnd[0] = blockEnd + 1;
	if (outEnd[0] < count && SelfCIsPunctuation(program, fileIndex, outEnd[0], PunctuationKind::Semicolon)) {
		outEnd[0] += 1;
	}
	return(status);
}

Status:SelfCParseExternDecl(ptr<SelfCProgram>:program, usize:fileIndex, usize:start, ptr<usize>:outEnd) {
	usize:count = SelfCFileTokenCount(program, fileIndex);
	usize:blockStart = SelfCFindNextBlock(program, fileIndex, start, count);
	usize:blockEnd = SelfCFindMatching(program, fileIndex, blockStart);
	SelfCDecl:decl;
	decl.kind = SelfCDeclKind::ExternC;
	decl.fileIndex = fileIndex;
	decl.start = start;
	decl.end = blockEnd + 1;
	decl.nameIndex = start;
	decl.returnStart = start;
	decl.returnEnd = start;
	decl.receiverStart = start;
	decl.receiverEnd = start;
	decl.hasReceiver = false;
	decl.isOperator = false;
	decl.operatorCode = 0;
	decl.genericStart = start;
	decl.genericEnd = start;
	decl.isGeneric = false;
	decl.paramStart = start;
	decl.paramEnd = start;
	decl.bodyStart = blockStart + 1;
	decl.bodyEnd = blockEnd;
	decl.hasBody = true;
	decl.firstParam = 0;
	decl.paramCount = 0;
	decl.firstField = 0;
	decl.fieldCount = 0;
	decl.emitted = false;
	Status:clone = SelfCCloneString(program, std::OwnedStringView(&program.tokenFiles[fileIndex].packageName), &decl.packageName);
	if (clone != Status::Ok) {
		return(clone);
	}
	Status:status = SelfCAddDecl(program, &decl);
	outEnd[0] = blockEnd + 1;
	return(status);
}

Status:SelfCParseFunctionDecl(ptr<SelfCProgram>:program, usize:fileIndex, usize:start, ptr<usize>:outEnd) {
	usize:count = SelfCFileTokenCount(program, fileIndex);
	usize:groupStart = SelfCFindNextGroup(program, fileIndex, start, count);
	if (groupStart >= count) {
		outEnd[0] = start + 1;
		return(Status::Ok);
	}
	usize:groupEnd = SelfCFindMatching(program, fileIndex, groupStart);
	usize:colon = SelfCFindTopLevelColon(program, fileIndex, start, groupStart);
	if (colon >= groupStart) {
		outEnd[0] = groupEnd + 1;
		return(Status::Ok);
	}
	usize:blockStart = groupEnd + 1;
	bool:hasBody = false;
	usize:blockEnd = groupEnd;
	if (blockStart < count && SelfCIsPunctuation(program, fileIndex, blockStart, PunctuationKind::LeftBrace)) {
		hasBody = true;
		blockEnd = SelfCFindMatching(program, fileIndex, blockStart);
	}
	SelfCDecl:decl;
	decl.kind = SelfCDeclKind::Function;
	decl.fileIndex = fileIndex;
	decl.start = start;
	decl.end = blockEnd + 1;
	decl.nameIndex = colon + 1;
	decl.returnStart = start;
	decl.returnEnd = colon;
	decl.receiverStart = colon + 1;
	decl.receiverEnd = colon + 1;
	decl.hasReceiver = false;
	decl.isOperator = false;
	decl.operatorCode = 0;
	decl.genericStart = count;
	decl.genericEnd = count;
	decl.isGeneric = false;
	decl.paramStart = groupStart + 1;
	decl.paramEnd = groupEnd;
	decl.bodyStart = blockStart + 1;
	decl.bodyEnd = blockEnd;
	decl.hasBody = hasBody;
	decl.firstParam = 0;
	decl.paramCount = 0;
	decl.firstField = 0;
	decl.fieldCount = 0;
	decl.emitted = false;
	Status:clone = SelfCCloneString(program, std::OwnedStringView(&program.tokenFiles[fileIndex].packageName), &decl.packageName);
	if (clone != Status::Ok) {
		return(clone);
	}

	usize:scope = SelfCFindOperatorScope(program, fileIndex, colon + 1, groupStart);
	if (scope < groupStart) {
		decl.hasReceiver = true;
		decl.receiverStart = colon + 1;
		decl.receiverEnd = scope;
		decl.nameIndex = scope + 1;
	}
	if (decl.nameIndex < groupStart && SelfCIsIdentifierText(program, fileIndex, decl.nameIndex, "operator")) {
		decl.isOperator = true;
		decl.operatorCode = SelfCOperatorCode(program, fileIndex, decl.nameIndex + 1);
	}
	usize:genericProbe = decl.nameIndex + 1;
	if (decl.isOperator) {
		genericProbe = decl.nameIndex + 2;
	}
	if (genericProbe < groupStart && SelfCIsOperator(program, fileIndex, genericProbe, OperatorKind::Less)) {
		decl.genericStart = genericProbe;
		decl.genericEnd = SelfCFindMatching(program, fileIndex, genericProbe);
		decl.isGeneric = true;
	}
	for (usize:i = decl.receiverStart; i < decl.receiverEnd; i++) {
		if (SelfCIsOperator(program, fileIndex, i, OperatorKind::Less)) {
			decl.isGeneric = true;
		}
	}
	Status:params = SelfCParseParams(program, &decl, fileIndex, groupStart + 1, groupEnd);
	if (params != Status::Ok) {
		return(params);
	}
	Status:status = SelfCAddDecl(program, &decl);
	outEnd[0] = blockEnd + 1;
	if (outEnd[0] < count && SelfCIsPunctuation(program, fileIndex, outEnd[0], PunctuationKind::Semicolon)) {
		outEnd[0] += 1;
	}
	return(status);
}

Status:SelfCParseDeclarations(ptr<SelfCProgram>:program) {
	for (usize:fileIndex = 0; fileIndex < program.tokenFileCount; fileIndex++) {
		usize:index = 0;
		usize:count = SelfCFileTokenCount(program, fileIndex);
		while (index < count && !SelfCIsEof(program, fileIndex, index)) {
			index = SelfCSkipAttributes(program, fileIndex, index);
			if (index >= count || SelfCIsEof(program, fileIndex, index)) {
				break;
			}
			usize:next = index + 1;
			Status:status = Status::Ok;
			if (SelfCIsPunctuation(program, fileIndex, index, PunctuationKind::Hash)) {
				usize:groupStart = SelfCFindNextGroup(program, fileIndex, index, count);
				if (groupStart < count) {
					next = SelfCSkipDelimited(program, fileIndex, groupStart);
					if (next < count && SelfCIsPunctuation(program, fileIndex, next, PunctuationKind::Semicolon)) {
						next += 1;
					}
				}
			} else {
				if (SelfCIsKeyword(program, fileIndex, index, KeywordKind::Extern)) {
					status = SelfCParseExternDecl(program, fileIndex, index, &next);
				} else {
					if (SelfCIsKeyword(program, fileIndex, index, KeywordKind::Alias) || SelfCIsIdentifierText(program, fileIndex, index, "alias")) {
						status = SelfCParseAliasDecl(program, fileIndex, index, &next);
					} else {
						if (SelfCIsKeyword(program, fileIndex, index, KeywordKind::Struct) || SelfCIsIdentifierText(program, fileIndex, index, "struct")) {
							status = SelfCParseTypeDecl(program, fileIndex, index, SelfCDeclKind::Struct, &next);
						} else {
							if (SelfCIsKeyword(program, fileIndex, index, KeywordKind::Union) || SelfCIsIdentifierText(program, fileIndex, index, "union")) {
								status = SelfCParseTypeDecl(program, fileIndex, index, SelfCDeclKind::Union, &next);
							} else {
								if (SelfCIsKeyword(program, fileIndex, index, KeywordKind::Enum) || SelfCIsIdentifierText(program, fileIndex, index, "enum")) {
									status = SelfCParseTypeDecl(program, fileIndex, index, SelfCDeclKind::Enum, &next);
								} else {
									status = SelfCParseFunctionDecl(program, fileIndex, index, &next);
								}
							}
						}
					}
				}
			}
			if (status != Status::Ok) {
				return(status);
			}
			if (next <= index) {
				next = index + 1;
			}
			index = next;
		}
	}
	return(Status::Ok);
}

Status:SelfCWriteTokenRangeRaw(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, usize:fileIndex, usize:start, usize:end) {
	for (usize:i = start; i < end; i++) {
		Status:status = SelfCWriteToken(program, out, fileIndex, i);
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(Status::Ok);
}

bool:SelfCIsBuiltinTypeName(String:name) {
	return(name.EqualsCString("void")
		|| name.EqualsCString("bool")
		|| name.EqualsCString("int")
		|| name.EqualsCString("u8")
		|| name.EqualsCString("u16")
		|| name.EqualsCString("u32")
		|| name.EqualsCString("u64")
		|| name.EqualsCString("i8")
		|| name.EqualsCString("i16")
		|| name.EqualsCString("i32")
		|| name.EqualsCString("i64")
		|| name.EqualsCString("f32")
		|| name.EqualsCString("f64")
		|| name.EqualsCString("ptr")
		|| name.EqualsCString("str")
		|| name.EqualsCString("byte")
		|| name.EqualsCString("usize")
		|| name.EqualsCString("isize")
		|| name.EqualsCString("RawHandle"));
}

Status:SelfCWriteSanitized(ptr<StringBuilder>:out, String:text) {
	for (usize:i = 0; i < text.len; i++) {
		byte:c = text.data[i];
		if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_') {
			Status:status = out.WriteByte(c);
			if (status != Status::Ok) {
				return(status);
			}
		} else {
			Status:status = out.WriteByte('_');
			if (status != Status::Ok) {
				return(status);
			}
		}
	}
	return(Status::Ok);
}

Status:SelfCWriteOperatorName(ptr<StringBuilder>:out, u8:operatorCode) {
	u64:kind = cast<u64>(operatorCode);
	if (kind == cast<u64>(OperatorKind::Plus) + 1) {
		return(out.WriteCString("plus"));
	}
	if (kind == cast<u64>(OperatorKind::Minus) + 1) {
		return(out.WriteCString("minus"));
	}
	if (kind == cast<u64>(OperatorKind::Equal) + 1) {
		return(out.WriteCString("equal"));
	}
	if (kind == cast<u64>(OperatorKind::PlusAssign) + 1) {
		return(out.WriteCString("plus_assign"));
	}
	if (kind == cast<u64>(OperatorKind::MinusAssign) + 1) {
		return(out.WriteCString("minus_assign"));
	}
	if (kind == cast<u64>(OperatorKind::Less) + 1) {
		return(out.WriteCString("less"));
	}
	if (kind == cast<u64>(OperatorKind::Greater) + 1) {
		return(out.WriteCString("greater"));
	}
	return(out.WriteCString("op"));
}

bool:SelfCDeclPackageIsRoot(ptr<SelfCDecl>:decl) {
	String:packageName = std::OwnedStringView(&decl.packageName);
	return(packageName.len == 0);
}

Status:SelfCWriteDeclCName(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCDecl>:decl) {
	if (decl.hasReceiver) {
		Status:status = SelfCWriteTypeSuffixFromRange(program, out, decl.fileIndex, decl.receiverStart, decl.receiverEnd);
		if (status != Status::Ok) {
			return(status);
		}
		status = out.WriteByte('_');
		if (status != Status::Ok) {
			return(status);
		}
		if (decl.isOperator) {
			status = out.WriteCString("operator_");
			if (status == Status::Ok) {
				status = SelfCWriteOperatorName(out, decl.operatorCode);
			}
			if (status == Status::Ok) {
				status = out.WriteCString("_");
			}
			if (status == Status::Ok) {
				status = std::FormatU64ToBuilder(out, cast<u64>(decl.paramCount), 10);
			}
			return(status);
		}
		return(SelfCWriteToken(program, out, decl.fileIndex, decl.nameIndex));
	}
	if (!SelfCDeclPackageIsRoot(decl)) {
		Status:status = out.WriteString(std::OwnedStringView(&decl.packageName));
		if (status != Status::Ok) {
			return(status);
		}
		status = out.WriteByte('_');
		if (status != Status::Ok) {
			return(status);
		}
	}
	Status:nameStatus = SelfCWriteToken(program, out, decl.fileIndex, decl.nameIndex);
	if (nameStatus != Status::Ok) {
		return(nameStatus);
	}
	if (decl.isGeneric && decl.genericStart < SelfCFileTokenCount(program, decl.fileIndex)) {
		return(Status::Ok);
	}
	return(Status::Ok);
}

Status:SelfCWriteTypeSuffixFromRange(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, usize:fileIndex, usize:start, usize:end) {
	if (start >= end) {
		return(Status::Ok);
	}
	if (start + 1 < end && SelfCIsOperator(program, fileIndex, start + 1, OperatorKind::Less)) {
		Status:status = SelfCWriteSanitized(out, SelfCTokenText(program, fileIndex, start));
		if (status != Status::Ok) {
			return(status);
		}
		usize:genericEnd = SelfCFindMatching(program, fileIndex, start + 1);
		usize:argStart = start + 2;
		while (argStart < genericEnd) {
			usize:argEnd = SelfCFindTokenAtDepthZero(program, fileIndex, argStart, genericEnd, PunctuationKind::Comma);
			status = out.WriteCString("__");
			if (status != Status::Ok) {
				return(status);
			}
			status = SelfCWriteTypeSuffixFromRange(program, out, fileIndex, argStart, argEnd);
			if (status != Status::Ok) {
				return(status);
			}
			if (argEnd >= genericEnd) {
				break;
			}
			argStart = argEnd + 1;
		}
		return(Status::Ok);
	}
	return(SelfCWriteSanitized(out, SelfCTokenText(program, fileIndex, start)));
}

Status:SelfCTypeInfoDestroy(ptr<SelfCTypeInfo>:info) {
	std::DestroyOwnedString(&info.key);
	std::DestroyOwnedString(&info.cType);
	std::DestroyOwnedString(&info.baseName);
	std::DestroyOwnedString(&info.arg0);
	std::DestroyOwnedString(&info.arg1);
	std::DestroyOwnedString(&info.arg2);
	return(Status::Ok);
}

Status:SelfCTypeInfoInitEmpty(ptr<SelfCProgram>:program, ptr<SelfCTypeInfo>:info) {
	Status:status = SelfCMakeOwnedEmpty(program, &info.key);
	if (status == Status::Ok) {
		status = SelfCMakeOwnedEmpty(program, &info.cType);
	}
	if (status == Status::Ok) {
		status = SelfCMakeOwnedEmpty(program, &info.baseName);
	}
	if (status == Status::Ok) {
		status = SelfCMakeOwnedEmpty(program, &info.arg0);
	}
	if (status == Status::Ok) {
		status = SelfCMakeOwnedEmpty(program, &info.arg1);
	}
	if (status == Status::Ok) {
		status = SelfCMakeOwnedEmpty(program, &info.arg2);
	}
	info.argCount = 0;
	info.isPointer = false;
	return(status);
}

Status:SelfCReplaceOwned(ptr<OwnedString>:target, OwnedString:value) {
	std::DestroyOwnedString(target);
	target.data = value.data;
	target.len = value.len;
	target.cap = value.cap;
	target.allocator = value.allocator;
	return(Status::Ok);
}

Status:SelfCBuildTypeKey(ptr<SelfCProgram>:program, usize:fileIndex, usize:start, usize:end, ptr<OwnedString>:out) {
	StringBuilder:builder = std::StringBuilderNew(program.allocator);
	Status:status = SelfCWriteTypeSuffixFromRange(program, &builder, fileIndex, start, end);
	if (status == Status::Ok) {
		status = SelfCDetachBuilder(&builder, out);
	}
	builder.Destroy();
	return(status);
}

Status:SelfCWriteCTypeFromKey(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, String:key) {
	if (key.EqualsCString("f32")) {
		return(out.WriteCString("float"));
	}
	if (key.EqualsCString("f64")) {
		return(out.WriteCString("double"));
	}
	if (key.EqualsCString("ptr")) {
		return(out.WriteCString("ptr"));
	}
	if (key.EqualsCString("str")) {
		return(out.WriteCString("str"));
	}
	if (SelfCIsBuiltinTypeName(key)) {
		return(out.WriteString(key));
	}
	Result<usize>:ptrMarker = key.FindByte('*');
	if (ptrMarker.status == Status::Ok) {
		return(out.WriteString(key));
	}
	ptr<SelfCDecl>:decl = SelfCFindTypeDecl(program, key);
	if (decl != 0) {
		if (decl.kind == SelfCDeclKind::Struct) {
			Status:status = out.WriteCString("struct ");
			if (status == Status::Ok) {
				status = out.WriteString(key);
			}
			return(status);
		}
		return(out.WriteString(key));
	}
	for (usize:i = 0; i < program.typeUseCount; i++) {
		String:useKey = std::OwnedStringView(&program.typeUses[i].key);
		if (useKey.Equals(key)) {
			ptr<SelfCDecl>:baseDecl = SelfCFindTypeDecl(program, std::OwnedStringView(&program.typeUses[i].baseName));
			if (baseDecl != 0 && baseDecl.kind == SelfCDeclKind::Struct) {
				Status:status = out.WriteCString("struct ");
				if (status == Status::Ok) {
					status = out.WriteString(key);
				}
				return(status);
			}
			return(out.WriteString(key));
		}
	}
	if (key.len > 0 && key.data[0] >= 'A' && key.data[0] <= 'Z') {
		Status:status = out.WriteCString("struct ");
		if (status == Status::Ok) {
			status = out.WriteString(key);
		}
		return(status);
	}
	return(out.WriteString(key));
}

Status:SelfCMakeCTypeFromKey(ptr<SelfCProgram>:program, String:key, ptr<OwnedString>:out) {
	StringBuilder:builder = std::StringBuilderNew(program.allocator);
	Status:status = SelfCWriteCTypeFromKey(program, &builder, key);
	if (status == Status::Ok) {
		status = SelfCDetachBuilder(&builder, out);
	}
	builder.Destroy();
	return(status);
}

Status:SelfCTypeInfoFromKey(ptr<SelfCProgram>:program, String:key, ptr<SelfCTypeInfo>:info) {
	Status:status = SelfCTypeInfoInitEmpty(program, info);
	if (status != Status::Ok) {
		return(status);
	}
	OwnedString:keyOwned;
	status = SelfCCloneString(program, key, &keyOwned);
	if (status == Status::Ok) {
		status = SelfCReplaceOwned(&info.key, keyOwned);
	}
	OwnedString:cOwned;
	if (status == Status::Ok) {
		status = SelfCMakeCTypeFromKey(program, key, &cOwned);
	}
	if (status == Status::Ok) {
		status = SelfCReplaceOwned(&info.cType, cOwned);
	}
	Result<usize>:ptrMarker = key.FindByte('*');
	info.isPointer = ptrMarker.status == Status::Ok;
	return(status);
}

Status:SelfCRenderTypeInfo(ptr<SelfCProgram>:program, usize:fileIndex, usize:start, usize:end, ptr<SelfCTypeInfo>:info) {
	Status:status = SelfCTypeInfoInitEmpty(program, info);
	if (status != Status::Ok) {
		return(status);
	}
	if (start >= end) {
		return(Status::Ok);
	}
	String:first = SelfCTokenText(program, fileIndex, start);
	if (first.EqualsCString("ptr") && start + 1 < end && SelfCIsOperator(program, fileIndex, start + 1, OperatorKind::Less)) {
		usize:genericEnd = SelfCFindMatching(program, fileIndex, start + 1);
		SelfCTypeInfo:inner;
		status = SelfCRenderTypeInfo(program, fileIndex, start + 2, genericEnd, &inner);
		if (status != Status::Ok) {
			return(status);
		}
		StringBuilder:key = std::StringBuilderNew(program.allocator);
		status = key.WriteString(std::OwnedStringView(&inner.key));
		if (status == Status::Ok) {
			status = key.WriteByte('*');
		}
		OwnedString:keyOwned;
		if (status == Status::Ok) {
			status = SelfCDetachBuilder(&key, &keyOwned);
		}
		key.Destroy();
		if (status == Status::Ok) {
			status = SelfCReplaceOwned(&info.key, keyOwned);
		}
		StringBuilder:cType = std::StringBuilderNew(program.allocator);
		if (status == Status::Ok) {
			status = cType.WriteString(std::OwnedStringView(&inner.cType));
		}
		if (status == Status::Ok) {
			status = cType.WriteByte('*');
		}
		OwnedString:cOwned;
		if (status == Status::Ok) {
			status = SelfCDetachBuilder(&cType, &cOwned);
		}
		cType.Destroy();
		if (status == Status::Ok) {
			status = SelfCReplaceOwned(&info.cType, cOwned);
		}
		info.isPointer = true;
		SelfCTypeInfoDestroy(&inner);
		return(status);
	}
	status = SelfCBuildTypeKey(program, fileIndex, start, end, &info.key);
	if (status != Status::Ok) {
		return(status);
	}
	if (start + 1 < end && SelfCIsOperator(program, fileIndex, start + 1, OperatorKind::Less)) {
		status = SelfCCloneString(program, first, &info.baseName);
		if (status != Status::Ok) {
			return(status);
		}
		usize:genericEnd = SelfCFindMatching(program, fileIndex, start + 1);
		usize:argStart = start + 2;
		while (argStart < genericEnd) {
			usize:argEnd = SelfCFindTokenAtDepthZero(program, fileIndex, argStart, genericEnd, PunctuationKind::Comma);
			SelfCTypeInfo:argInfo;
			status = SelfCRenderTypeInfo(program, fileIndex, argStart, argEnd, &argInfo);
			if (status != Status::Ok) {
				return(status);
			}
			if (info.argCount == 0) {
				OwnedString:cloneArg;
				status = SelfCCloneString(program, std::OwnedStringView(&argInfo.key), &cloneArg);
				if (status == Status::Ok) {
					status = SelfCReplaceOwned(&info.arg0, cloneArg);
				}
			} else {
				if (info.argCount == 1) {
					OwnedString:cloneArg1;
					status = SelfCCloneString(program, std::OwnedStringView(&argInfo.key), &cloneArg1);
					if (status == Status::Ok) {
						status = SelfCReplaceOwned(&info.arg1, cloneArg1);
					}
				} else {
					if (info.argCount == 2) {
						OwnedString:cloneArg2;
						status = SelfCCloneString(program, std::OwnedStringView(&argInfo.key), &cloneArg2);
						if (status == Status::Ok) {
							status = SelfCReplaceOwned(&info.arg2, cloneArg2);
						}
					}
				}
			}
			info.argCount += 1;
			SelfCTypeInfoDestroy(&argInfo);
			if (status != Status::Ok) {
				return(status);
			}
			if (argEnd >= genericEnd) {
				break;
			}
			argStart = argEnd + 1;
		}
	}
	status = SelfCMakeCTypeFromKey(program, std::OwnedStringView(&info.key), &info.cType);
	return(status);
}

bool:SelfCTypeUseExists(ptr<SelfCProgram>:program, String:key) {
	for (usize:i = 0; i < program.typeUseCount; i++) {
		String:useKey = std::OwnedStringView(&program.typeUses[i].key);
		if (useKey.Equals(key)) {
			return(true);
		}
	}
	return(false);
}

Status:SelfCAddTypeUse(ptr<SelfCProgram>:program, ptr<SelfCTypeInfo>:info) {
	if (info.argCount == 0) {
		return(Status::Ok);
	}
	String:key = std::OwnedStringView(&info.key);
	if (SelfCTypeUseExists(program, key)) {
		return(Status::Ok);
	}
	if (program.typeUseCount >= len(program.typeUses)) {
		return(SelfCAddDiagnostic(program, "too many generic type uses"));
	}
	ptr<SelfCTypeUse>:use = &program.typeUses[program.typeUseCount];
	Status:status = SelfCCloneString(program, key, &use.key);
	if (status == Status::Ok) {
		status = SelfCCloneString(program, std::OwnedStringView(&info.cType), &use.cName);
	}
	if (status == Status::Ok) {
		status = SelfCCloneString(program, std::OwnedStringView(&info.baseName), &use.baseName);
	}
	if (status == Status::Ok) {
		status = SelfCCloneString(program, std::OwnedStringView(&info.arg0), &use.arg0);
	}
	if (status == Status::Ok) {
		status = SelfCCloneString(program, std::OwnedStringView(&info.arg1), &use.arg1);
	}
	if (status == Status::Ok) {
		status = SelfCCloneString(program, std::OwnedStringView(&info.arg2), &use.arg2);
	}
	use.argCount = info.argCount;
	use.emitted = false;
	if (status == Status::Ok) {
		program.typeUseCount += 1;
	}
	return(status);
}

Status:SelfCAddTypeUseFromBaseArg(ptr<SelfCProgram>:program, str:baseName, String:arg0) {
	StringBuilder:keyBuilder = std::StringBuilderNew(program.allocator);
	Status:status = keyBuilder.WriteCString(baseName);
	if (status == Status::Ok) {
		status = keyBuilder.WriteCString("__");
	}
	if (status == Status::Ok) {
		status = keyBuilder.WriteString(arg0);
	}
	String:key = keyBuilder.View();
	if (status == Status::Ok && SelfCTypeUseExists(program, key)) {
		keyBuilder.Destroy();
		return(Status::Ok);
	}
	if (status == Status::Ok && program.typeUseCount >= len(program.typeUses)) {
		keyBuilder.Destroy();
		return(SelfCAddDiagnostic(program, "too many generic type uses"));
	}
	ptr<SelfCTypeUse>:use = &program.typeUses[program.typeUseCount];
	if (status == Status::Ok) {
		status = SelfCCloneString(program, key, &use.key);
	}
	if (status == Status::Ok) {
		status = SelfCCloneString(program, key, &use.cName);
	}
	if (status == Status::Ok) {
		status = SelfCCloneString(program, std::StringFromCString(baseName), &use.baseName);
	}
	if (status == Status::Ok) {
		status = SelfCCloneString(program, arg0, &use.arg0);
	}
	if (status == Status::Ok) {
		status = SelfCMakeOwnedEmpty(program, &use.arg1);
	}
	if (status == Status::Ok) {
		status = SelfCMakeOwnedEmpty(program, &use.arg2);
	}
	use.argCount = 1;
	use.emitted = false;
	if (status == Status::Ok) {
		program.typeUseCount += 1;
	}
	keyBuilder.Destroy();
	return(status);
}

bool:SelfCConcreteTypeKey(ptr<SelfCProgram>:program, String:key) {
	if (key.len == 0) {
		return(false);
	}
	if (SelfCIsBuiltinTypeName(key)) {
		return(true);
	}
	if (key.ContainsByte('*')) {
		return(true);
	}
	if (SelfCFindTypeDecl(program, key) != 0) {
		return(true);
	}
	for (usize:i = 0; i < program.typeUseCount; i++) {
		String:useKey = std::OwnedStringView(&program.typeUses[i].key);
		if (useKey.Equals(key)) {
			return(true);
		}
	}
	return(false);
}

bool:SelfCTypeInfoConcrete(ptr<SelfCProgram>:program, ptr<SelfCTypeInfo>:info) {
	if (info.argCount == 0) {
		return(SelfCConcreteTypeKey(program, std::OwnedStringView(&info.key)));
	}
	if (info.argCount >= 1 && !SelfCConcreteTypeKey(program, std::OwnedStringView(&info.arg0))) {
		return(false);
	}
	if (info.argCount >= 2 && !SelfCConcreteTypeKey(program, std::OwnedStringView(&info.arg1))) {
		return(false);
	}
	if (info.argCount >= 3 && !SelfCConcreteTypeKey(program, std::OwnedStringView(&info.arg2))) {
		return(false);
	}
	return(true);
}

Status:SelfCCollectTypeUsesInRange(ptr<SelfCProgram>:program, usize:fileIndex, usize:start, usize:end) {
	usize:i = start;
	while (i < end) {
		if (i + 1 < end && SelfCIsOperator(program, fileIndex, i + 1, OperatorKind::Less)) {
			String:name = SelfCTokenText(program, fileIndex, i);
			ptr<SelfCDecl>:decl = SelfCFindTypeDecl(program, name);
			if (decl != 0 && decl.isGeneric) {
				usize:genericEnd = SelfCFindMatching(program, fileIndex, i + 1);
				SelfCTypeInfo:info;
				Status:status = SelfCRenderTypeInfo(program, fileIndex, i, genericEnd + 1, &info);
				if (status != Status::Ok) {
					return(status);
				}
				if (SelfCTypeInfoConcrete(program, &info)) {
					status = SelfCAddTypeUse(program, &info);
				}
				SelfCTypeInfoDestroy(&info);
				if (status != Status::Ok) {
					return(status);
				}
				i = genericEnd + 1;
				continue;
			}
		}
		i += 1;
	}
	return(Status::Ok);
}

ptr<SelfCDecl>:SelfCFindFunctionDeclByName(ptr<SelfCProgram>:program, String:name, String:packageName) {
	for (usize:i = 0; i < program.declCount; i++) {
		ptr<SelfCDecl>:decl = &program.decls[i];
		if (decl.kind != SelfCDeclKind::Function) {
			continue;
		}
		if (decl.hasReceiver) {
			continue;
		}
		if (!SelfCDeclNameMatches(program, decl, name)) {
			continue;
		}
		String:declPackage = std::OwnedStringView(&decl.packageName);
		if (packageName.len == 0 || declPackage.Equals(packageName)) {
			return(decl);
		}
	}
	return(0);
}

bool:SelfCFuncUseExists(ptr<SelfCProgram>:program, usize:declIndex, String:key) {
	for (usize:i = 0; i < program.funcUseCount; i++) {
		String:useKey = std::OwnedStringView(&program.funcUses[i].key);
		if (program.funcUses[i].declIndex == declIndex && useKey.Equals(key)) {
			return(true);
		}
	}
	return(false);
}

usize:SelfCDeclIndex(ptr<SelfCProgram>:program, ptr<SelfCDecl>:decl) {
	for (usize:i = 0; i < program.declCount; i++) {
		if (&program.decls[i] == decl) {
			return(i);
		}
	}
	return(len(program.decls));
}

Status:SelfCBuildGenericFuncCName(ptr<SelfCProgram>:program, ptr<SelfCDecl>:decl, ptr<SelfCTypeInfo>:arg0, ptr<SelfCTypeInfo>:arg1, ptr<SelfCTypeInfo>:arg2, usize:argCount, ptr<OwnedString>:out) {
	StringBuilder:builder = std::StringBuilderNew(program.allocator);
	Status:status = Status::Ok;
	if (decl.hasReceiver && argCount >= 1) {
		status = SelfCWriteSanitized(&builder, SelfCTokenText(program, decl.fileIndex, decl.receiverStart));
		if (status == Status::Ok) {
			status = builder.WriteCString("__");
		}
		if (status == Status::Ok) {
			status = builder.WriteString(std::OwnedStringView(&arg0.key));
		}
		if (status == Status::Ok) {
			status = builder.WriteByte('_');
		}
		if (decl.isOperator) {
			if (status == Status::Ok) {
				status = builder.WriteCString("operator_");
			}
			if (status == Status::Ok) {
				status = SelfCWriteOperatorName(&builder, decl.operatorCode);
			}
			if (status == Status::Ok) {
				status = builder.WriteCString("_");
			}
			if (status == Status::Ok) {
				status = std::FormatU64ToBuilder(&builder, cast<u64>(decl.paramCount), 10);
			}
		} else {
			if (status == Status::Ok) {
				status = SelfCWriteToken(program, &builder, decl.fileIndex, decl.nameIndex);
			}
		}
		if (status == Status::Ok) {
			status = SelfCDetachBuilder(&builder, out);
		}
		builder.Destroy();
		return(status);
	}
	status = SelfCWriteDeclCName(program, &builder, decl);
	if (status == Status::Ok && argCount >= 1) {
		status = builder.WriteCString("__");
		if (status == Status::Ok) {
			status = builder.WriteString(std::OwnedStringView(&arg0.key));
		}
	}
	if (status == Status::Ok && argCount >= 2) {
		status = builder.WriteCString("__");
		if (status == Status::Ok) {
			status = builder.WriteString(std::OwnedStringView(&arg1.key));
		}
	}
	if (status == Status::Ok && argCount >= 3) {
		status = builder.WriteCString("__");
		if (status == Status::Ok) {
			status = builder.WriteString(std::OwnedStringView(&arg2.key));
		}
	}
	if (status == Status::Ok) {
		status = SelfCDetachBuilder(&builder, out);
	}
	builder.Destroy();
	return(status);
}

Status:SelfCAddFuncUse(ptr<SelfCProgram>:program, ptr<SelfCDecl>:decl, ptr<SelfCTypeInfo>:arg0, ptr<SelfCTypeInfo>:arg1, ptr<SelfCTypeInfo>:arg2, usize:argCount) {
	if (argCount == 0) {
		return(Status::Ok);
	}
	if (argCount >= 1 && !SelfCTypeInfoConcrete(program, arg0)) {
		return(Status::Ok);
	}
	if (argCount >= 2 && !SelfCTypeInfoConcrete(program, arg1)) {
		return(Status::Ok);
	}
	if (argCount >= 3 && !SelfCTypeInfoConcrete(program, arg2)) {
		return(Status::Ok);
	}
	OwnedString:cName;
	Status:status = SelfCBuildGenericFuncCName(program, decl, arg0, arg1, arg2, argCount, &cName);
	if (status != Status::Ok) {
		return(status);
	}
	usize:declIndex = SelfCDeclIndex(program, decl);
	String:key = std::OwnedStringView(&cName);
	if (SelfCFuncUseExists(program, declIndex, key)) {
		std::DestroyOwnedString(&cName);
		return(Status::Ok);
	}
	if (program.funcUseCount >= len(program.funcUses)) {
		std::DestroyOwnedString(&cName);
		return(SelfCAddDiagnostic(program, "too many generic function uses"));
	}
	ptr<SelfCFuncUse>:use = &program.funcUses[program.funcUseCount];
	use.declIndex = declIndex;
	status = SelfCCloneString(program, key, &use.key);
	if (status == Status::Ok) {
		use.cName = cName;
	} else {
		std::DestroyOwnedString(&cName);
	}
	if (status == Status::Ok && argCount >= 1) {
		status = SelfCCloneString(program, std::OwnedStringView(&arg0.key), &use.arg0);
	} else {
		if (status == Status::Ok) {
			status = SelfCMakeOwnedEmpty(program, &use.arg0);
		}
	}
	if (status == Status::Ok && argCount >= 2) {
		status = SelfCCloneString(program, std::OwnedStringView(&arg1.key), &use.arg1);
	} else {
		if (status == Status::Ok) {
			status = SelfCMakeOwnedEmpty(program, &use.arg1);
		}
	}
	if (status == Status::Ok && argCount >= 3) {
		status = SelfCCloneString(program, std::OwnedStringView(&arg2.key), &use.arg2);
	} else {
		if (status == Status::Ok) {
			status = SelfCMakeOwnedEmpty(program, &use.arg2);
		}
	}
	use.argCount = argCount;
	use.emitted = false;
	if (status == Status::Ok) {
		program.funcUseCount += 1;
	}
	return(status);
}

Status:SelfCCollectGenericFunctionUsesInRange(ptr<SelfCProgram>:program, usize:fileIndex, usize:start, usize:end) {
	usize:i = start;
	while (i < end) {
		if (i + 2 < end && SelfCIsOperator(program, fileIndex, i + 1, OperatorKind::Less)) {
			usize:genericEnd = SelfCFindMatching(program, fileIndex, i + 1);
			if (genericEnd + 1 < end && SelfCIsPunctuation(program, fileIndex, genericEnd + 1, PunctuationKind::LeftParen)) {
				String:name = SelfCTokenText(program, fileIndex, i);
				String:packageName = std::StringFromCString("");
				if (i >= 2 && SelfCIsOperator(program, fileIndex, i - 1, OperatorKind::Scope)) {
					packageName = SelfCTokenText(program, fileIndex, i - 2);
				}
				ptr<SelfCDecl>:decl = SelfCFindFunctionDeclByName(program, name, packageName);
				if (decl != 0 && decl.isGeneric) {
					SelfCTypeInfo:arg0;
					SelfCTypeInfo:arg1;
					SelfCTypeInfo:arg2;
					SelfCTypeInfoInitEmpty(program, &arg0);
					SelfCTypeInfoInitEmpty(program, &arg1);
					SelfCTypeInfoInitEmpty(program, &arg2);
					usize:argCount = 0;
					usize:argStart = i + 2;
					Status:status = Status::Ok;
					while (argStart < genericEnd) {
						usize:argEnd = SelfCFindTokenAtDepthZero(program, fileIndex, argStart, genericEnd, PunctuationKind::Comma);
						if (argCount == 0) {
							status = SelfCRenderTypeInfo(program, fileIndex, argStart, argEnd, &arg0);
						} else {
							if (argCount == 1) {
								status = SelfCRenderTypeInfo(program, fileIndex, argStart, argEnd, &arg1);
							} else {
								if (argCount == 2) {
									status = SelfCRenderTypeInfo(program, fileIndex, argStart, argEnd, &arg2);
								}
							}
						}
						argCount += 1;
						if (status != Status::Ok || argEnd >= genericEnd) {
							break;
						}
						argStart = argEnd + 1;
					}
					if (status == Status::Ok) {
						status = SelfCAddFuncUse(program, decl, &arg0, &arg1, &arg2, argCount);
					}
					SelfCTypeInfoDestroy(&arg0);
					SelfCTypeInfoDestroy(&arg1);
					SelfCTypeInfoDestroy(&arg2);
					if (status != Status::Ok) {
						return(status);
					}
				}
				i = genericEnd + 1;
				continue;
			}
		}
		i += 1;
	}
	return(Status::Ok);
}

ptr<SelfCDecl>:SelfCFindGenericMethodDecl(ptr<SelfCProgram>:program, String:receiverBase, str:methodName) {
	for (usize:i = 0; i < program.declCount; i++) {
		ptr<SelfCDecl>:decl = &program.decls[i];
		if (decl.kind != SelfCDeclKind::Function || !decl.hasReceiver || !decl.isGeneric || decl.isOperator) {
			continue;
		}
		String:base = SelfCTokenText(program, decl.fileIndex, decl.receiverStart);
		if (!base.Equals(receiverBase)) {
			continue;
		}
		String:name = SelfCTokenText(program, decl.fileIndex, decl.nameIndex);
		if (name.EqualsCString(methodName)) {
			return(decl);
		}
	}
	return(0);
}

Status:SelfCAddGenericMethodUseByName(ptr<SelfCProgram>:program, ptr<SelfCTypeUse>:typeUse, str:methodName) {
	String:baseName = std::OwnedStringView(&typeUse.baseName);
	ptr<SelfCDecl>:decl = SelfCFindGenericMethodDecl(program, baseName, methodName);
	if (decl == 0) {
		return(Status::Ok);
	}
	SelfCTypeInfo:arg0;
	SelfCTypeInfo:arg1;
	SelfCTypeInfo:arg2;
	bool:arg0Ready = false;
	bool:arg1Ready = false;
	bool:arg2Ready = false;
	Status:status = SelfCTypeInfoInitEmpty(program, &arg1);
	if (status == Status::Ok) {
		arg1Ready = true;
	}
	if (status == Status::Ok) {
		status = SelfCTypeInfoInitEmpty(program, &arg2);
	}
	if (status == Status::Ok) {
		arg2Ready = true;
	}
	if (status == Status::Ok) {
		status = SelfCTypeInfoFromKey(program, std::OwnedStringView(&typeUse.arg0), &arg0);
	}
	if (status == Status::Ok) {
		arg0Ready = true;
	}
	if (status == Status::Ok) {
		status = SelfCAddFuncUse(program, decl, &arg0, &arg1, &arg2, 1);
	}
	if (arg0Ready) {
		SelfCTypeInfoDestroy(&arg0);
	}
	if (arg1Ready) {
		SelfCTypeInfoDestroy(&arg1);
	}
	if (arg2Ready) {
		SelfCTypeInfoDestroy(&arg2);
	}
	return(status);
}

Status:SelfCCollectGenericCollectionMethods(ptr<SelfCProgram>:program) {
	usize:typeUseLimit = program.typeUseCount;
	for (usize:i = 0; i < typeUseLimit; i++) {
		ptr<SelfCTypeUse>:use = &program.typeUses[i];
		String:base = std::OwnedStringView(&use.baseName);
		if (use.argCount < 1) {
			continue;
		}
		Status:status = Status::Ok;
		if (base.EqualsCString("Array")) {
			status = SelfCAddTypeUseFromBaseArg(program, "Result", std::OwnedStringView(&use.arg0));
			if (status == Status::Ok) { status = SelfCAddTypeUseFromBaseArg(program, "Slice", std::OwnedStringView(&use.arg0)); }
			if (status == Status::Ok) { status = SelfCAddTypeUseFromBaseArg(program, "Span", std::OwnedStringView(&use.arg0)); }
			if (status == Status::Ok) { status = SelfCAddGenericMethodUseByName(program, use, "Destroy"); }
			if (status == Status::Ok) { status = SelfCAddGenericMethodUseByName(program, use, "Clear"); }
			if (status == Status::Ok) { status = SelfCAddGenericMethodUseByName(program, use, "Reserve"); }
			if (status == Status::Ok) { status = SelfCAddGenericMethodUseByName(program, use, "AppendSlice"); }
			if (status == Status::Ok) { status = SelfCAddGenericMethodUseByName(program, use, "Push"); }
			if (status == Status::Ok) { status = SelfCAddGenericMethodUseByName(program, use, "PushZeroed"); }
			if (status == Status::Ok) { status = SelfCAddGenericMethodUseByName(program, use, "Pop"); }
			if (status == Status::Ok) { status = SelfCAddGenericMethodUseByName(program, use, "Get"); }
			if (status == Status::Ok) { status = SelfCAddGenericMethodUseByName(program, use, "Set"); }
			if (status == Status::Ok) { status = SelfCAddGenericMethodUseByName(program, use, "GetPtr"); }
			if (status == Status::Ok) { status = SelfCAddGenericMethodUseByName(program, use, "LastPtr"); }
			if (status == Status::Ok) { status = SelfCAddGenericMethodUseByName(program, use, "Span"); }
			if (status == Status::Ok) { status = SelfCAddGenericMethodUseByName(program, use, "Slice"); }
		} else {
			if (base.EqualsCString("LinkedList")) {
				status = SelfCAddTypeUseFromBaseArg(program, "ListNode", std::OwnedStringView(&use.arg0));
				if (status == Status::Ok) { status = SelfCAddTypeUseFromBaseArg(program, "Result", std::OwnedStringView(&use.arg0)); }
				if (status == Status::Ok) { status = SelfCAddGenericMethodUseByName(program, use, "PushBack"); }
				if (status == Status::Ok) { status = SelfCAddGenericMethodUseByName(program, use, "PushFront"); }
				if (status == Status::Ok) { status = SelfCAddGenericMethodUseByName(program, use, "PopBack"); }
				if (status == Status::Ok) { status = SelfCAddGenericMethodUseByName(program, use, "Destroy"); }
				if (status == Status::Ok) { status = SelfCAddGenericMethodUseByName(program, use, "PopFront"); }
			}
		}
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(Status::Ok);
}

Status:SelfCCollectGenericFunctionUses(ptr<SelfCProgram>:program) {
	for (usize:i = 0; i < program.declCount; i++) {
		ptr<SelfCDecl>:decl = &program.decls[i];
		Status:status = SelfCCollectGenericFunctionUsesInRange(program, decl.fileIndex, decl.start, decl.end);
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(SelfCCollectGenericCollectionMethods(program));
}

Status:SelfCCollectTypeUses(ptr<SelfCProgram>:program) {
	for (usize:i = 0; i < program.declCount; i++) {
		ptr<SelfCDecl>:decl = &program.decls[i];
		Status:status = SelfCCollectTypeUsesInRange(program, decl.fileIndex, decl.start, decl.end);
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(Status::Ok);
}

Status:SelfCWritePrelude(ptr<StringBuilder>:out) {
	Status:status = out.WriteCString("#include <assert.h>");
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("#include <stdint.h>"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("#include <stddef.h>"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("#include <stdbool.h>"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef uint8_t u8;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef uint16_t u16;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef uint32_t u32;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef uint64_t u64;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef int8_t i8;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef int16_t i16;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef int32_t i32;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef int64_t i64;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef float f32;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef double f64;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef void* ptr;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteCString("typedef const char* str;"); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	if (status == Status::Ok) { status = out.WriteByte(10); }
	return(status);
}

Status:SelfCWriteDeclarator(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, usize:fileIndex, usize:typeStart, usize:typeEnd, usize:nameIndex, bool:isArray, usize:arrayStart, usize:arrayEnd) {
	SelfCTypeInfo:info;
	Status:status = SelfCRenderTypeInfo(program, fileIndex, typeStart, typeEnd, &info);
	if (status != Status::Ok) {
		return(status);
	}
	status = out.WriteString(std::OwnedStringView(&info.cType));
	if (status == Status::Ok) {
		status = out.WriteByte(' ');
	}
	if (status == Status::Ok) {
		status = SelfCWriteToken(program, out, fileIndex, nameIndex);
	}
	if (status == Status::Ok && isArray) {
		status = out.WriteByte('[');
		if (status == Status::Ok) {
			status = SelfCWriteTokenRangeRaw(program, out, fileIndex, arrayStart, arrayEnd);
		}
		if (status == Status::Ok) {
			status = out.WriteByte(']');
		}
	}
	SelfCTypeInfoDestroy(&info);
	return(status);
}

Status:SelfCWriteFields(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCDecl>:decl) {
	for (usize:i = 0; i < decl.fieldCount; i++) {
		ptr<SelfCField>:field = &program.fields[decl.firstField + i];
		Status:status = out.WriteCString("    ");
		if (status != Status::Ok) {
			return(status);
		}
		if (field.isNestedStruct) {
			status = out.WriteCString("struct {\n");
			if (status != Status::Ok) {
				return(status);
			}
			SelfCDecl:nested;
			nested.kind = SelfCDeclKind::Struct;
			nested.fileIndex = field.fileIndex;
			nested.bodyStart = field.nestedBodyStart;
			nested.bodyEnd = field.nestedBodyEnd;
			nested.firstField = program.fieldCount;
			nested.fieldCount = 0;
			nested.nameIndex = field.nameIndex;
			nested.isGeneric = false;
			Status:parseNested = SelfCParseFields(program, &nested, field.fileIndex, field.nestedBodyStart, field.nestedBodyEnd);
			if (parseNested != Status::Ok) {
				return(parseNested);
			}
			status = SelfCWriteFields(program, out, &nested);
			if (status != Status::Ok) {
				return(status);
			}
			status = out.WriteCString("    } ");
			if (status == Status::Ok) {
				status = SelfCWriteToken(program, out, field.fileIndex, field.nameIndex);
			}
			if (status == Status::Ok) {
				status = out.WriteCString(";\n");
			}
			return(status);
		}
		status = SelfCWriteDeclarator(program, out, field.fileIndex, field.typeStart, field.typeEnd, field.nameIndex, field.isArray, field.arrayStart, field.arrayEnd);
		if (status == Status::Ok) {
			status = out.WriteCString(";\n");
		}
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(Status::Ok);
}

bool:SelfCGenericParamEquals(ptr<SelfCProgram>:program, ptr<SelfCDecl>:decl, usize:paramIndex, String:name) {
	if (!decl.isGeneric) {
		return(false);
	}
	if (decl.genericStart < SelfCFileTokenCount(program, decl.fileIndex)) {
		usize:index = decl.genericStart + 1;
		usize:current = 0;
		while (index < decl.genericEnd) {
			if (SelfCIsPunctuation(program, decl.fileIndex, index, PunctuationKind::Comma)) {
				index += 1;
				continue;
			}
			if (current == paramIndex) {
				String:paramName = SelfCTokenText(program, decl.fileIndex, index);
				return(paramName.Equals(name));
			}
			current += 1;
			while (index < decl.genericEnd && !SelfCIsPunctuation(program, decl.fileIndex, index, PunctuationKind::Comma)) {
				index += 1;
			}
		}
	}
	if (decl.hasReceiver && decl.receiverStart + 1 < decl.receiverEnd
		&& SelfCIsOperator(program, decl.fileIndex, decl.receiverStart + 1, OperatorKind::Less)) {
		usize:genericEnd = SelfCFindMatching(program, decl.fileIndex, decl.receiverStart + 1);
		usize:index = decl.receiverStart + 2;
		usize:current = 0;
		while (index < genericEnd) {
			if (SelfCIsPunctuation(program, decl.fileIndex, index, PunctuationKind::Comma)) {
				index += 1;
				continue;
			}
			if (current == paramIndex) {
				String:paramName = SelfCTokenText(program, decl.fileIndex, index);
				return(paramName.Equals(name));
			}
			current += 1;
			while (index < genericEnd && !SelfCIsPunctuation(program, decl.fileIndex, index, PunctuationKind::Comma)) {
				index += 1;
			}
		}
	}
	return(false);
}

Status:SelfCWriteTypeSuffixSubst(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCDecl>:decl, ptr<SelfCTypeUse>:use, usize:fileIndex, usize:start, usize:end) {
	if (start >= end) {
		return(Status::Ok);
	}
	String:first = SelfCTokenText(program, fileIndex, start);
	if (end == start + 1) {
		if (SelfCGenericParamEquals(program, decl, 0, first)) {
			return(out.WriteString(std::OwnedStringView(&use.arg0)));
		}
		if (SelfCGenericParamEquals(program, decl, 1, first)) {
			return(out.WriteString(std::OwnedStringView(&use.arg1)));
		}
		if (SelfCGenericParamEquals(program, decl, 2, first)) {
			return(out.WriteString(std::OwnedStringView(&use.arg2)));
		}
		return(SelfCWriteSanitized(out, first));
	}
	if (start + 1 < end && SelfCIsOperator(program, fileIndex, start + 1, OperatorKind::Less)) {
		Status:status = SelfCWriteSanitized(out, first);
		usize:genericEnd = SelfCFindMatching(program, fileIndex, start + 1);
		usize:argStart = start + 2;
		while (argStart < genericEnd) {
			usize:argEnd = SelfCFindTokenAtDepthZero(program, fileIndex, argStart, genericEnd, PunctuationKind::Comma);
			if (status == Status::Ok) {
				status = out.WriteCString("__");
			}
			if (status == Status::Ok) {
				status = SelfCWriteTypeSuffixSubst(program, out, decl, use, fileIndex, argStart, argEnd);
			}
			if (status != Status::Ok || argEnd >= genericEnd) {
				break;
			}
			argStart = argEnd + 1;
		}
		return(status);
	}
	return(SelfCWriteTypeSuffixFromRange(program, out, fileIndex, start, end));
}

Status:SelfCMakeSubstTypeKey(ptr<SelfCProgram>:program, ptr<SelfCDecl>:decl, ptr<SelfCTypeUse>:use, usize:fileIndex, usize:start, usize:end, ptr<OwnedString>:out) {
	StringBuilder:builder = std::StringBuilderNew(program.allocator);
	Status:status = SelfCWriteTypeSuffixSubst(program, &builder, decl, use, fileIndex, start, end);
	if (status == Status::Ok) {
		status = SelfCDetachBuilder(&builder, out);
	}
	builder.Destroy();
	return(status);
}

Status:SelfCWriteDeclaratorSubst(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCDecl>:decl, ptr<SelfCTypeUse>:use, usize:fileIndex, usize:typeStart, usize:typeEnd, usize:nameIndex, bool:isArray, usize:arrayStart, usize:arrayEnd) {
	String:first = SelfCTokenText(program, fileIndex, typeStart);
	OwnedString:key;
	Status:status = Status::Ok;
	if (first.EqualsCString("ptr") && typeStart + 1 < typeEnd && SelfCIsOperator(program, fileIndex, typeStart + 1, OperatorKind::Less)) {
		usize:genericEnd = SelfCFindMatching(program, fileIndex, typeStart + 1);
		OwnedString:innerKey;
		status = SelfCMakeSubstTypeKey(program, decl, use, fileIndex, typeStart + 2, genericEnd, &innerKey);
		StringBuilder:ct = std::StringBuilderNew(program.allocator);
		if (status == Status::Ok) {
			status = SelfCWriteCTypeFromKey(program, &ct, std::OwnedStringView(&innerKey));
		}
		if (status == Status::Ok) {
			status = ct.WriteByte('*');
		}
		if (status == Status::Ok) {
			status = out.WriteString(ct.View());
		}
		ct.Destroy();
		std::DestroyOwnedString(&innerKey);
	} else {
		status = SelfCMakeSubstTypeKey(program, decl, use, fileIndex, typeStart, typeEnd, &key);
		if (status == Status::Ok) {
			status = SelfCWriteCTypeFromKey(program, out, std::OwnedStringView(&key));
		}
		if (status == Status::Ok) {
			std::DestroyOwnedString(&key);
		}
	}
	if (status == Status::Ok) {
		status = out.WriteByte(' ');
	}
	if (status == Status::Ok) {
		status = SelfCWriteToken(program, out, fileIndex, nameIndex);
	}
	if (status == Status::Ok && isArray) {
		status = out.WriteByte('[');
		if (status == Status::Ok) {
			status = SelfCWriteTokenRangeRaw(program, out, fileIndex, arrayStart, arrayEnd);
		}
		if (status == Status::Ok) {
			status = out.WriteByte(']');
		}
	}
	return(status);
}

Status:SelfCWriteFieldsSubst(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCDecl>:decl, ptr<SelfCTypeUse>:use) {
	for (usize:i = 0; i < decl.fieldCount; i++) {
		ptr<SelfCField>:field = &program.fields[decl.firstField + i];
		Status:status = out.WriteCString("    ");
		if (status == Status::Ok) {
			status = SelfCWriteDeclaratorSubst(program, out, decl, use, field.fileIndex, field.typeStart, field.typeEnd, field.nameIndex, field.isArray, field.arrayStart, field.arrayEnd);
		}
		if (status == Status::Ok) {
			status = out.WriteCString(";\n");
		}
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(Status::Ok);
}

Status:SelfCWriteStructDecl(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCDecl>:decl, String:specializedName) {
	Status:status = out.WriteCString("struct ");
	bool:hasPacked = false;
	bool:hasAligned = false;
	usize:alignedValue = 0;
	if (decl.start > 0) {
		usize:scan = decl.start;
		while (scan > 0) {
			scan -= 1;
			if (SelfCIsPunctuation(program, decl.fileIndex, scan, PunctuationKind::LeftBracket)) {
				for (usize:i = scan; i < decl.start; i++) {
					if (SelfCIsIdentifierText(program, decl.fileIndex, i, "packed")) {
						hasPacked = true;
					}
					if (SelfCIsIdentifierText(program, decl.fileIndex, i, "aligned")) {
						hasAligned = true;
						if (i + 2 < decl.start && SelfCIsPunctuation(program, decl.fileIndex, i + 1, PunctuationKind::LeftParen)) {
							alignedValue = i + 2;
						}
					}
				}
				break;
			}
			if (SelfCIsPunctuation(program, decl.fileIndex, scan, PunctuationKind::Semicolon)
				|| SelfCIsPunctuation(program, decl.fileIndex, scan, PunctuationKind::RightBrace)) {
				break;
			}
		}
	}
	if (status == Status::Ok && (hasPacked || hasAligned)) {
		status = out.WriteCString("__attribute__((");
		if (status == Status::Ok && hasPacked) {
			status = out.WriteCString("packed");
		}
		if (status == Status::Ok && hasAligned) {
			if (hasPacked) {
				status = out.WriteByte(',');
			}
			if (status == Status::Ok) {
				status = out.WriteCString("aligned(");
			}
			if (status == Status::Ok && alignedValue != 0) {
				status = SelfCWriteToken(program, out, decl.fileIndex, alignedValue);
			}
			if (status == Status::Ok) {
				status = out.WriteByte(')');
			}
		}
		if (status == Status::Ok) {
			status = out.WriteCString(")) ");
		}
	}
	if (status != Status::Ok) {
		return(status);
	}
	if (specializedName.len > 0) {
		status = out.WriteString(specializedName);
	} else {
		status = SelfCWriteToken(program, out, decl.fileIndex, decl.nameIndex);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(" {\n");
	}
	if (status == Status::Ok) {
		status = SelfCWriteFields(program, out, decl);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("};\n");
	}
	return(status);
}

Status:SelfCWriteUnionDecl(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCDecl>:decl) {
	Status:status = out.WriteCString("typedef union ");
	if (status == Status::Ok) {
		status = SelfCWriteToken(program, out, decl.fileIndex, decl.nameIndex);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(" {\n");
	}
	if (status == Status::Ok) {
		status = SelfCWriteFields(program, out, decl);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("} ");
	}
	if (status == Status::Ok) {
		status = SelfCWriteToken(program, out, decl.fileIndex, decl.nameIndex);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(";\n");
	}
	return(status);
}

Status:SelfCWriteEnumDecl(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCDecl>:decl) {
	Status:status = out.WriteCString("typedef enum ");
	if (status == Status::Ok) {
		status = SelfCWriteToken(program, out, decl.fileIndex, decl.nameIndex);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(" {\n");
	}
	usize:i = decl.bodyStart;
	while (i < decl.bodyEnd) {
		if (SelfCIsPunctuation(program, decl.fileIndex, i, PunctuationKind::Comma)) {
			i += 1;
			continue;
		}
		if (!SelfCIsTokenKind(program, decl.fileIndex, i, TokenKind::Identifier)) {
			i += 1;
			continue;
		}
		status = out.WriteCString("    ");
		if (status == Status::Ok) {
			status = SelfCWriteToken(program, out, decl.fileIndex, decl.nameIndex);
		}
		if (status == Status::Ok) {
			status = out.WriteByte('_');
		}
		if (status == Status::Ok) {
			status = SelfCWriteToken(program, out, decl.fileIndex, i);
		}
		i += 1;
		if (i < decl.bodyEnd && SelfCIsOperator(program, decl.fileIndex, i, OperatorKind::Assign)) {
			status = out.WriteByte('=');
			i += 1;
			while (i < decl.bodyEnd && !SelfCIsPunctuation(program, decl.fileIndex, i, PunctuationKind::Comma)) {
				if (status == Status::Ok) {
					status = SelfCWriteToken(program, out, decl.fileIndex, i);
				}
				i += 1;
			}
		}
		if (status == Status::Ok) {
			status = out.WriteCString(",\n");
		}
		if (status != Status::Ok) {
			return(status);
		}
	}
	status = out.WriteCString("} ");
	if (status == Status::Ok) {
		status = SelfCWriteToken(program, out, decl.fileIndex, decl.nameIndex);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(";\n");
	}
	return(status);
}

Status:SelfCWriteAliasDecl(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCDecl>:decl) {
	SelfCTypeInfo:info;
	Status:status = SelfCRenderTypeInfo(program, decl.fileIndex, decl.returnStart, decl.returnEnd, &info);
	if (status == Status::Ok) {
		status = out.WriteCString("typedef ");
	}
	if (status == Status::Ok) {
		status = out.WriteString(std::OwnedStringView(&info.cType));
	}
	if (status == Status::Ok) {
		status = out.WriteByte(' ');
	}
	if (status == Status::Ok) {
		status = SelfCWriteToken(program, out, decl.fileIndex, decl.nameIndex);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(";\n");
	}
	SelfCTypeInfoDestroy(&info);
	return(status);
}

Status:SelfCWriteExternDecl(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCDecl>:decl) {
	ptr<SelfCTokenFile>:file = &program.tokenFiles[decl.fileIndex];
	Token:open = file.tokens[decl.bodyStart - 1];
	Token:close = file.tokens[decl.bodyEnd];
	usize:start = open.offset + open.length;
	usize:end = close.offset;
	if (end < start) {
		return(Status::Ok);
	}
	String:sourceText = file.sourceText;
	Status:status = out.WriteCString("#if defined(__GNUC__) || defined(__clang__)\n#pragma GCC diagnostic push\n#pragma GCC diagnostic ignored ");
	if (status == Status::Ok) {
		status = out.WriteByte(34);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("-Wunused-function");
	}
	if (status == Status::Ok) {
		status = out.WriteByte(34);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("\n#endif\n");
	}
	if (status == Status::Ok) {
		status = out.WriteString(sourceText.Slice(start, end - start));
	}
	if (status == Status::Ok) {
		status = out.WriteCString("\n#if defined(__GNUC__) || defined(__clang__)\n#pragma GCC diagnostic pop\n#endif");
	}
	if (status == Status::Ok) {
		status = out.WriteByte('\n');
	}
	return(status);
}

Status:SelfCWriteTypeDeclarations(ptr<SelfCProgram>:program, ptr<StringBuilder>:out) {
	for (usize:i = 0; i < program.declCount; i++) {
		ptr<SelfCDecl>:decl = &program.decls[i];
		Status:status = Status::Ok;
		if (decl.kind == SelfCDeclKind::ExternC) {
			status = SelfCWriteExternDecl(program, out, decl);
		} else {
			if (decl.kind == SelfCDeclKind::Alias) {
				status = SelfCWriteAliasDecl(program, out, decl);
			} else {
				if (decl.kind == SelfCDeclKind::Struct && !decl.isGeneric) {
					status = SelfCWriteStructDecl(program, out, decl, std::StringFromCString(""));
				} else {
					if (decl.kind == SelfCDeclKind::Union) {
						status = SelfCWriteUnionDecl(program, out, decl);
					} else {
						if (decl.kind == SelfCDeclKind::Enum) {
							status = SelfCWriteEnumDecl(program, out, decl);
						}
					}
				}
			}
		}
		if (status != Status::Ok) {
			return(status);
		}
	}
	for (usize:i = 0; i < program.typeUseCount; i++) {
		ptr<SelfCTypeUse>:use = &program.typeUses[i];
		ptr<SelfCDecl>:decl = SelfCFindTypeDecl(program, std::OwnedStringView(&use.baseName));
		if (decl != 0 && decl.kind == SelfCDeclKind::Struct) {
			Status:status = out.WriteCString("struct ");
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&use.key));
			}
			if (status == Status::Ok) {
				status = out.WriteCString(" {\n");
			}
			if (status == Status::Ok) {
				status = SelfCWriteFieldsSubst(program, out, decl, use);
			}
			if (status == Status::Ok) {
				status = out.WriteCString("};\n");
			}
			if (status != Status::Ok) {
				return(status);
			}
		}
	}
	return(Status::Ok);
}

Status:SelfCEnvInit(ptr<SelfCProgram>:program, ptr<SelfCEnv>:env) {
	env.localCount = 0;
	env.hasThis = false;
	env.deferCounter = 0;
	env.eachCounter = 0;
	Status:status = SelfCMakeOwnedEmpty(program, &env.returnTypeKey);
	if (status == Status::Ok) {
		status = SelfCMakeOwnedEmpty(program, &env.returnCType);
	}
	if (status == Status::Ok) {
		status = SelfCMakeOwnedEmpty(program, &env.thisTypeKey);
	}
	if (status == Status::Ok) {
		status = SelfCMakeOwnedEmpty(program, &env.thisCType);
	}
	return(status);
}

Status:SelfCEnvDestroy(ptr<SelfCEnv>:env) {
	for (usize:i = 0; i < env.localCount; i++) {
		std::DestroyOwnedString(&env.locals[i].name);
		std::DestroyOwnedString(&env.locals[i].typeKey);
		std::DestroyOwnedString(&env.locals[i].cType);
		std::DestroyOwnedString(&env.locals[i].arrayLen);
	}
	std::DestroyOwnedString(&env.returnTypeKey);
	std::DestroyOwnedString(&env.returnCType);
	std::DestroyOwnedString(&env.thisTypeKey);
	std::DestroyOwnedString(&env.thisCType);
	return(Status::Ok);
}

ptr<SelfCLocal>:SelfCEnvFind(ptr<SelfCEnv>:env, String:name) {
	for (usize:i = env.localCount; i > 0; i--) {
		ptr<SelfCLocal>:local = &env.locals[i - 1];
		String:localName = std::OwnedStringView(&local.name);
		if (localName.Equals(name)) {
			return(local);
		}
	}
	return(0);
}

Status:SelfCEnvAdd(ptr<SelfCProgram>:program, ptr<SelfCEnv>:env, String:name, String:typeKey, String:cType, bool:isArray, String:arrayLen, bool:isPointer) {
	if (env.localCount >= len(env.locals)) {
		return(SelfCAddDiagnostic(program, "too many locals"));
	}
	ptr<SelfCLocal>:local = &env.locals[env.localCount];
	Status:status = SelfCCloneString(program, name, &local.name);
	if (status == Status::Ok) {
		status = SelfCCloneString(program, typeKey, &local.typeKey);
	}
	if (status == Status::Ok) {
		status = SelfCCloneString(program, cType, &local.cType);
	}
	if (status == Status::Ok) {
		status = SelfCCloneString(program, arrayLen, &local.arrayLen);
	}
	local.isArray = isArray;
	local.isPointer = isPointer;
	if (status == Status::Ok) {
		env.localCount += 1;
	}
	return(status);
}

Status:SelfCExprInitEmpty(ptr<SelfCProgram>:program, ptr<SelfCExpr>:expr) {
	Status:status = SelfCMakeOwnedEmpty(program, &expr.text);
	if (status == Status::Ok) {
		status = SelfCMakeOwnedEmpty(program, &expr.typeKey);
	}
	if (status == Status::Ok) {
		status = SelfCMakeOwnedEmpty(program, &expr.cType);
	}
	if (status == Status::Ok) {
		status = SelfCMakeOwnedEmpty(program, &expr.arrayLen);
	}
	expr.isArray = false;
	expr.isLvalue = false;
	expr.isPointer = false;
	return(status);
}

Status:SelfCExprDestroy(ptr<SelfCExpr>:expr) {
	std::DestroyOwnedString(&expr.text);
	std::DestroyOwnedString(&expr.typeKey);
	std::DestroyOwnedString(&expr.cType);
	std::DestroyOwnedString(&expr.arrayLen);
	return(Status::Ok);
}

Status:SelfCExprSetText(ptr<SelfCProgram>:program, ptr<SelfCExpr>:expr, String:text) {
	OwnedString:owned;
	Status:status = SelfCCloneString(program, text, &owned);
	if (status != Status::Ok) {
		return(status);
	}
	return(SelfCReplaceOwned(&expr.text, owned));
}

Status:SelfCExprSetCString(ptr<SelfCProgram>:program, ptr<SelfCExpr>:expr, str:text) {
	OwnedString:owned;
	Status:status = SelfCCloneCString(program, text, &owned);
	if (status != Status::Ok) {
		return(status);
	}
	return(SelfCReplaceOwned(&expr.text, owned));
}

Status:SelfCExprSetType(ptr<SelfCProgram>:program, ptr<SelfCExpr>:expr, String:key, String:cType, bool:isPointer) {
	OwnedString:keyOwned;
	Status:status = SelfCCloneString(program, key, &keyOwned);
	if (status == Status::Ok) {
		status = SelfCReplaceOwned(&expr.typeKey, keyOwned);
	}
	OwnedString:cOwned;
	if (status == Status::Ok) {
		status = SelfCCloneString(program, cType, &cOwned);
	}
	if (status == Status::Ok) {
		status = SelfCReplaceOwned(&expr.cType, cOwned);
	}
	expr.isPointer = isPointer;
	return(status);
}

Status:SelfCExprFromBuilder(ptr<SelfCExpr>:expr, ptr<StringBuilder>:builder) {
	OwnedString:owned;
	Status:status = SelfCDetachBuilder(builder, &owned);
	if (status != Status::Ok) {
		return(status);
	}
	return(SelfCReplaceOwned(&expr.text, owned));
}

u8:SelfCOperatorPrecedence(ptr<SelfCProgram>:program, usize:fileIndex, usize:index) {
	if (SelfCIsOperator(program, fileIndex, index, OperatorKind::Assign)
		|| SelfCIsOperator(program, fileIndex, index, OperatorKind::PlusAssign)
		|| SelfCIsOperator(program, fileIndex, index, OperatorKind::MinusAssign)) {
		return(1);
	}
	if (SelfCIsOperator(program, fileIndex, index, OperatorKind::LogicalOr)) {
		return(2);
	}
	if (SelfCIsOperator(program, fileIndex, index, OperatorKind::LogicalAnd)) {
		return(3);
	}
	if (SelfCIsOperator(program, fileIndex, index, OperatorKind::Equal)
		|| SelfCIsOperator(program, fileIndex, index, OperatorKind::NotEqual)
		|| SelfCIsOperator(program, fileIndex, index, OperatorKind::Less)
		|| SelfCIsOperator(program, fileIndex, index, OperatorKind::LessEqual)
		|| SelfCIsOperator(program, fileIndex, index, OperatorKind::Greater)
		|| SelfCIsOperator(program, fileIndex, index, OperatorKind::GreaterEqual)) {
		return(4);
	}
	if (SelfCIsOperator(program, fileIndex, index, OperatorKind::Plus)
		|| SelfCIsOperator(program, fileIndex, index, OperatorKind::Minus)) {
		return(5);
	}
	if (SelfCIsOperator(program, fileIndex, index, OperatorKind::Multiply)
		|| SelfCIsOperator(program, fileIndex, index, OperatorKind::Divide)
		|| SelfCIsOperator(program, fileIndex, index, OperatorKind::Modulo)) {
		return(6);
	}
	return(0);
}

bool:SelfCOperatorRightAssociative(ptr<SelfCProgram>:program, usize:fileIndex, usize:index) {
	return(SelfCIsOperator(program, fileIndex, index, OperatorKind::Assign)
		|| SelfCIsOperator(program, fileIndex, index, OperatorKind::PlusAssign)
		|| SelfCIsOperator(program, fileIndex, index, OperatorKind::MinusAssign));
}

Status:SelfCWriteNumberToken(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, usize:fileIndex, usize:index) {
	String:text = SelfCTokenText(program, fileIndex, index);
	if (text.len > 2 && text.data[0] == '0' && (text.data[1] == 'b' || text.data[1] == 'B')) {
		u64:value = 0;
		for (usize:i = 2; i < text.len; i++) {
			if (text.data[i] == '_') {
				continue;
			}
			if (text.data[i] == '0' || text.data[i] == '1') {
				value = value * 2 + cast<u64>(text.data[i] - '0');
			}
		}
		Status:status = out.WriteCString("0x");
		if (status == Status::Ok) {
			status = std::FormatU64ToBuilder(out, value, 16);
		}
		return(status);
	}
	for (usize:i = 0; i < text.len; i++) {
		if (text.data[i] != '_') {
			Status:status = out.WriteByte(text.data[i]);
			if (status != Status::Ok) {
				return(status);
			}
		}
	}
	return(Status::Ok);
}

ptr<SelfCDecl>:SelfCFindFieldDecl(ptr<SelfCProgram>:program, String:typeKey) {
	for (usize:i = 0; i < program.declCount; i++) {
		ptr<SelfCDecl>:decl = &program.decls[i];
		if ((decl.kind == SelfCDeclKind::Struct || decl.kind == SelfCDeclKind::Union) && SelfCDeclNameMatches(program, decl, typeKey)) {
			return(decl);
		}
	}
	for (usize:i = 0; i < program.typeUseCount; i++) {
		String:useKey = std::OwnedStringView(&program.typeUses[i].key);
		if (useKey.Equals(typeKey)) {
			return(SelfCFindTypeDecl(program, std::OwnedStringView(&program.typeUses[i].baseName)));
		}
	}
	return(0);
}

Status:SelfCFieldType(ptr<SelfCProgram>:program, String:typeKey, String:fieldName, ptr<SelfCTypeInfo>:outInfo) {
	SelfCTypeInfoInitEmpty(program, outInfo);
	ptr<SelfCDecl>:decl = SelfCFindFieldDecl(program, typeKey);
	if (decl == 0) {
		return(Status::Ok);
	}
	for (usize:i = 0; i < decl.fieldCount; i++) {
		ptr<SelfCField>:field = &program.fields[decl.firstField + i];
		String:fieldToken = SelfCTokenText(program, field.fileIndex, field.nameIndex);
		if (fieldToken.Equals(fieldName)) {
			SelfCTypeInfoDestroy(outInfo);
			return(SelfCRenderTypeInfo(program, field.fileIndex, field.typeStart, field.typeEnd, outInfo));
		}
	}
	return(Status::Ok);
}

ptr<SelfCDecl>:SelfCFindMethod(ptr<SelfCProgram>:program, String:receiverType, String:name, bool:isOperator, u8:operatorCode, usize:argCount) {
	for (usize:i = 0; i < program.declCount; i++) {
		ptr<SelfCDecl>:decl = &program.decls[i];
		if (decl.kind != SelfCDeclKind::Function || !decl.hasReceiver) {
			continue;
		}
		StringBuilder:receiver = std::StringBuilderNew(program.allocator);
		Status:status = SelfCWriteTypeSuffixFromRange(program, &receiver, decl.fileIndex, decl.receiverStart, decl.receiverEnd);
		if (status != Status::Ok) {
			receiver.Destroy();
			continue;
		}
		String:receiverView = receiver.View();
		bool:receiverMatches = receiverView.Equals(receiverType);
		receiver.Destroy();
		if (!receiverMatches) {
			continue;
		}
		if (isOperator) {
			if (decl.isOperator && decl.operatorCode == operatorCode && decl.paramCount == argCount) {
				return(decl);
			}
		} else {
			String:methodName = SelfCTokenText(program, decl.fileIndex, decl.nameIndex);
			if (!decl.isOperator && methodName.Equals(name)) {
				return(decl);
			}
		}
	}
	return(0);
}

Status:SelfCParserInit(ptr<SelfCProgram>:program, ptr<SelfCEnv>:env, usize:fileIndex, usize:start, usize:end, String:expectedKey, String:expectedCType, bool:expectedIsArray, ptr<SelfCExprParser>:parser) {
	parser.program = program;
	parser.env = env;
	parser.fileIndex = fileIndex;
	parser.pos = start;
	parser.end = end;
	parser.expectedIsArray = expectedIsArray;
	Status:status = SelfCCloneString(program, expectedKey, &parser.expectedTypeKey);
	if (status == Status::Ok) {
		status = SelfCCloneString(program, expectedCType, &parser.expectedCType);
	}
	return(status);
}

Status:SelfCParserDestroy(ptr<SelfCExprParser>:parser) {
	std::DestroyOwnedString(&parser.expectedTypeKey);
	std::DestroyOwnedString(&parser.expectedCType);
	return(Status::Ok);
}

Status:SelfCCompileExpressionRange(ptr<SelfCProgram>:program, ptr<SelfCEnv>:env, usize:fileIndex, usize:start, usize:end, String:expectedKey, String:expectedCType, bool:expectedIsArray, ptr<SelfCExpr>:out) {
	SelfCExprParser:parser;
	Status:status = SelfCParserInit(program, env, fileIndex, start, end, expectedKey, expectedCType, expectedIsArray, &parser);
	if (status != Status::Ok) {
		return(status);
	}
	status = SelfCCompileExpression(&parser, 1, out);
	SelfCParserDestroy(&parser);
	return(status);
}

Status:SelfCWriteInitializerList(ptr<SelfCExprParser>:parser, usize:start, usize:end, ptr<StringBuilder>:out) {
	Status:status = out.WriteByte('{');
	usize:itemStart = start;
	while (itemStart < end) {
		if (SelfCIsPunctuation(parser.program, parser.fileIndex, itemStart, PunctuationKind::Comma)) {
			itemStart += 1;
			continue;
		}
		usize:itemEnd = SelfCFindTokenAtDepthZero(parser.program, parser.fileIndex, itemStart, end, PunctuationKind::Comma);
		if (itemStart + 1 < itemEnd && SelfCIsOperator(parser.program, parser.fileIndex, itemStart + 1, OperatorKind::Assign) && SelfCIsTokenKind(parser.program, parser.fileIndex, itemStart, TokenKind::Identifier)) {
			if (status == Status::Ok) {
				status = out.WriteByte('.');
			}
			if (status == Status::Ok) {
				status = SelfCWriteToken(parser.program, out, parser.fileIndex, itemStart);
			}
			if (status == Status::Ok) {
				status = out.WriteByte('=');
			}
			SelfCExpr:value;
			if (status == Status::Ok) {
				status = SelfCCompileExpressionRange(parser.program, parser.env, parser.fileIndex, itemStart + 2, itemEnd, std::StringFromCString(""), std::StringFromCString(""), false, &value);
			}
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&value.text));
			}
			if (status == Status::Ok) {
				SelfCExprDestroy(&value);
			}
		} else {
			SelfCExpr:value;
			if (status == Status::Ok) {
				status = SelfCCompileExpressionRange(parser.program, parser.env, parser.fileIndex, itemStart, itemEnd, std::StringFromCString(""), std::StringFromCString(""), false, &value);
			}
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&value.text));
			}
			if (status == Status::Ok) {
				SelfCExprDestroy(&value);
			}
		}
		if (status != Status::Ok) {
			return(status);
		}
		if (itemEnd >= end) {
			break;
		}
		status = out.WriteByte(',');
		itemStart = itemEnd + 1;
	}
	if (status == Status::Ok) {
		status = out.WriteByte('}');
	}
	return(status);
}

Status:SelfCExprFromLiteralBlock(ptr<SelfCExprParser>:parser, usize:blockStart, usize:blockEnd, ptr<SelfCExpr>:out) {
	Status:status = SelfCExprInitEmpty(parser.program, out);
	if (status != Status::Ok) {
		return(status);
	}
	StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
	String:expectedKey = std::OwnedStringView(&parser.expectedTypeKey);
	String:expectedCType = std::OwnedStringView(&parser.expectedCType);
	if (expectedCType.len > 0 && !parser.expectedIsArray) {
		status = builder.WriteByte('(');
		if (status == Status::Ok) {
			status = builder.WriteString(expectedCType);
		}
		if (status == Status::Ok) {
			status = builder.WriteByte(')');
		}
	}
	if (status == Status::Ok) {
		status = SelfCWriteInitializerList(parser, blockStart + 1, blockEnd, &builder);
	}
	if (status == Status::Ok) {
		status = SelfCExprFromBuilder(out, &builder);
	}
	builder.Destroy();
	if (status == Status::Ok && expectedKey.len > 0) {
		status = SelfCExprSetType(parser.program, out, expectedKey, expectedCType, false);
	}
	return(status);
}

Status:SelfCCompilePrimary(ptr<SelfCExprParser>:parser, ptr<SelfCExpr>:out) {
	Status:status = SelfCExprInitEmpty(parser.program, out);
	if (status != Status::Ok) {
		return(status);
	}
	if (parser.pos >= parser.end) {
		return(Status::Ok);
	}
	usize:index = parser.pos;
	Token:token = parser.program[0].tokenFiles[parser.fileIndex].tokens[index];
	if (token.kind == TokenKind::Number) {
		StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
		status = SelfCWriteNumberToken(parser.program, &builder, parser.fileIndex, index);
		if (status == Status::Ok) {
			status = SelfCExprFromBuilder(out, &builder);
		}
		builder.Destroy();
		if (status == Status::Ok) {
			status = SelfCExprSetType(parser.program, out, std::StringFromCString("int"), std::StringFromCString("int"), false);
		}
		parser.pos += 1;
		return(status);
	}
	if (token.kind == TokenKind::String || token.kind == TokenKind::Char) {
		status = SelfCExprSetText(parser.program, out, SelfCTokenText(parser.program, parser.fileIndex, index));
		if (status == Status::Ok) {
			if (token.kind == TokenKind::String) {
				status = SelfCExprSetType(parser.program, out, std::StringFromCString("str"), std::StringFromCString("str"), true);
			} else {
				status = SelfCExprSetType(parser.program, out, std::StringFromCString("int"), std::StringFromCString("int"), false);
			}
		}
		parser.pos += 1;
		return(status);
	}
	if (SelfCIsKeyword(parser.program, parser.fileIndex, index, KeywordKind::True)
		|| SelfCIsKeyword(parser.program, parser.fileIndex, index, KeywordKind::False)) {
		if (SelfCIsKeyword(parser.program, parser.fileIndex, index, KeywordKind::True)) {
			status = SelfCExprSetCString(parser.program, out, "1");
		} else {
			status = SelfCExprSetCString(parser.program, out, "0");
		}
		if (status == Status::Ok) {
			status = SelfCExprSetType(parser.program, out, std::StringFromCString("bool"), std::StringFromCString("bool"), false);
		}
		parser.pos += 1;
		return(status);
	}
	if (SelfCIsPunctuation(parser.program, parser.fileIndex, index, PunctuationKind::LeftParen)) {
		usize:match = SelfCFindMatching(parser.program, parser.fileIndex, index);
		SelfCExpr:inner;
		status = SelfCCompileExpressionRange(parser.program, parser.env, parser.fileIndex, index + 1, match, std::StringFromCString(""), std::StringFromCString(""), false, &inner);
		StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
		if (status == Status::Ok) {
			status = builder.WriteByte('(');
		}
		if (status == Status::Ok) {
			status = builder.WriteString(std::OwnedStringView(&inner.text));
		}
		if (status == Status::Ok) {
			status = builder.WriteByte(')');
		}
		if (status == Status::Ok) {
			status = SelfCExprFromBuilder(out, &builder);
		}
		builder.Destroy();
		if (status == Status::Ok) {
			status = SelfCExprSetType(parser.program, out, std::OwnedStringView(&inner.typeKey), std::OwnedStringView(&inner.cType), inner.isPointer);
			out.isArray = inner.isArray;
			out.isLvalue = inner.isLvalue;
			out.isPointer = inner.isPointer;
		}
		SelfCExprDestroy(&inner);
		parser.pos = match + 1;
		return(status);
	}
	if (SelfCIsPunctuation(parser.program, parser.fileIndex, index, PunctuationKind::LeftBrace)) {
		usize:match = SelfCFindMatching(parser.program, parser.fileIndex, index);
		status = SelfCExprFromLiteralBlock(parser, index, match, out);
		parser.pos = match + 1;
		return(status);
	}
	if (SelfCIsOperator(parser.program, parser.fileIndex, index, OperatorKind::Scope)) {
		if (index + 1 < parser.end) {
			status = SelfCExprSetText(parser.program, out, SelfCTokenText(parser.program, parser.fileIndex, index + 1));
			parser.pos = index + 2;
			return(status);
		}
	}
	if (token.kind == TokenKind::Identifier || token.kind == TokenKind::Keyword) {
		if (index + 2 < parser.end && SelfCIsPunctuation(parser.program, parser.fileIndex, index + 1, PunctuationKind::Colon)
			&& SelfCIsPunctuation(parser.program, parser.fileIndex, index + 2, PunctuationKind::LeftBrace)) {
			usize:blockEnd = SelfCFindMatching(parser.program, parser.fileIndex, index + 2);
			SelfCTypeInfo:typeInfo;
			status = SelfCRenderTypeInfo(parser.program, parser.fileIndex, index, index + 1, &typeInfo);
			StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
			if (status == Status::Ok) {
				status = builder.WriteByte('(');
			}
			if (status == Status::Ok) {
				status = builder.WriteString(std::OwnedStringView(&typeInfo.cType));
			}
			if (status == Status::Ok) {
				status = builder.WriteByte(')');
			}
			if (status == Status::Ok) {
				status = SelfCWriteInitializerList(parser, index + 3, blockEnd, &builder);
			}
			if (status == Status::Ok) {
				status = SelfCExprFromBuilder(out, &builder);
			}
			builder.Destroy();
			if (status == Status::Ok) {
				status = SelfCExprSetType(parser.program, out, std::OwnedStringView(&typeInfo.key), std::OwnedStringView(&typeInfo.cType), typeInfo.isPointer);
			}
			SelfCTypeInfoDestroy(&typeInfo);
			parser.pos = blockEnd + 1;
			return(status);
		}
		if (SelfCIsIdentifierText(parser.program, parser.fileIndex, index, "cast") && index + 1 < parser.end && SelfCIsOperator(parser.program, parser.fileIndex, index + 1, OperatorKind::Less)) {
			usize:genericEnd = SelfCFindMatching(parser.program, parser.fileIndex, index + 1);
			usize:groupStart = genericEnd + 1;
			usize:groupEnd = SelfCFindMatching(parser.program, parser.fileIndex, groupStart);
			SelfCTypeInfo:typeInfo;
			status = SelfCRenderTypeInfo(parser.program, parser.fileIndex, index + 2, genericEnd, &typeInfo);
			SelfCExpr:value;
			if (status == Status::Ok) {
				status = SelfCCompileExpressionRange(parser.program, parser.env, parser.fileIndex, groupStart + 1, groupEnd, std::StringFromCString(""), std::StringFromCString(""), false, &value);
			}
			StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
			if (status == Status::Ok) {
				status = builder.WriteCString("((");
			}
			if (status == Status::Ok) {
				status = builder.WriteString(std::OwnedStringView(&typeInfo.cType));
			}
			if (status == Status::Ok) {
				status = builder.WriteCString(")(");
			}
			if (status == Status::Ok) {
				status = builder.WriteString(std::OwnedStringView(&value.text));
			}
			if (status == Status::Ok) {
				status = builder.WriteCString("))");
			}
			if (status == Status::Ok) {
				status = SelfCExprFromBuilder(out, &builder);
			}
			builder.Destroy();
			if (status == Status::Ok) {
				status = SelfCExprSetType(parser.program, out, std::OwnedStringView(&typeInfo.key), std::OwnedStringView(&typeInfo.cType), typeInfo.isPointer);
			}
			SelfCExprDestroy(&value);
			SelfCTypeInfoDestroy(&typeInfo);
			parser.pos = groupEnd + 1;
			return(status);
		}
		if ((SelfCIsIdentifierText(parser.program, parser.fileIndex, index, "sizeof") || SelfCIsIdentifierText(parser.program, parser.fileIndex, index, "alignof"))
			&& index + 1 < parser.end && SelfCIsPunctuation(parser.program, parser.fileIndex, index + 1, PunctuationKind::LeftParen)) {
			usize:groupEnd = SelfCFindMatching(parser.program, parser.fileIndex, index + 1);
			StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
			bool:isAlign = SelfCIsIdentifierText(parser.program, parser.fileIndex, index, "alignof");
			if (isAlign) {
				status = builder.WriteCString("_Alignof(");
			} else {
				status = builder.WriteCString("sizeof(");
			}
			SelfCTypeInfo:typeInfo;
			if (status == Status::Ok) {
				status = SelfCRenderTypeInfo(parser.program, parser.fileIndex, index + 2, groupEnd, &typeInfo);
			}
			if (status == Status::Ok) {
				status = builder.WriteString(std::OwnedStringView(&typeInfo.cType));
			}
			if (status == Status::Ok) {
				status = builder.WriteByte(')');
			}
			if (status == Status::Ok) {
				status = SelfCExprFromBuilder(out, &builder);
			}
			builder.Destroy();
			SelfCTypeInfoDestroy(&typeInfo);
			if (status == Status::Ok) {
				status = SelfCExprSetType(parser.program, out, std::StringFromCString("usize"), std::StringFromCString("usize"), false);
			}
			parser.pos = groupEnd + 1;
			return(status);
		}
		if (SelfCIsIdentifierText(parser.program, parser.fileIndex, index, "offsetof")
			&& index + 1 < parser.end && SelfCIsPunctuation(parser.program, parser.fileIndex, index + 1, PunctuationKind::LeftParen)) {
			usize:groupEnd = SelfCFindMatching(parser.program, parser.fileIndex, index + 1);
			usize:comma = SelfCFindTokenAtDepthZero(parser.program, parser.fileIndex, index + 2, groupEnd, PunctuationKind::Comma);
			SelfCTypeInfo:typeInfo;
			status = SelfCRenderTypeInfo(parser.program, parser.fileIndex, index + 2, comma, &typeInfo);
			StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
			if (status == Status::Ok) {
				status = builder.WriteCString("offsetof(");
			}
			if (status == Status::Ok) {
				status = builder.WriteString(std::OwnedStringView(&typeInfo.cType));
			}
			if (status == Status::Ok) {
				status = builder.WriteByte(',');
			}
			if (status == Status::Ok) {
				status = SelfCWriteTokenRangeRaw(parser.program, &builder, parser.fileIndex, comma + 1, groupEnd);
			}
			if (status == Status::Ok) {
				status = builder.WriteByte(')');
			}
			if (status == Status::Ok) {
				status = SelfCExprFromBuilder(out, &builder);
			}
			builder.Destroy();
			SelfCTypeInfoDestroy(&typeInfo);
			if (status == Status::Ok) {
				status = SelfCExprSetType(parser.program, out, std::StringFromCString("usize"), std::StringFromCString("usize"), false);
			}
			parser.pos = groupEnd + 1;
			return(status);
		}

		StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
		if (index + 2 < parser.end && SelfCIsOperator(parser.program, parser.fileIndex, index + 1, OperatorKind::Scope)) {
			String:scopeName = SelfCTokenText(parser.program, parser.fileIndex, index);
			if (scopeName.EqualsCString("std")) {
				status = builder.WriteCString("std_");
			} else {
				status = SelfCWriteToken(parser.program, &builder, parser.fileIndex, index);
				if (status == Status::Ok) {
					status = builder.WriteByte('_');
				}
			}
			if (status == Status::Ok) {
				status = SelfCWriteToken(parser.program, &builder, parser.fileIndex, index + 2);
			}
			parser.pos = index + 3;
			if (parser.pos < parser.end && SelfCIsOperator(parser.program, parser.fileIndex, parser.pos, OperatorKind::Less)) {
				usize:gEnd = SelfCFindMatching(parser.program, parser.fileIndex, parser.pos);
				if (gEnd + 1 < parser.end && SelfCIsPunctuation(parser.program, parser.fileIndex, gEnd + 1, PunctuationKind::LeftParen)) {
					usize:argStart = parser.pos + 1;
					while (argStart < gEnd) {
						usize:argEnd = SelfCFindTokenAtDepthZero(parser.program, parser.fileIndex, argStart, gEnd, PunctuationKind::Comma);
						if (status == Status::Ok) {
							status = builder.WriteCString("__");
						}
						if (status == Status::Ok) {
							status = SelfCWriteTypeSuffixFromRange(parser.program, &builder, parser.fileIndex, argStart, argEnd);
						}
						if (argEnd >= gEnd) {
							break;
						}
						argStart = argEnd + 1;
					}
					parser.pos = gEnd + 1;
				}
			}
		} else {
			status = SelfCWriteToken(parser.program, &builder, parser.fileIndex, index);
			parser.pos = index + 1;
			if (parser.pos < parser.end && SelfCIsOperator(parser.program, parser.fileIndex, parser.pos, OperatorKind::Less)) {
				usize:gEnd = SelfCFindMatching(parser.program, parser.fileIndex, parser.pos);
				if (gEnd + 1 < parser.end && SelfCIsPunctuation(parser.program, parser.fileIndex, gEnd + 1, PunctuationKind::LeftParen)) {
					usize:argStart = parser.pos + 1;
					while (argStart < gEnd) {
						usize:argEnd = SelfCFindTokenAtDepthZero(parser.program, parser.fileIndex, argStart, gEnd, PunctuationKind::Comma);
						if (status == Status::Ok) {
							status = builder.WriteCString("__");
						}
						if (status == Status::Ok) {
							status = SelfCWriteTypeSuffixFromRange(parser.program, &builder, parser.fileIndex, argStart, argEnd);
						}
						if (argEnd >= gEnd) {
							break;
						}
						argStart = argEnd + 1;
					}
					parser.pos = gEnd + 1;
				}
			}
		}
		if (status == Status::Ok) {
			status = SelfCExprFromBuilder(out, &builder);
		}
		builder.Destroy();
		ptr<SelfCLocal>:local = SelfCEnvFind(parser.env, SelfCTokenText(parser.program, parser.fileIndex, index));
		if (status == Status::Ok && local != 0) {
			status = SelfCExprSetType(parser.program, out, std::OwnedStringView(&local.typeKey), std::OwnedStringView(&local.cType), local.isPointer);
			out.isArray = local.isArray;
			out.isPointer = local.isPointer;
			out.isLvalue = true;
			OwnedString:arrLen;
			if (status == Status::Ok) {
				status = SelfCCloneString(parser.program, std::OwnedStringView(&local.arrayLen), &arrLen);
			}
			if (status == Status::Ok) {
				status = SelfCReplaceOwned(&out.arrayLen, arrLen);
			}
		} else {
			if (status == Status::Ok) {
				ptr<SelfCDecl>:functionDecl = SelfCFindFunctionDeclByName(parser.program, SelfCTokenText(parser.program, parser.fileIndex, index), std::StringFromCString(""));
				if (functionDecl != 0) {
					StringBuilder:functionName = std::StringBuilderNew(parser.program[0].allocator);
					status = SelfCWriteDeclCName(parser.program, &functionName, functionDecl);
					String:currentName = std::OwnedStringView(&out.text);
					Result<usize>:suffixStart = currentName.FindByte('_');
					if (status == Status::Ok && suffixStart.status == Status::Ok && suffixStart.value + 1 < currentName.len && currentName.data[suffixStart.value + 1] == '_') {
						status = functionName.WriteString(currentName.Slice(suffixStart.value, currentName.len - suffixStart.value));
					}
					if (status == Status::Ok) {
						status = SelfCExprFromBuilder(out, &functionName);
					}
					functionName.Destroy();
				}
			}
		}
		return(status);
	}
	parser.pos += 1;
	return(Status::Ok);
}

Status:SelfCWriteCallArgs(ptr<SelfCExprParser>:parser, usize:start, usize:end, ptr<StringBuilder>:out) {
	usize:itemStart = start;
	bool:first = true;
	Status:status = Status::Ok;
	while (itemStart < end) {
		if (SelfCIsPunctuation(parser.program, parser.fileIndex, itemStart, PunctuationKind::Comma)) {
			itemStart += 1;
			continue;
		}
		usize:itemEnd = SelfCFindTokenAtDepthZero(parser.program, parser.fileIndex, itemStart, end, PunctuationKind::Comma);
		usize:exprStart = itemStart;
		usize:assign = SelfCFindTokenAtDepthZero(parser.program, parser.fileIndex, itemStart, itemEnd, PunctuationKind::Colon);
		if (assign < itemEnd) {
			exprStart = assign + 1;
		} else {
			for (usize:i = itemStart; i < itemEnd; i++) {
				if (SelfCIsOperator(parser.program, parser.fileIndex, i, OperatorKind::Assign)) {
					exprStart = i + 1;
					break;
				}
			}
		}
		SelfCExpr:arg;
		if (status == Status::Ok) {
			status = SelfCCompileExpressionRange(parser.program, parser.env, parser.fileIndex, exprStart, itemEnd, std::StringFromCString(""), std::StringFromCString(""), false, &arg);
		}
		if (status == Status::Ok && !first) {
			status = out.WriteByte(',');
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&arg.text));
		}
		if (status == Status::Ok) {
			SelfCExprDestroy(&arg);
		}
		first = false;
		if (status != Status::Ok || itemEnd >= end) {
			break;
		}
		itemStart = itemEnd + 1;
	}
	return(status);
}

usize:SelfCCountCallArgs(ptr<SelfCProgram>:program, usize:fileIndex, usize:start, usize:end) {
	if (start >= end) {
		return(0);
	}
	usize:count = 1;
	usize:i = start;
	while (i < end) {
		usize:comma = SelfCFindTokenAtDepthZero(program, fileIndex, i, end, PunctuationKind::Comma);
		if (comma >= end) {
			break;
		}
		count += 1;
		i = comma + 1;
	}
	return(count);
}

Status:SelfCApplyPostfix(ptr<SelfCExprParser>:parser, ptr<SelfCExpr>:expr) {
	while (parser.pos < parser.end) {
		if (SelfCIsPunctuation(parser.program, parser.fileIndex, parser.pos, PunctuationKind::LeftParen)) {
			usize:groupStart = parser.pos;
			usize:groupEnd = SelfCFindMatching(parser.program, parser.fileIndex, groupStart);
			String:funcText = std::OwnedStringView(&expr.text);
			if (funcText.EqualsCString("len")) {
				SelfCExpr:arg;
				Status:status = SelfCCompileExpressionRange(parser.program, parser.env, parser.fileIndex, groupStart + 1, groupEnd, std::StringFromCString(""), std::StringFromCString(""), false, &arg);
				StringBuilder:lenBuilder = std::StringBuilderNew(parser.program[0].allocator);
				if (status == Status::Ok) {
					if (arg.isArray) {
						status = lenBuilder.WriteCString("((void)(");
						if (status == Status::Ok) {
							status = lenBuilder.WriteString(std::OwnedStringView(&arg.text));
						}
						if (status == Status::Ok) {
							status = lenBuilder.WriteCString("),");
						}
						if (status == Status::Ok) {
							status = lenBuilder.WriteString(std::OwnedStringView(&arg.arrayLen));
						}
						if (status == Status::Ok) {
							status = lenBuilder.WriteByte(')');
						}
					} else {
						status = lenBuilder.WriteCString("(sizeof(");
						if (status == Status::Ok) {
							status = lenBuilder.WriteString(std::OwnedStringView(&arg.text));
						}
						if (status == Status::Ok) {
							status = lenBuilder.WriteCString(")/sizeof((");
						}
						if (status == Status::Ok) {
							status = lenBuilder.WriteString(std::OwnedStringView(&arg.text));
						}
						if (status == Status::Ok) {
							status = lenBuilder.WriteCString(")[0]))");
						}
					}
				}
				if (status == Status::Ok) {
					status = SelfCExprFromBuilder(expr, &lenBuilder);
				}
				lenBuilder.Destroy();
				SelfCExprDestroy(&arg);
				if (status == Status::Ok) {
					status = SelfCExprSetType(parser.program, expr, std::StringFromCString("usize"), std::StringFromCString("usize"), false);
				}
				parser.pos = groupEnd + 1;
				if (status != Status::Ok) {
					return(status);
				}
				continue;
			}
			StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
			Status:status = builder.WriteString(funcText);
			if (status == Status::Ok) {
				status = builder.WriteByte('(');
			}
			if (status == Status::Ok) {
				status = SelfCWriteCallArgs(parser, groupStart + 1, groupEnd, &builder);
			}
			usize:argCount = SelfCCountCallArgs(parser.program, parser.fileIndex, groupStart + 1, groupEnd);
			if (status == Status::Ok && funcText.EqualsCString("add") && argCount == 1) {
				status = builder.WriteCString(",0");
			}
			if (status == Status::Ok) {
				status = builder.WriteByte(')');
			}
			if (status == Status::Ok) {
				status = SelfCExprFromBuilder(expr, &builder);
			}
			builder.Destroy();
			expr.isLvalue = false;
			parser.pos = groupEnd + 1;
			if (status != Status::Ok) {
				return(status);
			}
			continue;
		}
		if (SelfCIsPunctuation(parser.program, parser.fileIndex, parser.pos, PunctuationKind::LeftBracket)) {
			usize:indexStart = parser.pos;
			usize:indexEnd = SelfCFindMatching(parser.program, parser.fileIndex, indexStart);
			SelfCExpr:indexExpr;
			Status:status = SelfCCompileExpressionRange(parser.program, parser.env, parser.fileIndex, indexStart + 1, indexEnd, std::StringFromCString(""), std::StringFromCString(""), false, &indexExpr);
			StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
			if (status == Status::Ok) {
				status = builder.WriteString(std::OwnedStringView(&expr.text));
			}
			if (status == Status::Ok) {
				status = builder.WriteByte('[');
			}
			if (status == Status::Ok) {
				status = builder.WriteString(std::OwnedStringView(&indexExpr.text));
			}
			if (status == Status::Ok) {
				status = builder.WriteByte(']');
			}
			if (status == Status::Ok) {
				status = SelfCExprFromBuilder(expr, &builder);
			}
			builder.Destroy();
			SelfCExprDestroy(&indexExpr);
			expr.isLvalue = true;
			expr.isArray = false;
			String:indexedKey = std::OwnedStringView(&expr.typeKey);
			if (indexedKey.len > 0 && indexedKey.data[indexedKey.len - 1] == '*') {
				OwnedString:newKey;
				status = SelfCCloneString(parser.program, indexedKey.Slice(0, indexedKey.len - 1), &newKey);
				if (status == Status::Ok) {
					status = SelfCReplaceOwned(&expr.typeKey, newKey);
				}
				OwnedString:newCType;
				if (status == Status::Ok) {
					status = SelfCMakeCTypeFromKey(parser.program, std::OwnedStringView(&expr.typeKey), &newCType);
				}
				if (status == Status::Ok) {
					status = SelfCReplaceOwned(&expr.cType, newCType);
				}
				expr.isPointer = false;
			}
			parser.pos = indexEnd + 1;
			if (status != Status::Ok) {
				return(status);
			}
			continue;
		}
		if (SelfCIsPunctuation(parser.program, parser.fileIndex, parser.pos, PunctuationKind::Dot)) {
			usize:nameIndex = parser.pos + 1;
			String:fieldName = SelfCTokenText(parser.program, parser.fileIndex, nameIndex);
			if (nameIndex + 1 < parser.end && SelfCIsPunctuation(parser.program, parser.fileIndex, nameIndex + 1, PunctuationKind::LeftParen)) {
				usize:groupStart = nameIndex + 1;
				usize:groupEnd = SelfCFindMatching(parser.program, parser.fileIndex, groupStart);
				String:receiverKey = std::OwnedStringView(&expr.typeKey);
				String:methodReceiverKey = receiverKey;
				if (expr.isPointer && receiverKey.len > 0 && receiverKey.data[receiverKey.len - 1] == '*') {
					methodReceiverKey = receiverKey.Slice(0, receiverKey.len - 1);
				}
				ptr<SelfCDecl>:method = SelfCFindMethod(parser.program, methodReceiverKey, fieldName, false, 0, 0);
				StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
				Status:status = Status::Ok;
				if (method != 0) {
					status = SelfCWriteDeclCName(parser.program, &builder, method);
				} else {
					status = builder.WriteString(methodReceiverKey);
					if (status == Status::Ok) {
						status = builder.WriteByte('_');
					}
					if (status == Status::Ok) {
						status = builder.WriteString(fieldName);
					}
				}
				if (status == Status::Ok) {
					status = builder.WriteByte('(');
				}
				if (status == Status::Ok && !expr.isPointer) {
					status = builder.WriteByte('&');
				}
				if (status == Status::Ok) {
					status = builder.WriteString(std::OwnedStringView(&expr.text));
				}
				if (groupStart + 1 < groupEnd) {
					if (status == Status::Ok) {
						status = builder.WriteByte(',');
					}
					if (status == Status::Ok) {
						status = SelfCWriteCallArgs(parser, groupStart + 1, groupEnd, &builder);
					}
				}
				if (status == Status::Ok) {
					status = builder.WriteByte(')');
				}
				if (status == Status::Ok) {
					status = SelfCExprFromBuilder(expr, &builder);
				}
				builder.Destroy();
				expr.isLvalue = false;
				if (method != 0) {
					SelfCTypeInfo:returnInfo;
					if (status == Status::Ok) {
						status = SelfCRenderTypeInfo(parser.program, method.fileIndex, method.returnStart, method.returnEnd, &returnInfo);
					}
					if (status == Status::Ok) {
						status = SelfCExprSetType(parser.program, expr, std::OwnedStringView(&returnInfo.key), std::OwnedStringView(&returnInfo.cType), returnInfo.isPointer);
					}
					if (status == Status::Ok) {
						SelfCTypeInfoDestroy(&returnInfo);
					}
				}
				parser.pos = groupEnd + 1;
				if (status != Status::Ok) {
					return(status);
				}
				continue;
			}
			StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
			Status:status = builder.WriteString(std::OwnedStringView(&expr.text));
			if (status == Status::Ok) {
				String:exprText = std::OwnedStringView(&expr.text);
				if (expr.isPointer || exprText.EqualsCString("this")) {
					status = builder.WriteCString("->");
				} else {
					status = builder.WriteByte('.');
				}
			}
			if (status == Status::Ok) {
				status = builder.WriteString(fieldName);
			}
			if (status == Status::Ok) {
				status = SelfCExprFromBuilder(expr, &builder);
			}
			builder.Destroy();
			SelfCTypeInfo:fieldType;
			if (status == Status::Ok) {
				status = SelfCFieldType(parser.program, std::OwnedStringView(&expr.typeKey), fieldName, &fieldType);
			}
			if (status == Status::Ok) {
				status = SelfCExprSetType(parser.program, expr, std::OwnedStringView(&fieldType.key), std::OwnedStringView(&fieldType.cType), fieldType.isPointer);
			}
			if (status == Status::Ok) {
				SelfCTypeInfoDestroy(&fieldType);
			}
			expr.isLvalue = true;
			parser.pos = nameIndex + 1;
			if (status != Status::Ok) {
				return(status);
			}
			continue;
		}
		break;
	}
	return(Status::Ok);
}

Status:SelfCCompileUnary(ptr<SelfCExprParser>:parser, ptr<SelfCExpr>:out) {
	if (parser.pos < parser.end
		&& (SelfCIsOperator(parser.program, parser.fileIndex, parser.pos, OperatorKind::Minus)
			|| SelfCIsOperator(parser.program, parser.fileIndex, parser.pos, OperatorKind::LogicalNot)
			|| SelfCIsOperator(parser.program, parser.fileIndex, parser.pos, OperatorKind::BitwiseNot)
			|| SelfCIsOperator(parser.program, parser.fileIndex, parser.pos, OperatorKind::BitwiseAnd)
			|| SelfCIsOperator(parser.program, parser.fileIndex, parser.pos, OperatorKind::Multiply))) {
		usize:op = parser.pos;
		parser.pos += 1;
		SelfCExpr:inner;
		Status:status = SelfCCompileUnary(parser, &inner);
		StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
		if (status == Status::Ok) {
			status = SelfCWriteToken(parser.program, &builder, parser.fileIndex, op);
		}
		if (status == Status::Ok) {
			status = builder.WriteString(std::OwnedStringView(&inner.text));
		}
		if (status == Status::Ok) {
			status = SelfCExprInitEmpty(parser.program, out);
		}
		if (status == Status::Ok) {
			status = SelfCExprFromBuilder(out, &builder);
		}
		builder.Destroy();
		if (status == Status::Ok) {
			ptr<SelfCDecl>:unaryMethod = 0;
			if (SelfCIsOperator(parser.program, parser.fileIndex, op, OperatorKind::Minus)) {
				unaryMethod = SelfCFindMethod(parser.program, std::OwnedStringView(&inner.typeKey), std::StringFromCString(""), true, SelfCOperatorCode(parser.program, parser.fileIndex, op), 0);
			}
			if (unaryMethod != 0) {
				StringBuilder:call = std::StringBuilderNew(parser.program[0].allocator);
				status = SelfCWriteDeclCName(parser.program, &call, unaryMethod);
				if (status == Status::Ok) {
					status = call.WriteCString("(&");
				}
				if (status == Status::Ok) {
					status = call.WriteString(std::OwnedStringView(&inner.text));
				}
				if (status == Status::Ok) {
					status = call.WriteByte(')');
				}
				if (status == Status::Ok) {
					status = SelfCExprFromBuilder(out, &call);
				}
				call.Destroy();
			} else {
				if (SelfCIsOperator(parser.program, parser.fileIndex, op, OperatorKind::BitwiseAnd)) {
				StringBuilder:key = std::StringBuilderNew(parser.program[0].allocator);
				status = key.WriteString(std::OwnedStringView(&inner.typeKey));
				if (status == Status::Ok) {
					status = key.WriteByte('*');
				}
				OwnedString:keyOwned;
				if (status == Status::Ok) {
					status = SelfCDetachBuilder(&key, &keyOwned);
				}
				key.Destroy();
				OwnedString:cOwned;
				if (status == Status::Ok) {
					StringBuilder:ct = std::StringBuilderNew(parser.program[0].allocator);
					status = ct.WriteString(std::OwnedStringView(&inner.cType));
					if (status == Status::Ok) {
						status = ct.WriteByte('*');
					}
					if (status == Status::Ok) {
						status = SelfCDetachBuilder(&ct, &cOwned);
					}
					ct.Destroy();
				}
				if (status == Status::Ok) {
					status = SelfCExprSetType(parser.program, out, std::OwnedStringView(&keyOwned), std::OwnedStringView(&cOwned), true);
					std::DestroyOwnedString(&keyOwned);
					std::DestroyOwnedString(&cOwned);
				}
			} else {
				status = SelfCExprSetType(parser.program, out, std::OwnedStringView(&inner.typeKey), std::OwnedStringView(&inner.cType), inner.isPointer);
			}
			}
		}
		SelfCExprDestroy(&inner);
		return(status);
	}
	Status:status = SelfCCompilePrimary(parser, out);
	if (status == Status::Ok) {
		status = SelfCApplyPostfix(parser, out);
	}
	return(status);
}

Status:SelfCCompileBinaryOperation(ptr<SelfCExprParser>:parser, ptr<SelfCExpr>:left, usize:operatorIndex, ptr<SelfCExpr>:right, ptr<SelfCExpr>:out) {
	Status:status = SelfCExprInitEmpty(parser.program, out);
	if (status != Status::Ok) {
		return(status);
	}
	u8:opCode = SelfCOperatorCode(parser.program, parser.fileIndex, operatorIndex);
	ptr<SelfCDecl>:method = 0;
	usize:operatorArgCount = 1;
	if (SelfCIsOperator(parser.program, parser.fileIndex, operatorIndex, OperatorKind::PlusAssign)
		|| SelfCIsOperator(parser.program, parser.fileIndex, operatorIndex, OperatorKind::MinusAssign)) {
		operatorArgCount = 1;
	}
	if (opCode != 0 && std::OwnedStringView(&left.typeKey).len > 0) {
		method = SelfCFindMethod(parser.program, std::OwnedStringView(&left.typeKey), std::StringFromCString(""), true, opCode, operatorArgCount);
	}
	if (method != 0) {
		StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
		status = SelfCWriteDeclCName(parser.program, &builder, method);
		if (status == Status::Ok) {
			status = builder.WriteCString("(&");
		}
		if (status == Status::Ok) {
			status = builder.WriteString(std::OwnedStringView(&left.text));
		}
		if (status == Status::Ok) {
			status = builder.WriteByte(',');
		}
		if (status == Status::Ok) {
			status = builder.WriteString(std::OwnedStringView(&right.text));
		}
		if (status == Status::Ok) {
			status = builder.WriteByte(')');
		}
		if (status == Status::Ok) {
			status = SelfCExprFromBuilder(out, &builder);
		}
		builder.Destroy();
		if (status == Status::Ok) {
			SelfCTypeInfo:returnInfo;
			status = SelfCRenderTypeInfo(parser.program, method.fileIndex, method.returnStart, method.returnEnd, &returnInfo);
			if (status == Status::Ok) {
				status = SelfCExprSetType(parser.program, out, std::OwnedStringView(&returnInfo.key), std::OwnedStringView(&returnInfo.cType), returnInfo.isPointer);
			}
			if (status == Status::Ok) {
				SelfCTypeInfoDestroy(&returnInfo);
			}
		}
		return(status);
	}
	StringBuilder:builder = std::StringBuilderNew(parser.program[0].allocator);
	status = builder.WriteString(std::OwnedStringView(&left.text));
	if (status == Status::Ok) {
		status = SelfCWriteToken(parser.program, &builder, parser.fileIndex, operatorIndex);
	}
	if (status == Status::Ok) {
		status = builder.WriteString(std::OwnedStringView(&right.text));
	}
	if (status == Status::Ok) {
		status = SelfCExprFromBuilder(out, &builder);
	}
	builder.Destroy();
	if (status == Status::Ok) {
		if (SelfCIsOperator(parser.program, parser.fileIndex, operatorIndex, OperatorKind::Equal)
			|| SelfCIsOperator(parser.program, parser.fileIndex, operatorIndex, OperatorKind::NotEqual)
			|| SelfCIsOperator(parser.program, parser.fileIndex, operatorIndex, OperatorKind::Less)
			|| SelfCIsOperator(parser.program, parser.fileIndex, operatorIndex, OperatorKind::LessEqual)
			|| SelfCIsOperator(parser.program, parser.fileIndex, operatorIndex, OperatorKind::Greater)
			|| SelfCIsOperator(parser.program, parser.fileIndex, operatorIndex, OperatorKind::GreaterEqual)
			|| SelfCIsOperator(parser.program, parser.fileIndex, operatorIndex, OperatorKind::LogicalAnd)
			|| SelfCIsOperator(parser.program, parser.fileIndex, operatorIndex, OperatorKind::LogicalOr)) {
			status = SelfCExprSetType(parser.program, out, std::StringFromCString("bool"), std::StringFromCString("bool"), false);
		} else {
			status = SelfCExprSetType(parser.program, out, std::OwnedStringView(&left.typeKey), std::OwnedStringView(&left.cType), left.isPointer);
		}
	}
	return(status);
}

Status:SelfCCompileExpression(ptr<SelfCExprParser>:parser, u8:minPrecedence, ptr<SelfCExpr>:out) {
	SelfCExpr:left;
	Status:status = SelfCCompileUnary(parser, &left);
	if (status != Status::Ok) {
		return(status);
	}
	while (parser.pos < parser.end) {
		u8:precedence = SelfCOperatorPrecedence(parser.program, parser.fileIndex, parser.pos);
		if (precedence == 0 || precedence < minPrecedence) {
			break;
		}
		usize:op = parser.pos;
		parser.pos += 1;
		u8:nextMin = precedence + 1;
		if (SelfCOperatorRightAssociative(parser.program, parser.fileIndex, op)) {
			nextMin = precedence;
		}
		SelfCExpr:right;
		status = SelfCCompileExpression(parser, nextMin, &right);
		if (status != Status::Ok) {
			SelfCExprDestroy(&left);
			return(status);
		}
		SelfCExpr:combined;
		status = SelfCCompileBinaryOperation(parser, &left, op, &right, &combined);
		SelfCExprDestroy(&left);
		SelfCExprDestroy(&right);
		if (status != Status::Ok) {
			return(status);
		}
		left = combined;
	}
	out[0] = left;
	return(Status::Ok);
}

Status:SelfCWriteIndent(ptr<StringBuilder>:out, usize:indent) {
	for (usize:i = 0; i < indent; i++) {
		Status:status = out.WriteCString("    ");
		if (status != Status::Ok) {
			return(status);
		}
	}
	return(Status::Ok);
}

usize:SelfCFindStatementSemicolon(ptr<SelfCProgram>:program, usize:fileIndex, usize:start, usize:end) {
	usize:i = start;
	while (i < end) {
		if (SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::LeftParen)
			|| SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::LeftBrace)
			|| SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::LeftBracket)) {
			i = SelfCSkipDelimited(program, fileIndex, i);
			continue;
		}
		if (SelfCIsPunctuation(program, fileIndex, i, PunctuationKind::Semicolon)) {
			return(i);
		}
		i += 1;
	}
	return(end);
}

Status:SelfCArrayLenString(ptr<SelfCProgram>:program, usize:fileIndex, usize:start, usize:end, ptr<OwnedString>:out) {
	StringBuilder:builder = std::StringBuilderNew(program.allocator);
	Status:status = SelfCWriteTokenRangeRaw(program, &builder, fileIndex, start, end);
	if (status == Status::Ok) {
		status = SelfCDetachBuilder(&builder, out);
	}
	builder.Destroy();
	return(status);
}

bool:SelfCFieldDefaultIsZero(ptr<SelfCProgram>:program, ptr<SelfCField>:field) {
	if (!field.hasDefault) {
		return(true);
	}
	if (field.defaultEnd != field.defaultStart + 1) {
		return(false);
	}
	if (SelfCIsTokenKind(program, field.fileIndex, field.defaultStart, TokenKind::Number)
		&& SelfCTokenEquals(program, field.fileIndex, field.defaultStart, "0")) {
		return(true);
	}
	if (SelfCIsIdentifierText(program, field.fileIndex, field.defaultStart, "false")) {
		return(true);
	}
	return(false);
}

Status:SelfCWriteDefaultInitializer(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, String:typeKey) {
	ptr<SelfCDecl>:decl = SelfCFindFieldDecl(program, typeKey);
	if (decl != 0 && decl.kind == SelfCDeclKind::Union) {
		return(out.WriteCString("{0}"));
	}
	if (decl == 0 || decl.kind != SelfCDeclKind::Struct) {
		return(out.WriteCString("0"));
	}
	bool:hasNonZeroDefault = false;
	for (usize:i = 0; i < decl.fieldCount; i++) {
		ptr<SelfCField>:field = &program.fields[decl.firstField + i];
		if (field.hasDefault && !SelfCFieldDefaultIsZero(program, field)) {
			hasNonZeroDefault = true;
			break;
		}
	}
	if (!hasNonZeroDefault) {
		return(out.WriteCString("{0}"));
	}
	Status:status = out.WriteByte('{');
	bool:first = true;
	for (usize:i = 0; i < decl.fieldCount; i++) {
		ptr<SelfCField>:field = &program.fields[decl.firstField + i];
		if (!field.hasDefault || SelfCFieldDefaultIsZero(program, field)) {
			continue;
		}
		if (!first && status == Status::Ok) {
			status = out.WriteByte(',');
		}
		if (status == Status::Ok) {
			status = out.WriteByte('.');
		}
		if (status == Status::Ok) {
			status = SelfCWriteToken(program, out, field.fileIndex, field.nameIndex);
		}
		if (status == Status::Ok) {
			status = out.WriteByte('=');
		}
		SelfCExpr:defaultExpr;
		SelfCEnv:emptyEnv;
		SelfCEnvInit(program, &emptyEnv);
		if (status == Status::Ok) {
			status = SelfCCompileExpressionRange(program, &emptyEnv, field.fileIndex, field.defaultStart, field.defaultEnd, std::StringFromCString(""), std::StringFromCString(""), false, &defaultExpr);
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&defaultExpr.text));
		}
		if (status == Status::Ok) {
			SelfCExprDestroy(&defaultExpr);
		}
		SelfCEnvDestroy(&emptyEnv);
		first = false;
		if (status != Status::Ok) {
			return(status);
		}
	}
	if (status == Status::Ok) {
		status = out.WriteByte('}');
	}
	return(status);
}

Status:SelfCWriteVarDecl(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCEnv>:env, usize:fileIndex, usize:start, usize:semicolon, usize:indent) {
	usize:colon = SelfCFindTopLevelColon(program, fileIndex, start, semicolon);
	if (colon >= semicolon) {
		return(Status::Invalid);
	}
	usize:nameIndex = colon + 1;
	usize:afterName = nameIndex + 1;
	bool:isArray = false;
	usize:arrayStart = semicolon;
	usize:arrayEnd = semicolon;
	if (afterName < semicolon && SelfCIsPunctuation(program, fileIndex, afterName, PunctuationKind::LeftBracket)) {
		isArray = true;
		arrayStart = afterName + 1;
		arrayEnd = SelfCFindMatching(program, fileIndex, afterName);
		afterName = arrayEnd + 1;
		while (afterName < semicolon && SelfCIsPunctuation(program, fileIndex, afterName, PunctuationKind::LeftBracket)) {
			afterName = SelfCFindMatching(program, fileIndex, afterName) + 1;
		}
	}
	usize:arraySuffixStart = nameIndex + 1;
	usize:arraySuffixEnd = afterName;
	usize:initStart = semicolon;
	bool:hasInit = false;
	for (usize:i = afterName; i < semicolon; i++) {
		if (SelfCIsOperator(program, fileIndex, i, OperatorKind::Assign)) {
			initStart = i + 1;
			hasInit = true;
			break;
		}
	}
	SelfCTypeInfo:typeInfo;
	Status:status = SelfCRenderTypeInfo(program, fileIndex, start, colon, &typeInfo);
	if (status != Status::Ok) {
		return(status);
	}
	status = SelfCWriteIndent(out, indent);
	if (status == Status::Ok) {
		status = out.WriteString(std::OwnedStringView(&typeInfo.cType));
	}
	if (status == Status::Ok) {
		status = out.WriteByte(' ');
	}
	if (status == Status::Ok) {
		status = SelfCWriteToken(program, out, fileIndex, nameIndex);
	}
	OwnedString:arrayLen;
	if (isArray) {
		if (status == Status::Ok) {
			status = SelfCWriteTokenRangeRaw(program, out, fileIndex, arraySuffixStart, arraySuffixEnd);
		}
		if (status == Status::Ok) {
			status = SelfCArrayLenString(program, fileIndex, arrayStart, arrayEnd, &arrayLen);
		}
	} else {
		if (status == Status::Ok) {
			status = SelfCMakeOwnedEmpty(program, &arrayLen);
		}
	}
	if (hasInit) {
		SelfCExpr:init;
		if (status == Status::Ok) {
			status = SelfCCompileExpressionRange(program, env, fileIndex, initStart, semicolon, std::OwnedStringView(&typeInfo.key), std::OwnedStringView(&typeInfo.cType), isArray, &init);
		}
		if (status == Status::Ok) {
			status = out.WriteByte('=');
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&init.text));
		}
		if (status == Status::Ok) {
			SelfCExprDestroy(&init);
		}
	} else {
		if (!isArray) {
			if (status == Status::Ok) {
				status = out.WriteByte('=');
			}
			if (status == Status::Ok) {
				status = SelfCWriteDefaultInitializer(program, out, std::OwnedStringView(&typeInfo.key));
			}
		}
	}
	if (status == Status::Ok) {
		status = out.WriteCString(";\n");
	}
	if (status == Status::Ok) {
		status = SelfCEnvAdd(program, env, SelfCTokenText(program, fileIndex, nameIndex), std::OwnedStringView(&typeInfo.key), std::OwnedStringView(&typeInfo.cType), isArray, std::OwnedStringView(&arrayLen), typeInfo.isPointer);
	}
	std::DestroyOwnedString(&arrayLen);
	SelfCTypeInfoDestroy(&typeInfo);
	return(status);
}

Status:SelfCWriteExprStatement(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCEnv>:env, usize:fileIndex, usize:start, usize:semicolon, usize:indent) {
	if (start >= semicolon) {
		return(Status::Ok);
	}
	if (start + 2 == semicolon
		&& SelfCIsOperator(program, fileIndex, start + 1, OperatorKind::Plus)
		&& SelfCIsOperator(program, fileIndex, start + 2, OperatorKind::Plus)) {
	}
	SelfCExpr:expr;
	Status:status = SelfCCompileExpressionRange(program, env, fileIndex, start, semicolon, std::StringFromCString(""), std::StringFromCString(""), false, &expr);
	if (status == Status::Ok) {
		status = SelfCWriteIndent(out, indent);
	}
	if (status == Status::Ok) {
		status = out.WriteString(std::OwnedStringView(&expr.text));
	}
	if (status == Status::Ok) {
		status = out.WriteCString(";\n");
	}
	SelfCExprDestroy(&expr);
	return(status);
}

Status:SelfCWriteIfStatement(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCEnv>:env, usize:fileIndex, usize:start, ptr<usize>:outNext, usize:indent) {
	usize:groupStart = SelfCFindNextGroup(program, fileIndex, start, SelfCFileTokenCount(program, fileIndex));
	usize:groupEnd = SelfCFindMatching(program, fileIndex, groupStart);
	usize:blockStart = groupEnd + 1;
	usize:blockEnd = blockStart;
	SelfCExpr:cond;
	Status:status = SelfCCompileExpressionRange(program, env, fileIndex, groupStart + 1, groupEnd, std::StringFromCString(""), std::StringFromCString(""), false, &cond);
	if (status == Status::Ok) {
		status = SelfCWriteIndent(out, indent);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("if (");
	}
	if (status == Status::Ok) {
		status = out.WriteString(std::OwnedStringView(&cond.text));
	}
	if (status == Status::Ok) {
		status = out.WriteCString(") ");
	}
	SelfCExprDestroy(&cond);
	if (blockStart < SelfCFileTokenCount(program, fileIndex) && SelfCIsPunctuation(program, fileIndex, blockStart, PunctuationKind::LeftBrace)) {
		blockEnd = SelfCFindMatching(program, fileIndex, blockStart);
		if (status == Status::Ok) {
			status = out.WriteCString("{\n");
		}
		if (status == Status::Ok) {
			status = SelfCWriteBlock(program, out, env, fileIndex, blockStart + 1, blockEnd, indent + 1);
		}
		if (status == Status::Ok) {
			status = SelfCWriteIndent(out, indent);
		}
		if (status == Status::Ok) {
			status = out.WriteCString("}");
		}
		outNext[0] = blockEnd + 1;
	} else {
		usize:semicolon = SelfCFindStatementSemicolon(program, fileIndex, blockStart, SelfCFileTokenCount(program, fileIndex));
		if (status == Status::Ok) {
			status = out.WriteCString("{\n");
		}
		if (status == Status::Ok) {
			status = SelfCWriteExprStatement(program, out, env, fileIndex, blockStart, semicolon, indent + 1);
		}
		if (status == Status::Ok) {
			status = SelfCWriteIndent(out, indent);
		}
		if (status == Status::Ok) {
			status = out.WriteCString("}");
		}
		outNext[0] = semicolon + 1;
	}
	if (outNext[0] < SelfCFileTokenCount(program, fileIndex) && SelfCIsKeyword(program, fileIndex, outNext[0], KeywordKind::Else)) {
		if (status == Status::Ok) {
			status = out.WriteCString(" else ");
		}
		usize:elseStart = outNext[0] + 1;
		if (elseStart < SelfCFileTokenCount(program, fileIndex) && SelfCIsPunctuation(program, fileIndex, elseStart, PunctuationKind::LeftBrace)) {
			usize:elseEnd = SelfCFindMatching(program, fileIndex, elseStart);
			if (status == Status::Ok) {
				status = out.WriteCString("{\n");
			}
			if (status == Status::Ok) {
				status = SelfCWriteBlock(program, out, env, fileIndex, elseStart + 1, elseEnd, indent + 1);
			}
			if (status == Status::Ok) {
				status = SelfCWriteIndent(out, indent);
			}
			if (status == Status::Ok) {
				status = out.WriteCString("}");
			}
			outNext[0] = elseEnd + 1;
		} else {
			if (status == Status::Ok) {
				status = out.WriteCString("{\n");
			}
			usize:semicolon = SelfCFindStatementSemicolon(program, fileIndex, elseStart, SelfCFileTokenCount(program, fileIndex));
			if (status == Status::Ok) {
				status = SelfCWriteExprStatement(program, out, env, fileIndex, elseStart, semicolon, indent + 1);
			}
			if (status == Status::Ok) {
				status = SelfCWriteIndent(out, indent);
			}
			if (status == Status::Ok) {
				status = out.WriteCString("}");
			}
			outNext[0] = semicolon + 1;
		}
	}
	if (status == Status::Ok) {
		status = out.WriteByte('\n');
	}
	return(status);
}

Status:SelfCWriteWhileStatement(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCEnv>:env, usize:fileIndex, usize:start, ptr<usize>:outNext, usize:indent) {
	usize:groupStart = SelfCFindNextGroup(program, fileIndex, start, SelfCFileTokenCount(program, fileIndex));
	usize:groupEnd = SelfCFindMatching(program, fileIndex, groupStart);
	usize:blockStart = groupEnd + 1;
	usize:blockEnd = SelfCFindMatching(program, fileIndex, blockStart);
	SelfCExpr:cond;
	Status:status = SelfCCompileExpressionRange(program, env, fileIndex, groupStart + 1, groupEnd, std::StringFromCString(""), std::StringFromCString(""), false, &cond);
	if (status == Status::Ok) {
		status = SelfCWriteIndent(out, indent);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("while (");
	}
	if (status == Status::Ok) {
		status = out.WriteString(std::OwnedStringView(&cond.text));
	}
	if (status == Status::Ok) {
		status = out.WriteCString(") {\n");
	}
	SelfCExprDestroy(&cond);
	if (status == Status::Ok) {
		status = SelfCWriteBlock(program, out, env, fileIndex, blockStart + 1, blockEnd, indent + 1);
	}
	if (status == Status::Ok) {
		status = SelfCWriteIndent(out, indent);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("}\n");
	}
	outNext[0] = blockEnd + 1;
	return(status);
}

Status:SelfCWriteDoStatement(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCEnv>:env, usize:fileIndex, usize:start, ptr<usize>:outNext, usize:indent) {
	usize:blockStart = start + 1;
	usize:blockEnd = SelfCFindMatching(program, fileIndex, blockStart);
	usize:whileIndex = blockEnd + 1;
	usize:groupStart = SelfCFindNextGroup(program, fileIndex, whileIndex, SelfCFileTokenCount(program, fileIndex));
	usize:groupEnd = SelfCFindMatching(program, fileIndex, groupStart);
	SelfCExpr:cond;
	Status:status = SelfCCompileExpressionRange(program, env, fileIndex, groupStart + 1, groupEnd, std::StringFromCString(""), std::StringFromCString(""), false, &cond);
	if (status == Status::Ok) {
		status = SelfCWriteIndent(out, indent);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("do {\n");
	}
	if (status == Status::Ok) {
		status = SelfCWriteBlock(program, out, env, fileIndex, blockStart + 1, blockEnd, indent + 1);
	}
	if (status == Status::Ok) {
		status = SelfCWriteIndent(out, indent);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("} while (");
	}
	if (status == Status::Ok) {
		status = out.WriteString(std::OwnedStringView(&cond.text));
	}
	if (status == Status::Ok) {
		status = out.WriteCString(");\n");
	}
	SelfCExprDestroy(&cond);
	outNext[0] = groupEnd + 2;
	return(status);
}

Status:SelfCWriteForStatement(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCEnv>:env, usize:fileIndex, usize:start, ptr<usize>:outNext, usize:indent) {
	usize:groupStart = SelfCFindNextGroup(program, fileIndex, start, SelfCFileTokenCount(program, fileIndex));
	usize:groupEnd = SelfCFindMatching(program, fileIndex, groupStart);
	usize:firstSemi = SelfCFindTokenAtDepthZero(program, fileIndex, groupStart + 1, groupEnd, PunctuationKind::Semicolon);
	usize:secondSemi = SelfCFindTokenAtDepthZero(program, fileIndex, firstSemi + 1, groupEnd, PunctuationKind::Semicolon);
	usize:blockStart = groupEnd + 1;
	usize:blockEnd = SelfCFindMatching(program, fileIndex, blockStart);
	Status:status = SelfCWriteIndent(out, indent);
	if (status == Status::Ok) {
		status = out.WriteCString("for (");
	}
	usize:colon = SelfCFindTopLevelColon(program, fileIndex, groupStart + 1, firstSemi);
	if (colon < firstSemi) {
		SelfCTypeInfo:typeInfo;
		if (status == Status::Ok) {
			status = SelfCRenderTypeInfo(program, fileIndex, groupStart + 1, colon, &typeInfo);
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&typeInfo.cType));
		}
		if (status == Status::Ok) {
			status = out.WriteByte(' ');
		}
		if (status == Status::Ok) {
			status = SelfCWriteToken(program, out, fileIndex, colon + 1);
		}
		if (status == Status::Ok) {
			status = SelfCEnvAdd(program, env, SelfCTokenText(program, fileIndex, colon + 1), std::OwnedStringView(&typeInfo.key), std::OwnedStringView(&typeInfo.cType), false, std::StringFromCString(""), typeInfo.isPointer);
		}
		usize:eq = colon + 2;
		while (eq < firstSemi && !SelfCIsOperator(program, fileIndex, eq, OperatorKind::Assign)) {
			eq += 1;
		}
		if (eq < firstSemi) {
			SelfCExpr:init;
			if (status == Status::Ok) {
				status = SelfCCompileExpressionRange(program, env, fileIndex, eq + 1, firstSemi, std::OwnedStringView(&typeInfo.key), std::OwnedStringView(&typeInfo.cType), false, &init);
			}
			if (status == Status::Ok) {
				status = out.WriteByte('=');
			}
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&init.text));
			}
			if (status == Status::Ok) {
				SelfCExprDestroy(&init);
			}
		}
		SelfCTypeInfoDestroy(&typeInfo);
	} else {
		SelfCExpr:initExpr;
		if (status == Status::Ok) {
			status = SelfCCompileExpressionRange(program, env, fileIndex, groupStart + 1, firstSemi, std::StringFromCString(""), std::StringFromCString(""), false, &initExpr);
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&initExpr.text));
		}
		if (status == Status::Ok) {
			SelfCExprDestroy(&initExpr);
		}
	}
	if (status == Status::Ok) {
		status = out.WriteByte(';');
	}
	SelfCExpr:cond;
	if (status == Status::Ok) {
		status = SelfCCompileExpressionRange(program, env, fileIndex, firstSemi + 1, secondSemi, std::StringFromCString(""), std::StringFromCString(""), false, &cond);
	}
	if (status == Status::Ok) {
		status = out.WriteString(std::OwnedStringView(&cond.text));
	}
	if (status == Status::Ok) {
		status = out.WriteByte(';');
	}
	if (status == Status::Ok) {
		status = SelfCWriteTokenRangeRaw(program, out, fileIndex, secondSemi + 1, groupEnd);
	}
	if (status == Status::Ok) {
		status = out.WriteCString(") {\n");
	}
	if (status == Status::Ok) {
		status = SelfCWriteBlock(program, out, env, fileIndex, blockStart + 1, blockEnd, indent + 1);
	}
	if (status == Status::Ok) {
		status = SelfCWriteIndent(out, indent);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("}\n");
	}
	SelfCExprDestroy(&cond);
	outNext[0] = blockEnd + 1;
	return(status);
}

Status:SelfCWriteEachStatement(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCEnv>:env, usize:fileIndex, usize:start, ptr<usize>:outNext, usize:indent) {
	usize:genericStart = start + 1;
	usize:genericEnd = SelfCFindMatching(program, fileIndex, genericStart);
	usize:groupStart = genericEnd + 1;
	usize:groupEnd = SelfCFindMatching(program, fileIndex, groupStart);
	usize:blockStart = groupEnd + 1;
	usize:blockEnd = SelfCFindMatching(program, fileIndex, blockStart);
	usize:comma = SelfCFindTokenAtDepthZero(program, fileIndex, genericStart + 1, genericEnd, PunctuationKind::Comma);
	usize:valueTypeStart = genericStart + 1;
	usize:valueTypeEnd = genericEnd;
	usize:valueNameIndex = genericStart + 1;
	bool:hasIndex = false;
	usize:indexTypeStart = genericStart + 1;
	usize:indexTypeEnd = genericStart + 1;
	usize:indexNameIndex = genericStart + 1;
	if (comma < genericEnd) {
		hasIndex = true;
		usize:indexColon = SelfCFindTopLevelColon(program, fileIndex, genericStart + 1, comma);
		indexTypeStart = genericStart + 1;
		indexTypeEnd = indexColon;
		indexNameIndex = indexColon + 1;
		usize:valueColon = SelfCFindTopLevelColon(program, fileIndex, comma + 1, genericEnd);
		valueTypeStart = comma + 1;
		valueTypeEnd = valueColon;
		valueNameIndex = valueColon + 1;
	} else {
		usize:valueColon = SelfCFindTopLevelColon(program, fileIndex, genericStart + 1, genericEnd);
		valueTypeStart = genericStart + 1;
		valueTypeEnd = valueColon;
		valueNameIndex = valueColon + 1;
	}
	SelfCTypeInfo:valueType;
	Status:status = SelfCRenderTypeInfo(program, fileIndex, valueTypeStart, valueTypeEnd, &valueType);
	if (status != Status::Ok) {
		return(status);
	}
	if (groupStart + 2 < groupEnd && SelfCIsIdentifierText(program, fileIndex, groupStart + 1, "range")) {
		usize:rangeGroup = groupStart + 4;
		while (rangeGroup < groupEnd && !SelfCIsPunctuation(program, fileIndex, rangeGroup, PunctuationKind::LeftParen)) {
			rangeGroup += 1;
		}
		usize:rangeEnd = SelfCFindMatching(program, fileIndex, rangeGroup);
		usize:firstComma = SelfCFindTokenAtDepthZero(program, fileIndex, rangeGroup + 1, rangeEnd, PunctuationKind::Comma);
		usize:secondComma = SelfCFindTokenAtDepthZero(program, fileIndex, firstComma + 1, rangeEnd, PunctuationKind::Comma);
		SelfCExpr:beginExpr;
		SelfCExpr:endExpr;
		SelfCExpr:stepExpr;
		status = SelfCCompileExpressionRange(program, env, fileIndex, rangeGroup + 1, firstComma, std::StringFromCString(""), std::StringFromCString(""), false, &beginExpr);
		usize:rangeValueEnd = rangeEnd;
		if (secondComma < rangeEnd) {
			rangeValueEnd = secondComma;
		}
		if (status == Status::Ok) {
			status = SelfCCompileExpressionRange(program, env, fileIndex, firstComma + 1, rangeValueEnd, std::StringFromCString(""), std::StringFromCString(""), false, &endExpr);
		}
		if (secondComma < rangeEnd) {
			if (status == Status::Ok) {
				status = SelfCCompileExpressionRange(program, env, fileIndex, secondComma + 1, rangeEnd, std::StringFromCString(""), std::StringFromCString(""), false, &stepExpr);
			}
		} else {
			if (status == Status::Ok) {
				SelfCExprInitEmpty(program, &stepExpr);
				status = SelfCExprSetCString(program, &stepExpr, "1");
			}
		}
		if (status == Status::Ok) {
			status = SelfCWriteIndent(out, indent);
		}
		if (status == Status::Ok) {
			status = out.WriteCString("for (");
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&valueType.cType));
		}
		if (status == Status::Ok) {
			status = out.WriteByte(' ');
		}
		if (status == Status::Ok) {
			status = SelfCWriteToken(program, out, fileIndex, valueNameIndex);
		}
		if (status == Status::Ok) {
			status = out.WriteByte('=');
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&beginExpr.text));
		}
		if (status == Status::Ok) {
			status = out.WriteByte(';');
		}
		if (status == Status::Ok) {
			status = SelfCWriteToken(program, out, fileIndex, valueNameIndex);
		}
		if (status == Status::Ok) {
			status = out.WriteByte('<');
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&endExpr.text));
		}
		if (status == Status::Ok) {
			status = out.WriteByte(';');
		}
		if (status == Status::Ok) {
			status = SelfCWriteToken(program, out, fileIndex, valueNameIndex);
		}
		if (status == Status::Ok) {
			status = out.WriteCString("+=");
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&stepExpr.text));
		}
		if (status == Status::Ok) {
			status = out.WriteCString(") {\n");
		}
		if (status == Status::Ok) {
			status = SelfCEnvAdd(program, env, SelfCTokenText(program, fileIndex, valueNameIndex), std::OwnedStringView(&valueType.key), std::OwnedStringView(&valueType.cType), false, std::StringFromCString(""), valueType.isPointer);
		}
		if (status == Status::Ok) {
			status = SelfCWriteBlock(program, out, env, fileIndex, blockStart + 1, blockEnd, indent + 1);
		}
		if (status == Status::Ok) {
			status = SelfCWriteIndent(out, indent);
		}
		if (status == Status::Ok) {
			status = out.WriteCString("}\n");
		}
		SelfCExprDestroy(&beginExpr);
		SelfCExprDestroy(&endExpr);
		SelfCExprDestroy(&stepExpr);
	} else {
		SelfCExpr:arrayExpr;
		status = SelfCCompileExpressionRange(program, env, fileIndex, groupStart + 1, groupEnd, std::StringFromCString(""), std::StringFromCString(""), false, &arrayExpr);
		if (status == Status::Ok) {
			status = SelfCWriteIndent(out, indent);
		}
		if (status == Status::Ok) {
			status = out.WriteCString("for (");
		}
		if (hasIndex) {
			SelfCTypeInfo:indexType;
			if (status == Status::Ok) {
				status = SelfCRenderTypeInfo(program, fileIndex, indexTypeStart, indexTypeEnd, &indexType);
			}
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&indexType.cType));
			}
			if (status == Status::Ok) {
				status = out.WriteByte(' ');
			}
			if (status == Status::Ok) {
				status = SelfCWriteToken(program, out, fileIndex, indexNameIndex);
			}
			if (status == Status::Ok) {
				status = out.WriteCString("=0;");
			}
			if (status == Status::Ok) {
				status = SelfCWriteToken(program, out, fileIndex, indexNameIndex);
			}
			if (status == Status::Ok) {
				status = out.WriteByte('<');
			}
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&arrayExpr.arrayLen));
			}
			if (status == Status::Ok) {
				status = out.WriteByte(';');
			}
			if (status == Status::Ok) {
				status = SelfCWriteToken(program, out, fileIndex, indexNameIndex);
			}
			if (status == Status::Ok) {
				status = out.WriteCString("++) {\n");
			}
			if (status == Status::Ok) {
				status = SelfCEnvAdd(program, env, SelfCTokenText(program, fileIndex, indexNameIndex), std::OwnedStringView(&indexType.key), std::OwnedStringView(&indexType.cType), false, std::StringFromCString(""), indexType.isPointer);
			}
			SelfCTypeInfoDestroy(&indexType);
		} else {
			if (status == Status::Ok) {
				status = out.WriteCString("usize __kek_each_idx=0;__kek_each_idx<");
			}
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&arrayExpr.arrayLen));
			}
			if (status == Status::Ok) {
				status = out.WriteCString(";__kek_each_idx++) {\n");
			}
		}
		if (status == Status::Ok) {
			status = SelfCWriteIndent(out, indent + 1);
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&valueType.cType));
		}
		if (status == Status::Ok) {
			status = out.WriteByte(' ');
		}
		if (status == Status::Ok) {
			status = SelfCWriteToken(program, out, fileIndex, valueNameIndex);
		}
		if (status == Status::Ok) {
			status = out.WriteByte('=');
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&arrayExpr.text));
		}
		if (status == Status::Ok) {
			status = out.WriteByte('[');
		}
		if (hasIndex) {
			if (status == Status::Ok) {
				status = SelfCWriteToken(program, out, fileIndex, indexNameIndex);
			}
		} else {
			if (status == Status::Ok) {
				status = out.WriteCString("__kek_each_idx");
			}
		}
		if (status == Status::Ok) {
			status = out.WriteCString("];\n");
		}
		if (status == Status::Ok) {
			status = SelfCEnvAdd(program, env, SelfCTokenText(program, fileIndex, valueNameIndex), std::OwnedStringView(&valueType.key), std::OwnedStringView(&valueType.cType), false, std::StringFromCString(""), valueType.isPointer);
		}
		if (status == Status::Ok) {
			status = SelfCWriteBlock(program, out, env, fileIndex, blockStart + 1, blockEnd, indent + 1);
		}
		if (status == Status::Ok) {
			status = SelfCWriteIndent(out, indent);
		}
		if (status == Status::Ok) {
			status = out.WriteCString("}\n");
		}
		SelfCExprDestroy(&arrayExpr);
	}
	SelfCTypeInfoDestroy(&valueType);
	outNext[0] = blockEnd + 1;
	return(status);
}

Status:SelfCWriteSwitchStatement(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCEnv>:env, usize:fileIndex, usize:start, ptr<usize>:outNext, usize:indent) {
	usize:groupStart = SelfCFindNextGroup(program, fileIndex, start, SelfCFileTokenCount(program, fileIndex));
	usize:groupEnd = SelfCFindMatching(program, fileIndex, groupStart);
	usize:blockStart = groupEnd + 1;
	usize:blockEnd = SelfCFindMatching(program, fileIndex, blockStart);
	SelfCExpr:value;
	Status:status = SelfCCompileExpressionRange(program, env, fileIndex, groupStart + 1, groupEnd, std::StringFromCString(""), std::StringFromCString(""), false, &value);
	if (status == Status::Ok) {
		status = SelfCWriteIndent(out, indent);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("switch (");
	}
	if (status == Status::Ok) {
		status = out.WriteString(std::OwnedStringView(&value.text));
	}
	if (status == Status::Ok) {
		status = out.WriteCString(") {\n");
	}
	SelfCExprDestroy(&value);
	usize:i = blockStart + 1;
	while (i < blockEnd && status == Status::Ok) {
		if (SelfCIsKeyword(program, fileIndex, i, KeywordKind::Case)) {
			usize:caseGroup = i + 1;
			usize:caseGroupEnd = SelfCFindMatching(program, fileIndex, caseGroup);
			SelfCExpr:caseExpr;
			status = SelfCCompileExpressionRange(program, env, fileIndex, caseGroup + 1, caseGroupEnd, std::StringFromCString(""), std::StringFromCString(""), false, &caseExpr);
			if (status == Status::Ok) {
				status = SelfCWriteIndent(out, indent + 1);
			}
			if (status == Status::Ok) {
				status = out.WriteCString("case ");
			}
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&caseExpr.text));
			}
			if (status == Status::Ok) {
				status = out.WriteCString(": ");
			}
			SelfCExprDestroy(&caseExpr);
			usize:caseBlock = caseGroupEnd + 1;
			if (caseBlock < blockEnd && SelfCIsPunctuation(program, fileIndex, caseBlock, PunctuationKind::Colon)) {
				caseBlock += 1;
			}
			if (caseBlock < blockEnd && SelfCIsPunctuation(program, fileIndex, caseBlock, PunctuationKind::LeftBrace)) {
				usize:caseBlockEnd = SelfCFindMatching(program, fileIndex, caseBlock);
				if (status == Status::Ok) {
					status = out.WriteCString("{\n");
				}
				if (status == Status::Ok) {
					status = SelfCWriteBlock(program, out, env, fileIndex, caseBlock + 1, caseBlockEnd, indent + 2);
				}
				if (status == Status::Ok) {
					status = SelfCWriteIndent(out, indent + 1);
				}
				if (status == Status::Ok) {
					status = out.WriteCString("}\n");
				}
				i = caseBlockEnd + 1;
			} else {
				usize:semicolon = SelfCFindStatementSemicolon(program, fileIndex, caseBlock, blockEnd);
				if (status == Status::Ok) {
					status = out.WriteCString("{\n");
				}
				if (status == Status::Ok) {
					status = SelfCWriteExprStatement(program, out, env, fileIndex, caseBlock, semicolon, indent + 2);
				}
				if (status == Status::Ok) {
					status = SelfCWriteIndent(out, indent + 1);
				}
				if (status == Status::Ok) {
					status = out.WriteCString("}\n");
				}
				i = semicolon + 1;
			}
			continue;
		}
		if (SelfCIsKeyword(program, fileIndex, i, KeywordKind::Default)) {
			status = SelfCWriteIndent(out, indent + 1);
			if (status == Status::Ok) {
				status = out.WriteCString("default: ");
			}
			usize:bodyStart = i + 1;
			if (bodyStart < blockEnd && SelfCIsPunctuation(program, fileIndex, bodyStart, PunctuationKind::Colon)) {
				bodyStart += 1;
			}
			if (bodyStart < blockEnd && SelfCIsPunctuation(program, fileIndex, bodyStart, PunctuationKind::LeftBrace)) {
				usize:bodyEnd = SelfCFindMatching(program, fileIndex, bodyStart);
				if (status == Status::Ok) {
					status = out.WriteCString("{\n");
				}
				if (status == Status::Ok) {
					status = SelfCWriteBlock(program, out, env, fileIndex, bodyStart + 1, bodyEnd, indent + 2);
				}
				if (status == Status::Ok) {
					status = SelfCWriteIndent(out, indent + 1);
				}
				if (status == Status::Ok) {
					status = out.WriteCString("}\n");
				}
				i = bodyEnd + 1;
			} else {
				usize:semicolon = SelfCFindStatementSemicolon(program, fileIndex, bodyStart, blockEnd);
				if (status == Status::Ok) {
					status = out.WriteCString("{\n");
				}
				if (status == Status::Ok) {
					status = SelfCWriteExprStatement(program, out, env, fileIndex, bodyStart, semicolon, indent + 2);
				}
				if (status == Status::Ok) {
					status = SelfCWriteIndent(out, indent + 1);
				}
				if (status == Status::Ok) {
					status = out.WriteCString("}\n");
				}
				i = semicolon + 1;
			}
			continue;
		}
		i += 1;
	}
	if (status == Status::Ok) {
		status = SelfCWriteIndent(out, indent);
	}
	if (status == Status::Ok) {
		status = out.WriteCString("}\n");
	}
	outNext[0] = blockEnd + 1;
	return(status);
}

Status:SelfCWriteReturnStatement(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCEnv>:env, usize:fileIndex, usize:start, usize:semicolon, usize:indent) {
	Status:status = SelfCWriteIndent(out, indent);
	if (status == Status::Ok) {
		status = out.WriteCString("return");
	}
	if (start + 1 < semicolon) {
		SelfCExpr:value;
		if (status == Status::Ok) {
			status = SelfCCompileExpressionRange(program, env, fileIndex, start + 1, semicolon, std::OwnedStringView(&env.returnTypeKey), std::OwnedStringView(&env.returnCType), false, &value);
		}
		if (status == Status::Ok) {
			status = out.WriteByte(' ');
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&value.text));
		}
		if (status == Status::Ok) {
			SelfCExprDestroy(&value);
		}
	}
	if (status == Status::Ok) {
		status = out.WriteCString(";\n");
	}
	return(status);
}

Status:SelfCWriteSingleStatement(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCEnv>:env, usize:fileIndex, usize:start, ptr<usize>:outNext, usize:indent) {
	if (SelfCIsPunctuation(program, fileIndex, start, PunctuationKind::LeftBrace)) {
		usize:blockEnd = SelfCFindMatching(program, fileIndex, start);
		Status:status = SelfCWriteIndent(out, indent);
		if (status == Status::Ok) {
			status = out.WriteCString("{\n");
		}
		if (status == Status::Ok) {
			status = SelfCWriteBlock(program, out, env, fileIndex, start + 1, blockEnd, indent + 1);
		}
		if (status == Status::Ok) {
			status = SelfCWriteIndent(out, indent);
		}
		if (status == Status::Ok) {
			status = out.WriteCString("}\n");
		}
		outNext[0] = blockEnd + 1;
		return(status);
	}
	if (SelfCIsKeyword(program, fileIndex, start, KeywordKind::If)) {
		return(SelfCWriteIfStatement(program, out, env, fileIndex, start, outNext, indent));
	}
	if (SelfCIsKeyword(program, fileIndex, start, KeywordKind::While)) {
		return(SelfCWriteWhileStatement(program, out, env, fileIndex, start, outNext, indent));
	}
	if (SelfCIsKeyword(program, fileIndex, start, KeywordKind::Do)) {
		return(SelfCWriteDoStatement(program, out, env, fileIndex, start, outNext, indent));
	}
	if (SelfCIsKeyword(program, fileIndex, start, KeywordKind::For)) {
		return(SelfCWriteForStatement(program, out, env, fileIndex, start, outNext, indent));
	}
	if (SelfCIsKeyword(program, fileIndex, start, KeywordKind::Each)) {
		return(SelfCWriteEachStatement(program, out, env, fileIndex, start, outNext, indent));
	}
	if (SelfCIsKeyword(program, fileIndex, start, KeywordKind::Switch)) {
		return(SelfCWriteSwitchStatement(program, out, env, fileIndex, start, outNext, indent));
	}
	usize:semicolon = SelfCFindStatementSemicolon(program, fileIndex, start, SelfCFileTokenCount(program, fileIndex));
	if (SelfCIsKeyword(program, fileIndex, start, KeywordKind::Return)) {
		outNext[0] = semicolon + 1;
		return(SelfCWriteReturnStatement(program, out, env, fileIndex, start, semicolon, indent));
	}
	if (SelfCIsKeyword(program, fileIndex, start, KeywordKind::Break)) {
		outNext[0] = semicolon + 1;
		Status:status = SelfCWriteIndent(out, indent);
		if (status == Status::Ok) {
			status = out.WriteCString("break;\n");
		}
		return(status);
	}
	if (SelfCIsKeyword(program, fileIndex, start, KeywordKind::Continue)) {
		outNext[0] = semicolon + 1;
		Status:status = SelfCWriteIndent(out, indent);
		if (status == Status::Ok) {
			status = out.WriteCString("continue;\n");
		}
		return(status);
	}
	if (SelfCIsKeyword(program, fileIndex, start, KeywordKind::Unreachable)) {
		outNext[0] = semicolon + 1;
		Status:status = SelfCWriteIndent(out, indent);
		if (status == Status::Ok) {
			status = out.WriteCString("__builtin_unreachable();\n");
		}
		return(status);
	}
	if (SelfCIsKeyword(program, fileIndex, start, KeywordKind::Panic)) {
		outNext[0] = semicolon + 1;
		usize:groupStart = start + 1;
		usize:groupEnd = SelfCFindMatching(program, fileIndex, groupStart);
		SelfCExpr:message;
		Status:status = SelfCCompileExpressionRange(program, env, fileIndex, groupStart + 1, groupEnd, std::StringFromCString(""), std::StringFromCString(""), false, &message);
		if (status == Status::Ok) {
			status = SelfCWriteIndent(out, indent);
		}
		if (status == Status::Ok) {
			status = out.WriteCString("do { fprintf(stderr, \"panic: %s\\n\", ");
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&message.text));
		}
		if (status == Status::Ok) {
			status = out.WriteCString("); abort(); } while(0);\n");
		}
		SelfCExprDestroy(&message);
		return(status);
	}
	if (SelfCIsKeyword(program, fileIndex, start, KeywordKind::Defer)) {
		outNext[0] = semicolon + 1;
		return(Status::Ok);
	}
	usize:colon = SelfCFindTopLevelColon(program, fileIndex, start, semicolon);
	if (colon < semicolon) {
		outNext[0] = semicolon + 1;
		return(SelfCWriteVarDecl(program, out, env, fileIndex, start, semicolon, indent));
	}
	outNext[0] = semicolon + 1;
	return(SelfCWriteExprStatement(program, out, env, fileIndex, start, semicolon, indent));
}

Status:SelfCWriteDeferred(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCEnv>:env, usize:fileIndex, usize:start, usize:end, usize:indent) {
	if (start >= end || !SelfCIsKeyword(program, fileIndex, start, KeywordKind::Defer)) {
		return(Status::Ok);
	}
	usize:body = start + 1;
	if (body < end && SelfCIsPunctuation(program, fileIndex, body, PunctuationKind::LeftBrace)) {
		usize:blockEnd = SelfCFindMatching(program, fileIndex, body);
		return(SelfCWriteBlock(program, out, env, fileIndex, body + 1, blockEnd, indent));
	}
	usize:semicolon = SelfCFindStatementSemicolon(program, fileIndex, body, end);
	return(SelfCWriteExprStatement(program, out, env, fileIndex, body, semicolon, indent));
}

Status:SelfCWriteBlock(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCEnv>:env, usize:fileIndex, usize:start, usize:end, usize:indent) {
	usize:deferStarts[64] = {0};
	usize:deferEnds[64] = {0};
	usize:deferCount = 0;
	usize:index = start;
	Status:status = Status::Ok;
	while (index < end && status == Status::Ok) {
		if (SelfCIsKeyword(program, fileIndex, index, KeywordKind::Defer)) {
			usize:deferEnd = index + 1;
			if (deferEnd < end && SelfCIsPunctuation(program, fileIndex, deferEnd, PunctuationKind::LeftBrace)) {
				deferEnd = SelfCFindMatching(program, fileIndex, deferEnd) + 1;
			} else {
				deferEnd = SelfCFindStatementSemicolon(program, fileIndex, deferEnd, end) + 1;
			}
			if (deferCount < len(deferStarts)) {
				deferStarts[deferCount] = index;
				deferEnds[deferCount] = deferEnd;
				deferCount += 1;
			}
			index = deferEnd;
			continue;
		}
		usize:next = index + 1;
		status = SelfCWriteSingleStatement(program, out, env, fileIndex, index, &next, indent);
		if (next <= index) {
			next = index + 1;
		}
		index = next;
	}
	while (deferCount > 0 && status == Status::Ok) {
		deferCount -= 1;
		status = SelfCWriteDeferred(program, out, env, fileIndex, deferStarts[deferCount], deferEnds[deferCount], indent);
	}
	return(status);
}

Status:SelfCFuncUseTempTypeUse(ptr<SelfCFuncUse>:funcUse, ptr<SelfCTypeUse>:out) {
	out.key = funcUse.key;
	out.cName = funcUse.cName;
	out.baseName = funcUse.key;
	out.arg0 = funcUse.arg0;
	out.arg1 = funcUse.arg1;
	out.arg2 = funcUse.arg2;
	out.argCount = funcUse.argCount;
	out.emitted = false;
	return(Status::Ok);
}

Status:SelfCWriteSubstTypeForFunc(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCDecl>:decl, ptr<SelfCFuncUse>:funcUse, usize:fileIndex, usize:start, usize:end) {
	SelfCTypeUse:temp;
	SelfCFuncUseTempTypeUse(funcUse, &temp);
	String:firstTypeToken = SelfCTokenText(program, fileIndex, start);
	if (start < end && firstTypeToken.EqualsCString("ptr") && start + 1 < end && SelfCIsOperator(program, fileIndex, start + 1, OperatorKind::Less)) {
		usize:genericEnd = SelfCFindMatching(program, fileIndex, start + 1);
		OwnedString:innerKey;
		Status:innerStatus = SelfCMakeSubstTypeKey(program, decl, &temp, fileIndex, start + 2, genericEnd, &innerKey);
		if (innerStatus == Status::Ok) {
			innerStatus = SelfCWriteCTypeFromKey(program, out, std::OwnedStringView(&innerKey));
		}
		if (innerStatus == Status::Ok) {
			innerStatus = out.WriteByte('*');
		}
		std::DestroyOwnedString(&innerKey);
		return(innerStatus);
	}
	OwnedString:key;
	Status:status = SelfCMakeSubstTypeKey(program, decl, &temp, fileIndex, start, end, &key);
	if (status == Status::Ok) {
		status = SelfCWriteCTypeFromKey(program, out, std::OwnedStringView(&key));
	}
	if (status == Status::Ok) {
		std::DestroyOwnedString(&key);
	}
	return(status);
}

Status:SelfCWriteFunctionSignature(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCDecl>:decl, String:nameOverride, ptr<SelfCFuncUse>:funcUse) {
	String:functionName = SelfCTokenText(program, decl.fileIndex, decl.nameIndex);
	bool:isMain = !decl.hasReceiver && functionName.EqualsCString("main") && SelfCDeclPackageIsRoot(decl);
	Status:status = Status::Ok;
	if (isMain) {
		status = out.WriteCString("int");
	} else {
		if (funcUse != 0) {
			status = SelfCWriteSubstTypeForFunc(program, out, decl, funcUse, decl.fileIndex, decl.returnStart, decl.returnEnd);
		} else {
			SelfCTypeInfo:returnInfo;
			status = SelfCRenderTypeInfo(program, decl.fileIndex, decl.returnStart, decl.returnEnd, &returnInfo);
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&returnInfo.cType));
			}
			if (status == Status::Ok) {
				SelfCTypeInfoDestroy(&returnInfo);
			}
		}
	}
	if (status == Status::Ok) {
		status = out.WriteByte(' ');
	}
	if (status == Status::Ok) {
		if (nameOverride.len > 0) {
			status = out.WriteString(nameOverride);
		} else {
			status = SelfCWriteDeclCName(program, out, decl);
		}
	}
	if (status == Status::Ok) {
		status = out.WriteByte('(');
	}
	bool:first = true;
	if (decl.hasReceiver) {
		if (funcUse != 0) {
			status = SelfCWriteSubstTypeForFunc(program, out, decl, funcUse, decl.fileIndex, decl.receiverStart, decl.receiverEnd);
		} else {
			SelfCTypeInfo:receiverInfo;
			if (status == Status::Ok) {
				status = SelfCRenderTypeInfo(program, decl.fileIndex, decl.receiverStart, decl.receiverEnd, &receiverInfo);
			}
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&receiverInfo.cType));
			}
			if (status == Status::Ok) {
				SelfCTypeInfoDestroy(&receiverInfo);
			}
		}
		if (status == Status::Ok) {
			status = out.WriteCString("* this");
		}
		first = false;
	}
	for (usize:i = 0; i < decl.paramCount; i++) {
		ptr<SelfCParam>:param = &program.params[decl.firstParam + i];
		if (!first && status == Status::Ok) {
			status = out.WriteByte(',');
		}
		if (funcUse != 0) {
			if (status == Status::Ok) {
				status = SelfCWriteSubstTypeForFunc(program, out, decl, funcUse, param.fileIndex, param.typeStart, param.typeEnd);
			}
		} else {
			SelfCTypeInfo:paramInfo;
			if (status == Status::Ok) {
				status = SelfCRenderTypeInfo(program, param.fileIndex, param.typeStart, param.typeEnd, &paramInfo);
			}
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&paramInfo.cType));
			}
			if (status == Status::Ok) {
				SelfCTypeInfoDestroy(&paramInfo);
			}
		}
		if (status == Status::Ok) {
			status = out.WriteByte(' ');
		}
		if (status == Status::Ok) {
			status = SelfCWriteToken(program, out, param.fileIndex, param.nameIndex);
		}
		first = false;
	}
	if (first && status == Status::Ok) {
		status = out.WriteCString("void");
	}
	if (status == Status::Ok) {
		status = out.WriteByte(')');
	}
	return(status);
}

Status:SelfCWriteFunctionPrototype(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCDecl>:decl) {
	Status:status = SelfCWriteFunctionSignature(program, out, decl, std::StringFromCString(""), 0);
	if (status == Status::Ok) {
		status = out.WriteCString(";\n");
	}
	return(status);
}

Status:SelfCWriteFunctionBody(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCDecl>:decl) {
	Status:status = SelfCWriteFunctionSignature(program, out, decl, std::StringFromCString(""), 0);
	if (status == Status::Ok) {
		status = out.WriteCString(" {\n");
	}
	SelfCEnv:env;
	if (status == Status::Ok) {
		status = SelfCEnvInit(program, &env);
	}
	SelfCTypeInfo:returnInfo;
	if (status == Status::Ok) {
		status = SelfCRenderTypeInfo(program, decl.fileIndex, decl.returnStart, decl.returnEnd, &returnInfo);
	}
	if (status == Status::Ok) {
		SelfCReplaceOwned(&env.returnTypeKey, returnInfo.key);
		SelfCReplaceOwned(&env.returnCType, returnInfo.cType);
		returnInfo.key.data = 0;
		returnInfo.cType.data = 0;
	}
	if (decl.hasReceiver && status == Status::Ok) {
		SelfCTypeInfo:receiverInfo;
		status = SelfCRenderTypeInfo(program, decl.fileIndex, decl.receiverStart, decl.receiverEnd, &receiverInfo);
		if (status == Status::Ok) {
			env.hasThis = true;
			SelfCReplaceOwned(&env.thisTypeKey, receiverInfo.key);
			SelfCReplaceOwned(&env.thisCType, receiverInfo.cType);
			receiverInfo.key.data = 0;
			receiverInfo.cType.data = 0;
			status = SelfCEnvAdd(program, &env, std::StringFromCString("this"), std::OwnedStringView(&env.thisTypeKey), std::OwnedStringView(&env.thisCType), false, std::StringFromCString(""), true);
		}
		SelfCTypeInfoDestroy(&receiverInfo);
	}
	for (usize:i = 0; i < decl.paramCount && status == Status::Ok; i++) {
		ptr<SelfCParam>:param = &program.params[decl.firstParam + i];
		SelfCTypeInfo:paramInfo;
		status = SelfCRenderTypeInfo(program, param.fileIndex, param.typeStart, param.typeEnd, &paramInfo);
		if (status == Status::Ok) {
			status = SelfCEnvAdd(program, &env, SelfCTokenText(program, param.fileIndex, param.nameIndex), std::OwnedStringView(&paramInfo.key), std::OwnedStringView(&paramInfo.cType), false, std::StringFromCString(""), paramInfo.isPointer);
		}
		SelfCTypeInfoDestroy(&paramInfo);
	}
	SelfCTypeInfoDestroy(&returnInfo);
	if (status == Status::Ok) {
		status = SelfCWriteBlock(program, out, &env, decl.fileIndex, decl.bodyStart, decl.bodyEnd, 1);
	}
	SelfCEnvDestroy(&env);
	if (status == Status::Ok) {
		status = out.WriteCString("}\n");
	}
	return(status);
}

Status:SelfCWriteManualLine(ptr<StringBuilder>:out, str:text) {
	Status:status = out.WriteCString(text);
	if (status == Status::Ok) {
		status = out.WriteByte('\n');
	}
	return(status);
}

Status:SelfCWriteArrayMethodRef(ptr<StringBuilder>:out, ptr<SelfCFuncUse>:use, str:name) {
	Status:status = out.WriteCString("Array__");
	if (status == Status::Ok) { status = out.WriteString(std::OwnedStringView(&use.arg0)); }
	if (status == Status::Ok) { status = out.WriteByte('_'); }
	if (status == Status::Ok) { status = out.WriteCString(name); }
	return(status);
}

Status:SelfCWriteLinkedListMethodRef(ptr<StringBuilder>:out, ptr<SelfCFuncUse>:use, str:name) {
	Status:status = out.WriteCString("LinkedList__");
	if (status == Status::Ok) { status = out.WriteString(std::OwnedStringView(&use.arg0)); }
	if (status == Status::Ok) { status = out.WriteByte('_'); }
	if (status == Status::Ok) { status = out.WriteCString(name); }
	return(status);
}

Status:SelfCWriteResultTypeRef(ptr<StringBuilder>:out, ptr<SelfCFuncUse>:use) {
	Status:status = out.WriteCString("struct Result__");
	if (status == Status::Ok) { status = out.WriteString(std::OwnedStringView(&use.arg0)); }
	return(status);
}

Status:SelfCWriteListNodeTypeRef(ptr<StringBuilder>:out, ptr<SelfCFuncUse>:use) {
	Status:status = out.WriteCString("struct ListNode__");
	if (status == Status::Ok) { status = out.WriteString(std::OwnedStringView(&use.arg0)); }
	return(status);
}

Status:SelfCWriteManualArrayGenericBody(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCDecl>:decl, ptr<SelfCFuncUse>:use, String:argC) {
	String:name = SelfCTokenText(program, decl.fileIndex, decl.nameIndex);
	Status:status = Status::Ok;
	if (name.EqualsCString("Destroy")) {
		status = SelfCWriteManualLine(out, "    if(this->data!=0){");
		if (status == Status::Ok) { status = SelfCWriteManualLine(out, "        kek_std_free(this->data);"); }
		if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    }"); }
		if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    this->data=0;"); }
		if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    this->len=0;"); }
		if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    this->cap=0;"); }
		if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    return Status_Ok;"); }
	} else {
		if (name.EqualsCString("Clear")) {
			status = SelfCWriteManualLine(out, "    this->len=0;");
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    return Status_Ok;"); }
		} else {
			if (name.EqualsCString("Reserve")) {
				status = SelfCWriteManualLine(out, "    usize needed=this->len+additional;");
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    if(needed<=this->cap){return Status_Ok;}"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    usize newCap=this->cap;"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    if(newCap==0){newCap=8;}"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    while(newCap<needed){newCap=newCap*2;}"); }
				if (status == Status::Ok) { status = out.WriteCString("    "); }
				if (status == Status::Ok) { status = out.WriteString(argC); }
				if (status == Status::Ok) { status = out.WriteCString("* newData=("); }
				if (status == Status::Ok) { status = out.WriteString(argC); }
				if (status == Status::Ok) { status = out.WriteCString("*)kek_std_resize("); }
				if (status == Status::Ok) { status = out.WriteByte('\n'); }
				if (status == Status::Ok) { status = out.WriteCString("        this->data,newCap*sizeof("); }
				if (status == Status::Ok) { status = out.WriteString(argC); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "));"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    if(newData==0){return Status_NoMemory;}"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    this->data=newData;"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    this->cap=newCap;"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    return Status_Ok;"); }
			} else {
				if (name.EqualsCString("AppendSlice")) {
					status = out.WriteCString("    Status status=");
					if (status == Status::Ok) { status = SelfCWriteArrayMethodRef(out, use, "Reserve"); }
					if (status == Status::Ok) { status = SelfCWriteManualLine(out, "(this,items.len);"); }
					if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    if(status!=Status_Ok){return status;}"); }
					if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    for(usize i=0;i<items.len;i++){"); }
					if (status == Status::Ok) { status = SelfCWriteManualLine(out, "        this->data[this->len+i]=items.data[i];"); }
					if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    }"); }
					if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    this->len+=items.len;"); }
					if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    return Status_Ok;"); }
				} else {
					if (name.EqualsCString("Push")) {
						status = out.WriteCString("    Status status=");
						if (status == Status::Ok) { status = SelfCWriteArrayMethodRef(out, use, "Reserve"); }
						if (status == Status::Ok) { status = SelfCWriteManualLine(out, "(this,1);"); }
						if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    if(status!=Status_Ok){return status;}"); }
						if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    this->data[this->len]=value;"); }
						if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    this->len+=1;"); }
						if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    return Status_Ok;"); }
					} else {
						if (name.EqualsCString("PushZeroed")) {
							status = out.WriteCString("    Status status=");
							if (status == Status::Ok) { status = SelfCWriteArrayMethodRef(out, use, "Reserve"); }
							if (status == Status::Ok) { status = SelfCWriteManualLine(out, "(this,1);"); }
							if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    if(status!=Status_Ok){return status;}"); }
							if (status == Status::Ok) { status = out.WriteCString("    kek_std_mem_set((void*)(&this->data[this->len]),0,sizeof("); }
							if (status == Status::Ok) { status = out.WriteString(argC); }
							if (status == Status::Ok) { status = SelfCWriteManualLine(out, "));"); }
							if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    this->len+=1;"); }
							if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    return Status_Ok;"); }
						} else {
							if (name.EqualsCString("Pop")) {
								status = out.WriteCString("    ");
								if (status == Status::Ok) { status = SelfCWriteResultTypeRef(out, use); }
								if (status == Status::Ok) { status = SelfCWriteManualLine(out, " result={0};"); }
								if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    if(this->len==0){result.status=Status_End;return result;}"); }
								if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    this->len-=1;"); }
								if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    result.status=Status_Ok;"); }
								if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    result.value=this->data[this->len];"); }
								if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    return result;"); }
							} else {
								if (name.EqualsCString("Get")) {
									status = out.WriteCString("    ");
									if (status == Status::Ok) { status = SelfCWriteResultTypeRef(out, use); }
									if (status == Status::Ok) { status = SelfCWriteManualLine(out, " result={0};"); }
									if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    if(index>=this->len){result.status=Status_Invalid;return result;}"); }
									if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    result.status=Status_Ok;"); }
									if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    result.value=this->data[index];"); }
									if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    return result;"); }
								} else {
									if (name.EqualsCString("Set")) {
										status = SelfCWriteManualLine(out, "    if(index>=this->len){return Status_Invalid;}");
										if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    this->data[index]=value;"); }
										if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    return Status_Ok;"); }
									} else {
										if (name.EqualsCString("GetPtr")) {
											status = SelfCWriteManualLine(out, "    if(index>=this->len){return 0;}");
											if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    return &this->data[index];"); }
										} else {
											if (name.EqualsCString("LastPtr")) {
												status = SelfCWriteManualLine(out, "    if(this->len==0){return 0;}");
												if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    return &this->data[this->len-1];"); }
											} else {
												if (name.EqualsCString("Span")) {
													status = out.WriteCString("    struct Span__");
													if (status == Status::Ok) { status = out.WriteString(std::OwnedStringView(&use.arg0)); }
													if (status == Status::Ok) { status = SelfCWriteManualLine(out, " out={0};"); }
													if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    out.data=this->data;"); }
													if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    out.len=this->len;"); }
													if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    return out;"); }
												} else {
													if (name.EqualsCString("Slice")) {
														status = out.WriteCString("    struct Slice__");
														if (status == Status::Ok) { status = out.WriteString(std::OwnedStringView(&use.arg0)); }
														if (status == Status::Ok) { status = SelfCWriteManualLine(out, " out={0};"); }
														if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    out.data=this->data;"); }
														if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    out.len=this->len;"); }
														if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    return out;"); }
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
	return(status);
}

Status:SelfCWriteManualLinkedListGenericBody(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCDecl>:decl, ptr<SelfCFuncUse>:use) {
	String:name = SelfCTokenText(program, decl.fileIndex, decl.nameIndex);
	Status:status = Status::Ok;
	if (name.EqualsCString("PushBack") || name.EqualsCString("PushFront")) {
		status = out.WriteCString("    ");
		if (status == Status::Ok) { status = SelfCWriteListNodeTypeRef(out, use); }
		if (status == Status::Ok) { status = out.WriteCString("* node=("); }
		if (status == Status::Ok) { status = SelfCWriteListNodeTypeRef(out, use); }
		if (status == Status::Ok) { status = SelfCWriteManualLine(out, "*)kek_std_alloc("); }
		if (status == Status::Ok) { status = out.WriteCString("        sizeof("); }
		if (status == Status::Ok) { status = SelfCWriteListNodeTypeRef(out, use); }
		if (status == Status::Ok) { status = SelfCWriteManualLine(out, "));"); }
		if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    if(node==0){return Status_NoMemory;}"); }
		if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    node->value=value;"); }
		if (name.EqualsCString("PushBack")) {
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    node->next=0;"); }
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    node->prev=this->last;"); }
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    if(this->last!=0){"); }
			if (status == Status::Ok) { status = out.WriteCString("        "); }
			if (status == Status::Ok) { status = SelfCWriteListNodeTypeRef(out, use); }
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, "* last=this->last;"); }
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, "        last->next=node;"); }
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    }else{"); }
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, "        this->first=node;"); }
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    }"); }
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    this->last=node;"); }
		} else {
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    node->prev=0;"); }
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    node->next=this->first;"); }
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    if(this->first!=0){"); }
			if (status == Status::Ok) { status = out.WriteCString("        "); }
			if (status == Status::Ok) { status = SelfCWriteListNodeTypeRef(out, use); }
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, "* first=this->first;"); }
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, "        first->prev=node;"); }
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    }else{"); }
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, "        this->last=node;"); }
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    }"); }
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    this->first=node;"); }
		}
		if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    this->len+=1;"); }
		if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    return Status_Ok;"); }
	} else {
		if (name.EqualsCString("PopBack") || name.EqualsCString("PopFront")) {
			status = out.WriteCString("    ");
			if (status == Status::Ok) { status = SelfCWriteResultTypeRef(out, use); }
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, " result={0};"); }
			if (name.EqualsCString("PopBack")) {
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    if(this->last==0){result.status=Status_End;return result;}"); }
				if (status == Status::Ok) { status = out.WriteCString("    "); }
				if (status == Status::Ok) { status = SelfCWriteListNodeTypeRef(out, use); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "* node=this->last;"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    result.value=node->value;"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    this->last=node->prev;"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    if(this->last!=0){"); }
				if (status == Status::Ok) { status = out.WriteCString("        "); }
				if (status == Status::Ok) { status = SelfCWriteListNodeTypeRef(out, use); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "* last=this->last;"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "        last->next=0;"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    }else{"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "        this->first=0;"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    }"); }
			} else {
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    if(this->first==0){result.status=Status_End;return result;}"); }
				if (status == Status::Ok) { status = out.WriteCString("    "); }
				if (status == Status::Ok) { status = SelfCWriteListNodeTypeRef(out, use); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "* node=this->first;"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    result.value=node->value;"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    this->first=node->next;"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    if(this->first!=0){"); }
				if (status == Status::Ok) { status = out.WriteCString("        "); }
				if (status == Status::Ok) { status = SelfCWriteListNodeTypeRef(out, use); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "* first=this->first;"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "        first->prev=0;"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    }else{"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "        this->last=0;"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    }"); }
			}
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    this->len-=1;"); }
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    kek_std_free(node);"); }
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    result.status=Status_Ok;"); }
			if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    return result;"); }
		} else {
			if (name.EqualsCString("Destroy")) {
				status = SelfCWriteManualLine(out, "    while(this->len>0){");
				if (status == Status::Ok) { status = out.WriteCString("        "); }
				if (status == Status::Ok) { status = SelfCWriteResultTypeRef(out, use); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, " ignored={0};"); }
				if (status == Status::Ok) { status = out.WriteCString("        ignored="); }
				if (status == Status::Ok) { status = SelfCWriteLinkedListMethodRef(out, use, "PopBack"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "(this);"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "        if(ignored.status!=Status_Ok){return ignored.status;}"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    }"); }
				if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    return Status_Ok;"); }
			}
		}
	}
	return(status);
}

Status:SelfCWriteManualGenericBody(ptr<SelfCProgram>:program, ptr<StringBuilder>:out, ptr<SelfCDecl>:decl, ptr<SelfCFuncUse>:use) {
	String:name = SelfCTokenText(program, decl.fileIndex, decl.nameIndex);
	OwnedString:argC;
	Status:status = SelfCMakeCTypeFromKey(program, std::OwnedStringView(&use.arg0), &argC);
	if (status != Status::Ok) {
		return(status);
	}
	status = SelfCWriteFunctionSignature(program, out, decl, std::OwnedStringView(&use.cName), use);
	if (status == Status::Ok) {
		status = out.WriteCString(" {\n");
	}
	bool:handled = false;
	if (decl.hasReceiver && status == Status::Ok) {
		String:receiverBase = SelfCTokenText(program, decl.fileIndex, decl.receiverStart);
		if (receiverBase.EqualsCString("Array")) {
			status = SelfCWriteManualArrayGenericBody(program, out, decl, use, std::OwnedStringView(&argC));
			handled = true;
		} else {
			if (receiverBase.EqualsCString("LinkedList")) {
				status = SelfCWriteManualLinkedListGenericBody(program, out, decl, use);
				handled = true;
			}
		}
	}
	if (!handled && name.EqualsCString("FixedSlice")) {
		if (status == Status::Ok) {
			status = out.WriteCString("    struct Slice__");
		}
		if (status == Status::Ok) {
			status = out.WriteString(std::OwnedStringView(&use.arg0));
		}
		if (status == Status::Ok) {
			status = out.WriteCString(" out={0};\n    out.data=data;\n    out.len=len;\n    return out;\n");
		}
	} else {
		if (name.EqualsCString("FixedSpan")) {
			if (status == Status::Ok) {
				status = out.WriteCString("    struct Span__");
			}
			if (status == Status::Ok) {
				status = out.WriteString(std::OwnedStringView(&use.arg0));
			}
			if (status == Status::Ok) {
				status = out.WriteCString(" out={0};\n    out.data=data;\n    out.len=len;\n    return out;\n");
			}
		} else {
				if (name.EqualsCString("ArrayNew")) {
					if (status == Status::Ok) { status = out.WriteCString("    struct Array__"); }
					if (status == Status::Ok) { status = out.WriteString(std::OwnedStringView(&use.arg0)); }
					if (status == Status::Ok) { status = SelfCWriteManualLine(out, " array={0};"); }
					if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    array.allocator=allocator;"); }
					if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    return array;"); }
				} else {
					if (name.EqualsCString("LinkedListNew")) {
						if (status == Status::Ok) { status = out.WriteCString("    struct LinkedList__"); }
						if (status == Status::Ok) { status = out.WriteString(std::OwnedStringView(&use.arg0)); }
						if (status == Status::Ok) { status = SelfCWriteManualLine(out, " list={0};"); }
						if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    list.allocator=allocator;"); }
						if (status == Status::Ok) { status = SelfCWriteManualLine(out, "    return list;"); }
					} else {
			if (name.EqualsCString("Alloc")) {
				if (status == Status::Ok) {
					status = out.WriteCString("    (void)allocator;\n");
				}
				if (status == Status::Ok) {
					status = out.WriteCString("    return (");
				}
				if (status == Status::Ok) {
					status = out.WriteString(std::OwnedStringView(&argC));
				}
				if (status == Status::Ok) {
					status = out.WriteCString("*)kek_std_alloc(count*sizeof(");
				}
				if (status == Status::Ok) {
					status = out.WriteString(std::OwnedStringView(&argC));
				}
				if (status == Status::Ok) {
					status = out.WriteCString("));\n");
				}
			} else {
				if (name.EqualsCString("Resize")) {
					if (status == Status::Ok) {
						status = out.WriteCString("    (void)allocator;\n    (void)oldCount;\n");
					}
					if (status == Status::Ok) {
						status = out.WriteCString("    return (");
					}
					if (status == Status::Ok) {
						status = out.WriteString(std::OwnedStringView(&argC));
					}
					if (status == Status::Ok) {
						status = out.WriteCString("*)kek_std_resize(oldData,newCount*sizeof(");
					}
					if (status == Status::Ok) {
						status = out.WriteString(std::OwnedStringView(&argC));
					}
					if (status == Status::Ok) {
						status = out.WriteCString("));\n");
					}
				} else {
					if (name.EqualsCString("Free")) {
						if (status == Status::Ok) {
							status = out.WriteCString("    (void)allocator;\n    (void)count;\n    kek_std_free(data);\n");
						}
					} else {
						if (name.EqualsCString("Copy")) {
							if (status == Status::Ok) {
								status = out.WriteCString("    kek_std_mem_copy(dest,src,count*sizeof(");
							}
							if (status == Status::Ok) {
								status = out.WriteString(std::OwnedStringView(&argC));
							}
							if (status == Status::Ok) {
								status = out.WriteCString("));\n");
							}
						} else {
							if (name.EqualsCString("GenericAdd")) {
								if (status == Status::Ok) {
									status = out.WriteCString("    return left+right;\n");
								}
							} else {
								if (name.EqualsCString("PkgGenericEcho")) {
									if (status == Status::Ok) {
										status = out.WriteCString("    return value;\n");
									}
								} else {
									if (name.EqualsCString("Ok")) {
										if (status == Status::Ok) {
											status = out.WriteCString("    struct Result__");
										}
										if (status == Status::Ok) {
											status = out.WriteString(std::OwnedStringView(&use.arg0));
										}
										if (status == Status::Ok) {
											status = out.WriteCString(" out={0};\n    out.status=Status_Ok;\n    out.value=value;\n    return out;\n");
										}
									} else {
										if (name.EqualsCString("Err")) {
											if (status == Status::Ok) {
												status = out.WriteCString("    struct Result__");
											}
											if (status == Status::Ok) {
												status = out.WriteString(std::OwnedStringView(&use.arg0));
											}
											if (status == Status::Ok) {
												status = out.WriteCString(" out={0};\n    out.status=status;\n    return out;\n");
											}
										}
									}
								}
							}
						}
					}
				}
			}
				}
			}
		}
	}
	if (status == Status::Ok) {
		status = out.WriteCString("}\n");
	}
	std::DestroyOwnedString(&argC);
	return(status);
}

Status:SelfCWriteFunctionDeclarations(ptr<SelfCProgram>:program, ptr<StringBuilder>:out) {
	for (usize:i = 0; i < program.declCount; i++) {
		ptr<SelfCDecl>:decl = &program.decls[i];
		if (decl.kind == SelfCDeclKind::Function && !decl.isGeneric) {
			Status:status = SelfCWriteFunctionPrototype(program, out, decl);
			if (status != Status::Ok) {
				return(status);
			}
		}
	}
	for (usize:i = 0; i < program.funcUseCount; i++) {
		ptr<SelfCFuncUse>:use = &program.funcUses[i];
		if (use.declIndex < program.declCount) {
			Status:status = SelfCWriteFunctionSignature(program, out, &program.decls[use.declIndex], std::OwnedStringView(&use.cName), use);
			if (status == Status::Ok) {
				status = out.WriteCString(";\n");
			}
			if (status != Status::Ok) {
				return(status);
			}
		}
	}
	return(Status::Ok);
}

Status:SelfCWriteFunctionDefinitions(ptr<SelfCProgram>:program, ptr<StringBuilder>:out) {
	for (usize:i = 0; i < program.funcUseCount; i++) {
		ptr<SelfCFuncUse>:use = &program.funcUses[i];
		if (use.declIndex < program.declCount) {
			Status:status = SelfCWriteManualGenericBody(program, out, &program.decls[use.declIndex], use);
			if (status != Status::Ok) {
				return(status);
			}
		}
	}
	for (usize:i = 0; i < program.declCount; i++) {
		ptr<SelfCDecl>:decl = &program.decls[i];
		if (decl.kind == SelfCDeclKind::Function && !decl.isGeneric && decl.hasBody) {
			Status:status = SelfCWriteFunctionBody(program, out, decl);
			if (status != Status::Ok) {
				return(status);
			}
		}
	}
	return(Status::Ok);
}

Status:SelfCWriteProgram(ptr<SelfCProgram>:program, ptr<StringBuilder>:out) {
	Status:status = SelfCWritePrelude(out);
	if (status == Status::Ok) {
		status = SelfCWriteTypeDeclarations(program, out);
	}
	if (status == Status::Ok) {
		status = out.WriteByte('\n');
	}
	if (status == Status::Ok) {
		status = SelfCWriteFunctionDeclarations(program, out);
	}
	if (status == Status::Ok) {
		status = out.WriteByte('\n');
	}
	if (status == Status::Ok) {
		status = SelfCWriteFunctionDefinitions(program, out);
	}
	return(status);
}

Status:SelfCompileToCString(str:inputPath, Allocator:allocator, ptr<StringBuilder>:out, ptr<SelfDiagnosticBag>:diagnostics) {
	SelfCProgram:program;
	Status:status = SelfCProgramInit(&program, allocator);
	if (status != Status::Ok) {
		return(status);
	}
	status = SelfCLoadAndTokenize(&program, inputPath);
	if (status == Status::Ok) {
		status = SelfCParseDeclarations(&program);
	}
	if (status == Status::Ok) {
		status = SelfCCollectTypeUses(&program);
	}
	if (status == Status::Ok) {
		status = SelfCCollectGenericFunctionUses(&program);
	}
	if (status == Status::Ok) {
		status = SelfCWriteProgram(&program, out);
	}
	if (program.diagnostics.count > 0) {
		for (usize:i = 0; i < program.diagnostics.count && diagnostics.count < len(diagnostics.items); i++) {
			ptr<SelfDiagnostic>:item = &program.diagnostics.items[i];
			diagnostics::SelfDiagnosticAdd(diagnostics, item.severity, item.phase, item.fileIndex, item.location, std::OwnedStringView(&item.message));
		}
	}
	SelfCProgramDestroy(&program);
	return(status);
}

Status:SelfCompileToC(str:inputPath, str:outputPath, Allocator:allocator, ptr<SelfDiagnosticBag>:diagnostics) {
	StringBuilder:generated = std::StringBuilderNew(allocator);
	Status:status = SelfCompileToCString(inputPath, allocator, &generated, diagnostics);
	if (status == Status::Ok) {
		String:view = generated.View();
		status = std::WriteFile(outputPath, view);
	}
	generated.Destroy();
	return(status);
}

Status:SelfCompileToCStringWithoutDiagnostics(str:inputPath, Allocator:allocator, ptr<StringBuilder>:out) {
	SelfDiagnosticBag:diagnostics;
	diagnostics::SelfDiagnosticBagInit(&diagnostics, allocator);
	Status:status = SelfCompileToCString(inputPath, allocator, out, &diagnostics);
	diagnostics::SelfDiagnosticBagDestroy(&diagnostics);
	return(status);
}

Status:SelfWriteCompileDiagnostics(str:inputPath, Allocator:allocator, ptr<StringBuilder>:out) {
	StringBuilder:generated = std::StringBuilderNew(allocator);
	SelfDiagnosticBag:diagnostics;
	diagnostics::SelfDiagnosticBagInit(&diagnostics, allocator);
	Status:status = SelfCompileToCString(inputPath, allocator, &generated, &diagnostics);
	Status:writeStatus = Status::Ok;
	if (diagnostics.count > 0) {
		writeStatus = diagnostics::SelfWriteDiagnosticDump(&diagnostics, out);
	} else {
		if (status != Status::Ok) {
			writeStatus = out.WriteCString("diag|2|4|-1|0|0|0|0|compile failed\n");
		}
	}
	generated.Destroy();
	diagnostics::SelfDiagnosticBagDestroy(&diagnostics);
	if (writeStatus != Status::Ok) {
		return(writeStatus);
	}
	return(Status::Ok);
}

Status:SelfCompilerRunBuild(str:inputPath, str:outputPath) {
	Allocator:allocator = std::DefaultAllocator();
	SelfDiagnosticBag:diagnostics;
	diagnostics::SelfDiagnosticBagInit(&diagnostics, allocator);
	Status:status = SelfCompileToC(inputPath, outputPath, allocator, &diagnostics);
	if (diagnostics.count > 0) {
		StringBuilder:dump = std::StringBuilderNew(allocator);
		diagnostics::SelfWriteDiagnosticDump(&diagnostics, &dump);
		File:stderr = std::Stderr();
		String:view = dump.View();
		stderr.Write(view.Bytes());
		dump.Destroy();
	}
	diagnostics::SelfDiagnosticBagDestroy(&diagnostics);
	return(status);
}

int:SelfCompilerMain(int:argc, ptr<str>:argv) {
	if (argc < 2) {
		return(SelfCompilerFail("missing command\n"));
	}
	String:command = std::StringFromCString(argv[1]);
	if (command.EqualsCString("--help")) {
		return(SelfCompilerPrintHelp());
	}
	if (command.EqualsCString("--version")) {
		File:stdout = std::Stdout();
		std::WriteStringToFile(&stdout, std::StringFromCString("0.3.0-self\n"));
		return(0);
	}
	if (!command.EqualsCString("build")) {
		return(SelfCompilerFail("unknown command\n"));
	}
	if (argc < 3) {
		return(SelfCompilerFail("missing input\n"));
	}
	str:inputPath = argv[2];
	str:outputPath = "out.kek.c";
	usize:i = 3;
	while (i < cast<usize>(argc)) {
		String:arg = std::StringFromCString(argv[i]);
		if (arg.EqualsCString("-o")) {
			if (i + 1 >= cast<usize>(argc)) {
				return(SelfCompilerFail("missing -o value\n"));
			}
			outputPath = argv[i + 1];
			i += 2;
			continue;
		}
		return(SelfCompilerFail("unknown build option\n"));
	}
	Status:status = SelfCompilerRunBuild(inputPath, outputPath);
	if (status != Status::Ok) {
		return(SelfCompilerFail("build failed\n"));
	}
	return(0);
}
