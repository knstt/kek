{
  "version": 1,
  "states": [
    {
      "name": "StandardInput",
      "fields": [
        {
          "name": "input",
          "type": "String",
          "default": "",
          "max": 1000
        }
      ],
      "constructors": []
    },
    {
      "name": "StandardOutput",
      "fields": [
        {
          "name": "output",
          "type": "String",
          "default": "",
          "max": 1000
        }
      ],
      "constructors": []
    },
    {
      "name": "Player",
      "fields": [
        {
          "name": "name",
          "type": "String",
          "default": "Rookie Scout",
          "max": 64
        },
        {
          "name": "health",
          "type": "i32",
          "default": 100,
          "min": 0,
          "max": 100
        },
        {
          "name": "x",
          "type": "i32",
          "default": 1,
          "min": 1,
          "max": 7
        },
        {
          "name": "y",
          "type": "i32",
          "default": 1,
          "min": 1,
          "max": 5
        },
        {
          "name": "gold",
          "type": "i32",
          "default": 0,
          "min": 0,
          "max": 99
        },
        {
          "name": "has_treasure",
          "type": "bool",
          "default": false
        }
      ],
      "constructors": [
        {
          "name": "dead",
          "values": {
            "health": 0
          }
        }
      ]
    },
    {
      "name": "DungeonMap",
      "fields": [
        {
          "name": "width",
          "type": "i32",
          "default": 9,
          "min": 9,
          "max": 9
        },
        {
          "name": "height",
          "type": "i32",
          "default": 7,
          "min": 7,
          "max": 7
        }
      ],
      "constructors": []
    },
    {
      "name": "Treasure",
      "fields": [
        {
          "name": "treasure_x",
          "type": "i32",
          "default": 6,
          "min": 1,
          "max": 7
        },
        {
          "name": "treasure_y",
          "type": "i32",
          "default": 1,
          "min": 1,
          "max": 5
        }
      ],
      "constructors": []
    },
    {
      "name": "Goblin",
      "fields": [
        {
          "name": "goblin_x",
          "type": "i32",
          "default": 4,
          "min": 1,
          "max": 7
        },
        {
          "name": "goblin_y",
          "type": "i32",
          "default": 3,
          "min": 1,
          "max": 5
        },
        {
          "name": "goblin_alive",
          "type": "bool",
          "default": true
        }
      ],
      "constructors": []
    },
    {
      "name": "GameProgress",
      "fields": [
        {
          "name": "exit_x",
          "type": "i32",
          "default": 7,
          "min": 1,
          "max": 7
        },
        {
          "name": "exit_y",
          "type": "i32",
          "default": 5,
          "min": 1,
          "max": 5
        },
        {
          "name": "turn",
          "type": "i32",
          "default": 0,
          "min": 0
        },
        {
          "name": "message",
          "type": "String",
          "default": "Find the treasure, avoid trouble, and reach the exit.",
          "max": 240
        },
        {
          "name": "game_over",
          "type": "bool",
          "default": false
        },
        {
          "name": "won",
          "type": "bool",
          "default": false
        }
      ],
      "constructors": []
    }
  ],
  "hooks": [
    {
      "name": "RenderAfterProgressChanged",
      "on": {
        "state": "GameProgress",
        "event": "changed"
      },
      "reads": [
        "Player",
        "DungeonMap",
        "Treasure",
        "Goblin",
        "GameProgress"
      ],
      "writes": [
        "StandardOutput"
      ]
    },
    {
      "name": "HandleInputChanged",
      "on": {
        "state": "StandardInput",
        "event": "changed"
      },
      "reads": [
        "StandardInput"
      ],
      "writes": [
        "Player",
        "Goblin",
        "GameProgress"
      ]
    }
  ]
}
