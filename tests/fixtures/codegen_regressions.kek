#import(std/lib.kek);

struct:NestedTail {
	u8:prefix;
	struct:Inner {
		u8:value;
	};
	u8:suffix;
};

struct:Quad<T1, T2, T3, T4> {
	T1:first;
	T2:second;
	T3:third;
	T4:fourth;
};

T:EchoGeneric<T>(T:value) {
	return(value);
}

T:AddGeneric<T>(T:left, T:right) {
	return(left + right);
}

int:DeferBeforeReturn() {
	int:value = 0;
	defer value += 1;
	return(value);
}

int:DeferBeforeBreak() {
	int:value = 0;
	while (value == 0) {
		defer value += 1;
		break;
	}
	return(value);
}

int:DeferBeforeContinue() {
	int:value = 0;
	while (value == 0) {
		defer value += 1;
		continue;
	}
	return(value);
}

int:OuterArrayLenAfterShadow() {
	int:values[3] = {0};
	{
		int:values[5] = {0};
		assert(len(values) == 5);
	}
	return(cast<int>(len(values)));
}

i64:main() {
	NestedTail:item;
	item.prefix = 3;
	item.Inner.value = 5;
	item.suffix = 7;
	assert(item.prefix == 3);
	assert(item.Inner.value == 5);
	assert(item.suffix == 7);

	int:many = 0;
	{
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
		defer many += 1;
	}
	assert(many == 65);
	assert(DeferBeforeReturn() == 1);
	assert(DeferBeforeBreak() == 1);
	assert(DeferBeforeContinue() == 1);
	assert(OuterArrayLenAfterShadow() == 3);

	Quad<u8, u16, u32, u64>:quad;
	quad.first = 1;
	quad.second = 2;
	quad.third = 3;
	quad.fourth = 4;
	assert(quad.first == 1);
	assert(quad.second == 2);
	assert(quad.third == 3);
	assert(quad.fourth == 4);
	assert(EchoGeneric<u16>(19) == 19);
	assert(AddGeneric<int>(20, 22) == 42);
	return(0);
}
