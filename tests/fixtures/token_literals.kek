#import(std/lib.kek);

/// Tokenizer parity fixture.
struct:TokenFixture {
	u8:value;
};

i64:main() {
	TokenFixture:item = { value = 'a' };
	u64:binary = 0b1010_0001;
	u64:hex = 0xFF_AA_00_12;
	str:text = "quoted \"text\"";
	u8:newline = '\n';
	assert(text != 0);
	assert(newline == 10);
	// line comment
	/// doc comment
	/* block
	   comment */
	if ((item.value == 'a' && binary != 0) || hex >= 1) {
		return(0);
	}
	return(1);
}
