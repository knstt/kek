#import(std);

i64:main() {
	Allocator:allocator = std::DefaultAllocator();

	byte:input[5] = { 104, 101, 108, 108, 111 };
	Slice<byte>:inputSlice = std::FixedSlice<byte>(input, len(input));
	String:text = std::StringFromBytes(inputSlice);
	assert(text.len == 5);
	assert(text.data[0] == 'h');
	assert(text.Equals(std::StringFromBytes(inputSlice)));
	assert(text.ContainsByte('e'));
	Result<usize>:foundByte = text.FindByte('l');
	assert(foundByte.status == Status::Ok);
	assert(foundByte.value == 2);
	String:slicedText = text.Slice(1, 3);
	assert(slicedText.EqualsCString("ell"));
	String:cText = std::StringFromCString("compiler");
	assert(cText.len == 8);
	assert(cText.EqualsCString("compiler"));

	byte:prefixBytes[2] = { 104, 101 };
	String:prefix = std::StringFromBytes(std::FixedSlice<byte>(prefixBytes, len(prefixBytes)));
	assert(text.StartsWith(prefix));

	byte:suffixBytes[2] = { 108, 111 };
	String:suffix = std::StringFromBytes(std::FixedSlice<byte>(suffixBytes, len(suffixBytes)));
	assert(text.EndsWith(suffix));

	byte:out[8] = {0};
	MemoryWriter:writer = std::MemoryWriterNew(std::FixedSpan<byte>(out, len(out)));
	Result<usize>:writeResult = writer.Write(inputSlice);
	assert(writeResult.status == Status::Ok);
	assert(writeResult.value == 5);
	assert(writer.Written() == 5);
	assert(out[1] == 101);

	MemoryReader:reader = std::MemoryReaderNew(inputSlice);
	byte:readOut[3] = {0};
	Result<usize>:readResult = reader.Read(std::FixedSpan<byte>(readOut, len(readOut)));
	assert(readResult.status == Status::Ok);
	assert(readResult.value == 3);
	assert(readOut[2] == 108);

	ptr<byte>:heap = std::Alloc<byte>(allocator, 5);
	assert(heap != 0);
	std::Copy<byte>(heap, input, 5);
	assert(heap[4] == 111);
	std::Free<byte>(allocator, heap, 5);

	StringBuilder:builder = std::StringBuilderNew(allocator);
	assert(std::WriteStringToBuilder(&builder, text) == Status::Ok);
	String:built = builder.View();
	assert(built.Equals(text));
	assert(std::FormatI64ToBuilder(&builder, -42) == Status::Ok);
	assert(std::FormatU64ToBuilder(&builder, 31, 16) == Status::Ok);
	assert(std::FormatBoolToBuilder(&builder, true) == Status::Ok);
	byte:formattedBytes[14] = {
		104, 101, 108, 108, 111, 45, 52, 50,
		49, 70, 116, 114, 117, 101,
	};
	String:formatted = std::StringFromBytes(std::FixedSlice<byte>(formattedBytes, len(formattedBytes)));
	String:formattedView = builder.View();
	assert(formattedView.Equals(formatted));
	Result<OwnedString>:ownedResult = builder.ToOwnedString();
	assert(ownedResult.status == Status::Ok);
	assert(ownedResult.value.len == 14);
	OwnedString:owned = ownedResult.value;
	assert(owned.Destroy() == Status::Ok);
	assert(builder.Destroy() == Status::Ok);

	StringBuilder:methodBuilder = std::StringBuilderNew(allocator);
	assert(methodBuilder.WriteCString("hi") == Status::Ok);
	assert(methodBuilder.WriteByte('!') == Status::Ok);
	assert(methodBuilder.WriteRepeatByte('?', 2) == Status::Ok);
	assert(methodBuilder.WriteIndent(1) == Status::Ok);
	assert(methodBuilder.WriteString(text) == Status::Ok);
	String:methodView = methodBuilder.View();
	assert(methodView.len == 11);
	assert(methodView.data[0] == 'h');
	assert(methodView.data[2] == '!');
	assert(methodView.data[5] == ' ');
	Result<OwnedString>:detached = methodBuilder.Detach();
	assert(detached.status == Status::Ok);
	OwnedString:detachedText = detached.value;
	assert(detachedText.len == 11);
	assert(detachedText.Destroy() == Status::Ok);
	assert(methodBuilder.Destroy() == Status::Ok);

	Array<byte>:array = std::ArrayNew<byte>(allocator);
	assert(array.Reserve(2) == Status::Ok);
	assert(array.Push(7) == Status::Ok);
	assert(array.Push(9) == Status::Ok);
	Result<byte>:item = array.Get(1);
	assert(item.status == Status::Ok);
	assert(item.value == 9);
	assert(array.Set(1, 11) == Status::Ok);
	Result<byte>:popped = array.Pop();
	assert(popped.status == Status::Ok);
	assert(popped.value == 11);
	assert(array.Clear() == Status::Ok);
	byte:more[2] = { 1, 2 };
	assert(array.AppendSlice(std::FixedSlice<byte>(more, len(more))) == Status::Ok);
	ptr<byte>:second = array.GetPtr(1);
	assert(second != 0);
	assert(second[0] == 2);
	assert(array.PushZeroed() == Status::Ok);
	ptr<byte>:last = array.LastPtr();
	assert(last != 0);
	assert(last[0] == 0);
	assert(array.Destroy() == Status::Ok);

	ptr<ListNode<byte>>:nodeForSpecialization = std::Alloc<ListNode<byte>>(allocator, 1);
	assert(nodeForSpecialization != 0);
	std::Free<ListNode<byte>>(allocator, nodeForSpecialization, 1);

	LinkedList<byte>:list = std::LinkedListNew<byte>(allocator);
	assert(list.PushBack(3) == Status::Ok);
	assert(list.PushFront(2) == Status::Ok);
	assert(list.len == 2);
	Result<byte>:front = list.PopFront();
	assert(front.status == Status::Ok);
	assert(front.value == 2);
	Result<byte>:back = list.PopBack();
	assert(back.status == Status::Ok);
	assert(back.value == 3);
	assert(list.Destroy() == Status::Ok);

	str:filePath = "out/stdlib_test";
	Result<File>:opened = std::FileOpen(filePath, FileMode::Write);
	assert(opened.status == Status::Ok);
	File:file = opened.value;
	assert(file.Write(inputSlice).status == Status::Ok);
	assert(file.Close() == Status::Ok);
	assert(std::WriteFile("out/stdlib_helper", text) == Status::Ok);
	OwnedString:fileText;
	assert(std::ReadFileToOwnedString("out/stdlib_helper", allocator, &fileText) == Status::Ok);
	String:fileView = fileText.View();
	assert(fileView.Equals(text));
	assert(fileText.Destroy() == Status::Ok);

	String:cursorInput = std::StringFromCString(" a\nb");
	ByteCursor:cursor = std::ByteCursorNew(cursorInput);
	assert(cursor.line == 1);
	assert(cursor.column == 1);
	assert(cursor.SkipAsciiWhitespace() == Status::Ok);
	assert(cursor.pos == 1);
	assert(cursor.column == 2);
	assert(cursor.Peek() == 'a');
	assert(cursor.PeekAt(1) == '\n');
	assert(cursor.MatchByte('a'));
	assert(cursor.Advance() == '\n');
	assert(cursor.line == 2);
	assert(cursor.column == 1);
	assert(cursor.Peek() == 'b');
	assert(cursor.Advance() == 'b');
	assert(cursor.AtEnd());

	return(0);
}
