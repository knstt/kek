state StandardInput {
  input: String

  default {
    input: ""
  }

  verify {
    input.len() <= 1000
  }
}

state StandardOutput {
  output: String

  default {
    output: ""
  }

  verify {
    output.len() <= 1000
  }
}

state Player {
  name: String
  health: i32

  default {
    name: "Player"
    health: 100
  }

  verify {
    name.len() <= 64
    health >= 0 && health <= 100
  }
}
