state StandardInput {
  input: String

  default {
    input: ""
  }

  verify {
    input.len() <= 1000
  }
}

state StandardOutput {
  output: String

  default {
    output: ""
  }

  verify {
    output.len() <= 1000
  }
}

state Player {
  name: String
  health: i32
  x: i32
  y: i32
  gold: i32
  has_treasure: bool

  default {
    name: "Rookie Scout"
    health: 100
    x: 1
    y: 1
    gold: 0
    has_treasure: false
  }

  verify {
    name.len() <= 64
    health >= 0 && health <= 100
    x >= 1 && x <= 7
    y >= 1 && y <= 5
    gold >= 0 && gold <= 99
  }
}

state DungeonMap {
  width: i32
  height: i32

  default {
    width: 9
    height: 7
  }

  verify {
    width == 9
    height == 7
  }
}

state Treasure {
  treasure_x: i32
  treasure_y: i32

  default {
    treasure_x: 6
    treasure_y: 1
  }

  verify {
    treasure_x >= 1 && treasure_x <= 7
    treasure_y >= 1 && treasure_y <= 5
  }
}

state Goblin {
  goblin_x: i32
  goblin_y: i32
  goblin_alive: bool

  default {
    goblin_x: 4
    goblin_y: 3
    goblin_alive: true
  }

  verify {
    goblin_x >= 1 && goblin_x <= 7
    goblin_y >= 1 && goblin_y <= 5
  }
}

state GameProgress {
  exit_x: i32
  exit_y: i32
  turn: i32
  message: String
  game_over: bool
  won: bool

  default {
    exit_x: 7
    exit_y: 5
    turn: 0
    message: "Find the treasure, avoid trouble, and reach the exit."
    game_over: false
    won: false
  }

  verify {
    exit_x >= 1 && exit_x <= 7
    exit_y >= 1 && exit_y <= 5
    turn >= 0
    message.len() <= 240
  }
}

hook RenderAfterProgressChanged {
  on GameProgress.changed
  reads Player, DungeonMap, Treasure, Goblin, GameProgress
  writes StandardOutput
}

hook HandleInputChanged {
  on StandardInput.changed
  reads StandardInput
  writes Player, Goblin, GameProgress
}
